# Global Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://sdk.mercadopago.com" "https://www.mercadopago.com.mx")
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://sdk.mercadopago.com https://cdnjs.cloudflare.com https://accounts.google.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.mercadopago.com https://generativelanguage.googleapis.com https://accounts.google.com https://unpkg.com https://api.github.com https://*.pages.dev; frame-src 'self' https://www.mercadopago.com.mx https://sdk.mercadopago.com https://accounts.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.mercadopago.com.mx https://wa.me https://api.whatsapp.com; upgrade-insecure-requests;
  X-Robots-Tag: all

# Admin & Panel Protection (No Indexing)
/panel/*
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Static Assets Caching
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# API Security & No-Cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  X-Content-Type-Options: nosniff
