# ══════════════════════════════════════════════════════════════
# THE GARAGE & BICISAAS — CREDENCIALES SUPABASE CLOUD (PRUEBAS)
# ══════════════════════════════════════════════════════════════
# Copia este archivo como .env.supabase (ignorado por Git)
# y pega los valores de tu nuevo proyecto en https://supabase.com
# ══════════════════════════════════════════════════════════════

# URL de la API del proyecto (Settings -> API -> Project URL)
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clave pública anónima (Settings -> API -> anon public)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clave secreta service_role (Settings -> API -> service_role secret)
# IMPORTANTE: Solo para ejecutar las migraciones y crear usuarios de prueba.
# Se revocará y rotará al terminar.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Cadena de conexión directa a PostgreSQL (Settings -> Database -> Connection string -> URI)
# Reemplaza [YOUR-PASSWORD] con la contraseña que elegiste al crear el proyecto.
SUPABASE_DB_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
