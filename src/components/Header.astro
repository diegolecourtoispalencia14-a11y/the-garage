---
---

<header class="site-header">
  <div class="container-fluid header-inner">
    
    <!-- Authentic Brand Logo (White Monochrome for Dark Luxury) -->
    <a href="/" class="logo-link" title="The Garage Bike Experts - Inicio">
      <img
        src="/img/the-garage-logo-white.png"
        alt="The Garage Bike Experts - Playa del Carmen"
        class="brand-logo"
        loading="eager"
      />
    </a>

    <!-- Navigation Links -->
    <nav class="nav-links" aria-label="Navegación Principal">
      <a href="/inventario" class="nav-item">
        <span class="nav-num font-mono">01</span>
        <span>Inventario</span>
      </a>
      <a href="/#sec-matchmaker" class="nav-item">
        <span class="nav-num font-mono">02</span>
        <span>Asesor</span>
      </a>
      <a href="/comunidad" class="nav-item">
        <span class="nav-num font-mono">03</span>
        <span>Comunidad</span>
      </a>
      <a href="/guia-tallas" class="nav-item">
        <span class="nav-num font-mono">04</span>
        <span>Calculadora</span>
      </a>
      <a href="/guias" class="nav-item">
        <span class="nav-num font-mono">05</span>
        <span>Guías</span>
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="header-actions">
      <a
        href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20hacer%20una%20consulta%20con%20un%20experto%20de%20The%20Garage."
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp header-wa-btn"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.152.57 4.17 1.564 5.91l-1.564 5.708 5.867-1.538c1.701.928 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>

  </div>
</header>

<style>
  .site-header {
    background-color: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-hairline);
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.18s var(--ease-spring);
    letter-spacing: -0.01em;
  }

  .nav-num {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-weight: 700;
  }

  .nav-item:hover {
    color: var(--text-primary);
  }
  .nav-item:hover .nav-num {
    color: var(--brand-red);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-wa-btn {
    padding: 0.55rem 1.15rem;
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }
</style>
