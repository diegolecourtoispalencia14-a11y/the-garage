      <!-- Mobile Hamburger Button -->
      <button type="button" class="mobile-menu-toggle" id="mobile-menu-btn" aria-label="Abrir Menú">
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-nav-drawer" id="mobile-nav-drawer">
    <nav class="mobile-nav-list font-mono">
      <a href="/inventario" class="mobile-nav-link">
        <span class="mobile-nav-num">[01]</span>
        <span>INVENTARIO EN TIENDA</span>
      </a>
      <a href="/#sec-matchmaker" class="mobile-nav-link">
        <span class="mobile-nav-num">[02]</span>
        <span>ASESOR BIKE FINDER</span>
      </a>
      <a href="/comunidad" class="mobile-nav-link">
        <span class="mobile-nav-num">[03]</span>
        <span>COMUNIDAD &amp; INSTAGRAM</span>
      </a>
      <a href="/guia-tallas" class="mobile-nav-link">
        <span class="mobile-nav-num">[04]</span>
        <span>CALCULADORA DE TALLA</span>
      </a>
      <a href="/guias" class="mobile-nav-link">
        <span class="mobile-nav-num">[05]</span>
        <span>GUÍAS &amp; MANTENIMIENTO</span>
      </a>
      <a href="/riviera-maya" class="mobile-nav-link">
        <span class="mobile-nav-num">[06]</span>
        <span>COBERTURA RIVIERA MAYA</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-hairline);
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.18s var(--ease-spring);
    letter-spacing: -0.01em;
  }

  .nav-num {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-weight: 700;
  }

  .nav-item:hover {
    color: var(--text-primary);
  }
  .nav-item:hover .nav-num {
    color: var(--brand-red);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-wa-btn {
    padding: 0.55rem 1.15rem;
    font-size: 0.82rem;
  }

  /* Mobile Toggle */
  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-toggle .bar {
    width: 20px;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    display: none;
    background: #09090B;
    border-bottom: 1px solid var(--border-hairline);
    padding: var(--space-4) var(--space-5);
  }

  .mobile-nav-drawer.open {
    display: block;
    animation: fadeInUp 0.25s var(--ease-spring);
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .mobile-nav-link:hover {
    color: #FFFFFF;
  }

  .mobile-nav-num {
    color: #FB7185;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .nav-links {
      display: none;
    }
    .mobile-menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  function initHeaderDrawer() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    btn?.addEventListener('click', () => {
      drawer?.classList.toggle('open');
    });

    // Auto-close on link click
    drawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('open');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderDrawer);
  } else {
    initHeaderDrawer();
  }
</script>
