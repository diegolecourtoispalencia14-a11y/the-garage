        class="brand-logo"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" aria-label="Navegación Principal">
      <a href="/inventario" class="nav-item">
        <span class="nav-num font-mono">01</span>
        <span>Inventario</span>
      </a>
      <a href="/#sec-matchmaker" class="nav-item">
        <span class="nav-num font-mono">02</span>
        <span>Asesor</span>
      </a>
      <a href="/comunidad" class="nav-item">
        <span class="nav-num font-mono">03</span>
        <span>Comunidad</span>
      </a>
      <a href="/guia-tallas" class="nav-item">
        <span class="nav-num font-mono">04</span>
        <span>Calculadora</span>
      </a>
      <a href="/guias" class="nav-item">
        <span class="nav-num font-mono">05</span>
        <span>Guías</span>
      </a>
      <a href="/riviera-maya" class="nav-item">
        <span class="nav-num font-mono">06</span>
        <span>Cobertura</span>
      </a>
    </nav>

    <!-- Right Actions (WhatsApp & Mobile Toggle) -->
