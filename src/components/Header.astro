---
---

<!-- Top Announcement Banner -->
<div style="background-color: var(--secondary); color: #F8FAFC; font-size: 0.8rem; padding: 0.45rem 1rem; border-bottom: 1px solid #27272A;">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: #22C55E;"></span>
      <span><strong>The Garage</strong> • Tienda física en Playa del Carmen</span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem; font-weight: 600;">
      <span>🚚 Envíos y entregas en Riviera Maya & Valladolid</span>
      <a href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20hacer%20una%20consulta%20directa." target="_blank" rel="noopener noreferrer" style="color: var(--primary); text-decoration: underline;">
        +52 984 138 1493
      </a>
    </div>
  </div>
</div>

<!-- Main Navbar -->
<header style="background-color: #FFFFFF; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; padding-bottom: 0.75rem;">
    
    <!-- Logo -->
    <a href="/" style="display: flex; align-items: center; gap: 0.75rem;" title="The Garage - Inicio">
      <div style="width: 44px; height: 44px; background: #18181B; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FF5722" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18.5" cy="17.5" r="3.5"/>
          <circle cx="5.5" cy="17.5" r="3.5"/>
          <circle cx="15" cy="5" r="1"/>
          <path d="M12 17.5V14l-3-3 4-3 2 3h2"/>
        </svg>
      </div>
      <div>
        <span style="font-size: 1.35rem; font-weight: 900; letter-spacing: -0.02em; color: var(--secondary); display: block; line-height: 1;">THE GARAGE</span>
        <span style="font-size: 0.7rem; font-weight: 800; color: var(--primary); letter-spacing: 0.15em; text-transform: uppercase;">Bicicletas • Playa del Carmen</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav style="display: flex; align-items: center; gap: 1.25rem;">
      <a href="/" style="font-size: 0.9rem; font-weight: 700; color: var(--secondary); transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--secondary)'">
        Inventario
      </a>
      <a href="/riviera-maya" style="font-size: 0.9rem; font-weight: 700; color: var(--secondary); transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--secondary)'">
        Cobertura
      </a>
      <a
        href="https://wa.me/529841381493?text=Hola,%20me%20interesa%20agendar%20una%20visita%20a%20la%20tienda%20o%20conocer%20el%20inventario."
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp"
        style="padding: 0.5rem 0.95rem; font-size: 0.85rem;"
      >
        <span>Apartar / WhatsApp</span>
      </a>
    </nav>

  </div>
</header>
