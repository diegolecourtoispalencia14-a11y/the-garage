---
const categorias = [
  { id: 'todas', label: 'Todos los Modelos' },
  { id: 'MTB', label: 'MTB & Senderos' },
  { id: 'Ruta', label: 'Ruta & Asfalto' },
  { id: 'Gravel', label: 'Gravel Aventura' },
  { id: 'Urbana', label: 'Urbana' },
];
---

<div class="filter-toolbar-container">
  <div class="filter-scroll-wrapper">
    {categorias.map((cat, idx) => (
      <button
        type="button"
        class={`filter-tab-pill font-mono ${idx === 0 ? 'active' : ''}`}
        data-filter={cat.id}
      >
        <span>{cat.label}</span>
      </button>
    ))}
  </div>

  <div class="filter-count-indicator font-mono" id="filter-count-label">
    Mostrando todas las unidades
  </div>
</div>

<style>
  .filter-toolbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-hairline);
    flex-wrap: wrap;
    width: 100%;
  }

  .filter-scroll-wrapper {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .filter-scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .filter-tab-pill {
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-hairline);
    background: var(--surface-card);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s var(--ease-spring);
    letter-spacing: 0.02em;
  }

  .filter-tab-pill:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--text-primary);
    background: var(--surface-elevated);
  }

  .filter-tab-pill.active {
    background: #FFFFFF;
    color: #09090B;
    border-color: #FFFFFF;
  }

  .filter-count-indicator {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }
</style>

<script>
  function initInventoryFilters() {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-tab-pill');
    const cards = document.querySelectorAll<HTMLElement>('.bici-grid .card-bici-tile');
    const countLabel = document.getElementById('filter-count-label');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.getAttribute('data-filter') || 'todas';
        let visibleCount = 0;

        cards.forEach((card) => {
          const cat = card.getAttribute('data-categoria');
          if (filter === 'todas' || cat === filter) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countLabel) {
          countLabel.textContent = `${visibleCount} ${visibleCount === 1 ? 'unidad disponible' : 'unidades disponibles'}`;
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInventoryFilters);
  } else {
    initInventoryFilters();
  }
</script>
