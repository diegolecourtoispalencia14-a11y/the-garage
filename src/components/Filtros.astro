---
---

<div class="filtros-container" style="background: #FFFFFF; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.25rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    
    <!-- Top row: Search & Result Counter -->
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center;">
      <div style="flex: 1; min-width: 240px; position: relative;">
        <input
          type="text"
          id="filter-search"
          placeholder="Buscar por marca, modelo, rodada o talla..."
          style="width: 100%; padding: 0.65rem 1rem 0.65rem 2.5rem; border-radius: var(--radius-md); border: 1px solid var(--border); font-size: 0.95rem; outline: none; transition: border-color 0.2s ease;"
          onfocus="this.style.borderColor='var(--primary)'"
          onblur="this.style.borderColor='var(--border)'"
        />
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>

      <div style="font-size: 0.9rem; font-weight: 700; color: var(--text-muted);">
        <span id="result-count">3</span> bicicletas en inventario
      </div>
    </div>

    <!-- Category Tabs -->
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
        Categoría:
      </span>
      <div id="filter-categorias" style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
        <button type="button" class="filter-btn active" data-categoria="todas">Todas</button>
        <button type="button" class="filter-btn" data-categoria="MTB">MTB / Montaña</button>
        <button type="button" class="filter-btn" data-categoria="Ruta">Ruta</button>
        <button type="button" class="filter-btn" data-categoria="Urbana">Urbana</button>
        <button type="button" class="filter-btn" data-categoria="Eléctrica">Eléctrica</button>
        <button type="button" class="filter-btn" data-categoria="Infantil">Infantil</button>
      </div>
    </div>

    <!-- Secondary Filters: Disponibilidad & Estado -->
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border);">
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
          Disponibilidad:
        </span>
        <select id="filter-disponibilidad" style="padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: #F8FAFC; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <option value="todas">Todas</option>
          <option value="Disponible">Solo Disponibles</option>
          <option value="Apartada">Apartadas</option>
          <option value="Vendida">Vendidas</option>
        </select>
      </div>

      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">
          Estado:
        </span>
        <select id="filter-estado" style="padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: #F8FAFC; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <option value="todos">Todos</option>
          <option value="Nueva">Nuevas</option>
          <option value="Seminueva">Seminuevas</option>
        </select>
      </div>

      <button
        id="filter-reset"
        type="button"
        style="margin-left: auto; background: none; border: none; color: var(--primary); font-size: 0.85rem; font-weight: 700; cursor: pointer; text-decoration: underline;"
      >
        Limpiar filtros
      </button>
    </div>

  </div>
</div>

<!-- Empty state container if 0 results match -->
<div id="no-results" style="display: none; text-align: center; padding: 3rem 1.5rem; background: #FFFFFF; border-radius: var(--radius-lg); border: 1px dashed var(--border); margin: 2rem 0;">
  <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔍</div>
  <h3 class="title-md" style="margin-bottom: 0.5rem;">No encontramos bicicletas con esos filtros</h3>
  <p class="subtitle" style="max-width: 500px; margin: 0 auto 1.5rem;">
    Pregúntanos por WhatsApp qué modelo o talla buscas. Constantemente recibimos inventario nuevo en la tienda de Playa del Carmen.
  </p>
  <a
    href="https://wa.me/529841381493?text=Hola,%20busco%20una%20bicicleta%20espec%C3%ADfica%20que%20no%20encontr%C3%A9%20en%20el%20cat%C3%A1logo.%20%C2%BFTienen%20disponibilidad?"
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-whatsapp"
    style="display: inline-flex;"
  >
    Preguntar por modelo específico en WhatsApp
  </a>
</div>

<style>
  .filter-btn {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background-color: #F8FAFC;
    color: var(--text-main);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-btn:hover {
    background-color: #E2E8F0;
    border-color: var(--text-muted);
  }
  .filter-btn.active {
    background-color: var(--secondary);
    color: #FFFFFF;
    border-color: var(--secondary);
  }
</style>

<script>
  function initFiltros() {
    const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('#filter-categorias .filter-btn');
    const dispSelect = document.getElementById('filter-disponibilidad') as HTMLSelectElement | null;
    const estadoSelect = document.getElementById('filter-estado') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('filter-reset');
    const cards = document.querySelectorAll<HTMLElement>('.bici-grid .card');
    const countEl = document.getElementById('result-count');
    const noResultsEl = document.getElementById('no-results');

    let currentCat = 'todas';

    function applyFilters() {
      const searchVal = (searchInput?.value || '').toLowerCase().trim();
      const dispVal = dispSelect?.value || 'todas';
      const estadoVal = estadoSelect?.value || 'todos';

      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-categoria') || '';
        const cardDisp = card.getAttribute('data-disponibilidad') || '';
        const cardEstado = card.getAttribute('data-estado') || '';
        const cardSearch = card.getAttribute('data-search') || '';

        const matchCat = currentCat === 'todas' || cardCat === currentCat;
        const matchDisp = dispVal === 'todas' || cardDisp === dispVal;
        const matchEstado = estadoVal === 'todos' || cardEstado === estadoVal;
        const matchSearch = !searchVal || cardSearch.includes(searchVal);

        if (matchCat && matchDisp && matchEstado && matchSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countEl) {
        countEl.textContent = visibleCount.toString();
      }

      if (noResultsEl) {
        noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.getAttribute('data-categoria') || 'todas';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    dispSelect?.addEventListener('change', applyFilters);
    estadoSelect?.addEventListener('change', applyFilters);

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (dispSelect) dispSelect.value = 'todas';
      if (estadoSelect) estadoSelect.value = 'todos';
      currentCat = 'todas';
      catButtons.forEach((b) => {
        if (b.getAttribute('data-categoria') === 'todas') b.classList.add('active');
        else b.classList.remove('active');
      });
      applyFilters();
    });
  }

  // Run on first load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFiltros);
  } else {
    initFiltros();
  }
</script>
