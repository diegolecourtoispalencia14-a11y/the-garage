---
// GoogleOneTap.astro
// Google Identity Services One-Tap login integration.
//
// SETUP REQUIRED (one-time, 5 min):
// 1. Go to console.cloud.google.com
// 2. Create a project (or use existing one)
// 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
// 4. Application type: Web application
// 5. Authorized JS origins: https://the-garage-dw4.pages.dev
// 6. Copy the Client ID and paste it below replacing YOUR_GOOGLE_CLIENT_ID
//
// Until the Client ID is configured, this component is silent and does nothing.
---

<!-- Google Identity Services SDK -->
<script src="https://accounts.google.com/gsi/client" async defer is:inline></script>

<!-- Hidden One-Tap initialization element -->
<div
  id="g_id_onload"
  data-client_id="727148939594-h5l331vu9mqq7nc61lsv6b21ed6uhjdt.apps.googleusercontent.com"
  data-callback="handleGoogleCredentialResponse"
  data-auto_prompt="false"
  data-itp_support="true"
  data-cancel_on_tap_outside="false"
  style="display:none;"
></div>

<!-- Optional: render a sign-in button when triggered programmatically -->
<div id="tg-google-btn-container" style="display:none;"></div>

<!-- Exit Intent Modal (Google One-Tap offer) -->
<div id="tg-exit-modal" aria-hidden="true" style="
  display:none;
  position:fixed;
  inset:0;
  z-index:9998;
  background:rgba(9,9,11,0.75);
  backdrop-filter:blur(8px);
  align-items:center;
  justify-content:center;
">
  <div style="
    background:#111113;
    border:1px solid rgba(255,255,255,0.08);
    border-radius:16px;
    padding:2.5rem 2rem;
    max-width:420px;
    width:90%;
    text-align:center;
    position:relative;
  ">
    <button id="tg-exit-close" aria-label="Cerrar" style="
      position:absolute;top:1rem;right:1rem;
      background:none;border:none;
      color:#888;cursor:pointer;font-size:1.2rem;
    ">✕</button>

    <p class="font-mono" style="
      font-size:0.7rem;letter-spacing:0.1em;
      color:#a1a1aa;margin-bottom:0.75rem;
    ">[ACCESO EXCLUSIVO / THE GARAGE]</p>

    <h3 style="font-size:1.4rem;font-weight:600;color:#fff;margin-bottom:0.5rem;line-height:1.3;">
      Tu ficha de geometría te espera
    </h3>
    <p style="color:#a1a1aa;font-size:0.9rem;margin-bottom:1.5rem;line-height:1.6;">
      Inicia sesión y guarda tu perfil de ciclista: talla exacta, historial de bicicletas consultadas y acceso anticipado a drops Basso.
    </p>

    <!-- Google Sign-In Button rendered here -->
    <div id="tg-onetap-render-target" style="display:flex;justify-content:center;margin-bottom:1rem;"></div>

    <p style="font-size:0.75rem;color:#52525b;">
      Solo tu nombre y correo. Sin contraseña. Puedes eliminar tu perfil en cualquier momento.
    </p>
  </div>
</div>

<script is:inline>
(function () {

  /* ── Decode Google JWT without external library ── */
  function decodeJWT(token) {
    try {
      var parts   = token.split('.');
      var payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');
      var json    = decodeURIComponent(
        atob(payload).split('').map(function (c) {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join('')
      );
      return JSON.parse(json);
    } catch (_) {
      return null;
    }
  }

  /* ── Main credential callback (called by Google SDK) ── */
  window.handleGoogleCredentialResponse = function (response) {
    if (!response || !response.credential) return;

    var payload = decodeJWT(response.credential);
    if (!payload) return;

    var userInfo = {
      google_id:  payload.sub,
      name:       payload.name       || '',
      first_name: payload.given_name || '',
      email:      payload.email      || '',
      picture:    payload.picture    || '',
      verified:   payload.email_verified || false
    };

    // Fire tracker event
    window.dispatchEvent(new CustomEvent('tg:google_login', { detail: userInfo }));

    // Personalize UI
    personalizeUI(userInfo);

    // Close modal if open
    var modal = document.getElementById('tg-exit-modal');
    if (modal) modal.style.display = 'none';

    // Show a subtle welcome acknowledgment
    showWelcome(userInfo.first_name || userInfo.name);
  };

  function personalizeUI(user) {
    // Show name in header area if element exists
    var nameSlots = document.querySelectorAll('[data-tg-user-name]');
    nameSlots.forEach(function (el) {
      el.textContent = user.first_name || user.name;
    });

    // Show avatar if element exists
    var avatarSlots = document.querySelectorAll('[data-tg-user-avatar]');
    avatarSlots.forEach(function (el) {
      if (user.picture) {
        el.src = user.picture;
        el.style.display = 'block';
      }
    });

    // Update any CTA that says "Iniciar sesión"
    var loginBtns = document.querySelectorAll('[data-tg-login-cta]');
    loginBtns.forEach(function (el) {
      el.textContent = 'Mi Perfil — ' + (user.first_name || user.email);
    });
  }

  function showWelcome(name) {
    var el = document.createElement('div');
    el.textContent = 'Bienvenido, ' + name + '. Tu perfil fue guardado.';
    el.style.cssText = [
      'position:fixed', 'bottom:2rem', 'left:50%',
      'transform:translateX(-50%)',
      'background:#18181b', 'color:#e4e4e7',
      'border:1px solid rgba(255,255,255,0.1)',
      'border-radius:8px', 'padding:0.75rem 1.5rem',
      'font-size:0.85rem', 'z-index:9999',
      'font-family:monospace', 'white-space:nowrap',
      'box-shadow:0 8px 24px rgba(0,0,0,0.5)'
    ].join(';');
    document.body.appendChild(el);
    setTimeout(function () {
      el.style.transition = 'opacity 0.4s';
      el.style.opacity    = '0';
      setTimeout(function () { el.remove(); }, 400);
    }, 3500);
  }

  /* ── Exit Intent: show One-Tap modal ── */
  window.addEventListener('tg:exit_intent', function () {
    // Don't show if user already identified
    var user = null;
    try { user = JSON.parse(localStorage.getItem('tg_user') || 'null'); } catch (_) {}
    if (user) return;

    // Don't show on admin pages
    if (window.location.pathname.indexOf('/admin') === 0) return;

    var modal     = document.getElementById('tg-exit-modal');
    var target    = document.getElementById('tg-onetap-render-target');
    var clientCfg = document.getElementById('g_id_onload');

    if (!modal) return;

    // Only show if Google SDK loaded and Client ID is configured
    if (!clientCfg || !clientCfg.dataset.client_id) return;

    modal.style.display = 'flex';
    modal.removeAttribute('aria-hidden');

    // Render the button inside the modal
    if (window.google && window.google.accounts && target && !target.hasChildNodes()) {
      google.accounts.id.renderButton(target, {
        theme:    'outline',
        size:     'large',
        text:     'continue_with',
        shape:    'pill',
        logo_alignment: 'center',
        width:    280
      });
    }
  });

  /* ── Allow programmatic trigger (e.g., from Paddock Club CTA) ── */
  window.TGGoogleOneTap = {
    prompt: function () {
      var clientCfg = document.getElementById('g_id_onload');
      if (!clientCfg || clientCfg.dataset.client_id === 'YOUR_GOOGLE_CLIENT_ID') return;
      if (window.google && window.google.accounts) {
        google.accounts.id.prompt();
      }
    }
  };

  /* ── Wire close button ── */
  document.addEventListener('DOMContentLoaded', function () {
    var closeBtn = document.getElementById('tg-exit-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        var modal = document.getElementById('tg-exit-modal');
        if (modal) { modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); }
      });
    }

    // Restore personalization if user is already logged in
    try {
      var storedUser = JSON.parse(localStorage.getItem('tg_user') || 'null');
      if (storedUser) personalizeUI(storedUser);
    } catch (_) {}
  });

})();
</script>
