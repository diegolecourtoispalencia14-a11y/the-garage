---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-fluid">
    <div class="footer-grid">
      
      <!-- Columna 1: Marca & Redes -->
      <div class="footer-col">
        <a href="/" class="footer-brand-logo" title="The Garage Bike Experts">
          <img
            src="/img/the-garage-logo-white.png"
            alt="The Garage Bike Experts"
            style="height: 38px; width: auto; object-fit: contain;"
          />
        </a>
        <p class="footer-tagline">
          Boutique ciclista y taller de precisión en Cataluña, Playa del Carmen. Distribuidores oficiales de Basso Bikes Italia y nutrición deportiva Wayfar.
        </p>
        
        <a
          href="https://www.instagram.com/thegarage.pdc/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline footer-ig-btn font-mono"
        >
          <span>@thegarage.pdc en Instagram ↗</span>
        </a>
      </div>

      <!-- Columna 2: Ubicación & Contacto -->
      <div class="footer-col">
        <h2 class="footer-col-title font-mono">[01 // UBICACIÓN & CITAS]</h2>
        <p class="footer-text">
          <strong style="color:#ffffff; font-size:0.88rem;">Taller &amp; Boutique a Puerta Cerrada</strong><br />
          Av. Ich Xeel, Cataluña · C.P. 77725<br />
          Playa del Carmen, Quintana Roo<br />
          <span style="display:inline-block; margin-top:0.4rem; font-size:0.75rem; color:#34d399; background:rgba(52,211,153,0.1); padding:0.25rem 0.6rem; border-radius:6px; border:1px solid rgba(52,211,153,0.25);">
            Visitas presenciales únicamente con cita previa
          </span>
        </p>
        <div class="footer-contact-link">
          <span class="font-mono text-xs text-zinc-500">Concierge WhatsApp:</span><br />
          <a href="https://wa.me/529841381493" class="footer-wa-link font-mono">+52 984 138 1493</a>
        </div>
      </div>

      <!-- Columna 3: Horarios de Servicio -->
      <div class="footer-col">
        <h2 class="footer-col-title font-mono">[02 // HORARIOS]</h2>
        <ul class="footer-schedule font-mono">
          <li>
            <span>Lunes – Jueves:</span>
            <strong>9:00 am – 7:00 pm</strong>
          </li>
          <li>
            <span>Viernes:</span>
            <strong style="color:#38bdf8;">9:00 am – 6:00 pm (Rodada The Garage Ride)</strong>
          </li>
          <li>
            <span>Sábado:</span>
            <strong>9:00 am – 2:00 pm (Previa Cita)</strong>
          </li>
          <li>
            <span>Domingo:</span>
            <span style="color: #71717A;">Cerrado</span>
          </li>
        </ul>

        <!-- Google Reviews Trust Badge -->
        <a
          href="https://www.google.com/maps/search/?api=1&query=The+Garage+Bike+Experts+Av+Ich+Xeel+Catalu%C3%B1a+Playa+del+Carmen"
          target="_blank"
          rel="noopener noreferrer"
          style="text-decoration:none; margin-top:1rem; padding:0.6rem 0.85rem; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:8px; display:flex; align-items:center; gap:0.65rem; transition:border-color 0.2s, background 0.2s;"
          title="Ver perfil oficial de The Garage y opiniones en Google (4.95 / 5)"
        >
          <svg width="22" height="22" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
          <div>
            <div style="font-size:0.8rem; font-weight:700; color:#ffffff; display:flex; align-items:center; gap:0.35rem;">
              <span style="display:inline-flex; gap:2px; color:#f59e0b;"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span> 4.95 / 5.0
            </div>
            <div style="font-size:0.7rem; color:#a1a1aa;">38 opiniones en Google ↗</div>
          </div>
        </a>
      </div>

      <!-- Columna 4: Navegación -->
      <div class="footer-col">
        <h2 class="footer-col-title font-mono">[03 // NAVEGACIÓN]</h2>
        <ul class="footer-nav-list">
          <li><a href="/inventario">Catálogo &amp; Inventario</a></li>
          <li><a href="/#sec-matchmaker">Asesor de Bicicleta</a></li>
          <li><a href="/comunidad">Comunidad &amp; Rodadas de los Viernes</a></li>
          <li><a href="/guia-tallas">Calculadora de Talla</a></li>
          <li><a href="/guias">Guías &amp; Mantenimiento</a></li>
          <li><a href="/aviso-privacidad" class="text-xs text-zinc-500">Aviso de Privacidad</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom-bar font-mono">
      <p>© {year} THE GARAGE • BIKE EXPERTS. PLAYA DEL CARMEN, QUINTANA ROO.</p>
      <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer">@THEGARAGE.PDC</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #060608;
    color: var(--text-muted);
    padding: var(--space-8) 0 var(--space-6) 0;
    border-top: 1px solid var(--border-hairline);
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand-logo {
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .footer-tagline {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .footer-ig-btn {
    padding: 0.55rem 1rem;
    font-size: 0.78rem;
    width: fit-content;
  }

  .footer-col-title {
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .footer-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .footer-contact-link {
    margin-top: auto;
  }

  .footer-wa-link {
    color: var(--whatsapp);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .footer-schedule {
    list-style: none;
    font-size: 0.82rem;
    line-height: 1.8;
  }
  .footer-schedule li {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .footer-schedule strong {
    color: var(--text-primary);
  }

  .footer-nav-list {
    list-style: none;
    font-size: 0.88rem;
    line-height: 2;
  }
  .footer-nav-list a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-nav-list a:hover {
    color: #FFFFFF;
  }

  .footer-bottom-bar {
    border-top: 1px solid var(--border-hairline);
    padding-top: var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.72rem;
    color: var(--text-dim);
  }
  .footer-bottom-bar a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .footer-bottom-bar a:hover {
    color: #FFFFFF;
  }
</style>
