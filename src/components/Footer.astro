---
const year = new Date().getFullYear();
---

<footer style="background-color: #0F172A; color: #94A3B8; padding-top: 3.5rem; padding-bottom: 2.5rem; border-top: 3px solid #1E293B; margin-top: 4rem;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2.5rem; margin-bottom: 3rem;">
      
      <!-- Columna 1: Negocio & Redes -->
      <div>
        <div style="margin-bottom: 1.25rem;">
          <img
            src="/img/the-garage-logo-white.png"
            alt="The Garage Bike Experts"
            style="height: 48px; width: auto; object-fit: contain;"
          />
        </div>
        <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem; color: #CBD5E1;">
          Expertos en bicicletas en Playa del Carmen. Venta, asesoría, taller y entrega de bicicletas MTB, ruta y urbanas en toda la Riviera Maya.
        </p>
        
        <!-- Social Buttons -->
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn"
            style="background: linear-gradient(45deg, #F58529, #D62976, #962FBF, #4F5BD5); color: #FFFFFF; padding: 0.5rem 0.9rem; font-size: 0.85rem;"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@thegarage.pdc</span>
          </a>
          <a
            href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20visitar%20la%20tienda%20en%20Playa%20del%20Carmen."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
            style="padding: 0.5rem 0.9rem; font-size: 0.85rem;"
          >
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Columna 2: Ubicación & Contacto -->
      <div>
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 800; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">
          📍 Visítanos en Tienda
        </h3>
        <p style="font-size: 0.9rem; line-height: 1.6; color: #E2E8F0; margin-bottom: 0.75rem;">
          <strong>THE GARAGE • BIKE EXPERTS</strong><br />
          Av. Ich Xeel CASA 19, Cataluña<br />
          C.P. 77725 Playa del Carmen, Quintana Roo, México
        </p>
        <p style="font-size: 0.85rem; color: #94A3B8;">
          WhatsApp / Tel: <a href="https://wa.me/529841381493" style="color: var(--primary); font-weight: 700;">+52 984 138 1493</a>
        </p>
      </div>

      <!-- Columna 3: Horarios de Tienda -->
      <div>
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 800; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">
          🕒 Horario de Atención
        </h3>
        <ul style="list-style: none; font-size: 0.85rem; line-height: 1.8; color: #CBD5E1;">
          <li style="display: flex; justify-content: space-between; border-bottom: 1px dashed #334155; padding: 0.2rem 0;">
            <span>Lunes – Viernes:</span>
            <span style="font-weight: 700; color: #FFFFFF;">9:00 a.m. – 7:00 p.m.</span>
          </li>
          <li style="display: flex; justify-content: space-between; border-bottom: 1px dashed #334155; padding: 0.2rem 0;">
            <span>Sábado:</span>
            <span style="font-weight: 700; color: #FFFFFF;">9:00 a.m. – 2:00 p.m.</span>
          </li>
          <li style="display: flex; justify-content: space-between; padding: 0.2rem 0;">
            <span>Domingo:</span>
            <span style="color: #EF4444; font-weight: 700;">Cerrado</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Enlaces & Experiencias -->
      <div>
        <h3 style="color: #FFFFFF; font-size: 1rem; font-weight: 800; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">
          Herramientas & Enlaces
        </h3>
        <ul style="list-style: none; font-size: 0.88rem; line-height: 2;">
          <li><a href="/" style="color: #CBD5E1; transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='#CBD5E1'">Catálogo e Inventario</a></li>
          <li><a href="/guia-tallas" style="color: #CBD5E1; transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='#CBD5E1'">📏 Calculadora de Tallas</a></li>
          <li><a href="/comunidad" style="color: #CBD5E1; transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='#CBD5E1'">Comunidad & Rodadas</a></li>
          <li><a href="/guias" style="color: #CBD5E1; transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='#CBD5E1'">Guías Técnicas & Rutas</a></li>
          <li><a href="/riviera-maya" style="color: #CBD5E1; transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='#CBD5E1'">Entregas en Riviera Maya</a></li>
          <li><a href="/aviso-privacidad" style="color: #CBD5E1; transition: color 0.15s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='#CBD5E1'">Aviso de Privacidad</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div style="border-top: 1px solid #1E293B; padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.8rem; color: #64748B;">
      <p>© {year} THE GARAGE • BIKE EXPERTS. Todos los derechos reservados. Playa del Carmen, Quintana Roo.</p>
      <div style="display: flex; gap: 1rem;">
        <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer" style="color: #94A3B8; text-decoration: underline;">@thegarage.pdc</a>
        <a href="/guia-tallas" style="color: #94A3B8; text-decoration: underline;">Calculadora</a>
        <a href="/comunidad" style="color: #94A3B8; text-decoration: underline;">Comunidad</a>
      </div>
    </div>
  </div>
</footer>
