---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-fluid">
    <div class="footer-grid">
      
      <!-- Columna 1: Marca & Redes -->
      <div class="footer-col">
        <a href="/" class="footer-brand-logo" title="The Garage Bike Experts">
          <img
            src="/img/the-garage-logo-white.png"
            alt="The Garage Bike Experts"
            style="height: 38px; width: auto; object-fit: contain;"
          />
        </a>
        <p class="footer-tagline">
          Boutique ciclista y taller de precisión en Cataluña, Playa del Carmen. Distribuidores oficiales de Basso Bikes Italia y nutrición deportiva Wayfar.
        </p>
        
        <a
          href="https://www.instagram.com/thegarage.pdc/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline footer-ig-btn font-mono"
        >
          <span>@thegarage.pdc en Instagram ↗</span>
        </a>
      </div>

      <!-- Columna 2: Ubicación & Contacto -->
      <div class="footer-col">
        <h3 class="footer-col-title font-mono">[01 // UBICACIÓN]</h3>
        <p class="footer-text">
          Av. Ich Xeel CASA 19, Cataluña<br />
          C.P. 77725 Playa del Carmen, Q.R.
        </p>
        <div class="footer-contact-link">
          <span class="font-mono text-xs text-zinc-500">Concierge WhatsApp:</span><br />
          <a href="https://wa.me/529841381493" class="footer-wa-link font-mono">+52 984 138 1493</a>
        </div>
      </div>

      <!-- Columna 3: Horarios de Servicio -->
      <div class="footer-col">
        <h3 class="footer-col-title font-mono">[02 // HORARIOS]</h3>
        <ul class="footer-schedule font-mono">
          <li>
            <span>Lunes – Viernes:</span>
            <strong>9:00 am – 7:00 pm</strong>
          </li>
          <li>
            <span>Sábado:</span>
            <strong>9:00 am – 2:00 pm</strong>
          </li>
          <li>
            <span>Domingo:</span>
            <span style="color: #71717A;">Rodadas Comunitarias</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Navegación -->
      <div class="footer-col">
        <h3 class="footer-col-title font-mono">[03 // NAVEGACIÓN]</h3>
        <ul class="footer-nav-list">
          <li><a href="/inventario">Catálogo &amp; Inventario</a></li>
          <li><a href="/#sec-matchmaker">Asesor de Bicicleta</a></li>
          <li><a href="/comunidad">Comunidad &amp; Rodadas</a></li>
          <li><a href="/guia-tallas">Calculadora de Talla</a></li>
          <li><a href="/guias">Guías &amp; Mantenimiento</a></li>
          <li><a href="/aviso-privacidad" class="text-xs text-zinc-500">Aviso de Privacidad</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom-bar font-mono">
      <p>© {year} THE GARAGE • BIKE EXPERTS. PLAYA DEL CARMEN, QUINTANA ROO.</p>
      <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer">@THEGARAGE.PDC</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #060608;
    color: var(--text-muted);
    padding: var(--space-8) 0 var(--space-6) 0;
    border-top: 1px solid var(--border-hairline);
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand-logo {
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .footer-tagline {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .footer-ig-btn {
    padding: 0.55rem 1rem;
    font-size: 0.78rem;
    width: fit-content;
  }

  .footer-col-title {
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .footer-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .footer-contact-link {
    margin-top: auto;
  }

  .footer-wa-link {
    color: var(--whatsapp);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .footer-schedule {
    list-style: none;
    font-size: 0.82rem;
    line-height: 1.8;
  }
  .footer-schedule li {
    display: flex;
    justify-content: space-between;
    padding: 0.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .footer-schedule strong {
    color: var(--text-primary);
  }

  .footer-nav-list {
    list-style: none;
    font-size: 0.88rem;
    line-height: 2;
  }
  .footer-nav-list a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-nav-list a:hover {
    color: #FFFFFF;
  }

  .footer-bottom-bar {
    border-top: 1px solid var(--border-hairline);
    padding-top: var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 0.72rem;
    color: var(--text-dim);
  }
  .footer-bottom-bar a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .footer-bottom-bar a:hover {
    color: #FFFFFF;
  }
</style>
