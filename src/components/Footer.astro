---
const year = new Date().getFullYear();
---

<footer style="background-color: #0F172A; color: #94A3B8; padding-top: 4.5rem; padding-bottom: 3.5rem; border-top: 1px solid #1E293B;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; margin-bottom: 3.5rem;">
      
      <!-- Columna 1: Negocio & Redes -->
      <div>
        <div style="margin-bottom: 1.25rem;">
          <img
            src="/img/the-garage-logo-white.png"
            alt="The Garage Bike Experts"
            style="height: 40px; width: auto; object-fit: contain;"
          />
        </div>
        <p style="font-size: 0.88rem; line-height: 1.6; margin-bottom: 1.5rem; color: #CBD5E1;">
          Tienda boutique y taller de bicicletas en Playa del Carmen. Distribuidores de Basso, Lee Cougan y nutrición Wayfar.
        </p>
        
        <div style="display: flex; gap: 0.75rem;">
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn"
            style="background: #1E293B; color: #FFFFFF; padding: 0.5rem 1rem; font-size: 0.8rem;"
          >
            Instagram @thegarage.pdc
          </a>
        </div>
      </div>

      <!-- Columna 2: Ubicación -->
      <div>
        <h3 style="color: #FFFFFF; font-size: 0.88rem; font-weight: 700; margin-bottom: 1.15rem; text-transform: uppercase; letter-spacing: 0.06em;">
          Ubicación
        </h3>
        <p style="font-size: 0.88rem; line-height: 1.6; color: #CBD5E1; margin-bottom: 0.75rem;">
          Av. Ich Xeel CASA 19, Cataluña<br />
          C.P. 77725 Playa del Carmen, Q.R.
        </p>
        <p style="font-size: 0.85rem; color: #94A3B8;">
          WhatsApp: <a href="https://wa.me/529841381493" style="color: #38BDF8; text-decoration: none; font-weight: 600;">+52 984 138 1493</a>
        </p>
      </div>

      <!-- Columna 3: Horarios -->
      <div>
        <h3 style="color: #FFFFFF; font-size: 0.88rem; font-weight: 700; margin-bottom: 1.15rem; text-transform: uppercase; letter-spacing: 0.06em;">
          Horarios
        </h3>
        <ul style="list-style: none; font-size: 0.85rem; line-height: 1.8; color: #CBD5E1;">
          <li style="display: flex; justify-content: space-between; padding: 0.2rem 0;">
            <span>Lunes – Viernes:</span>
            <span style="font-weight: 600; color: #FFFFFF;">9:00 am – 7:00 pm</span>
          </li>
          <li style="display: flex; justify-content: space-between; padding: 0.2rem 0;">
            <span>Sábado:</span>
            <span style="font-weight: 600; color: #FFFFFF;">9:00 am – 2:00 pm</span>
          </li>
          <li style="display: flex; justify-content: space-between; padding: 0.2rem 0;">
            <span>Domingo:</span>
            <span style="color: #94A3B8;">Cerrado</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Enlaces Rápidos -->
      <div>
        <h3 style="color: #FFFFFF; font-size: 0.88rem; font-weight: 700; margin-bottom: 1.15rem; text-transform: uppercase; letter-spacing: 0.06em;">
          Navegación
        </h3>
        <ul style="list-style: none; font-size: 0.88rem; line-height: 2;">
          <li><a href="/" style="color: #CBD5E1; text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='#FFFFFF'" onmouseout="this.style.color='#CBD5E1'">Inventario</a></li>
          <li><a href="/guia-tallas" style="color: #CBD5E1; text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='#FFFFFF'" onmouseout="this.style.color='#CBD5E1'">Calculadora de Talla</a></li>
          <li><a href="/comunidad" style="color: #CBD5E1; text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='#FFFFFF'" onmouseout="this.style.color='#CBD5E1'">Comunidad &amp; Rodadas</a></li>
          <li><a href="/guias" style="color: #CBD5E1; text-decoration: none; transition: color 0.15s;" onmouseover="this.style.color='#FFFFFF'" onmouseout="this.style.color='#CBD5E1'">Guías &amp; Rutas</a></li>
          <li><a href="/aviso-privacidad" style="color: #64748B; text-decoration: none; font-size: 0.8rem;">Aviso de Privacidad</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div style="border-top: 1px solid #1E293B; padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.8rem; color: #64748B;">
      <p>© {year} THE GARAGE • BIKE EXPERTS. Playa del Carmen, Quintana Roo, México.</p>
      <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer" style="color: #94A3B8; text-decoration: none;">@thegarage.pdc</a>
    </div>
  </div>
</footer>
