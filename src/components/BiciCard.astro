---
interface Props {
  bici: {
    id: string;
    modelo: string;
    marca: string;
    categoria: string;
    precio: number;
    moneda: string;
    estado: string;
    disponibilidad: string;
    talla: string;
    color: string;
    specs: {
      cuadro: string;
      grupo: string;
      frenos: string;
      rodada: string;
    };
    fotos: string[];
    mensajeWhatsApp?: string;
    destacada?: boolean;
    esMuestra?: boolean;
  };
  priority?: boolean;
}

const { bici, priority = false } = Astro.props;

const statusStyles: Record<string, { label: string; dot: string; color: string; bg: string }> = {
  Disponible: { label: 'Disponible', dot: '#22C55E', color: '#15803D', bg: '#F0FDF4' },
  Apartada: { label: 'Apartada', dot: '#F59E0B', color: '#B45309', bg: '#FFFBEB' },
  Vendida: { label: 'Vendida', dot: '#94A3B8', color: '#64748B', bg: '#F8FAFC' },
};

const status = statusStyles[bici.disponibilidad] || statusStyles['Disponible'];
const precioFormateado = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: bici.moneda || 'MXN',
  maximumFractionDigits: 0,
}).format(bici.precio);

const defaultWaMsg = `Hola, me interesa la ${bici.marca} ${bici.modelo} (${precioFormateado}). ¿Sigue disponible?`;
const waUrl = `https://wa.me/529841381493?text=${encodeURIComponent(bici.mensajeWhatsApp || defaultWaMsg)}`;
---

<article
  class="card-bici"
  data-categoria={bici.categoria}
  data-estado={bici.estado}
  data-disponibilidad={bici.disponibilidad}
>
  <!-- Card Visual Media Container -->
  <a href={`/bici/${bici.id}`} class="media-container" title={`Ver ${bici.marca} ${bici.modelo}`}>
    <img
      src={bici.fotos[0]}
      alt={`${bici.marca} ${bici.modelo}`}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
    
    <!-- Minimalist Status Dot -->
    <div class="status-indicator" style={`background: ${status.bg}; color: ${status.color}; border: 1px solid ${status.bg};`}>
      <span class="status-dot" style={`background: ${status.dot};`}></span>
      <span>{status.label}</span>
    </div>

    <!-- Hover Glass Action -->
    <div class="hover-overlay">
      <span class="glass-action-btn">
        Ver Ficha Técnica →
      </span>
    </div>
  </a>

  <!-- Metadata Body -->
  <div class="meta-container">
    <div class="title-price-row">
      <h2 class="bike-name">
        <a href={`/bici/${bici.id}`}>{bici.marca} {bici.modelo}</a>
      </h2>
      <span class="bike-price">{precioFormateado}</span>
    </div>

    <div class="details-row">
      <span>{bici.categoria} • Talla {bici.talla}</span>
      <span>{bici.specs.grupo}</span>
    </div>

    <!-- Direct WhatsApp Quick Action -->
    <div class="card-footer-row">
      {bici.disponibilidad !== 'Vendida' ? (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
          style="width: 100%; padding: 0.6rem 1rem; font-size: 0.82rem;"
        >
          Apartar por WhatsApp
        </a>
      ) : (
        <a
          href={`https://wa.me/529841381493?text=${encodeURIComponent(`Hola, vi que se vendió la ${bici.marca} ${bici.modelo}. ¿Tienen otra similar?`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
          style="width: 100%; padding: 0.6rem 1rem; font-size: 0.82rem; color: var(--text-muted);"
        >
          Pedir Bicicleta Similar
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card-bici {
    background: #FFFFFF;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-spring), border-color 0.25s ease;
  }

  .card-bici:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--border-hairline-hover);
  }

  .media-container {
    position: relative;
    aspect-ratio: 1.15 / 1;
    background: var(--surface-subtle);
    overflow: hidden;
    display: block;
  }

  .media-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }

  .card-bici:hover .media-container img {
    transform: scale(1.03);
  }

  .status-indicator {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .card-bici:hover .hover-overlay {
    opacity: 1;
  }

  .glass-action-btn {
    background: rgba(255, 255, 255, 0.95);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  }

  .meta-container {
    padding: 1.25rem 1.25rem 1.4rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .title-price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .bike-name {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .bike-name a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .bike-name a:hover {
    color: var(--brand-red);
  }

  .bike-price {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .details-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .card-footer-row {
    margin-top: auto;
  }
</style>
