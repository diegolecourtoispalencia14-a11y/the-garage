---
interface Props {
  bici: {
    id: string;
    modelo: string;
    marca: string;
    categoria: string;
    precio: number;
    moneda: string;
    estado: string;
    disponibilidad: string;
    talla: string;
    color: string;
    specs: {
      cuadro: string;
      grupo: string;
      frenos: string;
      rodada: string;
    };
    fotos: string[];
    mensajeWhatsApp?: string;
    destacada?: boolean;
    esMuestra?: boolean;
  };
  priority?: boolean;
}

const { bici, priority = false } = Astro.props;

const statusStyles: Record<string, { label: string; dot: string; color: string; bg: string }> = {
  Disponible: { label: 'Disponible', dot: '#22C55E', color: '#09090B', bg: 'rgba(34, 197, 94, 0.95)' },
  Apartada: { label: 'Apartada', dot: '#F59E0B', color: '#09090B', bg: 'rgba(245, 158, 11, 0.95)' },
  Vendida: { label: 'Vendida', dot: '#71717A', color: '#F4F4F5', bg: 'rgba(63, 63, 70, 0.95)' },
};

const status = statusStyles[bici.disponibilidad] || statusStyles['Disponible'];
const precioFormateado = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: bici.moneda || 'MXN',
  maximumFractionDigits: 0,
}).format(bici.precio);

const defaultWaMsg = `Hola, me interesa la ${bici.marca} ${bici.modelo} (${precioFormateado}). ¿Sigue disponible?`;
const waUrl = `https://wa.me/529841381493?text=${encodeURIComponent(bici.mensajeWhatsApp || defaultWaMsg)}`;
---

<article
  class="card-bici-tile"
  data-categoria={bici.categoria}
  data-estado={bici.estado}
  data-disponibilidad={bici.disponibilidad}
>
  <!-- Card Visual Media Container with Fixed Aspect-Ratio -->
  <a href={`/bici/${bici.id}`} class="card-media-wrap" title={`Ver ${bici.marca} ${bici.modelo}`}>
    <img
      src={bici.fotos[0]}
      alt={`${bici.marca} ${bici.modelo}`}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      width="640"
      height="480"
    />
    
    <!-- Minimalist Status Dot -->
    <div class="card-status-pill font-mono" style={`background: ${status.bg}; color: ${status.color};`}>
      <span class="status-dot" style={`background: ${status.dot};`}></span>
      <span>{status.label}</span>
    </div>

    <div class="card-price-overlay font-mono">
      {precioFormateado}
    </div>
  </a>

  <!-- Metadata Body -->
  <div class="card-meta-wrap">
    <div class="card-category-row font-mono">
      <span>{bici.categoria} // TALLA {bici.talla}</span>
      <span class="card-condition-label">{bici.estado}</span>
    </div>

    <h2 class="card-bike-name">
      <a href={`/bici/${bici.id}`}>{bici.marca} {bici.modelo}</a>
    </h2>

    <p class="card-specs-line">
      {bici.specs.grupo} • {bici.specs.rodada} • Frenos {bici.specs.frenos}
    </p>

    <!-- Direct Actions -->
    <div class="card-action-box">
      {bici.disponibilidad !== 'Vendida' ? (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp card-full-btn"
        >
          Apartar por WhatsApp
        </a>
      ) : (
        <a
          href={`https://wa.me/529841381493?text=${encodeURIComponent(`Hola, vi que se vendió la ${bici.marca} ${bici.modelo}. ¿Tienen otra similar?`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline card-full-btn"
          style="color: var(--text-muted);"
        >
          Pedir Bicicleta Similar
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card-bici-tile {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s var(--ease-spring), border-color 0.25s ease, box-shadow 0.25s var(--ease-spring);
  }

  .card-bici-tile:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 16px 40px -12px rgba(225, 29, 72, 0.15);
  }

  .card-media-wrap {
    position: relative;
    aspect-ratio: 16 / 11;
    background: #09090B;
    overflow: hidden;
    display: block;
  }

  .card-media-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }

  .card-bici-tile:hover .card-media-wrap img {
    transform: scale(1.04);
  }

  .card-status-pill {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .card-price-overlay {
    position: absolute;
    bottom: 0.85rem;
    right: 0.85rem;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .card-meta-wrap {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-category-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-1);
  }

  .card-condition-label {
    color: var(--text-secondary);
  }

  .card-bike-name {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }

  .card-bike-name a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-bike-name a:hover {
    color: #FB7185;
  }

  .card-specs-line {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .card-action-box {
    margin-top: auto;
  }

  .card-full-btn {
    width: 100%;
    padding: 0.65rem 1rem;
    font-size: 0.82rem;
  }
</style>
