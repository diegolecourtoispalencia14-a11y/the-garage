---
interface Props {
  bici: {
    id: string;
    modelo: string;
    marca: string;
    categoria: string;
    precio: number;
    moneda: string;
    estado: string;
    disponibilidad: string;
    talla: string;
    color: string;
    specs: {
      cuadro: string;
      grupo: string;
      frenos: string;
      rodada: string;
    };
    fotos: string[];
    mensajeWhatsApp?: string;
    destacada?: boolean;
    esMuestra?: boolean;
  };
  priority?: boolean;
}

const { bici, priority = false } = Astro.props;

const statusStyles: Record<string, { label: string; bg: string; color: string }> = {
  Disponible: { label: 'Disponible', bg: '#DCFCE7', color: '#15803D' },
  Apartada: { label: 'Apartada', bg: '#FEF3C7', color: '#B45309' },
  Vendida: { label: 'Vendida', bg: '#F1F5F9', color: '#64748B' },
};

const status = statusStyles[bici.disponibilidad] || statusStyles['Disponible'];
const precioFormateado = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: bici.moneda || 'MXN',
  maximumFractionDigits: 0,
}).format(bici.precio);

const defaultWaMsg = `Hola, me interesa la ${bici.marca} ${bici.modelo} (${precioFormateado}). ¿Sigue disponible?`;
const waUrl = `https://wa.me/529841381493?text=${encodeURIComponent(bici.mensajeWhatsApp || defaultWaMsg)}`;
---

<article
  class="card-bici"
  data-categoria={bici.categoria}
  data-estado={bici.estado}
  data-disponibilidad={bici.disponibilidad}
>
  <!-- Image Container -->
  <a href={`/bici/${bici.id}`} class="image-box" title={`Ver ${bici.marca} ${bici.modelo}`}>
    <img
      src={bici.fotos[0]}
      alt={`${bici.marca} ${bici.modelo}`}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
    
    <!-- Status Pill -->
    <div class="status-badge" style={`background: ${status.bg}; color: ${status.color};`}>
      <span class="status-dot" style={`background: ${status.color};`}></span>
      {status.label}
    </div>
  </a>

  <!-- Content Box -->
  <div class="content-box">
    <div class="meta-row">
      <span class="category-text">{bici.categoria} • {bici.talla}</span>
      <span class="condition-text">{bici.estado}</span>
    </div>

    <h2 class="bike-title">
      <a href={`/bici/${bici.id}`}>{bici.marca} {bici.modelo}</a>
    </h2>

    <div class="price-row">
      <span class="price-amount">{precioFormateado}</span>
      <span class="currency-label">{bici.moneda}</span>
    </div>

    <!-- Clean Tech Specs Summary -->
    <p class="specs-summary">
      {bici.specs.grupo} • {bici.specs.rodada}
    </p>

    <!-- Bottom Actions -->
    <div class="actions-row">
      <a href={`/bici/${bici.id}`} class="btn btn-outline" style="flex: 1; padding: 0.65rem 1rem; font-size: 0.85rem;">
        Ver Ficha
      </a>
      {bici.disponibilidad !== 'Vendida' ? (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
          style="flex: 1.2; padding: 0.65rem 1rem; font-size: 0.85rem;"
        >
          Apartar
        </a>
      ) : (
        <a
          href={`https://wa.me/529841381493?text=${encodeURIComponent(`Hola, vi que se vendió la ${bici.marca} ${bici.modelo}. ¿Tienen otra similar?`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
          style="flex: 1.2; padding: 0.65rem 1rem; font-size: 0.85rem; color: #64748B;"
        >
          Pedir Similar
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card-bici {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-bici:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .image-box {
    position: relative;
    aspect-ratio: 1/1;
    background: #F8FAFC;
    overflow: hidden;
    display: block;
  }

  .image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-bici:hover .image-box img {
    transform: scale(1.03);
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .content-box {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }

  .category-text {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .condition-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
  }

  .bike-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .bike-title a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bike-title a:hover {
    color: var(--primary);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .price-amount {
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .currency-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .specs-summary {
    font-size: 0.85rem;
    color: #64748B;
    margin-bottom: 1.5rem;
  }

  .actions-row {
    margin-top: auto;
    display: flex;
    gap: 0.75rem;
  }
</style>
