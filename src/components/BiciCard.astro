---
import BadgeDisponibilidad from './BadgeDisponibilidad.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';

interface Props {
  bici: {
    id: string;
    modelo: string;
    marca: string;
    categoria: string;
    precio: number;
    moneda: string;
    estado: string;
    disponibilidad: string;
    talla: string;
    color: string;
    specs?: {
      cuadro?: string;
      grupo?: string;
      frenos?: string;
      rodada?: string;
    };
    fotos: string[];
    mensajeWhatsApp: string;
    destacada?: boolean;
    esMuestra?: boolean;
  };
  priority?: boolean;
}

const { bici, priority = false } = Astro.props;
const precioFormateado = bici.precio.toLocaleString('es-MX', {
  style: 'currency',
  currency: bici.moneda || 'MXN',
  maximumFractionDigits: 0,
});

const isVendida = bici.disponibilidad === 'Vendida';
const isApartada = bici.disponibilidad === 'Apartada';
const fotoPrincipal = bici.fotos && bici.fotos.length > 0 ? bici.fotos[0] : '/img/the-garage-logo.svg';

const textoBoton = isVendida 
  ? "Preguntar por similar" 
  : isApartada 
    ? "Consultar disponibilidad" 
    : "Consultar por WhatsApp";
---

<article
  class={`card ${isVendida ? 'card-sold' : ''}`}
  data-categoria={bici.categoria}
  data-estado={bici.estado}
  data-disponibilidad={bici.disponibilidad}
  data-search={`${bici.marca} ${bici.modelo} ${bici.categoria} ${bici.talla} ${bici.color}`.toLowerCase()}
>
  <a href={`/bici/${bici.id}`} class="card-img-wrap" title={`Ver detalles de ${bici.marca} ${bici.modelo}`}>
    <img
      src={fotoPrincipal}
      alt={`${bici.marca} ${bici.modelo} - Bicicleta ${bici.categoria} en Playa del Carmen`}
      width="400"
      height="400"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
    <div style="position: absolute; top: 0.75rem; left: 0.75rem; z-index: 2;">
      <BadgeDisponibilidad disponibilidad={bici.disponibilidad} esMuestra={bici.esMuestra} />
    </div>
    <div style="position: absolute; bottom: 0.75rem; right: 0.75rem; z-index: 2;">
      <span class={`badge ${bici.estado === 'Nueva' ? 'badge-nueva' : 'badge-seminueva'}`}>
        {bici.estado}
      </span>
    </div>
  </a>

  <div class="card-body">
    <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;">
      <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 0.05em;">
        {bici.marca} • {bici.categoria}
      </span>
      <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">
        Talla: {bici.talla}
      </span>
    </div>

    <h2 class="title-md" style="margin-top: -0.25rem;">
      <a href={`/bici/${bici.id}`} style="color: var(--secondary); transition: color 0.15s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--secondary)'">
        {bici.marca} {bici.modelo}
      </a>
    </h2>

    {bici.specs && (
      <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.25rem;">
        {bici.specs.rodada && (
          <span style="font-size: 0.75rem; background: #F1F5F9; color: #475569; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">
            🚲 Rod. {bici.specs.rodada}
          </span>
        )}
        {bici.specs.grupo && (
          <span style="font-size: 0.75rem; background: #F1F5F9; color: #475569; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">
            ⚙️ {bici.specs.grupo}
          </span>
        )}
      </div>
    )}

    <div style="margin-top: auto; padding-top: 0.75rem; display: flex; align-items: baseline; justify-content: space-between;">
      <div>
        <span class="price-tag">{precioFormateado}</span>
        <span class="price-currency">{bici.moneda || 'MXN'}</span>
      </div>
    </div>

    <div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
      <BotonWhatsApp
        mensaje={bici.mensajeWhatsApp}
        texto={textoBoton}
        tamano="md"
        fullWidth={true}
      />
      <a
        href={`/bici/${bici.id}`}
        class="btn btn-outline"
        style="padding: 0.5rem; font-size: 0.85rem;"
      >
        Ver ficha completa →
      </a>
    </div>
  </div>
</article>
