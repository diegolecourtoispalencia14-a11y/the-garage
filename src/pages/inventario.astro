  /* ── Filter Execution ── */
  function filterProducts(all) {
    return all.filter(p => {
      // Category
      if (activeCategory !== 'all' && p.cat !== activeCategory) return false;

      // Price Range
      if (activePriceRange === 'under500' && p.webPrice >= 500) return false;
      if (activePriceRange === '500to2000' && (p.webPrice < 500 || p.webPrice > 2000)) return false;
      if (activePriceRange === '2000to10000' && (p.webPrice < 2000 || p.webPrice > 10000)) return false;
      if (activePriceRange === 'over10000' && p.webPrice <= 10000) return false;

      // Brand
      if (activeBrand !== 'all' && p.brand !== activeBrand) return false;

      // Stock
      if (onlyInStock && p.stock <= 0) return false;

      // Free shipping (threshold >= $500 MXN)
      if (onlyFreeShipping && p.webPrice < 500) return false;

      // Search
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const mName = (p.name || '').toLowerCase().includes(q);
        const mBrand = (p.brand || '').toLowerCase().includes(q);
        const mCat = (p.cat || '').toLowerCase().includes(q);
        const mSku = (p.sku || '').toLowerCase().includes(q);
        if (!mName && !mBrand && !mCat && !mSku) return false;
      }

      return true;
    });
  }

  function sortProducts(list) {
    const copy = [...list];
    if (activeSort === 'price-asc') copy.sort((a,b) => a.webPrice - b.webPrice);
    else if (activeSort === 'price-desc') copy.sort((a,b) => b.webPrice - a.webPrice);
    else if (activeSort === 'name-asc') copy.sort((a,b) => a.name.localeCompare(b.name));
    else {
      // Featured: bikes first, then high stock items
      copy.sort((a,b) => {
        if (a.cat === 'Bicicletas' && b.cat !== 'Bicicletas') return -1;
        if (b.cat === 'Bicicletas' && a.cat !== 'Bicicletas') return 1;
        return b.stock - a.stock;
      });
    }
    return copy;
  }

  /* ── Render Sidebar Category & Brand Options ── */
  function renderSidebarFilters(all) {
    // Categories count
    const catContainer = document.getElementById('cat-options-container');
    const categories = ['all', ...new Set(all.map(p => p.cat).filter(Boolean))];

    catContainer.innerHTML = categories.map(cat => {
      const count = cat === 'all' ? all.length : all.filter(p => p.cat === cat).length;
      const svgIcon = SVG_CAT_ICONS[cat] || SVG_CAT_ICONS['all'];
      const label = cat === 'all' ? 'Todas las Categorías' : cat;
      const isActive = activeCategory === cat;
      return `
        <button class="filter-cat-btn ${isActive ? 'active' : ''}" onclick="selectCategory('${cat}')">
          <span class="cat-btn-inner">
            <span class="cat-icon-badge">${svgIcon}</span>
            <span>${label}</span>
          </span>
          <span class="filter-badge-num">${count}</span>
        </button>
      `;
    }).join('');

    // Brands chips
    const brandContainer = document.getElementById('brand-chips-container');
    const brands = ['all', ...new Set(all.map(p => p.brand).filter(Boolean))];

    brandContainer.innerHTML = brands.map(b => {
      const isActive = activeBrand === b;
      return `
        <button class="brand-chip ${isActive ? 'active' : ''}" onclick="selectBrand('${b}')">
          ${b === 'all' ? 'Todas' : b}
        </button>
      `;
    }).join('');
  }

