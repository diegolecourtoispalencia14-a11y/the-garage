<script is:inline define:vars={{ staticBikes, masterCatalogJson }}>
(function() {
  const INV_KEY = 'bicisaas_inventory';
  const WEB_KEY = 'bicisaas_web_bikes';

  function getCanonicalKey(item) {
    if (!item) return '';
    return String(item.sku || item.id || item.slug || item.name || '').trim();
  }

  function findProductOverride(prod, overrides) {
    if (!overrides || typeof overrides !== 'object') return {};

    const candidateKeys = [
      prod.sku,
      prod.id,
      prod.slug,
      prod.sku ? prod.sku.toLowerCase() : '',
      prod.id ? prod.id.toLowerCase() : '',
      prod.slug ? prod.slug.toLowerCase() : '',
      getCanonicalKey(prod)
    ].filter(Boolean);

    for (const key of candidateKeys) {
      if (overrides[key] && typeof overrides[key] === 'object') {
        return overrides[key];
      }
    }

    const prodName = String(prod.name || '').toLowerCase().trim();
    if (!prodName) return {};

    for (const [k, v] of Object.entries(overrides)) {
      if (!v || typeof v !== 'object') continue;
      const kLower = k.toLowerCase().trim();
      const vName = String(v.name || '').toLowerCase().trim();
      if (vName && vName === prodName) return v;
      if (kLower === prodName) return v;
    }

    return {};
  }

  function fmt(n) { return '$' + Number(n).toLocaleString('es-MX', { minimumFractionDigits: 0 }); }

  /* ── Load Unified Catalog (combining localStorage + defaults) ── */
  const masterCatalog = (function() {
    try { return JSON.parse(masterCatalogJson || '[]'); }
    catch(e) { return []; }
  })();

  const masterMap = {};
  masterCatalog.forEach(p => {
    if (p.sku) masterMap[p.sku] = p;
    if (p.id) masterMap[p.id] = p;
    if (p.slug) masterMap[p.slug] = p;
    const can = getCanonicalKey(p);
    masterMap[can] = p;
  });

  function getFullStoreProducts() {
    let localInv = [];
    try {
      localInv = JSON.parse(localStorage.getItem(INV_KEY) || '[]');
    } catch(e) { localInv = []; }

    let overrides = {};
    try {
      overrides = JSON.parse(localStorage.getItem(WEB_KEY) || '{}');
    } catch(e) { overrides = {}; }

    // Lanzamiento oficial: filtrar estrictamente solo las 15 bicicletas maestras
    const masterIds = new Set(masterCatalog.map(m => String(m.id || '').toLowerCase()));
    const masterSkus = new Set(masterCatalog.map(m => String(m.sku || '').toLowerCase()));
    const masterNames = new Set(masterCatalog.map(m => String(m.name || '').toLowerCase()));

    localInv = localInv.filter(item => {
      const rawId = String(item.id || '').toLowerCase();
      const rawSku = String(item.sku || '').toLowerCase();
      const rawName = String(item.name || '').toLowerCase();
      return masterIds.has(rawId) || masterSkus.has(rawSku) || masterNames.has(rawName);
    });

    if (!localInv || !localInv.length) {
      localInv = [...masterCatalog];
      try {
        localStorage.setItem(INV_KEY, JSON.stringify(localInv));
      } catch(e) {}
    } else {
      // Ensure all master catalog items exist in local inventory
      masterCatalog.forEach(mp => {
        const mpKey = getCanonicalKey(mp);
        const exists = localInv.find(item => getCanonicalKey(item) === mpKey || (item.name && item.name.toLowerCase() === mp.name.toLowerCase()));
        if (!exists) localInv.push(mp);
      });
      try {
        localStorage.setItem(INV_KEY, JSON.stringify(localInv));
      } catch(e) {}
    }

    // Exclude rental fleet items (rental fleet is managed exclusively in /panel/rentas and displayed on /renta)
    const retailOnly = localInv.filter(p => {
      const id = String(p.id || '');
      const sku = String(p.sku || '');
      const cat = String(p.cat || '');
      const name = String(p.name || '').toLowerCase();
      if (id.startsWith('RENT-') || sku.startsWith('RENT-')) return false;
      if (cat === 'Renta' || cat === 'Flota Rentas' || cat === 'Rentas') return false;
      if (name.includes('renta de') || name.includes('flota renta')) return false;
      return true;
    });

    // Deduplicate items by canonical key
    const seenMap = new Map();
    const uniqueInv = [];
    for (const item of retailOnly) {
      const key = getCanonicalKey(item);
      if (!seenMap.has(key)) {
        seenMap.set(key, true);
        uniqueInv.push(item);
      }
    }

    // Map and apply overrides from /panel/sitio-web
    return uniqueInv.map(prod => {
      const canonicalSku = getCanonicalKey(prod);
      const sku = prod.sku || canonicalSku;
      const ov = findProductOverride(prod, overrides);
      const masterRef = masterMap[sku] || masterMap[prod.id] || masterMap[canonicalSku] || {};

      const basePrice = ov.price !== undefined ? Number(ov.price) : Number(prod.price || masterRef.price || 0);
      const webPrice = Math.round(basePrice * 1.035);
      const stock = ov.stock !== undefined ? Number(ov.stock) : Number(prod.stock !== undefined ? prod.stock : (masterRef.stock !== undefined ? masterRef.stock : 1));

      // Publication logic: in /panel/sitio-web, an item can be published or hidden
      let isPublished = true;
      if (ov.publishedOnWeb !== undefined) {
        isPublished = ov.publishedOnWeb === true;
      } else if (ov.isPublished !== undefined) {
        isPublished = ov.isPublished === true;
      } else if (prod.publishedOnWeb !== undefined) {
        isPublished = prod.publishedOnWeb === true;
      } else if (prod.isPublished !== undefined) {
        isPublished = prod.isPublished === true;
      }

      // Photos & specs fallback to master catalog
      const fotos = (ov.fotos && ov.fotos.length) ? ov.fotos : (prod.fotos && prod.fotos.length ? prod.fotos : (masterRef.fotos || []));
      const specs = ov.specs || prod.specs || masterRef.specs || `${prod.brand || 'The Garage'} de alta durabilidad y rendimiento en el Caribe.`;
      const talla = ov.talla || prod.talla || masterRef.talla;
      const precioRenta = ov.precioRenta !== undefined ? ov.precioRenta : (prod.precioRenta !== undefined ? prod.precioRenta : masterRef.precioRenta);
      const modalidad = ov.modalidad || prod.modalidad || masterRef.modalidad;

      return {
        ...masterRef,
        ...prod,
        ...ov,
        id: sku,
        sku: sku,
        slug: prod.slug || masterRef.slug || prod.id,
        name: ov.name || prod.name || masterRef.name,
        brand: ov.brand || prod.brand || masterRef.brand || 'The Garage',
        cat: ov.cat || prod.cat || masterRef.cat || 'Bicicletas',
        price: basePrice,
        webPrice: webPrice,
        stock: stock,
        isPublished: isPublished,
        fotos: fotos,
        specs: specs,
        talla: talla,
        precioRenta: precioRenta,
        modalidad: modalidad
      };
    }).filter(p => p.isPublished === true); // Strictly require isPublished to be true!
  }

  /* ── State ── */
  let activeCategory = 'all';
