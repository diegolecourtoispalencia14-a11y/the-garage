                href="https://wa.me/529841381493?text=${encodeURIComponent('Hola The Garage, me interesa el producto: ' + p.name + ' (' + fmt(p.webPrice) + '). ¿Tienen entrega hoy en Playa del Carmen?')}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-wa-round"
                title="Consultar disponibilidad por WhatsApp"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.152.57 4.17 1.564 5.91l-1.564 5.708 5.867-1.538c1.701.928 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/></svg>
              </a>
            </div>
          </div>
        </article>
      `;
    }).join('');
  }

  /* ── Filter Actions ── */
  window.selectCategory = function(cat) {
    activeCategory = cat;
    renderSidebarFilters(getFullStoreProducts());
    renderGrid();
  };

  window.selectBrand = function(brand) {
    activeBrand = brand;
    renderSidebarFilters(getFullStoreProducts());
    renderGrid();
  };

  window.resetAllFilters = function() {
    activeCategory = 'all';
    activePriceRange = 'all';
    activeBrand = 'all';
    onlyInStock = true;
    onlyFreeShipping = false;
    searchQuery = '';
    activeSort = 'featured';

    document.getElementById('store-search-input').value = '';
    document.querySelector('input[name="price-range"][value="all"]').checked = true;
    document.getElementById('chk-only-instock').checked = true;
    document.getElementById('chk-free-shipping').checked = false;
    document.getElementById('store-sort-select').value = 'featured';

    renderSidebarFilters(getFullStoreProducts());
    renderGrid();
  };

  document.getElementById('btn-clear-filters').addEventListener('click', window.resetAllFilters);

  // Price range change
  document.querySelectorAll('input[name="price-range"]').forEach(radio => {
    radio.addEventListener('change', function() {
      activePriceRange = this.value;
      renderGrid();
    });
  });

  // Checkboxes
  document.getElementById('chk-only-instock').addEventListener('change', function() {
    onlyInStock = this.checked;
    renderGrid();
  });
  document.getElementById('chk-free-shipping').addEventListener('change', function() {
    onlyFreeShipping = this.checked;
    renderGrid();
  });

  // Search
  document.getElementById('store-search-input').addEventListener('input', function() {
    searchQuery = this.value.trim();
    renderGrid();
  });

  // Sort
  document.getElementById('store-sort-select').addEventListener('change', function() {
    activeSort = this.value;
    renderGrid();
  });

  /* ── Cart Interaction ── */
  window.addToCartStore = function(id) {
    const all = getFullStoreProducts();
    const p = all.find(item => item.sku === id || item.id === id);
    if (!p) return;

    if (window.cartAdd) {
      window.cartAdd({
        id: p.sku || p.id,
        name: p.name,
        price: p.webPrice,
        brand: p.brand || 'The Garage',
        photo: (p.fotos && p.fotos[0]) ? p.fotos[0] : null
      });
    } else {
      alert(`${p.name} agregado al carrito (${fmt(p.webPrice)}).`);
    }
  };

  /* ── Compare Engine (Side-by-Side Comparison) ── */
  window.toggleCompare = function(id) {
    const all = getFullStoreProducts();
    const p = all.find(item => item.sku === id || item.id === id);
    if (!p) return;

    const existsIdx = compareList.findIndex(c => c.sku === id || c.id === id);
    if (existsIdx !== -1) {
      compareList.splice(existsIdx, 1);
    } else {
      if (compareList.length >= 4) {
        alert('Puedes comparar un máximo de 4 productos simultáneamente.');
        return;
      }
      compareList.push(p);
    }

    updateCompareUI();
    renderGrid(); // update check state on cards
  };

  function updateCompareUI() {
    const bar = document.getElementById('floating-compare-bar');
    const countEl = document.getElementById('compare-bar-count');
    const thumbsContainer = document.getElementById('compare-mini-thumbs');

    if (!compareList.length) {
      bar.style.display = 'none';
      return;
    }

    bar.style.display = 'block';
    countEl.textContent = `${compareList.length} producto${compareList.length > 1 ? 's' : ''} seleccionado${compareList.length > 1 ? 's' : ''} para comparar`;

    thumbsContainer.innerHTML = compareList.map(p => {
      const img = p.fotos && p.fotos[0];
      return img ? `<img src="${img}" class="comp-thumb" alt="${p.name}" title="${p.name}" />` : `<div class="comp-thumb comp-thumb-empty">${getCatSvg(p.cat)}</div>`;
    }).join('');
  }

  document.getElementById('btn-clear-compare').addEventListener('click', () => {
    compareList = [];
    updateCompareUI();
    renderGrid();
  });

  // Open Modal
  document.getElementById('btn-open-compare-modal').addEventListener('click', () => {
    if (!compareList.length) return;
    renderCompareModal();
    document.getElementById('compare-modal').style.display = 'flex';
  });

  document.getElementById('btn-close-compare-modal').addEventListener('click', () => {
    document.getElementById('compare-modal').style.display = 'none';
  });

  function renderCompareModal() {
    const body = document.getElementById('compare-modal-body');
    const cols = compareList.length;

    body.innerHTML = `
      <div class="compare-grid-table" style="grid-template-columns: repeat(${cols}, minmax(240px, 1fr));">
        ${compareList.map(p => {
          const img = p.fotos && p.fotos[0];
          const prodId = p.sku || p.id;
          return `
            <div class="comp-col-card">
              <div class="comp-col-img">
                ${img ? `<img src="${img}" alt="${p.name}" />` : `<span style="display:flex; justify-content:center;">${getCatSvg(p.cat)}</span>`}
              </div>

              <div>
                <span style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; color:#ff9500; font-weight:800;">${p.brand}</span>
                <h4 style="font-size:1rem; font-weight:700; margin:0.25rem 0 0.5rem; color:#ffffff;">${p.name}</h4>
                <div style="font-size:1.35rem; font-weight:800; color:#2997ff;">${fmt(p.webPrice)} MXN</div>
              </div>

              <div class="comp-row-spec">
                <span class="comp-spec-label">Categoría</span>
                <span class="comp-spec-val">${p.cat}</span>
              </div>

              <div class="comp-row-spec">
                <span class="comp-spec-label">Talla / Medida</span>
                <span class="comp-spec-val">${p.talla || 'N/A / Ajustable'}</span>
              </div>

              <div class="comp-row-spec">
                <span class="comp-spec-label">Disponibilidad en Tienda</span>
                <span class="comp-spec-val" style="color:${p.stock > 0 ? '#34c759' : '#ff3b30'}; font-weight:700;">
                  ${p.stock > 0 ? `En Stock (${p.stock} piezas)` : 'Agotado'}
                </span>
              </div>

              <div class="comp-row-spec">
                <span class="comp-spec-label">Envío a Domicilio</span>
                <span class="comp-spec-val">${p.webPrice >= 500 ? 'Envío Gratis (Didi Moto / Paquetería)' : '$80 MXN'}</span>
              </div>

              <div class="comp-row-spec">
                <span class="comp-spec-label">Especificaciones Técnicas</span>
                <p style="font-size:0.8rem; color:#a1a1aa; line-height:1.4; margin:0.2rem 0 0;">${p.specs || 'Componentes de alta gama inspeccionados en taller The Garage.'}</p>
              </div>

              <div style="margin-top:auto; padding-top:1rem; display:flex; flex-direction:column; gap:0.5rem;">
                <button class="btn-add-cart-nike" style="width:100%;" onclick="addToCartStore('${prodId}'); document.getElementById('compare-modal').style.display='none';">
                  Agregar al Carrito
                </button>
                <button style="background:transparent; border:1px solid rgba(255,255,255,0.15); color:#a1a1aa; border-radius:100px; padding:0.4rem; font-size:0.75rem; cursor:pointer;" onclick="toggleCompare('${prodId}'); renderCompareModal();">
                  Quitar de la comparativa
                </button>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  // Storage & focus listeners for real-time synchronization with /panel/sitio-web
  window.addEventListener('storage', function(e) {
    if (e.key === INV_KEY || e.key === WEB_KEY) {
      const freshData = getFullStoreProducts();
      renderSidebarFilters(freshData);
      renderGrid();
    }
  });

  window.addEventListener('focus', function() {
    const freshData = getFullStoreProducts();
    renderSidebarFilters(freshData);
    renderGrid();
  });

  // Init
  const initialData = getFullStoreProducts();
  renderSidebarFilters(initialData);
  renderGrid();
})();
</script>
