---
import Base from '../layouts/Base.astro';
import BiciCard from '../components/BiciCard.astro';
import Filtros from '../components/Filtros.astro';
import { getCollection } from 'astro:content';

const bicisEntries = await getCollection('bicis');
const orderMap: Record<string, number> = {
  Disponible: 1,
  Apartada: 2,
  Vendida: 3,
};

const bicis = bicisEntries
  .map(e => e.data)
  .sort((a, b) => {
    const orderA = orderMap[a.disponibilidad] || 99;
    const orderB = orderMap[b.disponibilidad] || 99;
    if (orderA !== orderB) return orderA - orderB;
    return (b.destacada ? 1 : 0) - (a.destacada ? 1 : 0);
  });
---

<Base
  title="Catálogo & Inventario Oficial | The Garage Playa del Carmen"
  description="Inventario de bicicletas nuevas, seminuevas y custom builds disponibles en tienda física en Playa del Carmen. Distribuidores Basso, Merida, Giant, Specialized y Trek."
>
  <div class="inventory-page-wrap">
    <div class="container-fluid">
      
      <!-- Header de Catálogo -->
      <section class="inventory-header-section">
        <div class="inventory-header-content">
          <div class="inventory-badges font-mono">
            <span class="inv-tag-red">[INVENTARIO FÍSICO EN TIENDA]</span>
            <span class="inv-tag-loc">CATALUÑA CASA 19, PDC</span>
          </div>
          <h1 class="title-xl inventory-main-title">
            Bicicletas Listas para Rodar.
          </h1>
          <p class="subtitle inventory-subtitle">
            Unidades inspeccionadas con torquímetro mecánico en taller, calibración de transmisión certificada y <strong>1er servicio de reajuste gratis a los 30 días</strong>.
          </p>
        </div>

        <a
          href="https://wa.me/529841381493?text=Hola,%20busco%20una%20bicicleta%20espec%C3%ADfica%20del%20cat%C3%A1logo.%20%C2%BFMe%20pueden%20asesorar?"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <span>Asesoría Directa por WhatsApp</span>
        </a>
      </section>

      <!-- Toolbar de Filtros -->
      <section class="inventory-toolbar-section">
        <Filtros />
      </section>

      <!-- Grilla de Bicicletas -->
      <section class="inventory-grid-section">
        <div class="bici-grid">
          {bicis.map((bici, index) => (
            <BiciCard bici={bici} priority={index === 0} />
          ))}
        </div>
      </section>

      <!-- Custom Build Basso Callout -->
      <section class="basso-custom-banner">
        <div class="basso-custom-content">
          <span class="font-mono text-xs text-rose-400 font-bold uppercase tracking-wider">
            [BASSO BIKES ITALIA // CUSTOM BUILD]
          </span>
          <h2 class="title-lg" style="color: #FFFFFF; margin: 0.5rem 0;">
            ¿Buscas un cuadro o ensamble específico?
          </h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 680px;">
            Como distribuidores oficiales de Basso Bikes, podemos cotizar e importar tu cuadro de carbono italiano Torayca con el grupo electrónico SRAM AXS/Shimano Di2 y ruedas a tu medida.
          </p>
        </div>

        <a
          href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20cotizar%20un%20cuadro%20o%20ensamble%20personalizado%20de%20Basso%20Bikes."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Cotizar Ensamble a Medida ↗
        </a>
      </section>

    </div>
  </div>
</Base>

<style>
  .inventory-page-wrap {
    padding: var(--space-6) 0 var(--space-9) 0;
  }

  .inventory-header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-6);
  }

  .inventory-header-content {
    max-width: 780px;
  }

  .inventory-badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 0.72rem;
  }

  .inv-tag-red {
    color: #FB7185;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .inv-tag-loc {
    color: var(--text-muted);
  }

  .inventory-main-title {
    margin-bottom: var(--space-2);
  }

  .inventory-subtitle {
    max-width: 680px;
  }

  .inventory-toolbar-section {
    margin-bottom: var(--space-6);
  }

  .inventory-grid-section {
    margin-bottom: var(--space-8);
  }

  .basso-custom-banner {
    background: linear-gradient(135deg, #18181C 0%, #101013 100%);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
</style>
