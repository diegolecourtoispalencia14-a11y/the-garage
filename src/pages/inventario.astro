---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { MASTER_PRODUCTS } from '../data/allProducts';
const masterCatalogJson = JSON.stringify(MASTER_PRODUCTS);
import { Icon } from 'astro-icon/components';

// Build-time baseline for static collection bikes
const bicisEntries = await getCollection('bicis');
const staticBikes = JSON.stringify(bicisEntries.map(e => e.data));

const initialProducts = MASTER_PRODUCTS;

const initialCats = [
  { id: 'all', label: 'Todas las Bicis', count: initialProducts.length },
  { id: 'MTB', label: 'Montaña (MTB)', count: initialProducts.filter(p => p.cat === 'MTB').length },
  { id: 'Ruta', label: 'Ruta & Carrera', count: initialProducts.filter(p => p.cat === 'Ruta').length },
  { id: 'Urbana', label: 'Urbana & Híbrida', count: initialProducts.filter(p => p.cat === 'Urbana').length },
  { id: 'Infantil', label: 'Infantil & Juvenil', count: initialProducts.filter(p => p.cat === 'Infantil').length }
];

const initialBrands = ['all', ...new Set(initialProducts.map(p => p.brand).filter(Boolean))];
---

<Base
  title="Tienda & Catálogo Oficial | The Garage Bike Experts"
  description="Catálogo oficial con inventario físico en tienda en Playa del Carmen: bicicletas de montaña, ruta y gravel, componentes Shimano, cascos POC, nutrición y accesorios. Envío gratis en compras desde $500 MXN."
>
  <div class="store-page-wrap">
    <div class="container-fluid">
      
      <!-- Top Announcement Banner -->
      <div class="store-banner">
        <span style="display:inline-flex; align-items:center; gap:0.4rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <strong>Envío Gratis</strong> en compras desde $500 MXN en Playa del Carmen
        </span>
        <span class="dot-sep">•</span>
        <span style="display:inline-flex; align-items:center; gap:0.4rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/></svg>
          Pick-up en Boutique Cataluña con cita previa (PDC)
        </span>
        <span class="dot-sep">•</span>
        <span style="display:inline-flex; align-items:center; gap:0.4rem;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <strong>4.95 / 5.0 en Google Reviews</strong> (38 opiniones)
        </span>
      </div>

      <!-- Hero Header -->
      <header class="store-hero">
        <div class="store-hero-content">
          <div class="store-badges">
            <span class="tag-red font-mono">[TIENDA & CATÁLOGO OFICIAL]</span>
            <span class="tag-loc font-mono">PLAYA DEL CARMEN, Q. ROO</span>
          </div>
          <h1 class="store-title">Equipamiento & Bicicletas Listas para Rodar.</h1>
          <p class="store-sub">
            Explora nuestro catálogo universal de bicicletas, refacciones, componentes de alta gama y accesorios. Compara modelos lado a lado y compra con envío directo a tu puerta.
          </p>
        </div>

        <div class="store-hero-actions">
          <a
            href="https://wa.me/529841381493?text=Hola,%20busco%20asesor%C3%ADa%20para%20elegir%20un%20producto%20o%20bicicleta%20del%20cat%C3%A1logo."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-wa-hero"
          >
            <Icon name="mdi:whatsapp" width="20" height="20" />
            <span>Asesoría Directa por WhatsApp</span>
          </a>
        </div>
      </header>

      <!-- Main E-commerce Layout (Nike / Adidas Style: Sticky Sidebar + Product Grid) -->
      <div class="store-layout">

        <!-- ══════════ LEFT COLUMN: FILTROS TIPO NIKE / ADIDAS ══════════ -->
        <aside class="store-filters-sidebar">
          <div class="filters-header">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <Icon name="mdi:filter-variant" width="20" height="20" color="var(--accent-color)" />
              <h3 style="font-size:1.1rem; font-weight:700; margin:0; letter-spacing:-0.02em;">Filtros</h3>
            </div>
            <button id="btn-clear-filters" class="btn-clear">Limpiar Todo</button>
          </div>

          <!-- Filter Group: Search -->
          <div class="filter-group">
            <div class="filter-search-box">
              <Icon name="mdi:magnify" width="18" height="18" style="color:var(--text-muted);" />
              <input type="text" id="store-search-input" placeholder="Buscar producto, marca o SKU..." />
            </div>
          </div>

          <!-- Filter Group: Categorías -->
          <div class="filter-group">
            <h4 class="filter-title">Categorías</h4>
            <div class="filter-options-list" id="cat-options-container">
              {initialCats.map(c => (
                <button class={`filter-cat-btn ${c.id === 'all' ? 'active' : ''}`} onclick={`selectCategory('${c.id}')`}>
                  <span class="cat-btn-inner">
                    <span class="cat-icon-badge">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        {c.id === 'all' ? (
                          <><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></>
                        ) : (
                          <><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/><path d="M8 14h5"/></>
                        )}
                      </svg>
                    </span>
                    <span>{c.label}</span>
                  </span>
                  <span class="filter-badge-num">{c.count}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Filter Group: Rango de Precio -->
          <div class="filter-group">
            <h4 class="filter-title">Rango de Precio</h4>
            <div class="filter-options-list">
              <label class="filter-radio-label">
                <input type="radio" name="price-range" value="all" checked />
                <span>Todos los precios</span>
              </label>
              <label class="filter-radio-label">
                <input type="radio" name="price-range" value="under500" />
                <span>Menos de $500 MXN</span>
              </label>
              <label class="filter-radio-label">
                <input type="radio" name="price-range" value="500to2000" />
                <span>$500 a $2,000 MXN</span>
              </label>
              <label class="filter-radio-label">
                <input type="radio" name="price-range" value="2000to10000" />
                <span>$2,000 a $10,000 MXN</span>
              </label>
              <label class="filter-radio-label">
                <input type="radio" name="price-range" value="over10000" />
                <span>Más de $10,000 MXN</span>
              </label>
            </div>
          </div>

          <!-- Filter Group: Marcas Populares -->
          <div class="filter-group">
            <h4 class="filter-title">Marcas</h4>
            <div class="brand-chips-grid" id="brand-chips-container">
              {initialBrands.map(b => (
                <button class={`brand-chip ${b === 'all' ? 'active' : ''}`} onclick={`selectBrand('${b}')`}>
                  {b === 'all' ? 'Todas' : b}
                </button>
              ))}
            </div>
          </div>

          <!-- Filter Group: Disponibilidad -->
          <div class="filter-group" style="border-bottom:none;">
            <h4 class="filter-title">Disponibilidad</h4>
            <label class="filter-checkbox-label">
              <input type="checkbox" id="chk-only-instock" checked />
              <span>Solo unidades en stock inmediato</span>
            </label>
            <label class="filter-checkbox-label" style="margin-top:0.4rem;">
              <input type="checkbox" id="chk-free-shipping" />
              <span>Envío Gratis en Playa del Carmen (≥$500)</span>
            </label>
          </div>

        </aside>

        <!-- ══════════ RIGHT COLUMN: TOOLBAR & PRODUCT GRID ══════════ -->
        <main class="store-products-main">

          <!-- Top Toolbar: Count + Sort + Compare Toggle -->
          <div class="store-top-toolbar">
            <div class="store-count-label">
              Mostrando <strong id="store-count-num">{initialProducts.length}</strong> productos
            </div>

            <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
              <!-- Sort Selector -->
              <div class="sort-selector-wrap">
                <label for="store-sort-select">Ordenar por:</label>
                <select id="store-sort-select" class="sort-select">
                  <option value="featured">Destacados & Recomendados</option>
                  <option value="price-asc">Precio: Menor a Mayor</option>
                  <option value="price-desc">Precio: Mayor a Menor</option>
                  <option value="name-asc">Nombre: A - Z</option>
                </select>
              </div>

              <!-- Quick Compare Toggle Button -->
              <button id="btn-toggle-compare-mode" class="btn-compare-mode" title="Activa casillas para comparar especificaciones">
                <Icon name="mdi:scale-balance" width="18" height="18" />
                <span id="compare-mode-btn-text">Comparar Productos</span>
              </button>
            </div>
          </div>

          <!-- Active Filter Tags Row -->
          <div id="active-filter-tags" class="active-tags-row" style="display:none;"></div>

          <!-- Product Grid (Nike / Adidas Style Cards) -->
          <div class="nike-product-grid" id="store-product-grid">
            {initialProducts.map(p => {
              const imageSrc = (p.fotos && p.fotos[0]) ? p.fotos[0] : null;
              const webPrice = Math.round(p.price * 1.035);
              const isFreeShipping = webPrice >= 500;
              const prodId = p.slug || p.sku || p.id;
              const waText = encodeURIComponent(`Hola The Garage, me interesa el producto: ${p.name} ($${webPrice.toLocaleString('es-MX', { minimumFractionDigits: 0 })}). ¿Tienen entrega hoy en Playa del Carmen?`);
              return (
                <article class="nike-card">
                  <!-- Image Box (Clickable to Product Detail) -->
                  <a href={`/bici/${prodId}`} class="nike-card-img-wrap" style="text-decoration:none; display:block;">
                    {imageSrc ? (
                      <img src={imageSrc} alt={p.name} loading="lazy" />
                    ) : (
                      <div class="nike-no-img-box">
                        <div class="tech-blueprint-icon">
                          <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/><path d="M8 14h5"/></svg>
                        </div>
                        <span class="nike-no-img-text font-mono">[{p.cat.toUpperCase()}]</span>
                      </div>
                    )}

                    <!-- Badges -->
                    <div class="nike-badge-top-left">
                      {p.precioRenta && (
                        <span class="badge-pill-shipping" style="background:rgba(0,113,227,0.9); color:#ffffff;">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="m12 17.5 2.5-7.5H6l3.5 7.5"/><path d="M12 17.5 9.5 10H6"/><path d="m15 5-3 5"/></svg> Renta: ${p.precioRenta}/día
                        </span>
                      )}
                      {isFreeShipping && (
                        <span class="badge-pill-shipping">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Envío Gratis (PDC)
                        </span>
                      )}
                      <span class="badge-pill-stock">{p.stock > 0 ? `${p.stock} en tienda` : 'Agotado'}</span>
                    </div>

                    <!-- Compare Button -->
                    <button
                      class="btn-card-compare"
                      onclick={`event.preventDefault(); event.stopPropagation(); toggleCompare('${prodId}')`}
                      title="Comparar especificaciones técnicas"
                    >
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                      <span>Comparar</span>
                    </button>
                  </a>

                  <!-- Body -->
                  <div class="nike-card-body">
                    <span class="nike-brand-tag">{p.brand || 'The Garage'} · {p.cat}</span>
                    <h3 class="nike-prod-title">
                      <a href={`/bici/${prodId}`} style="color:inherit; text-decoration:none;">{p.name}</a>
                    </h3>
                    <p class="nike-prod-sub">{p.talla ? <>Talla: <strong>{p.talla}</strong> · </> : ''}{p.specs ? p.specs.slice(0, 75) + '...' : ''}</p>
                    {p.precioRenta && (
                      <div style="margin:0.25rem 0 0.5rem; font-size:0.75rem; color:#2997ff; font-weight:600; display:flex; align-items:center; justify-content:space-between; background:rgba(0,113,227,0.08); padding:0.3rem 0.55rem; border-radius:6px; border:1px solid rgba(0,113,227,0.2);">
                        <span>🚲 Disponible en Renta: <strong>${p.precioRenta} MXN/día</strong></span>
                        <a href="/renta" style="color:#ffffff; font-weight:700; text-decoration:underline;">Rentar &rarr;</a>
                      </div>
                    )}

                    <div class="nike-price-row">
                      <div>
                        <div class="nike-price-main">${webPrice.toLocaleString('es-MX', { minimumFractionDigits: 0 })}</div>
                        <div class="nike-fee-note">Incluye comisión web (3.5%)</div>
                      </div>
                      <div style="font-size:0.75rem; color:#34c759; font-weight:600; text-align:right;">
                        {isFreeShipping ? 'Envío gratis en Playa' : 'Envío $80 MXN'}
                      </div>
                    </div>

                    <!-- Card Actions -->
                    <div class="nike-card-actions">
                      <a href={`/bici/${prodId}`} class="btn-detail-glass" title="Ver detalle y especificaciones">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        <span>Detalle</span>
                      </a>

                      <button class="btn-dualtone-cart" onclick={`addToCartStore('${prodId}')`} title="Agregar al carrito">
                        <span class="dualtone-cart-label">Agregar</span>
                        <span class="dualtone-cart-icon">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        </span>
                      </button>

                      <a
                        href={`https://wa.me/529841381493?text=${waText}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-wa-pill"
                        title="Consultar disponibilidad inmediata por WhatsApp"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.531 1.931.812 2.79.812 3.179 0 5.767-2.587 5.768-5.766 0-3.181-2.588-5.768-5.767-5.768zm0 10.362c-.792 0-1.637-.24-2.348-.661l-.168-.1-1.748.458.467-1.704-.11-.176c-.461-.736-.704-1.579-.704-2.446 0-2.535 2.062-4.597 4.601-4.597 2.538 0 4.602 2.063 4.602 4.601 0 2.538-2.064 4.602-4.602 4.602z"/></svg>
                        <span>WhatsApp</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

        </main>
      </div>

      <!-- ══════════ BOTTOM FLOATING COMPARE BAR ══════════ -->
      <div id="floating-compare-bar" class="floating-compare-bar" style="display:none;">
        <div class="compare-bar-content">
          <div class="compare-bar-left">
            <span class="compare-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg></span>
            <div>
              <strong id="compare-bar-count">0 productos seleccionados</strong>
              <div style="font-size:0.78rem; color:var(--text-muted);">Compara componentes, peso, geometría y precio</div>
            </div>
            <div id="compare-mini-thumbs" class="compare-mini-thumbs"></div>
          </div>
          <div class="compare-bar-actions">
            <button id="btn-clear-compare" class="btn-clear-compare">Limpiar</button>
            <button id="btn-open-compare-modal" class="btn-primary-compare">
              Ver Comparación Detallada →
            </button>
          </div>
        </div>
      </div>

      <!-- ══════════ MODAL DE COMPARACIÓN LADO A LADO ══════════ -->
      <div id="compare-modal" class="compare-modal-overlay" style="display:none;">
        <div class="compare-modal-box">
          <div class="compare-modal-header">
            <div>
              <h2 style="font-size:1.4rem; font-weight:700; margin:0; display:flex; align-items:center; gap:0.5rem;">
                <Icon name="mdi:scale-balance" width="24" height="24" color="var(--accent-color)" />
                Comparativa de Productos Lado a Lado
              </h2>
              <p style="color:var(--text-muted); font-size:0.85rem; margin:0.25rem 0 0;">Analiza especificaciones técnicas, precio y disponibilidad para tomar la mejor decisión.</p>
            </div>
            <button id="btn-close-compare-modal" class="btn-close-modal">&times;</button>
          </div>

          <div class="compare-modal-body" id="compare-modal-body">
            <!-- Dynamic Side-by-Side Table rendered by JS -->
          </div>
        </div>
      </div>

      <!-- Custom Build Basso Banner (Footer) -->
      <section class="basso-custom-banner" style="margin-top:4rem;">
        <div class="basso-custom-content">
          <span class="font-mono text-xs text-rose-400 font-bold uppercase tracking-wider">
            [BASSO BIKES ITALIA // CUSTOM BUILD]
          </span>
          <h2 class="title-lg" style="color: #FFFFFF; margin: 0.5rem 0;">
            ¿Buscas un cuadro o ensamble específico?
          </h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 680px;">
            Como distribuidores oficiales de Basso Bikes, cotizamos e importamos tu cuadro de carbono italiano Torayca con grupo SRAM AXS / Shimano Di2 y ruedas a tu medida.
          </p>
        </div>

        <a
          href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20cotizar%20un%20cuadro%20o%20ensamble%20personalizado%20de%20Basso%20Bikes."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Cotizar Ensamble a Medida ↗
        </a>
      </section>

    </div>
  </div>
</Base>

<style is:global>
  /* ── Store Layout & Base ── */
  .store-page-wrap {
    padding: 1.5rem 0 5rem 0;
    color: #f5f5f7;
  }

  .store-banner {
    background: linear-gradient(90deg, #18181b, #27272a);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 0.65rem 1.25rem;
    font-size: 0.82rem;
    color: #d4d4d8;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    text-align: center;
  }
  .dot-sep { opacity: 0.4; }

  .store-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 2rem;
  }
  .store-hero-content { max-width: 780px; }
  .store-badges { display: flex; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.75rem; }
  .tag-red { color: #ff3b30; font-weight: 700; letter-spacing: 0.06em; }
  .tag-loc { color: #86868b; }
  .store-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .store-sub {
    font-size: 1rem;
    color: #a1a1aa;
    line-height: 1.6;
  }
  .btn-wa-hero {
    background: #25d366;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.2s, background 0.2s;
  }
  .btn-wa-hero:hover { background: #20ba5a; transform: translateY(-2px); }

  /* ── 2-Column Store Layout ── */
  .store-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: flex-start;
  }
  @media (max-width: 980px) {
    .store-layout { grid-template-columns: 1fr; }
  }

  /* ── Sticky Sidebar Filters (Nike / Adidas Style) ── */
  .store-filters-sidebar {
    position: sticky;
