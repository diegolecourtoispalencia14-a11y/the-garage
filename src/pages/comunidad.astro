    shortcode: "DbKdO6OFS87b3HevOt3mCquoKe3oynVy7zj_Yg0",
    categoria: "Eventos & Carreras",
    tipo: "evento",
    badge: "CLÁSICA 7:30",
    emoji: "🏆",
    titulo: "Clásica 7:30 Circuito XCO — La Fiesta del MTB en Playa",
    descripcion: "Carrera oficial de cross-country organizada y respaldada por The Garage en senderos técnicos de Quintana Roo.",
    imagen: "/img/instagram/live-ig-fredy_sanzDbKdO6OFS87b3HevOt3mCquoKe3oynVy7zj_Yg0.jpg",
    specs: ["Circuito Técnico XCO", "MTB Competencia", "Riviera Maya"]
  },
  {
    permalink: "https://www.instagram.com/thegarage.pdc/reel/DbJIcYSz_JP/",
    shortcode: "DbJIcYSz_JP",
    categoria: "Nutrición & Eventos",
    tipo: "evento",
    badge: "LOGÍSTICA DE CARRERA",
    emoji: "🌴",
    titulo: "Logística y Soporte en Competencias Regionales",
    descripcion: "Presencia en carreras locales con servicio técnico de emergencia e hidratación para todos los ciclistas participantes.",
    imagen: "/img/instagram/live-ig-thegarage.pdcDbJIcYSz_JP.jpg",
    specs: ["Soporte en Ruta", "Taller Móvil", "Comunidad Ciclista"]
