---
import Base from '../layouts/Base.astro';

const stories = [
  { id: 'basso', name: 'Basso Italia', emoji: '🇮🇹', border: 'linear-gradient(45deg, #009246, #FFFFFF, #CE2B37)', filter: 'arribo' },
  { id: 'rodadas', name: 'The Garage Ride', emoji: '🌴', border: 'linear-gradient(45deg, #FF3B30, #FF9500)', filter: 'rodada' },
  { id: 'clasica', name: 'Clásica 7:30', emoji: '🏆', border: 'linear-gradient(45deg, #F59E0B, #D97706)', filter: 'evento' },
  { id: 'taller', name: 'Taller & SRAM', emoji: '🔧', border: 'linear-gradient(45deg, #64748B, #94A3B8)', filter: 'taller' },
  { id: 'wayfar', name: 'Wayfar Nutrición', emoji: '⚡', border: 'linear-gradient(45deg, #EA580C, #F97316)', filter: 'lifestyle' },
  { id: 'bikepacking', name: 'Huellas de Coral', emoji: '🌊', border: 'linear-gradient(45deg, #0284C7, #06B6D4)', filter: 'rodada' }
