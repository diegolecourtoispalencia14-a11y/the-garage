---

<Base
  title="Comunidad & Feed Oficial | The Garage Playa del Carmen"
  description="Feed en vivo extraído directamente de @thegarage.pdc. Distribuidores oficiales de Basso, eventos Clásica 7:30 XCO, nutrición Wayfar y rodadas en Playa del Carmen."
>
  <div class="comunidad-page-wrap">
    <div class="container-fluid">
      
      <!-- Top Stories Row -->
      <div class="stories-track-bar">
        {stories.map((story) => (
          <button type="button" class="story-tab-btn font-mono" data-filter={story.filter}>
            <span class="story-tag-pill">{story.tag}</span>
            <span class="story-name-label">{story.name}</span>
          </button>
        ))}
      </div>

      <!-- Header Section -->
      <section class="comunidad-hero-section">
        <div class="comunidad-hero-content">
          <div class="comunidad-badges font-mono">
            <span class="badge-ig-live">FEED OFICIAL @THEGARAGE.PDC</span>
            <span class="badge-loc">PLAYA DEL CARMEN, Q.R.</span>
          </div>
          <h1 class="title-xl" style="margin-bottom: 0.75rem;">
            Comunidad, Rodadas &amp; Eventos.
          </h1>
          <p class="subtitle" style="max-width: 720px;">
            Publicaciones originales extraídas de nuestro Instagram. Salidas semanales <strong>The Garage Ride</strong>, la carrera <strong>Clásica 7:30 XCO</strong>, distribución oficial de <strong>Basso Bikes</strong> y nutrición <strong>Wayfar</strong>.
          </p>
        </div>

        <a
          href="https://www.instagram.com/thegarage.pdc/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <span>Seguir en Instagram ↗</span>
        </a>
      </section>

      <!-- Media Grid -->
      <div class="media-grid-container">
        {posts.map((post) => (
          <article class="media-feed-card" data-tipo={post.tipo}>
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="media-view-box"
              title="Abrir post original en Instagram"
            >
              <img src={post.imagen} alt={post.titulo} loading="lazy" width="640" height="640" />
              <div class="media-tag-badge font-mono">
                {post.badge}
              </div>
            </a>

            <div class="media-body-box">
              <span class="media-cat-label font-mono">[{post.categoria.toUpperCase()}]</span>
              <h2 class="media-card-title">{post.titulo}</h2>
              <p class="media-card-desc">{post.descripcion}</p>

              <div class="media-actions-row">
                <a
                  href={`https://wa.me/529841381493?text=Hola,%20vi%20la%20publicaci%C3%B3n%20sobre%20${encodeURIComponent(post.titulo)}%20(${post.permalink})%20y%20me%20gustar%C3%ADa%20m%C3%A1s%20informaci%C3%B3n.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-whatsapp media-btn-wa"
                >
                  Consultar por WhatsApp
                </a>
                <a
                  href={post.permalink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline media-btn-post font-mono"
                >
                  Post ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</Base>

<style>
  .comunidad-page-wrap {
    padding: var(--space-6) 0 var(--space-9) 0;
  }

  .stories-track-bar {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-6);
    scrollbar-width: none;
  }
  .stories-track-bar::-webkit-scrollbar {
    display: none;
  }

  .story-tab-btn {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s var(--ease-spring);
    color: var(--text-secondary);
  }
  .story-tab-btn:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    background: var(--surface-elevated);
  }

  .story-tag-pill {
    font-size: 0.7rem;
    font-weight: 800;
    color: #FB7185;
  }
  .story-name-label {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .comunidad-hero-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-7);
  }

  .comunidad-hero-content {
    max-width: 780px;
  }

  .comunidad-badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 0.72rem;
  }
  .badge-ig-live {
    color: #FB7185;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .badge-loc {
    color: var(--text-muted);
  }

  .media-grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--space-5);
  }

  .media-feed-card {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s var(--ease-spring), border-color 0.25s ease, box-shadow 0.25s var(--ease-spring);
  }
  .media-feed-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 16px 40px -12px rgba(225, 29, 72, 0.15);
  }

  .media-view-box {
    position: relative;
    aspect-ratio: 1/1;
    background: #09090B;
    overflow: hidden;
    display: block;
  }
  .media-view-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }
  .media-feed-card:hover .media-view-box img {
    transform: scale(1.04);
  }

  .media-tag-badge {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .media-body-box {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .media-cat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  .media-card-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: var(--space-2);
  }

  .media-card-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .media-actions-row {
    margin-top: auto;
    display: flex;
    gap: var(--space-2);
  }

  .media-btn-wa {
    flex: 1;
    padding: 0.6rem 1rem;
    font-size: 0.82rem;
  }
  .media-btn-post {
    padding: 0.6rem 1rem;
    font-size: 0.82rem;
  }
</style>
