<script>
  function initFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-pill');
    const cards = document.querySelectorAll<HTMLElement>('.social-grid .social-card');
    const stories = document.querySelectorAll<HTMLButtonElement>('.story-bubble');

    function applyFilter(tipo: string) {
      tabs.forEach((t) => {
        if (t.getAttribute('data-tipo') === tipo) {
          t.classList.add('active');
        } else {
          t.classList.remove('active');
        }
      });

      cards.forEach((card) => {
        const cardTipo = card.getAttribute('data-tipo');
        if (tipo === 'todas' || cardTipo === tipo) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const tipo = tab.getAttribute('data-tipo') || 'todas';
        applyFilter(tipo);
      });
    });

    stories.forEach((story) => {
      story.addEventListener('click', () => {
        const filter = story.getAttribute('data-filter') || 'todas';
        applyFilter(filter);
        const grid = document.querySelector('.social-grid');
        if (grid) grid.scrollIntoView({ behavior: 'smooth' });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilters);
  } else {
    initFilters();
  }
</script>
