    shortcode: "Dcn9XZoRC-3",
    categoria: "Comunidad & Rodadas",
    tipo: "rodada",
    badge: "THE GARAGE RIDE",
    emoji: "🌴",
    titulo: "The Garage Ride — Rodada Grupal en Playa del Carmen",
