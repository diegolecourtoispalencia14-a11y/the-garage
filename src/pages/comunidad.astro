    categoria: 'Eventos & Carreras',
    tipo: 'evento',
    tag: 'Clásica 7:30 XCO',
    emoji: '🏆',
    titulo: 'Clásica 7:30 Circuito XCO — La gran fiesta del ciclismo de montaña',
    descripcion: 'Organización y cronometraje de la carrera de cross-country más esperada en la Riviera Maya. Circuito técnico, categorías libre y master con hidratación Wayfar en pista.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '341 likes',
    comentarios: '56 comentarios',
    badge: 'EVENTO OFICIAL',
    imagen: '/img/instagram/real-clasica-730.webp',
    specs: ['Circuito XCO Técnico', 'Categorías Libre / Master', 'Hidratación en Pista']
  },
  {
    id: 'entrega-amigos-tienda',
    categoria: 'Entregas & Taller',
    tipo: 'entrega',
    tag: 'Nueva Bici',
    emoji: '🤝',
    titulo: 'Nueva entrega en tienda — Listos para rodar en Cataluña',
    descripcion: 'Felicidades por la nueva nave. Ajuste de altura de sillín, calibración de transmisión y revisión de presión de llantas antes de salir a rodar.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '197 likes',
    comentarios: '21 comentarios',
    badge: 'NUEVO RIDER',
    imagen: '/img/instagram/real-entrega-amigos-tienda.webp',
    specs: ['Ajuste Biomecánico', '1er Servicio Incluido', 'Garantía Directa']
  },
  {
    id: 'wayfar-sunset',
    categoria: 'Nutrición Wayfar',
    tipo: 'lifestyle',
    tag: 'Wayfar Nutrition',
    emoji: '⚡',
    titulo: 'Wayfar Watermelon Electrolitos — Hidratación frente al Caribe',
    descripcion: '50 servicios de hidratación pura sin azúcar añadida. Repone minerales esenciales para evitar calambres y deshidratación en rodadas bajo el sol caribeño.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '168 likes',
    comentarios: '15 comentarios',
    badge: 'DISPONIBLE EN TIENDA',
    imagen: '/img/instagram/real-wayfar-sunset.webp',
    specs: ['Electrolitos Puros', 'Sabor Sandía', '50 Servicios']
  },
  {
    id: 'basso-astra-road',
    categoria: 'Distribuidor Basso',
    tipo: 'arribo',
    tag: 'Basso Bikes Italia',
    emoji: '🇮🇹',
    titulo: 'Basso Astra Disc — Máxima velocidad en asfalto',
    descripcion: 'Cuadro 100% carbono hecho en Italia, cableado totalmente integrado y geometría de resistencia para volar en la carretera Cancún - Tulum.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '225 likes',
    comentarios: '33 comentarios',
    badge: 'DISTRIBUIDOR OFICIAL',
    imagen: '/img/instagram/real-basso-astra-road.webp',
    specs: ['Cuadro Carbono Torayca', 'Frenos de Disco', 'Handmade in Italy']
  },
  {
    id: 'peloton-selva',
    categoria: 'Rodadas de Comunidad',
    tipo: 'rodada',
    tag: 'Ruta Cenotes',
    emoji: '🌴',
    titulo: 'Pelotón de sábado por la carretera de la selva maya',
    descripcion: 'Rodando en grupo seguro con vanguardia y barredora. El ciclismo se disfruta más en equipo.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '312 likes',
    comentarios: '44 comentarios',
    badge: 'RODADA GRUPAL',
    imagen: '/img/instagram/real-peloton-selva.webp',
    specs: ['60 km Fondo', 'Carretera Asfaltada', 'Vehículo de Apoyo']
  },
  {
    id: 'cicloviaje-playa',
    categoria: 'Aventura & Bikepacking',
    tipo: 'lifestyle',
    tag: 'Huellas de Coral',
    emoji: '🌊',
    titulo: 'Cicloviaje por el Sistema Arrecifal Mesoamericano',
    descripcion: 'Expediciones en dos ruedas bordeando las costas de Quintana Roo. Alforjas listas, mapa trazado y pasión por explorar el Caribe.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '267 likes',
    comentarios: '39 comentarios',
    badge: 'BIKEPACKING CARIBE',
    imagen: '/img/instagram/real-cicloviaje-playa.webp',
    specs: ['Ruta Costera', 'Bikepacking', 'Exploración Riviera']
  },
  {
    id: 'zipp-wheels-upgrade',
    categoria: 'Taller & Upgrades',
    tipo: 'taller',
    tag: 'Zipp Wheels',
    emoji: '🔧',
    titulo: 'Ruedas de Carbono Zipp 303 XPLR & Llantas Pirelli',
    descripcion: 'Montaje de rines de carbono Zipp con neumáticos Pirelli tubeless para un rodaje suave y reactivo en terrenos mixtos.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '183 likes',
    comentarios: '19 comentarios',
    badge: 'UPGRADE TALLER',
    imagen: '/img/instagram/real-zipp-wheels.webp',
    specs: ['Zipp Carbono', 'Pirelli Tubeless', 'Montaje de Precisión']
  },
  {
    id: 'magene-smart-trainer',
    categoria: 'Entrenamiento Indoor',
    tipo: 'lifestyle',
    tag: 'Magene Trainer',
    emoji: '⚡',
    titulo: 'Rodillo Inteligente Magene T110 Smart Trainer',
    descripcion: 'Entrena potencia y cadencia desde la comodidad de tu casa con conexión directa a Zwift y plataformas de ciclismo virtual.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '144 likes',
    comentarios: '16 comentarios',
    badge: 'DISPONIBLE EN TIENDA',
    imagen: '/img/instagram/real-magene-trainer.webp',
    specs: ['Resistencia Magnética', 'Conexión Bluetooth / ANT+', 'Compatible con Zwift']
  },
  {
    id: 'basso-distribuidor-oficial',
    categoria: 'Distribuidor Basso',
    tipo: 'arribo',
    tag: 'Basso Italia',
    emoji: '🇮🇹',
    titulo: 'Distribuidores Autorizados Basso Bikes en Quintana Roo',
    descripcion: 'Traemos a Playa del Carmen lo más exclusivo del ciclismo italiano. Garantía oficial de fábrica y asesoría personalizada en tienda.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '358 likes',
    comentarios: '52 comentarios',
    badge: 'OFICIAL EN PLAYA',
    imagen: '/img/instagram/real-basso-distribuidor-oficial.webp',
    specs: ['Garantía de Fábrica', 'Importación Directa', 'Asesoría en Tienda']
  },
  {
    id: 'basso-event-finish',
    categoria: 'Eventos & Carreras',
    tipo: 'evento',
    tag: 'Carrera Caribe',
    emoji: '🏁',
    titulo: 'Rider The Garage en podio de evento ciclista regional',
    descripcion: 'Orgullosos de nuestros ciclistas representándonos en cada competencia del sureste mexicano con máquinas Basso y nutrición Wayfar.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '290 likes',
    comentarios: '37 comentarios',
    badge: 'PODIO THE GARAGE',
    imagen: '/img/instagram/real-basso-event.webp',
    specs: ['Competencia Regional', 'Equipo The Garage', 'Podio']
  }
];
---

<Base
  title="Comunidad Ciclista & Instagram Live | The Garage Playa del Carmen"
  description="Feed oficial de la comunidad de The Garage (@thegarage.pdc). Distribuidores oficiales de Basso, Lee Cougan, eventos Clásica 7:30 XCO y rodadas en Playa del Carmen."
>
  <!-- Hero Section con Identidad Real de The Garage -->
  <section style="background: radial-gradient(circle at top right, #FFF1F2 0%, #FFFFFF 60%); border-bottom: 2px solid #0F172A; padding: 3.5rem 0 2.5rem 0;">
    <div class="container">
      <div style="max-width: 860px;">
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem;">
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FDF2F8; border: 1.5px solid #FCE7F3; color: #BE185D; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;"
          >
            📸 INSTAGRAM OFICIAL @THEGARAGE.PDC
          </a>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #0F172A; color: #FFFFFF; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">
            🌴 THE GARAGE RIDE &amp; CLÁSICA 7:30 XCO
          </div>
        </div>

        <h1 class="title-xl" style="margin-bottom: 1rem; color: #0F172A;">
          Comunidad, Rodadas &amp; Eventos en Playa del Carmen.
        </h1>
        <p class="subtitle" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 1.75rem;">
          En <strong>The Garage</strong> no solo vendemos bicicletas: organizamos las rodadas sabatinas <strong>The Garage Ride</strong>, la carrera <strong>Clásica 7:30 XCO</strong>, distribuimos <strong>Basso Bikes</strong> y equipamos a los ciclistas de la Riviera Maya con nutrición <strong>Wayfar</strong> y taller certificado.
        </p>

        <!-- Social Proof Stats Bar -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.15rem; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.35rem;">🚴</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">The Garage Ride</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Rodadas grupales sabatinas</span>
            </div>
          </div>
          <div style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.15rem; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.35rem;">🏆</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Clásica 7:30 XCO</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Circuito y carreras oficiales</span>
            </div>
          </div>
          <div style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.15rem; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.35rem;">⚡</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Wayfar &amp; Basso</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Nutrición e ingeniería italiana</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Feed Social Interactivo con las Fotos Reales de Instagram -->
  <section style="padding: 3rem 0 5rem 0;">
    <div class="container">
      
      <!-- Interactive Filter Tabs -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem;">
        <div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem;" id="insta-filters">
          <button type="button" class="insta-tab active" data-tipo="todas">Todo el Feed ({instagramPosts.length})</button>
          <button type="button" class="insta-tab" data-tipo="rodada">🌴 The Garage Ride</button>
          <button type="button" class="insta-tab" data-tipo="evento">🏆 Clásica 7:30 &amp; Eventos</button>
          <button type="button" class="insta-tab" data-tipo="arribo">🇮🇹 Basso Bikes</button>
          <button type="button" class="insta-tab" data-tipo="taller">🔧 Taller &amp; Upgrades</button>
          <button type="button" class="insta-tab" data-tipo="lifestyle">⚡ Wayfar &amp; Kits</button>
        </div>

        <a
          href="https://www.instagram.com/thegarage.pdc/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          style="background: linear-gradient(45deg, #F58529, #D62976, #962FBF, #4F5BD5); color: #FFFFFF; padding: 0.6rem 1.25rem; font-size: 0.85rem;"
        >
          Seguir en Instagram ↗
        </a>
      </div>

      <!-- Instagram Posts Grid con las Fotos Reales del Perfil -->
      <div class="insta-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        {instagramPosts.map((post) => (
          <article
            class="insta-card"
            data-tipo={post.tipo}
            style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;"
          >
            <!-- Card Header: User & Tag -->
            <div style="padding: 0.85rem 1.15rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); background: #FAFAFA;">
              <div style="display: flex; align-items: center; gap: 0.65rem;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: #FFFFFF; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1.5px solid #E2E8F0;">
                  <img src="/img/the-garage-avatar.png" alt="Avatar The Garage" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <div>
                  <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">thegarage.pdc</strong>
                  <span style="font-size: 0.72rem; color: var(--text-muted);">{post.fecha}</span>
                </div>
              </div>
              <span class="badge" style="background: #F1F5F9; color: #475569; font-size: 0.7rem;">
                {post.emoji} {post.categoria}
              </span>
            </div>

            <!-- Card Media Container con Fotografía Real Extraída -->
            <div style="position: relative; aspect-ratio: 1/1; background: #000000; overflow: hidden;">
              <img
                src={post.imagen}
                alt={post.titulo}
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;"
                loading="lazy"
              />
              <div style="position: absolute; bottom: 0.85rem; left: 0.85rem;">
                <span class="badge" style="background: rgba(15, 23, 42, 0.85); color: #FFFFFF; font-size: 0.7rem; backdrop-filter: blur(4px);">
                  {post.badge}
                </span>
              </div>
            </div>

            <!-- Card Body & Text -->
            <div style="padding: 1.3rem; display: flex; flex-direction: column; flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; font-size: 0.8rem; color: #64748B; font-weight: 700;">
                <div style="display: flex; gap: 0.75rem;">
                  <span>❤️ {post.likes}</span>
                  <span>💬 {post.comentarios}</span>
                </div>
                <span>Playa del Carmen</span>
              </div>

              <h2 class="title-md" style="margin-bottom: 0.5rem; color: var(--secondary); font-size: 1.05rem; line-height: 1.35;">
                {post.titulo}
              </h2>

              <p style="font-size: 0.88rem; color: #475569; line-height: 1.55; margin-bottom: 1.15rem;">
                {post.descripcion}
              </p>

              <!-- Specs pills -->
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem;">
                {post.specs.map((spec) => (
                  <span style="font-size: 0.72rem; background: #F1F5F9; color: #334155; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700;">
                    ✓ {spec}
                  </span>
                ))}
              </div>

              <!-- Action Bottom -->
              <div style="margin-top: auto; padding-top: 0.85rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <a
                  href={`https://wa.me/529841381493?text=Hola,%20vi%20la%20publicaci%C3%B3n%20en%20la%20web%20sobre%20${encodeURIComponent(post.titulo)}%20y%20me%20gustar%C3%ADa%20m%C3%A1s%20informaci%C3%B3n.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-whatsapp"
                  style="padding: 0.45rem 0.9rem; font-size: 0.8rem;"
                >
                  Consultar por WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/thegarage.pdc/"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size: 0.8rem; font-weight: 800; color: #E1306C;"
                >
                  Ver en IG ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Riders Club Banner -->
      <div style="margin-top: 4.5rem; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; border-radius: var(--radius-xl); padding: 3.5rem 2.5rem; box-shadow: var(--shadow-xl); border: 2px solid #334155;">
        <div style="max-width: 780px; margin-bottom: 2rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255,87,34,0.2); border: 1px solid #FF5722; color: #FF7043; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 1rem;">
            🚴 THE GARAGE RIDERS CLUB
          </div>
          <h2 class="title-lg" style="color: #FFFFFF; margin-bottom: 0.75rem;">
            Únete a la familia The Garage en Playa del Carmen:
          </h2>
          <p style="color: #CBD5E1; font-size: 1rem; line-height: 1.6;">
            Salidas grupales todos los fines de semana, entrenamientos para la Clásica 7:30 XCO, soporte de mecánicos y precios especiales en Wayfar:
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">🌴</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">The Garage Ride</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Rodadas sabatinas hacia Cenotes, Tulum y Puerto Aventuras con barredora.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">🏆</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">Clásica 7:30 XCO</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Inscripciones preferenciales y entrenamientos en el circuito técnico.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">⚡</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">Descuento en Wayfar &amp; SRAM</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Electrolitos, geles, refacciones originales y upgrades en taller.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">🔧</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">1er Mantenimiento Gratis</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Reajuste y calibración de tornillería a los 30 días de rodar.</p>
          </div>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
          <a
            href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20unirme%20a%20The%20Garage%20Ride%20y%20conocer%20las%20pr%C3%B3ximas%20fechas%20de%20rodadas."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-lg"
          >
            Unirme al Grupo de Rodadas en WhatsApp
          </a>
          <a
            href="/"
            class="btn btn-outline"
            style="color: #0F172A; background: #FFFFFF; font-weight: 800;"
          >
            Ver Catálogo de Bicicletas →
          </a>
        </div>
      </div>

    </div>
  </section>
</Base>

<style>
  .insta-tab {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--border);
    background: #F8FAFC;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .insta-tab.active {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
  }
  .insta-card {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .insta-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .insta-card:hover img {
    transform: scale(1.03);
  }
</style>

<script>
  function initInstaFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('#insta-filters .insta-tab');
    const cards = document.querySelectorAll<HTMLElement>('.insta-grid .insta-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        const tipo = tab.getAttribute('data-tipo') || 'todas';

        cards.forEach((card) => {
          const cardTipo = card.getAttribute('data-tipo');
          if (tipo === 'todas' || cardTipo === tipo) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstaFilters);
  } else {
    initInstaFilters();
  }
</script>
