---

<Base
  title="Comunidad & Feed Oficial | The Garage Playa del Carmen"
  description="Feed en vivo extraído directamente de @thegarage.pdc. Distribuidores oficiales de Basso, eventos Clásica 7:30 XCO, nutrición Wayfar y rodadas en Playa del Carmen."
>
  <!-- Instagram Stories Highlights Row -->
  <section style="background: var(--surface-base); padding: 1.25rem 0; border-bottom: 1px solid var(--border-hairline);">
    <div class="container">
      <div class="stories-track">
        {stories.map((story) => (
          <button
            type="button"
            class="story-item"
            data-filter={story.filter}
          >
            <div class="story-circle">
              <span style="font-size: 1.35rem;">{story.emoji}</span>
            </div>
            <span class="story-label">
              {story.name}
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Magazine Hero Section -->
  <section style="padding: 4rem 0 3rem 0; border-bottom: 1px solid var(--border-hairline); background: var(--surface-base);">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 2rem;">
        
        <div style="max-width: 700px;">
          <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1rem;">
            <div style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; border: 1.5px solid var(--border-hairline);">
              <img src="/img/the-garage-avatar.png" alt="Avatar The Garage" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div>
              <strong style="font-size: 0.95rem; display: block; letter-spacing: -0.01em;">@thegarage.pdc</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Comunidad Ciclista • Playa del Carmen</span>
            </div>
          </div>

          <h1 class="title-xl" style="margin-bottom: 0.85rem;">
            Comunidad, Rodadas &amp; Eventos en el Caribe.
          </h1>
          <p class="subtitle" style="font-size: 1.05rem; line-height: 1.6;">
            Salidas grupales sabatinas <strong>The Garage Ride</strong>, la carrera <strong>Clásica 7:30 XCO</strong>, distribución oficial de <strong>Basso Bikes</strong> y nutrición deportiva <strong>Wayfar</strong>.
          </p>
        </div>

        <a
          href="https://www.instagram.com/thegarage.pdc/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          style="background: linear-gradient(45deg, #F58529, #D62976, #962FBF, #4F5BD5); color: #FFFFFF; padding: 0.75rem 1.5rem; font-size: 0.88rem;"
        >
          Seguir @thegarage.pdc ↗
        </a>

      </div>
    </div>
  </section>

  <!-- Feed Section with Recent.design Style Grid -->
  <section style="padding: 3.5rem 0 6rem 0; background: var(--surface-subtle);">
    <div class="container">
      
      <!-- Filter Toolbar -->
      <div class="social-toolbar">
        <div class="social-pills" id="insta-filters">
          <button type="button" class="tab-pill active" data-tipo="todas">Todos ({posts.length})</button>
          <button type="button" class="tab-pill" data-tipo="rodada">🌴 Rodadas</button>
          <button type="button" class="tab-pill" data-tipo="evento">🏆 Eventos</button>
          <button type="button" class="tab-pill" data-tipo="arribo">🇮🇹 Basso</button>
          <button type="button" class="tab-pill" data-tipo="taller">🔧 Taller</button>
          <button type="button" class="tab-pill" data-tipo="lifestyle">⚡ Nutrición</button>
        </div>
      </div>

      <!-- Recent.design Style Media Grid -->
      <div class="media-grid">
        {posts.map((post) => (
          <article class="media-card" data-tipo={post.tipo}>
            <!-- Image Frame -->
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="media-frame"
              title="Abrir publicación en Instagram"
            >
              <img
                src={post.imagen}
                alt={post.titulo}
                loading="lazy"
              />
              <div class="media-tag">
                {post.badge}
              </div>
              <div class="media-hover">
                <span class="hover-btn">
                  Abrir en Instagram ↗
                </span>
              </div>
            </a>

            <!-- Clean Meta Row -->
            <div class="media-body">
              <div class="media-meta">
                <span class="category-chip">{post.emoji} {post.categoria}</span>
              </div>

              <h2 class="media-title">
                {post.titulo}
              </h2>

              <p class="media-desc">
                {post.descripcion}
              </p>

              <!-- Conversion Actions -->
              <div class="media-footer">
                <a
                  href={`https://wa.me/529841381493?text=Hola,%20vi%20la%20publicaci%C3%B3n%20sobre%20${encodeURIComponent(post.titulo)}%20(${post.permalink})%20y%20me%20gustar%C3%ADa%20m%C3%A1s%20informaci%C3%B3n.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-whatsapp"
                  style="flex: 1; padding: 0.55rem 0.9rem; font-size: 0.8rem;"
                >
                  Consultar WhatsApp
                </a>
                <a
                  href={post.permalink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline"
                  style="padding: 0.55rem 0.9rem; font-size: 0.8rem;"
                >
                  Post ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>
</Base>

<style>
  .stories-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .stories-track::-webkit-scrollbar {
    display: none;
  }

  .story-item {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 68px;
  }

  .story-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--surface-muted);
    border: 1px solid var(--border-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s var(--ease-spring), border-color 0.2s ease;
  }
  .story-item:hover .story-circle {
    transform: scale(1.08);
    border-color: var(--text-primary);
  }

  .story-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* Toolbar */
  .social-toolbar {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-hairline);
  }
  .social-pills {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .social-pills::-webkit-scrollbar {
    display: none;
  }

  .tab-pill {
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-hairline);
    background: #FFFFFF;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s var(--ease-spring);
  }
  .tab-pill:hover {
    border-color: var(--border-hairline-hover);
    color: var(--text-primary);
  }
  .tab-pill.active {
    background: var(--text-primary);
    color: #FFFFFF;
    border-color: var(--text-primary);
  }

  /* Media Grid */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .media-card {
    background: #FFFFFF;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-spring), border-color 0.25s ease;
  }
  .media-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--border-hairline-hover);
  }

  .media-frame {
    position: relative;
    aspect-ratio: 1/1;
    background: var(--surface-subtle);
    overflow: hidden;
    display: block;
  }
  .media-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }
  .media-card:hover .media-frame img {
    transform: scale(1.03);
  }

  .media-tag {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .media-hover {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .media-card:hover .media-hover {
    opacity: 1;
  }

  .hover-btn {
    background: #FFFFFF;
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  }

  .media-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .media-meta {
    margin-bottom: 0.4rem;
  }
  .category-chip {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .media-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .media-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .media-footer {
    margin-top: auto;
    display: flex;
    gap: 0.65rem;
  }
</style>

<script>
  function initRecentSocialFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('#insta-filters .tab-pill');
    const cards = document.querySelectorAll<HTMLElement>('.media-grid .media-card');
    const stories = document.querySelectorAll<HTMLButtonElement>('.story-item');

    function applyFilter(tipo: string) {
      tabs.forEach((t) => {
        if (t.getAttribute('data-tipo') === tipo) {
          t.classList.add('active');
        } else {
          t.classList.remove('active');
        }
      });

      cards.forEach((card) => {
        const cardTipo = card.getAttribute('data-tipo');
        if (tipo === 'todas' || cardTipo === tipo) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const tipo = tab.getAttribute('data-tipo') || 'todas';
        applyFilter(tipo);
      });
    });

    stories.forEach((story) => {
      story.addEventListener('click', () => {
        const filter = story.getAttribute('data-filter') || 'todas';
        applyFilter(filter);
        const grid = document.querySelector('.media-grid');
        if (grid) grid.scrollIntoView({ behavior: 'smooth' });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecentSocialFilters);
  } else {
    initRecentSocialFilters();
  }
</script>
