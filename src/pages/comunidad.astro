    shortcode: "DG6tjHqvTnn",
    categoria: "Equipamiento",
    tipo: "lifestyle",
    badge: "EQUIPAMIENTO",
    emoji: "👕",
    titulo: "Piel Oficial The Garage — Jerseys & Indumentaria",
