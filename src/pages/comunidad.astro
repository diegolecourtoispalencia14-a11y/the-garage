---
import Base from '../layouts/Base.astro';

const instagramPosts = [
  {
    id: 'the-garage-ride-group',
    categoria: 'Rodadas de Comunidad',
    tipo: 'rodada',
    tag: 'The Garage Ride',
    emoji: '🌴',
    titulo: 'The Garage Ride — Comunidad Ciclista de Playa del Carmen',
    descripcion: 'Nuestras rodadas de convivencia de fin de semana. Grupo mixto de ruta y MTB con salida desde la tienda, hidratación en ruta y soporte mecánico en todo el recorrido.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '284 likes',
    comentarios: '42 comentarios',
    badge: 'COMUNIDAD OFICIAL',
    imagen: '/img/instagram/real-the-garage-ride-group.webp',
