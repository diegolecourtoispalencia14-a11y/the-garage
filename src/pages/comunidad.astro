---
import Base from '../layouts/Base.astro';

const instagramPosts = [
  {
    id: 'merida-scultura-arribo',
    categoria: 'Bicicleta en Tienda',
    tipo: 'arribo',
    tag: 'Merida Bikes',
    emoji: '🚴',
    titulo: 'Merida Scultura 300 Shimano Tiagra 10 vel (Talla S/M)',
    descripcion: 'Recién llegada a piso de venta. Bicicleta de ruta con cuadro de aluminio ligero y horquilla de carbono FACT. Equipada con grupo completo Shimano Tiagra 2x10 vel. Calibrada y lista para rodar en la carretera.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '158 likes',
    comentarios: '22 comentarios',
    badge: 'DISPONIBLE EN TIENDA',
    imagen: '/img/bicis/merida-scultura-1.webp',
    specs: ['Shimano Tiagra 2x10 vel.', 'Horquilla Carbono', 'Talla S/M (52 cm)']
  },
  {
    id: 'oferta-relampago-vendida',
    categoria: 'Prueba Social & Ventas',
    tipo: 'entrega',
    tag: 'Oferta Relámpago',
    emoji: '⚡',
    titulo: 'Oferta Relámpago MTB R29 $7,900 — VENDIDA en 24 hrs',
    descripcion: '¡Se fue volando! Bicicleta de montaña R29 talla M con grupo Shimano 2x8 y frenos hidráulicos entregada a su nuevo dueño en Playa del Carmen con revisión mecánica completa.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '214 likes',
    comentarios: '34 comentarios',
    badge: '⚪ VENDIDA EN TIENDA',
    imagen: '/img/bicis/mtb-relampago-1.webp',
    specs: ['Precio $7,900 MXN', 'Rodada 29"', 'Shimano 2x8 + Hidráulicos']
  },
  {
    id: 'taller-inspeccion-real',
    categoria: 'Taller Especializado',
    tipo: 'taller',
    tag: 'Servicio Mecánico',
    emoji: '🔧',
    descripcion: 'Calibración milimétrica de pata de cambio, tensión de cadena y purga de frenos hidráulicos. Toda bicicleta sale de nuestro local en Cataluña probada al 100%.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '112 likes',
    comentarios: '14 comentarios',
    badge: 'SERVICIO DE TALLER',
    imagen: '/img/bicis/mtb-relampago-3.webp',
    specs: ['Calibración de Cambios', 'Purga Hidráulica', 'Ajuste de Torque']
  },
  {
    id: 'basso-palta-gravel',
    categoria: 'Distribuidor Oficial',
    tipo: 'arribo',
    tag: 'Basso Bikes Italia',
    emoji: '🇮🇹',
    titulo: 'Basso Palta Gravel — Ingeniería italiana en Playa del Carmen',
    descripcion: 'Orgullosos de ser distribuidores oficiales de Basso Bikes en Quintana Roo. Cuadro de carbono Torayca, absorción de vibraciones y geometría gravel para rodar asfalto y terracerías de la Riviera.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '142 likes',
    comentarios: '18 comentarios',
    badge: 'DISTRIBUIDOR OFICIAL',
    imagen: '/img/real/gravel-basso.jpg',
    specs: ['Carbono Torayca', 'Handmade in Italy', 'Gravel & All-Road']
  },
  {
    id: 'rodada-sabado-cenotes',
    categoria: 'Comunidad & Rodadas',
    tipo: 'rodada',
    tag: 'Rodada de Sábado',
    emoji: '🌴',
    titulo: 'Rodada dominical Playa - Puerto Aventuras (55 km)',
    descripcion: 'Más de 25 ciclistas en nuestra rodada de convivencia hacia la Ruta de los Cenotes. Ritmo controlado, hidratación Wayfar en ruta y convivencia al volver a The Garage.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '235 likes',
    comentarios: '31 comentarios',
    badge: 'RODADA COMUNITARIA',
    imagen: '/img/real/community-ride.jpg',
    specs: ['55 km Convivencia', 'PDC - Puerto Aventuras', 'Todos los niveles']
  },
  {
    id: 'taller-sram-axs',
    categoria: 'Taller Especializado',
    tipo: 'taller',
    tag: 'SRAM Transmission',
    emoji: '⚡',
    titulo: 'Instalación y Calibración SRAM Eagle AXS T-Type',
    descripcion: 'Transmisión inalámbrica de última generación. Cero cables, cambios instantáneos bajo carga máxima y durabilidad total en el clima húmedo de la costa.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '97 likes',
    comentarios: '12 comentarios',
    badge: 'SRAM PRO SHOP',
    imagen: '/img/real/workshop-sram.jpg',
    specs: ['SRAM AXS Wireless', 'Montaje Directo al Cuadro', 'Ajuste Electrónico']
  }
];
---

<Base
  title="Comunidad Ciclista & Instagram Live | The Garage Playa del Carmen"
  description="Extensión oficial del Instagram @thegarage.pdc. Distribuidores oficiales de Basso, Lee Cougan, taller SRAM y rodadas comunitarias en Playa del Carmen."
>
  <!-- Hero Section con Fotografías Reales de Tienda -->
  <section style="background: radial-gradient(circle at top right, #F1F5F9 0%, #FFFFFF 60%); border-bottom: 2px solid #0F172A; padding: 3.5rem 0 2.5rem 0;">
    <div class="container">
      <div style="max-width: 840px;">
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem;">
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FDF2F8; border: 1.5px solid #FCE7F3; color: #BE185D; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;"
          >
            📸 INSTAGRAM OFICIAL @THEGARAGE.PDC
          </a>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #0F172A; color: #FFFFFF; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">
            🇮🇹 BASSO & LEE COUGAN OFICIAL
          </div>
        </div>

        <h1 class="title-xl" style="margin-bottom: 1rem; color: #0F172A;">
          Comunidad, Taller & Pasión Ciclista en Playa del Carmen.
        </h1>
        <p class="subtitle" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 1.75rem;">
          En <strong>The Garage</strong> somos más que una tienda: somos el punto de encuentro de ciclistas en la Riviera Maya. Conoce las novedades de Basso y Lee Cougan, trabajos de taller y únete a nuestras rodadas semanales.
        </p>

        <!-- Social Proof Stats Bar -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.15rem; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.35rem;">🏆</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Distribuidor Autorizado</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Basso Bikes & Lee Cougan</span>
            </div>
          </div>
          <div style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.15rem; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.35rem;">🔧</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Taller Especializado</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Transmisiones SRAM AXS</span>
            </div>
          </div>
          <div style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem 1.15rem; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 1.35rem;">🌴</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Rodadas Semanales</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Cenotes, Tulum y Carretera</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Feed Social Interactivo de Instagram con Fotos Reales -->
  <section style="padding: 3rem 0 5rem 0;">
    <div class="container">
      
      <!-- Interactive Filter Tabs -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem;">
        <div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem;" id="insta-filters">
          <button type="button" class="insta-tab active" data-tipo="todas">Todas las Publicaciones</button>
          <button type="button" class="insta-tab" data-tipo="arribo">🚴 Nuevos Arribos</button>
          <button type="button" class="insta-tab" data-tipo="entrega">⚡ Ventas & Ofertas</button>
          <button type="button" class="insta-tab" data-tipo="taller">🔧 Taller Mecánico</button>
          <button type="button" class="insta-tab" data-tipo="rodada">🌴 Rodadas del Caribe</button>
        </div>

        <a
          href="https://www.instagram.com/thegarage.pdc/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          style="background: linear-gradient(45deg, #F58529, #D62976, #962FBF, #4F5BD5); color: #FFFFFF; padding: 0.6rem 1.25rem; font-size: 0.85rem;"
        >
          Seguir en Instagram ↗
        </a>
      </div>

      <!-- Instagram Posts Grid con Fotos Reales -->
      <div class="insta-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        {instagramPosts.map((post) => (
          <article
            class="insta-card"
            data-tipo={post.tipo}
            style="background: #FFFFFF; border: 1.5px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;"
          >
            <!-- Card Header: User & Tag -->
            <div style="padding: 0.9rem 1.25rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); background: #FAFAFA;">
              <div style="display: flex; align-items: center; gap: 0.65rem;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: #FFFFFF; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1.5px solid #E2E8F0;">
                  <img src="/img/the-garage-avatar.png" alt="Avatar The Garage" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <div>
                  <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">thegarage.pdc</strong>
                  <span style="font-size: 0.72rem; color: var(--text-muted);">{post.fecha}</span>
                </div>
              </div>
              <span class="badge" style="background: #F1F5F9; color: #475569; font-size: 0.7rem;">
                {post.emoji} {post.categoria}
              </span>
            </div>

            <!-- Card Media Container con Fotografía Real -->
            <div style="position: relative; aspect-ratio: 1/1; background: #F8FAFC; overflow: hidden;">
              <img
                src={post.imagen}
                alt={post.titulo}
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;"
                loading="lazy"
              />
              <div style="position: absolute; bottom: 0.85rem; left: 0.85rem;">
                <span class="badge" style="background: rgba(15, 23, 42, 0.85); color: #FFFFFF; font-size: 0.7rem; backdrop-filter: blur(4px);">
                  {post.badge}
                </span>
              </div>
            </div>

            <!-- Card Body & Text -->
            <div style="padding: 1.4rem; display: flex; flex-direction: column; flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; font-size: 0.8rem; color: #64748B; font-weight: 700;">
                <div style="display: flex; gap: 0.75rem;">
                  <span>❤️ {post.likes}</span>
                  <span>💬 {post.comentarios}</span>
                </div>
                <span>Playa del Carmen</span>
              </div>

              <h2 class="title-md" style="margin-bottom: 0.5rem; color: var(--secondary); font-size: 1.1rem; line-height: 1.3;">
                {post.titulo}
              </h2>

              <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin-bottom: 1.25rem;">
                {post.descripcion}
              </p>

              <!-- Specs pills -->
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem;">
                {post.specs.map((spec) => (
                  <span style="font-size: 0.72rem; background: #F1F5F9; color: #334155; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700;">
                    ✓ {spec}
                  </span>
                ))}
              </div>

              <!-- Action Bottom -->
              <div style="margin-top: auto; padding-top: 0.85rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <a
                  href={`https://wa.me/529841381493?text=Hola,%20vi%20la%20publicaci%C3%B3n%20de%20Instagram%20sobre%20${encodeURIComponent(post.titulo)}%20y%20me%20gustar%C3%ADa%20m%C3%A1s%20informaci%C3%B3n.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-whatsapp"
                  style="padding: 0.45rem 0.9rem; font-size: 0.8rem;"
                >
                  Consultar por WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/thegarage.pdc/"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-size: 0.8rem; font-weight: 800; color: #E1306C;"
                >
                  Ver en IG ↗
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Riders Club Banner -->
      <div style="margin-top: 4.5rem; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; border-radius: var(--radius-xl); padding: 3.5rem 2.5rem; box-shadow: var(--shadow-xl); border: 2px solid #334155;">
        <div style="max-width: 780px; margin-bottom: 2rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255,87,34,0.2); border: 1px solid #FF5722; color: #FF7043; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 1rem;">
            🚴 THE GARAGE RIDERS CLUB
          </div>
          <h2 class="title-lg" style="color: #FFFFFF; margin-bottom: 0.75rem;">
            Beneficios exclusivos para ciclistas de The Garage:
          </h2>
          <p style="color: #CBD5E1; font-size: 1rem; line-height: 1.6;">
            Al adquirir tu bicicleta o realizar servicios en nuestro taller, formas parte de nuestra comunidad ciclista:
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">🔧</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">1er Mantenimiento Gratis</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Reajuste de chicotes, cadena y tornillería a los primeros 30 días de rodar.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">💬</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">Comunidad VIP WhatsApp</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Avisos de rodadas sabatinas, rutas seguras y clínicas mecánicas gratuitas.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">⚡</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">Descuento en Wayfar & SRAM</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Precios especiales en hidratación, refacciones originales y upgrades.</p>
          </div>
          <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid #334155;">
            <div style="font-size: 1.75rem; margin-bottom: 0.4rem;">🤝</div>
            <strong style="color: #FFFFFF; font-size: 0.95rem; display: block;">Garantía y Respaldo</strong>
            <p style="color: #94A3B8; font-size: 0.8rem; margin-top: 0.25rem;">Gestión directa de garantías de cuadro y componentes en nuestro taller.</p>
          </div>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;">
          <a
            href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20unirme%20a%20la%20comunidad%20de%20rodadas%20y%20conocer%20The%20Garage%20Riders."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-lg"
          >
            Unirme al Grupo de Rodadas en WhatsApp
          </a>
          <a
            href="/"
            class="btn btn-outline"
            style="color: #0F172A; background: #FFFFFF; font-weight: 800;"
          >
            Ver Catálogo de Bicicletas →
          </a>
        </div>
      </div>

    </div>
  </section>
</Base>

<style>
  .insta-tab {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--border);
    background: #F8FAFC;
    color: #334155;
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .insta-tab.active {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
  }
  .insta-card {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .insta-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .insta-card:hover img {
    transform: scale(1.03);
  }
</style>

<script>
  function initInstaFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('#insta-filters .insta-tab');
    const cards = document.querySelectorAll<HTMLElement>('.insta-grid .insta-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        const tipo = tab.getAttribute('data-tipo') || 'todas';

        cards.forEach((card) => {
          const cardTipo = card.getAttribute('data-tipo');
          if (tipo === 'todas' || cardTipo === tipo) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstaFilters);
  } else {
    initInstaFilters();
  }
</script>
