    categoria: 'Comunidad & Equipo',
    tipo: 'lifestyle',
    tag: 'Jersey Oficial',
    emoji: '👕',
    titulo: 'Piel Oficial The Garage — Jerseys y Equipamiento',
    descripcion: 'Diseñado para el calor y humedad de Quintana Roo. Telas de secado rápido, corte aerodinámico y los colores que nos representan en cada carretera y sendero.',
    fecha: 'Publicado en @thegarage.pdc',
    likes: '219 likes',
    comentarios: '28 comentarios',
    badge: 'EQUIPAMIENTO OFICIAL',
    imagen: '/img/instagram/real-the-garage-jersey-rider.webp',
