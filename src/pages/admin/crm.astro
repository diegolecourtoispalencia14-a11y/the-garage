---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Panel CRM & Prospectos | The Garage Bike Experts"
  description="Gestor de prospectos y recontactación para The Garage Bike Experts."
>
  <div class="crm-page-wrapper">
    <div class="container-fluid">

      <!-- PIN Protection Modal Overlay -->
      <div id="pin-lock-overlay" class="lock-modal-overlay">
        <div class="lock-card font-mono">
          <span class="lock-badge">[ACCESO RESTRINGIDO // TALLER]</span>
          <h2 class="lock-title">Panel CRM The Garage</h2>
          <p class="lock-desc">Ingresa el PIN de administrador para consultar la base de datos de clientes:</p>
          
          <form id="pin-form" onsubmit="event.preventDefault(); window.tryUnlock();">
            <input
              type="password"
              id="admin-pin-input"
              class="pin-input font-mono"
              maxlength="4"
              inputmode="numeric"
              pattern="[0-9]*"
              placeholder="••••"
              autofocus
            />
            <button type="submit" id="btn-unlock-crm" class="btn btn-primary pin-submit-btn">
              <span>Desbloquear CRM ↗</span>
            </button>
          </form>

          <p id="pin-error-msg" class="pin-error" style="display: none;">
            PIN incorrecto. (PIN por defecto: 1493)
          </p>
          <p class="pin-hint">PIN inicial de tienda: <strong>1493</strong></p>
        </div>
      </div>

      <!-- Main CRM Application (Shown upon unlock) -->
      <div id="crm-main-app" class="crm-content-view" style="display: none;">
        
        <!-- Header -->
        <header class="crm-top-bar">
          <div>
            <div class="crm-badge-row font-mono">
              <span class="badge-red">[PANEL PRIVADO]</span>
              <span class="badge-dim">RECONTACTACIÓN &amp; PROSPECTOS LFPDPPP</span>
            </div>
            <h1 class="title-xl" style="margin-top: 0.25rem;">The Garage • Lead CRM</h1>
          </div>

          <div class="crm-top-actions font-mono">
            <button type="button" id="btn-export-csv" class="btn btn-outline">
              <span>Descargar CSV / Excel</span>
            </button>
            <a href="/" class="btn btn-primary">
              <span>Tienda en Vivo ↗</span>
            </a>
          </div>
        </header>

        <!-- KPI Metrics Grid -->
        <section class="kpi-cards-grid font-mono">
          <div class="kpi-box">
            <span class="kpi-label">[TOTAL PROSPECTOS]</span>
            <div class="kpi-number" id="metric-total">0</div>
            <span class="kpi-note">Consentimiento registrado</span>
          </div>
          <div class="kpi-box">
            <span class="kpi-label">[DISCIPLINA TOP]</span>
            <div class="kpi-number" id="metric-top-discipline" style="font-size: 1.4rem;">Gravel / Ruta</div>
            <span class="kpi-note">Mayor interés en tienda</span>
          </div>
          <div class="kpi-box">
            <span class="kpi-label">[CANAL WHATSAPP]</span>
            <div class="kpi-number" id="metric-wa-rate">85%</div>
            <span class="kpi-note">Canal prioritario</span>
          </div>
          <div class="kpi-box">
            <span class="kpi-label">[TIEMPO DE RESPUESTA]</span>
            <div class="kpi-number" style="color: #4ADE80;">&lt; 15 min</div>
            <span class="kpi-note">Estándar Concierge</span>
          </div>
        </section>

        <!-- Search & Filter Controls -->
        <section class="crm-controls-panel font-mono">
          <div class="filter-inputs-group">
            <input
              type="text"
              id="crm-search"
              placeholder="Buscar por teléfono, correo, bici o talla..."
              class="crm-search-box"
            />
            <select id="crm-filter-category" class="crm-select-box">
              <option value="ALL">Todas las Categorías</option>
              <option value="Gravel">Gravel &amp; Aventura</option>
              <option value="Ruta">Ruta &amp; Asfalto</option>
              <option value="MTB">MTB &amp; Senderos</option>
            </select>
            <select id="crm-filter-status" class="crm-select-box">
              <option value="ALL">Todos los Estados</option>
              <option value="Nuevo">Nuevo</option>
              <option value="Contactado">Contactado</option>
              <option value="Cita Agendada">Cita Agendada</option>
              <option value="Apartada">Apartada / Vendida</option>
            </select>
          </div>

          <button type="button" id="btn-clear-demo" class="btn btn-outline" style="font-size: 0.75rem;">
            Restablecer Demo ↻
          </button>
        </section>

        <!-- Leads Table -->
        <section class="crm-table-container font-mono">
          <table class="crm-table">
            <thead>
              <tr>
                <th>FECHA &amp; 1RA VISITA</th>
                <th>CONTACTO</th>
                <th>DISCIPLINA // TALLA</th>
                <th>BICICLETA CONSULTADA</th>
                <th>ESTADO</th>
                <th>ACCIÓN CONCIERGE</th>
              </tr>
            </thead>
            <tbody id="leads-tbody">
              <!-- Rendered dynamically -->
            </tbody>
          </table>
        </section>

      </div>

    </div>
  </div>
</Base>

<style>
  .crm-page-wrapper {
    padding: var(--space-6) 0 var(--space-9) 0;
    min-height: 80vh;
  }

  /* Lock Modal */
  .lock-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(9, 9, 11, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: var(--space-4);
  }

  .lock-card {
    background: var(--surface-card);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3rem);
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
  }

  .lock-badge {
    font-size: 0.72rem;
    color: #FB7185;
    font-weight: 800;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .lock-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .lock-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .pin-input {
    width: 100%;
    background: #09090B;
    border: 1px solid var(--border-hairline);
    color: #FFFFFF;
    font-size: 1.75rem;
    letter-spacing: 0.4em;
    text-align: center;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .pin-input:focus {
    border-color: #E11D48;
  }

  .pin-submit-btn {
    width: 100%;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.85rem;
  }

  .pin-error {
    color: #FB7185;
    font-size: 0.75rem;
    margin-top: 0.75rem;
  }

  .pin-hint {
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-top: 1rem;
  }

  /* Main CRM View */
  .crm-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-6);
  }

  .crm-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.72rem;
  }
  .badge-red {
    color: #FB7185;
    font-weight: 800;
  }
  .badge-dim {
    color: var(--text-muted);
  }

  .crm-top-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* KPI Grid */
  .kpi-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .kpi-box {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .kpi-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-bottom: 0.25rem;
  }

  .kpi-number {
    font-size: 1.8rem;
    font-weight: 900;
    color: #FFFFFF;
  }

  .kpi-note {
    font-size: 0.72rem;
    color: #4ADE80;
    margin-top: 0.25rem;
  }

  /* Controls Panel */
  .crm-controls-panel {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .filter-inputs-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .crm-search-box {
    background: #09090B;
    border: 1px solid var(--border-hairline);
    color: #FFFFFF;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    min-width: 240px;
    outline: none;
  }
  .crm-search-box:focus {
    border-color: #E11D48;
  }

  .crm-select-box {
    background: #09090B;
    border: 1px solid var(--border-hairline);
    color: #FFFFFF;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    outline: none;
    cursor: pointer;
  }

  /* Table */
  .crm-table-container {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .crm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    text-align: left;
  }

  .crm-table th {
    background: var(--surface-subtle);
    color: var(--text-dim);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-hairline);
  }

  .crm-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .crm-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .status-pill {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .status-nuevo {
    background: rgba(225, 29, 72, 0.15);
    color: #FB7185;
    border: 1px solid rgba(225, 29, 72, 0.35);
  }
  .status-contactado {
    background: rgba(56, 189, 248, 0.15);
    color: #38BDF8;
    border: 1px solid rgba(56, 189, 248, 0.35);
  }
  .status-cita {
    background: rgba(250, 204, 21, 0.15);
    color: #FACC15;
    border: 1px solid rgba(250, 204, 21, 0.35);
  }
  .status-apartada {
    background: rgba(34, 197, 94, 0.15);
    color: #4ADE80;
    border: 1px solid rgba(34, 197, 94, 0.35);
  }
</style>

<script is:inline>
  (function() {
    var DEFAULT_PIN = "1493";

    var initialLeads = [
      {
        id: "lead-1",
        contact: "+52 984 112 3456",
        channel: "whatsapp",
        terrain: "Gravel",
        size: "M (52-54 cm)",
        model: "Basso Bikes Italia Tera Gravel / Palta",
        status: "Nuevo",
        first_visit: new Date(Date.now() - 3600000 * 2).toISOString(),
        captured_at: new Date(Date.now() - 3600000 * 2).toISOString()
      },
      {
        id: "lead-2",
        contact: "carlos.ciclista@gmail.com",
        channel: "email",
        terrain: "Ruta",
        size: "S/M (52 cm)",
        model: "Merida Scultura 300 Shimano Tiagra",
        status: "Contactado",
        first_visit: new Date(Date.now() - 3600000 * 24).toISOString(),
        captured_at: new Date(Date.now() - 3600000 * 24).toISOString()
      },
      {
        id: "lead-3",
        contact: "+52 984 876 5432",
        channel: "whatsapp",
        terrain: "MTB",
        size: "L (19\")",
        model: "Oferta Relámpago MTB R29 Shimano",
        status: "Cita Agendada",
        first_visit: new Date(Date.now() - 3600000 * 48).toISOString(),
        captured_at: new Date(Date.now() - 3600000 * 48).toISOString()
      }
    ];

    function getStoredLeads() {
      var local = localStorage.getItem('the_garage_leads');
      if (!local) {
        localStorage.setItem('the_garage_leads', JSON.stringify(initialLeads));
        return initialLeads;
      }
      try {
        var parsed = JSON.parse(local);
        return parsed.length > 0 ? parsed : initialLeads;
      } catch(e) {
        return initialLeads;
      }
    }

    function renderCRM() {
      var leads = getStoredLeads();
      var tbody = document.getElementById('leads-tbody');
      var searchInput = document.getElementById('crm-search');
      var catSelect = document.getElementById('crm-filter-category');
      var statusSelect = document.getElementById('crm-filter-status');

      var searchVal = (searchInput && searchInput.value) ? searchInput.value.toLowerCase() : '';
      var catFilter = (catSelect && catSelect.value) ? catSelect.value : 'ALL';
      var statusFilter = (statusSelect && statusSelect.value) ? statusSelect.value : 'ALL';

      var filtered = leads.filter(function(l) {
        var contactStr = (l.contact || '').toLowerCase();
        var modelStr = (l.model || l.model_matched || '').toLowerCase();
        var sizeStr = (l.size || l.user_size || '').toLowerCase();
        var terrainStr = l.terrain || l.terrain_interest || '';
        var statusStr = l.status || 'Nuevo';

        var matchesSearch = contactStr.indexOf(searchVal) !== -1 ||
                            modelStr.indexOf(searchVal) !== -1 ||
                            sizeStr.indexOf(searchVal) !== -1;
        var matchesCat = catFilter === 'ALL' || terrainStr === catFilter;
        var matchesStatus = statusFilter === 'ALL' || statusStr === statusFilter;
        return matchesSearch && matchesCat && matchesStatus;
      });

      var totalMetric = document.getElementById('metric-total');
      if (totalMetric) totalMetric.textContent = leads.length.toString();

      if (tbody) {
        tbody.innerHTML = filtered.map(function(lead) {
          var rawContact = lead.contact || '';
          var isWA = lead.channel === 'whatsapp' || rawContact.indexOf('@') === -1;
          var cleanPhone = rawContact.replace(/\D/g, '');
          var modelName = lead.model || lead.model_matched || 'Bicicleta Consultada';
          var userSize = lead.size || lead.user_size || 'M';
          var status = lead.status || 'Nuevo';
          var dateObj = new Date(lead.captured_at || Date.now());
          var dateStr = dateObj.toLocaleDateString('es-MX', {
            month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
          });

          var waMessage = "Hola! Te escribimos de The Garage Bike Experts en Cataluña. Vimos que en tu visita te interesó la " + modelName + " (Talla " + userSize + "). ¿Te gustaría agendar una prueba de manejo o apartado?";
          var phoneFormatted = cleanPhone.length === 10 ? '52' + cleanPhone : cleanPhone;
          var waUrl = "https://wa.me/" + phoneFormatted + "?text=" + encodeURIComponent(waMessage);

          var statusClass = 'status-nuevo';
          if (status === 'Contactado') statusClass = 'status-contactado';
          if (status === 'Cita Agendada') statusClass = 'status-cita';
          if (status === 'Apartada') statusClass = 'status-apartada';

          var actionHtml = isWA ?
            '<a href="' + waUrl + '" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" style="padding: 4px 10px; font-size: 0.72rem;"><span>💬 WhatsApp</span></a>' :
            '<a href="mailto:' + rawContact + '?subject=Tu Ficha Tecnica The Garage" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.72rem;"><span>✉️ Correo</span></a>';

          return '<tr>' +
            '<td class="font-mono text-xs">' +
              '<div>' + dateStr + '</div>' +
              '<div style="color: var(--text-dim); font-size: 0.68rem;">1ra Visita Trackeada</div>' +
            '</td>' +
            '<td class="font-mono font-bold" style="color: #FFFFFF;">' +
              rawContact +
              '<div style="font-size: 0.7rem; color: var(--text-dim); font-weight: normal;">Canal: ' + (isWA ? 'WhatsApp' : 'Email') + '</div>' +
            '</td>' +
            '<td class="font-mono">' +
              '<span style="color: #FB7185; font-weight: 700;">' + (lead.terrain || lead.terrain_interest || 'Gravel') + '</span>' +
              '<div style="font-size: 0.72rem; color: var(--text-dim);">Talla: ' + userSize + '</div>' +
            '</td>' +
            '<td>' +
              '<strong style="color: var(--text-primary);">' + modelName + '</strong>' +
            '</td>' +
            '<td>' +
              '<span class="status-pill ' + statusClass + '">' + status + '</span>' +
            '</td>' +
            '<td>' + actionHtml + '</td>' +
          '</tr>';
        }).join('');
      }
    }

    window.tryUnlock = function() {
      var pinInput = document.getElementById('admin-pin-input');
      var pinOverlay = document.getElementById('pin-lock-overlay');
      var crmApp = document.getElementById('crm-main-app');
      var pinError = document.getElementById('pin-error-msg');

      var val = pinInput ? pinInput.value.trim() : '';
      if (val === DEFAULT_PIN || sessionStorage.getItem('crm_unlocked') === 'true') {
        sessionStorage.setItem('crm_unlocked', 'true');
        if (pinOverlay) pinOverlay.style.display = 'none';
        if (crmApp) crmApp.style.display = 'block';
        renderCRM();
      } else {
        if (pinError) pinError.style.display = 'block';
        if (pinInput) pinInput.value = '';
      }
    };

    // Auto-unlock on 4 digits typed
    var pinField = document.getElementById('admin-pin-input');
    pinField?.addEventListener('input', function() {
      if (pinField.value.length === 4) {
        window.tryUnlock();
      }
    });

    if (sessionStorage.getItem('crm_unlocked') === 'true') {
      window.tryUnlock();
    }

    // Filter events
    document.getElementById('crm-search')?.addEventListener('input', renderCRM);
    document.getElementById('crm-filter-category')?.addEventListener('change', renderCRM);
    document.getElementById('crm-filter-status')?.addEventListener('change', renderCRM);

    // Reset Demo
    document.getElementById('btn-clear-demo')?.addEventListener('click', function() {
      if (confirm('¿Restablecer datos demo del CRM?')) {
        localStorage.setItem('the_garage_leads', JSON.stringify(initialLeads));
        renderCRM();
      }
    });

    // Export CSV
    document.getElementById('btn-export-csv')?.addEventListener('click', function() {
      var leads = getStoredLeads();
      var headers = ["ID", "Fecha_Captura", "Contacto", "Canal", "Terreno", "Talla", "Modelo_Match", "Estado"];
      var rows = leads.map(function(l) {
        return [
          l.id || "lead",
          l.captured_at || new Date().toISOString(),
          '"' + (l.contact || '') + '"',
          l.channel || 'whatsapp',
          l.terrain || l.terrain_interest || '',
          l.size || l.user_size || '',
          '"' + (l.model || l.model_matched || '') + '"',
          l.status || 'Nuevo'
        ];
      });

      var csvContent = "data:text/csv;charset=utf-8," + [headers.join(",")].concat(rows.map(function(e) { return e.join(","); })).join("\n");
      var encodedUri = encodeURI(csvContent);
      var link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", "the_garage_leads_" + new Date().toISOString().slice(0, 10) + ".csv");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

  })();
</script>
