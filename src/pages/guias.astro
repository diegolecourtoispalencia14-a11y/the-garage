---
import Base from '../layouts/Base.astro';

const guias = [
  {
    slug: "salitre-humedad-caribe",
    categoria: "Taller & Cirugía",
    tag: "01 // TALLER & CIRUGÍA",
    tagColor: "#FB7185",
    tiempoLectura: "6 min",
    titulo: "Cómo Proteger tu Bicicleta del Salitre y la Humedad Tropical",
    resumen: "Corrosión galvánica, la trampa del lavado a presión en rodamientos sellados y selección de lubricantes hidrofóbicos para el clima costero de Quintana Roo.",
    destacado: "Regla de taller: Lubricación de base húmeda o ceras cerámicas.",
    url: "/guia/salitre-humedad-caribe"
  },
  {
    slug: "rutas-ciclistas-riviera-maya",
    categoria: "Rutas & Expedición",
    tag: "02 // RUTAS & EXPEDICIÓN",
    tagColor: "#38BDF8",
    tiempoLectura: "8 min",
    titulo: "Las 4 Mejores Rutas Ciclistas de MTB, Ruta y Gravel en la Riviera Maya",
    resumen: "Circuitos de asfalto hacia Puerto Aventuras, singletracks técnicos en Punta Venado, logística del ferry a Cozumel y la Ruta de los Cenotes.",
    destacado: "Análisis de acotamiento seguro, presiones tubeless y viento costero.",
    url: "/guia/rutas-ciclistas-riviera-maya"
  },
  {
    slug: "hidratacion-termorregulacion-wayfar",
    categoria: "Nutrición & Wayfar",
    tag: "03 // NUTRICIÓN & RENDIMIENTO",
    tagColor: "#4ADE80",
    tiempoLectura: "5 min",
    titulo: "Estrategia de Hidratación y Termorregulación para Rodar bajo 35°C",
    resumen: "Fisiología del sudor bajo 80% de humedad relativa, prevención de hiponatremia y el protocolo de reposición de electrolitos de Wayfar.",
    destacado: "Protocolo clínico: 500-750ml con sodio y carbohidratos por hora.",
    url: "/guia/hidratacion-termorregulacion-wayfar"
  }
];
---

<Base
  title="Guías Técnicas & Rutas Ciclistas | The Garage Playa del Carmen"
  description="Manuales técnicos redactados por mecánicos certificados en Playa del Carmen: protección anti-salitre, las mejores rutas de la Riviera Maya y nutrición Wayfar."
>
  <div class="guias-directory-wrap">
    <div class="container-fluid">

      <!-- Header Section -->
      <section class="directory-header-section">
        <div class="directory-badges font-mono">
          <span class="badge-red">[05 // CONOCIMIENTO TÉCNICO]</span>
          <span class="badge-dim">CONOCIMIENTO DE TALLER &amp; EXPEDICIÓN</span>
        </div>
        <h1 class="title-xl" style="margin-bottom: 0.75rem;">
          Guías Técnicas &amp; Rutas para Rodar.
        </h1>
        <p class="subtitle" style="max-width: 760px;">
          Manuales de ingeniería, rutas locales y protocolos de hidratación redactados por el equipo técnico de The Garage para rodar con seguridad en el Caribe.
        </p>
      </section>

      <!-- Minimalist Cards Grid -->
      <section class="directory-grid-section">
        <div class="directory-cards-grid">
          {guias.map((item) => (
            <article class="directory-card-tile">
              <div>
                <div class="card-meta-row font-mono">
                  <span class="card-tag" style={`color: ${item.tagColor};`}>{item.tag}</span>
                  <span class="card-time">{item.tiempoLectura}</span>
                </div>

                <h2 class="card-title">
                  <a href={item.url}>{item.titulo}</a>
                </h2>

                <p class="card-summary">{item.resumen}</p>

                <div class="card-key-takeaway font-mono">
                  <span style="color: var(--text-muted);">Clave:</span> {item.destacado}
                </div>
              </div>

              <div class="card-footer-action">
                <a href={item.url} class="btn btn-outline card-read-btn">
                  <span>Leer Manual Completo →</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Community Banner -->
      <section class="directory-bottom-banner">
        <div class="banner-content-wrap">
          <span class="font-mono text-xs text-rose-400 font-bold uppercase tracking-wider block mb-2">
            [THE GARAGE RIDERS CLUB]
          </span>
          <h2 class="title-lg" style="color: #FFFFFF; margin-bottom: 0.5rem;">
            Aprende en la teoría. Rueda en la práctica.
          </h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; max-width: 620px;">
            Únete a nuestras rodadas sabatinas gratuitas y aplica estas técnicas en pelotón con asistencia mecánica y barredora en ruta.
          </p>
        </div>

        <a
          href="https://wa.me/529841381493?text=Hola,%20quiero%20unirme%20a%20The%20Garage%20Ride."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          Unirme a las Rodadas Sabatinas
        </a>
      </section>

    </div>
  </div>
</Base>

<style>
  .guias-directory-wrap {
    padding: var(--space-6) 0 var(--space-9) 0;
  }

  .directory-header-section {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-7);
  }

  .directory-badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 0.72rem;
  }
  .badge-red {
    color: #FB7185;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .badge-dim {
    color: var(--text-muted);
  }

  .directory-grid-section {
    margin-bottom: var(--space-8);
  }

  .directory-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .directory-card-tile {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 3.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s var(--ease-spring), border-color 0.25s ease, box-shadow 0.25s var(--ease-spring);
  }
  .directory-card-tile:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 16px 40px -12px rgba(225, 29, 72, 0.15);
  }

  .card-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    margin-bottom: var(--space-3);
  }
  .card-tag {
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .card-time {
    color: var(--text-muted);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }
  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-title a:hover {
    color: #FB7185;
  }

  .card-summary {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  .card-key-takeaway {
    background: var(--surface-subtle);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-size: 0.78rem;
    color: var(--text-primary);
    line-height: 1.5;
    margin-bottom: var(--space-5);
  }

  .card-footer-action {
    margin-top: auto;
  }
  .card-read-btn {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
  }

  .directory-bottom-banner {
    background: linear-gradient(135deg, #18181C 0%, #101013 100%);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
</style>
