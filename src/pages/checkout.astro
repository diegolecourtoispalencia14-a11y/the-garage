---
import Base from '../layouts/Base.astro';
---
<Base title="Checkout | The Garage Bike Experts">
  <div style="max-width:960px; margin:0 auto; padding:2rem 1rem 4rem; font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text',sans-serif;">

    <div style="margin-bottom:2rem;">
      <a href="/inventario" style="color:#86868b; font-size:0.88rem; text-decoration:none;">← Seguir comprando</a>
      <h1 style="font-size:2rem; font-weight:700; margin:0.5rem 0 0; letter-spacing:-0.03em;">Finalizar Compra</h1>
    </div>

    <div style="display:grid; grid-template-columns:1fr 380px; gap:2rem; align-items:start;">

      <!-- Left: Delivery Info -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">

        <!-- Order Summary (mobile-first) -->
        <div class="checkout-card" id="order-summary-mobile">
          <h3 class="section-title">Resumen del Pedido</h3>
          <div id="co-items-mobile"></div>
          <div id="co-totals-mobile" class="totals-block"></div>
        </div>

        <!-- Delivery Method -->
        <div class="checkout-card">
          <h3 class="section-title">¿Cómo quieres recibir tu pedido?</h3>
          <div class="delivery-options">
            <label class="delivery-option active" id="opt-didi">
              <input type="radio" name="delivery" value="didi" checked style="display:none;" />
              <div class="delivery-icon-svg" style="width:36px; height:36px; border-radius:10px; background:rgba(0,113,227,0.12); color:#0071e3; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/><path d="M8 14h5"/></svg>
              </div>
              <div>
                <strong>Envío a domicilio (Didi Moto)</strong>
                <p style="margin:0.2rem 0 0; font-size:0.82rem; color:#86868b;">Entrega en 30–60 min en Playa del Carmen. <span id="shipping-label" style="color:#34c759; font-weight:700;">Gratis en este pedido</span></p>
              </div>
            </label>
            <label class="delivery-option" id="opt-tienda">
              <input type="radio" name="delivery" value="tienda" style="display:none;" />
              <div class="delivery-icon-svg" style="width:36px; height:36px; border-radius:10px; background:rgba(52,199,89,0.12); color:#34c759; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 10V7"/></svg>
              </div>
              <div>
                <strong>Recoger en Tienda (Gratis)</strong>
                <p style="margin:0.2rem 0 0; font-size:0.82rem; color:#86868b;">Av. Ich Xeel, Cataluña, Playa del Carmen (Taller a Puerta Cerrada · Atención con Cita Previa). Lun–Sáb 10am–7pm.</p>
              </div>
            </label>
          </div>
        </div>

        <!-- Contact + Address -->
        <div class="checkout-card">
          <h3 class="section-title">Datos de Contacto y Entrega</h3>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
            <div class="form-group" style="grid-column:span 2;">
              <label>Nombre completo</label>
              <input type="text" id="f-name" placeholder="Tu nombre completo" required />
            </div>
            <div class="form-group">
              <label>Teléfono (10 dígitos)</label>
              <input type="tel" id="f-phone" placeholder="9841234567" maxlength="10" required />
            </div>
            <div class="form-group">
              <label>Email (opcional)</label>
              <input type="email" id="f-email" placeholder="tu@email.com" />
            </div>
            <div id="address-section" style="grid-column:span 2; display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
              <div class="form-group" style="grid-column:span 2;">
                <label>Dirección</label>
                <input type="text" id="f-address" placeholder="Calle, número, entre calles" />
              </div>
              <div class="form-group">
                <label>Colonia / Fraccionamiento</label>
                <input type="text" id="f-colonia" placeholder="Ej: Centro, Ejidal" />
              </div>
              <div class="form-group">
                <label>Referencia</label>
                <input type="text" id="f-reference" placeholder="Ej: Casa azul, portón negro" />
              </div>
            </div>
            <div class="form-group" style="grid-column:span 2;">
              <label>Notas adicionales (opcional)</label>
              <input type="text" id="f-notes" placeholder="Horario preferido de entrega, instrucciones especiales..." />
            </div>

            <!-- Honeypot anti-bot protection (invisible to legitimate users) -->
            <div style="opacity:0; position:absolute; top:0; left:-9000px; height:0; width:0; z-index:-1;" aria-hidden="true">
              <input type="text" id="f-company-tax-hp" tabindex="-1" autocomplete="off" />
            </div>
          </div>
        </div>

        <!-- Payment Method -->
        <div class="checkout-card">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
            <h3 class="section-title" style="margin:0;">Método de Pago</h3>
            <span id="checkout-mode-badge" style="display:inline-flex; align-items:center; gap:0.4rem; padding:0.25rem 0.75rem; border-radius:100px; font-size:0.75rem; font-weight:700; background:rgba(255,149,0,0.12); color:#ff9500; border:1px solid rgba(255,149,0,0.25);">
              <span style="width:7px; height:7px; border-radius:50%; background:#ff9500;"></span>
              <span id="checkout-mode-text">Modo Pruebas (Sandbox)</span>
            </span>
          </div>
          <div style="background:rgba(0,113,227,0.06); border:1px solid rgba(0,113,227,0.2); border-radius:14px; padding:1.25rem; display:flex; gap:1rem; align-items:flex-start; margin-bottom:1rem;">
            <div style="width:38px; height:38px; border-radius:10px; background:rgba(0,113,227,0.15); color:#0071e3; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            </div>
            <div>
              <strong style="color:#f5f5f7;">MercadoPago — Pago Seguro</strong>
              <p style="margin:0.2rem 0 0; font-size:0.82rem; color:#86868b;" id="checkout-desc">Tarjeta de crédito/débito, transferencia SPEI o pago en OXXO. Tu información está encriptada y protegida.</p>
              <div style="display:flex; gap:0.5rem; margin-top:0.5rem; flex-wrap:wrap;">
                <span style="background:rgba(255,255,255,0.06); border-radius:6px; padding:0.15rem 0.5rem; font-size:0.72rem; color:#86868b;">VISA</span>
                <span style="background:rgba(255,255,255,0.06); border-radius:6px; padding:0.15rem 0.5rem; font-size:0.72rem; color:#86868b;">Mastercard</span>
                <span style="background:rgba(255,255,255,0.06); border-radius:6px; padding:0.15rem 0.5rem; font-size:0.72rem; color:#86868b;">SPEI</span>
                <span style="background:rgba(255,255,255,0.06); border-radius:6px; padding:0.15rem 0.5rem; font-size:0.72rem; color:#86868b;">OXXO</span>
                <span style="background:rgba(255,255,255,0.06); border-radius:6px; padding:0.15rem 0.5rem; font-size:0.72rem; color:#86868b;">Meses sin intereses</span>
              </div>
            </div>
          </div>
          <p style="font-size:0.8rem; color:#86868b; margin:0;" id="checkout-footer-hint">Al continuar, serás redirigido de forma segura al checkout de MercadoPago para completar tu pago.</p>
        </div>

        <button id="btn-pay" onclick="processCheckout()" style="
          width:100%; padding:1.1rem;
          background:#0071e3; color:white;
          border:none; border-radius:100px;
          font-weight:700; font-size:1.05rem;
          cursor:pointer; transition:background 0.2s;
          display:flex; align-items:center; justify-content:center; gap:0.5rem;
        ">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Continuar con MercadoPago
        </button>
        <p id="pay-error" style="color:#ff3b30; font-size:0.85rem; text-align:center; display:none; margin:0;"></p>

      </div>

      <!-- Right: Order Summary (desktop) -->
      <div class="checkout-card" id="order-summary-desktop" style="position:sticky; top:2rem;">
        <h3 class="section-title">Tu Pedido</h3>
        <div id="co-items-desktop" style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1rem;"></div>
        <div id="co-totals-desktop" class="totals-block"></div>
      </div>

    </div>
  </div>
</Base>

<style>
  .checkout-card {
    background: #1c1c1e;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    padding: 1.5rem;
  }
  .section-title {
    font-size: 1rem; font-weight: 700; color: #f5f5f7;
    margin: 0 0 1rem;
  }
  .delivery-options { display: flex; flex-direction: column; gap: 0.75rem; }
  .delivery-option {
    display: flex; align-items: flex-start; gap: 1rem;
    padding: 1rem; border-radius: 12px; cursor: pointer;
    border: 1.5px solid rgba(255,255,255,0.1);
    transition: border-color 0.2s, background 0.2s;
  }
  .delivery-option.active { border-color: #0071e3; background: rgba(0,113,227,0.07); }
  .delivery-icon { font-size: 1.5rem; flex-shrink: 0; }
  .delivery-option strong { color: #f5f5f7; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.8rem; font-weight: 600; color: #86868b; }
  .form-group input {
    padding: 0.75rem 1rem; border-radius: 10px;
    border: 1.5px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04); color: #f5f5f7;
    font-size: 0.95rem; outline: none; transition: border-color 0.2s;
  }
  .form-group input:focus { border-color: #0071e3; }
  .totals-block { display: flex; flex-direction: column; gap: 0.5rem; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 0.75rem; }
  .total-row { display: flex; justify-content: space-between; font-size: 0.88rem; color: #86868b; }
  .total-row.grand { font-size: 1.1rem; font-weight: 700; color: #f5f5f7; margin-top: 0.25rem; }
  #order-summary-mobile { display: none; }
  @media (max-width: 720px) {
    .checkout-card:first-child > div { grid-template-columns: 1fr !important; }
    #order-summary-mobile { display: block; }
    #order-summary-desktop { display: none; }
    > div > div:first-child { grid-template-columns: 1fr !important; }
  }
</style>

<script is:inline>
  const payCfg = JSON.parse(localStorage.getItem('bicisaas_payment_config') || 'null') || {
    mode: 'sandbox',
    onlineFeePercent: 3.5,
    freeShippingThreshold: 500,
    shippingCost: 80,
    notificationWhatsApp: '529841381493'
  };

  const isLive = payCfg.mode === 'production';
  const COMMISSION = (payCfg.onlineFeePercent !== undefined ? payCfg.onlineFeePercent : 3.5) / 100;
  const SHIPPING_THRESHOLD = payCfg.freeShippingThreshold !== undefined ? payCfg.freeShippingThreshold : 500;
  const SHIPPING_COST = payCfg.shippingCost !== undefined ? payCfg.shippingCost : 80;
  const WA_NUMBER = payCfg.notificationWhatsApp || '529841381493';

  // Update UI badge & button according to mode
  const modeBadge = document.getElementById('checkout-mode-badge');
  const modeText = document.getElementById('checkout-mode-text');
  const btnPay = document.getElementById('btn-pay');
  const descEl = document.getElementById('checkout-desc');

  if (isLive) {
    if (modeBadge) {
      modeBadge.style.background = 'rgba(52,199,89,0.12)';
      modeBadge.style.color = '#34c759';
      modeBadge.style.borderColor = 'rgba(52,199,89,0.25)';
      const dot = modeBadge.querySelector('span');
      if (dot) { dot.style.background = '#34c759'; }
    }
    if (modeText) modeText.textContent = 'Modo Producción (Cobro Seguro)';
    if (btnPay) {
      btnPay.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Pagar con MercadoPago (Producción)';
      btnPay.style.background = '#0071e3';
    }
    if (descEl) {
      descEl.textContent = 'Cobro seguro oficial con tarjeta de débito/crédito, SPEI o Mercado Pago. Tu compra queda verificada y registrada inmediatamente.';
    }
  } else {
    if (modeBadge) {
      modeBadge.style.background = 'rgba(255,149,0,0.12)';
      modeBadge.style.color = '#ff9500';
      modeBadge.style.borderColor = 'rgba(255,149,0,0.25)';
      const dot = modeBadge.querySelector('span');
      if (dot) { dot.style.background = '#ff9500'; }
    }
    if (modeText) modeText.textContent = 'Modo Pruebas (Sandbox)';
    if (btnPay) {
      btnPay.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Continuar con MercadoPago (Pruebas)';
    }
  }

  function fmt(n) { return '$' + Number(n).toLocaleString('es-MX', { minimumFractionDigits: 0 }); }

  function getItems() {
    try { return JSON.parse(localStorage.getItem('bicisaas_cart') || '[]'); }
    catch(e) { return []; }
  }

  let deliveryMethod = 'didi';

  // Delivery toggle
  document.querySelectorAll('.delivery-option').forEach(opt => {
    opt.addEventListener('click', function() {
      document.querySelectorAll('.delivery-option').forEach(o => o.classList.remove('active'));
      this.classList.add('active');
      deliveryMethod = this.querySelector('input').value;
      const isPickup = deliveryMethod === 'tienda';
      document.getElementById('address-section').style.display = isPickup ? 'none' : 'grid';
      renderTotals();
    });
  });

  function renderItems(containerId) {
    const items = getItems();
    const el = document.getElementById(containerId);
    if (!el) return;
    if (!items.length) { el.innerHTML = '<p style="color:#86868b; font-size:0.85rem; text-align:center;">Carrito vacío</p>'; return; }
    el.innerHTML = items.map(i => `
      <div style="display:flex; gap:0.75rem; align-items:center; padding:0.5rem 0; border-bottom:1px solid rgba(255,255,255,0.06);">
        <div style="width:34px; height:34px; border-radius:8px; background:rgba(255,255,255,0.06); color:#a1a1aa; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
        </div>
        <div style="flex:1;">
          <div style="font-size:0.9rem; color:#f5f5f7; font-weight:600;">${i.name}</div>
          <div style="font-size:0.78rem; color:#86868b;">Qty: ${i.qty}</div>
        </div>
        <strong style="color:#f5f5f7; font-size:0.95rem;">${fmt(i.price * i.qty)}</strong>
      </div>
    `).join('');
  }

  function renderTotals() {
    const items = getItems();
    const subtotal = items.reduce((s, i) => s + (i.price * i.qty), 0);
    const fee = Math.round(subtotal * COMMISSION);
    const isPickup = deliveryMethod === 'tienda';
    const shipping = isPickup ? 0 : (subtotal >= SHIPPING_THRESHOLD ? 0 : SHIPPING_COST);
    const total = subtotal + fee + shipping;

    const html = `
      <div class="total-row"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
      <div class="total-row"><span>Comisión en línea (${(COMMISSION * 100).toFixed(1)}%)</span><span>+${fmt(fee)}</span></div>
      <div class="total-row"><span>Envío${isPickup ? ' (Recoger en tienda)' : shipping === 0 ? ' (Gratis)' : ''}</span><span>${shipping === 0 ? 'Gratis' : fmt(shipping)}</span></div>
      <div class="total-row grand"><span>Total</span><span>${fmt(total)}</span></div>
    `;
    ['co-totals-desktop', 'co-totals-mobile'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = html;
    });

    const shippingLabel = document.getElementById('shipping-label');
    if (shippingLabel) {
      shippingLabel.textContent = shipping === 0 ? 'Gratis en este pedido' : fmt(shipping);
      shippingLabel.style.color = shipping === 0 ? '#34c759' : '#ff9500';
    }

    return { subtotal, fee, shipping, total };
  }

  function processCheckout() {
    const name = document.getElementById('f-name').value.trim();
    const phone = document.getElementById('f-phone').value.replace(/\D/g,'');
    const isPickup = deliveryMethod === 'tienda';
    const address = isPickup ? 'Recoger en tienda' : (document.getElementById('f-address').value.trim() || '');
    const colonia = document.getElementById('f-colonia')?.value?.trim() || '';
    const reference = document.getElementById('f-reference')?.value?.trim() || '';
    const notes = document.getElementById('f-notes').value.trim();
    const errEl = document.getElementById('pay-error');

    // Anti-bot honeypot check (OWASP A07: anti-automation)
    const hp = document.getElementById('f-company-tax-hp');
    if (hp && hp.value.trim().length > 0) {
      console.warn('Anti-bot security check triggered');
      errEl.textContent = 'No fue posible validar tu solicitud. Por favor recarga e intenta de nuevo.';
      errEl.style.display = 'block';
      return;
    }

    if (!name) { errEl.textContent = 'Por favor ingresa tu nombre.'; errEl.style.display = 'block'; return; }
    if (phone.length < 10) { errEl.textContent = 'Ingresa tu teléfono de 10 dígitos.'; errEl.style.display = 'block'; return; }
    if (!isPickup && !address) { errEl.textContent = 'Ingresa tu dirección de entrega.'; errEl.style.display = 'block'; return; }
    errEl.style.display = 'none';

    const items = getItems();
    if (!items.length) { errEl.textContent = 'Tu carrito está vacío.'; errEl.style.display = 'block'; return; }

    const { subtotal, fee, shipping, total } = renderTotals();

    // Generate cryptographically random order ID (OWASP A01: IDOR/BOLA mitigation)
    let orderRand = '';
    if (window.crypto && window.crypto.getRandomValues) {
      const bytes = new Uint8Array(4);
      window.crypto.getRandomValues(bytes);
      orderRand = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('').toUpperCase();
    } else {
      orderRand = Math.random().toString(36).slice(2, 10).toUpperCase();
    }
    const orderId = 'ORD-' + Date.now().toString(36).toUpperCase() + '-' + orderRand;

    // Save order to localStorage (for success page + CRM)
    const order = {
      id: orderId,
      name, phone, address, colonia, reference, notes,
      delivery: deliveryMethod, items, subtotal, fee, shipping, total,
      isLiveOrder: isLive,
      createdAt: new Date().toISOString()
    };
    localStorage.setItem('bicisaas_pending_order', JSON.stringify(order));

    const btn = document.getElementById('btn-pay');
    btn.textContent = '⏳ Procesando pago...';
    btn.disabled = true;

    setTimeout(() => {
      if (isLive) {
        if (payCfg.mpPaymentLink) {
          window.open(payCfg.mpPaymentLink, '_blank');
        }
        window.location.href = '/checkout/exito?status=approved';
      } else {
        window.location.href = '/checkout/exito?status=approved&sandbox=true';
      }
    }, 1500);
  }

  // Init
  if (!getItems().length) {
    window.location.href = '/inventario';
  }
  renderItems('co-items-desktop');
  renderItems('co-items-mobile');
  renderTotals();
</script>
