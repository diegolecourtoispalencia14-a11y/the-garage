---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada | The Garage Playa del Carmen">
  <div class="error-page-wrap" style="padding: 6rem 1.5rem; text-align: center; max-width: 600px; margin: 0 auto;">
    <div id="dynamic-loader" style="display:none; padding: 2rem;">
      <div style="display:flex; justify-content:center; margin-bottom: 1rem; animation: spin 2s linear infinite;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></div>
      <h2 style="font-size: 1.3rem; font-weight: 700;">Cargando producto desde el almacén local...</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Sincronizando información en tiempo real.</p>
    </div>

    <div id="standard-404">
      <div style="display:flex; justify-content:center; margin-bottom: 1rem;"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5L8.5 7H12l2.5 4.5M12 11.5l3.5 6M5.5 17.5l4-10.5"/></svg></div>
      <h1 style="font-size: 2rem; font-weight: 900; margin-bottom: 0.5rem;">404 — Producto o Página No Encontrada</h1>
      <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
        El modelo o accesorio que buscas puede haberse vendido o actualizado en el catálogo de Playa del Carmen.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem;">
        <a href="/inventario" class="btn btn-primary" style="padding: 0.75rem 1.75rem; border-radius: 100px; text-decoration: none; font-weight: 700;">
          Ver Catálogo Completo
        </a>
        <a href="/" class="btn btn-outline" style="padding: 0.75rem 1.75rem; border-radius: 100px; text-decoration: none;">
          Volver al Inicio
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    // Client-side fallback for dynamically created products in localStorage
    (function() {
      const path = window.location.pathname;
      if (path.startsWith('/bici/')) {
        const rawSlug = path.replace(/^\/bici\//, '').replace(/\/$/, '').toLowerCase();
        try {
          const localInv = JSON.parse(localStorage.getItem('bicisaas_inventory') || '[]');
          const match = localInv.find(p =>
            (p.sku && p.sku.toLowerCase() === rawSlug) ||
            (p.id && String(p.id).toLowerCase() === rawSlug) ||
            (p.name && p.name.toLowerCase().includes(rawSlug))
          );
          if (match) {
            document.getElementById('standard-404').style.display = 'none';
            document.getElementById('dynamic-loader').style.display = 'block';
            // Redirect to matching canonical SKU if alias or refresh
            if (match.sku && match.sku.toLowerCase() !== rawSlug) {
              window.location.replace('/bici/' + match.sku);
              return;
            }
          }
        } catch(e) {}
      }
    })();
  </script>
</Base>
