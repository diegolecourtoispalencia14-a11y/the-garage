<script>
  function initMasterBento() {
    // 1. First-Party Visit Tracker (CRO standard)
    const firstVisitKey = 'the_garage_first_visit';
    if (!localStorage.getItem(firstVisitKey)) {
      localStorage.setItem(firstVisitKey, new Date().toISOString());
    }

    // 2. Dock Smooth Scroll & Scroll Spy
    const dockButtons = document.querySelectorAll<HTMLElement>('.dock-nav-btn[data-target]');
    dockButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (targetId) {
          document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    const observedSections = ['sec-hero', 'sec-matchmaker', 'sec-drops', 'sec-riders'];
    const sectionElements = observedSections.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    if ('IntersectionObserver' in window && sectionElements.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const currentId = entry.target.id;
            dockButtons.forEach(btn => {
              if (btn.getAttribute('data-target') === currentId) {
                btn.classList.add('active');
              } else {
                btn.classList.remove('active');
              }
            });
          }
        });
      }, { threshold: 0.35, rootMargin: '-10% 0px -40% 0px' });

      sectionElements.forEach(sec => observer.observe(sec));
    }

    // 3. Paddock Club Bar Close Trigger
    const paddockDrawer = document.getElementById('paddock-club-drawer');
    const paddockClose = document.getElementById('paddock-close');
    paddockClose?.addEventListener('click', () => {
      if (paddockDrawer) {
        paddockDrawer.style.display = 'none';
        sessionStorage.setItem('paddock_dismissed', 'true');
      }
    });
    if (sessionStorage.getItem('paddock_dismissed') === 'true' && paddockDrawer) {
      paddockDrawer.style.display = 'none';
    }

    // 4. Matchmaker Wizard State & Steps
    let terrain = 'MTB';
    let goal = 'entrenamiento';
    let size = 'M';
    let currentModelTitle = 'Merida Scultura 300 Shimano Tiagra';
    let currentModelPrice = '$19,800 MXN';

    const stepTerrain = document.getElementById('step-terrain');
    const stepGoal = document.getElementById('step-goal');
    const stepSize = document.getElementById('step-size');
    const stepResult = document.getElementById('step-result');
    const stepLabel = document.getElementById('wizard-step-label');

    // Step 1: Terrain
    document.querySelectorAll<HTMLButtonElement>('[data-terrain]').forEach(btn => {
      btn.addEventListener('click', () => {
        terrain = btn.getAttribute('data-terrain') || 'MTB';
        localStorage.setItem('the_garage_interest_terrain', terrain);
        if (stepTerrain && stepGoal && stepLabel) {
          stepTerrain.style.display = 'none';
          stepGoal.style.display = 'block';
          stepLabel.textContent = 'Paso 2 de 3';
        }
      });
    });

    // Step 2: Goal
    document.querySelectorAll<HTMLButtonElement>('[data-goal]').forEach(btn => {
      btn.addEventListener('click', () => {
        goal = btn.getAttribute('data-goal') || 'entrenamiento';
        if (stepGoal && stepSize && stepLabel) {
          stepGoal.style.display = 'none';
          stepSize.style.display = 'block';
          stepLabel.textContent = 'Paso 3 de 3';
        }
      });
    });

    // Step 3: Size & Render
    document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach(btn => {
      btn.addEventListener('click', () => {
        size = btn.getAttribute('data-size') || 'M';
        localStorage.setItem('the_garage_user_size', size);
        renderMatchResult();
      });
    });

    // Back Buttons
    document.getElementById('btn-back-terrain')?.addEventListener('click', () => {
      if (stepTerrain && stepGoal && stepLabel) {
        stepGoal.style.display = 'none';
        stepTerrain.style.display = 'block';
        stepLabel.textContent = 'Paso 1 de 3';
      }
    });

    document.getElementById('btn-back-goal')?.addEventListener('click', () => {
      if (stepGoal && stepSize && stepLabel) {
        stepSize.style.display = 'none';
        stepGoal.style.display = 'block';
        stepLabel.textContent = 'Paso 2 de 3';
      }
    });

    document.getElementById('btn-restart-match')?.addEventListener('click', () => {
      if (stepTerrain && stepResult && stepLabel) {
        stepResult.style.display = 'none';
        stepTerrain.style.display = 'block';
        stepLabel.textContent = 'Paso 1 de 3';
      }
    });

    function renderMatchResult() {
      const resImg = document.getElementById('res-img') as HTMLImageElement;
      const resCat = document.getElementById('res-cat');
      const resTitle = document.getElementById('res-title');
      const resPrice = document.getElementById('res-price');
      const resDesc = document.getElementById('res-desc');
      const resWa = document.getElementById('res-wa-btn') as HTMLAnchorElement;

      let modelTitle = 'Merida Scultura 300 Shimano Tiagra';
      let modelPrice = '$19,800 MXN';
      let modelCat = 'RUTA & ENTRENAMIENTO // TALLA ' + size;
      let modelImg = '/img/bicis/merida-scultura-1.webp';
      let modelDesc = 'Ideal para tu objetivo de rendimiento en asfalto. Cuadro ligero de aluminio con horquilla de carbono, grupo Shimano Tiagra 2x10 vel y ergonomía rápida.';

      if (terrain === 'Gravel') {
        modelTitle = 'Basso Bikes Italia Tera Gravel / Palta';
        modelPrice = 'Cotización Personalizada';
        modelCat = 'GRAVEL & AVENTURA // TALLA ' + size;
        modelImg = '/img/instagram/live-ig-thegarage.pdcDG6tlpFv-Pq.jpg';
        modelDesc = 'Geometría italiana de absorción, cuadro con paso de rueda de hasta 45mm para arena y terracería, cableado interno total y máxima polivalencia.';
      } else if (terrain === 'MTB' || goal === 'iniciacion') {
        modelTitle = 'Oferta Relámpago MTB R29 Shimano';
        modelPrice = '$7,900 MXN';
        modelCat = 'MONTAÑA & SENDEROS // TALLA ' + size;
        modelImg = '/img/bicis/mtb-relampago-1.webp';
        modelDesc = 'Perfecta para senderos de la Riviera Maya y paseos todo terreno. Rodada 29", suspensión delantera, transmisión Shimano y frenos de disco hidráulicos.';
      } else if (goal === 'competencia') {
        modelTitle = 'Basso Bikes Italia Diamante / Astra Custom Build';
        modelPrice = 'Cotización Personalizada';
        modelCat = 'COMPETENCIA ÉLITE // TALLA ' + size;
        modelImg = '/img/instagram/live-ig-thegarage.pdcDG6tlpFv-Pq.jpg';
        modelDesc = 'Cuadro monocasco de carbono Torayca hecho a mano en Italia, grupo electrónico SRAM AXS/Shimano Di2 y ruedas de carbono para el más alto nivel competitivo.';
      }

      currentModelTitle = modelTitle;
      currentModelPrice = modelPrice;

      if (resImg) resImg.src = modelImg;
      if (resCat) resCat.textContent = modelCat;
      if (resTitle) resTitle.textContent = modelTitle;
      if (resPrice) resPrice.textContent = modelPrice;
      if (resDesc) resDesc.textContent = modelDesc;
      if (resWa) {
        resWa.href = `https://wa.me/529841381493?text=${encodeURIComponent(`Hola, completé el asesor en la web y mi match fue: ${modelTitle} (${modelPrice}). Me gustaría apartarla.`)}`;
      }

      if (stepSize && stepResult && stepLabel) {
        stepSize.style.display = 'none';
        stepResult.style.display = 'block';
        stepLabel.textContent = 'Match Listo';
      }
    }

    // 5. Smart Lead Capture Form Submission Handler
    const leadForm = document.getElementById('lead-capture-form');
    const contactInput = document.getElementById('lead-contact-input') as HTMLInputElement;
    const successMsg = document.getElementById('lead-success-msg');
    const submitBtn = document.getElementById('lead-submit-btn');

    leadForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const contactVal = contactInput?.value.trim();
      if (!contactVal) return;

      const leadPayload = {
        contact: contactVal,
        channel: contactVal.includes('@') ? 'email' : 'whatsapp',
        terrain: terrain,
        size: size,
        model: currentModelTitle
      };

      // 1. Dispatch custom event to BehaviorTracker (integrates with CRM Pipeline)
      window.dispatchEvent(new CustomEvent('tg:lead_captured', { detail: leadPayload }));

      // 2. Backward compatibility for legacy CRM Leads table
      const legacyPayload = {
        ...leadPayload,
        first_visit: localStorage.getItem('the_garage_first_visit') || new Date().toISOString(),
        captured_at: new Date().toISOString(),
        url: window.location.href
      };
      const existingLeads = JSON.parse(localStorage.getItem('the_garage_leads') || '[]');
      existingLeads.push(legacyPayload);
      localStorage.setItem('the_garage_leads', JSON.stringify(existingLeads));

      // Visual Feedback
      if (submitBtn) submitBtn.textContent = 'Enviando...';
      setTimeout(() => {
        if (submitBtn) submitBtn.textContent = 'Registrado';
        if (successMsg) successMsg.style.display = 'block';
        if (contactInput) contactInput.disabled = true;
      }, 500);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMasterBento);
  } else {
    initMasterBento();
  }
</script>
