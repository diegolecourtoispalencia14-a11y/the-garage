---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const bicisEntries = await getCollection('bicis');
const bicis = bicisEntries.map(e => e.data);
---

<Base
  title="THE GARAGE • BIKE EXPERTS | Boutique Ciclista & Taller en Playa del Carmen"
  description="Distribuidor oficial Basso Bikes Italia en Playa del Carmen. Taller especializado SRAM/Shimano, nutrición Wayfar, rodadas The Garage Ride y catálogo de bicicletas."
>
  <div class="bento-wrapper">
    <div class="container-fluid">

      <!-- Top Real-Time Status Ticker -->
      <div class="status-strip">
        <div class="status-indicator-group">
          <span class="live-dot"></span>
          <span class="font-mono status-badge-text">TALLER ACTIVO // CATALUÑA CASA 19, PLAYA DEL CARMEN</span>
        </div>
        <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer" class="font-mono ig-live-badge">
          <span>@thegarage.pdc</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>

      <!-- BENTO SECTION 1: INICIO & TALLER CIRUGÍA -->
      <div class="bento-row bento-hero-grid" id="sec-hero">
        
        <!-- Bento Tile 1: Master Hero -->
        <div class="bento-tile tile-hero-main">
          <div class="tile-hero-header">
            <div class="meta-pill-group font-mono">
              <span class="tag-distributor">DISTRIBUIDOR OFICIAL BASSO</span>
              <span class="tag-region">RIVIERA MAYA</span>
            </div>
            
            <h1 class="hero-headline">
              Ingeniería italiana.<br />
              <span class="headline-contrast">Pasión en el Caribe.</span>
            </h1>

            <p class="hero-body-text">
              Bicicletas de ruta, gravel y montaña de alto rendimiento. Distribución oficial de <strong>Basso Bikes</strong>, taller de cirugía mecánica SRAM/Shimano, hidratación <strong>Wayfar</strong> y rodadas grupales sabatinas.
            </p>
          </div>

          <div class="tile-hero-footer">
            <a href="#sec-matchmaker" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/></svg>
              <span>Probar Asesor de Bicicleta</span>
            </a>
            <a
              href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20consultar%20sobre%20las%20bicicletas%20disponibles%20o%20agendar%20taller."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.152.57 4.17 1.564 5.91l-1.564 5.708 5.867-1.538c1.701.928 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/></svg>
              <span>Concierge WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Bento Tile 2: Workshop Surgery Side -->
        <div class="bento-tile tile-taller-side">
          <div class="taller-card-top">
            <div class="taller-meta-row font-mono">
              <span class="tag-chapter">[01 // CIRUGÍA TALLER]</span>
              <span class="tag-active-live font-mono">
                <span class="active-dot"></span> Abierto Hoy
              </span>
            </div>
            
            <h2 class="taller-heading">Calibración Milimétrica</h2>
            <p class="taller-sub-text">
              Mantenimiento de transmisiones electrónicas SRAM AXS &amp; Di2, purgado de frenos hidráulicos y servicio completo de suspensiones.
            </p>
          </div>

          <div class="taller-technical-specs font-mono">
            <div class="tech-spec-row">
              <span class="spec-label">1er Mantenimiento</span>
              <span class="spec-val">Gratis a 30 días</span>
            </div>
            <div class="tech-spec-row">
              <span class="spec-label">Nutrición Deportiva</span>
              <span class="spec-val highlight-red">Punto Oficial Wayfar</span>
            </div>
            <div class="tech-spec-row">
              <span class="spec-label">Inspección Torquímetro</span>
              <span class="spec-val">Certificada en Tienda</span>
            </div>
          </div>
        </div>

      </div>

      <!-- BENTO SECTION 2: INTERACTIVE BIKE MATCHMAKER -->
      <div class="bento-tile tile-matchmaker" id="sec-matchmaker">
        <div class="matchmaker-top-bar">
          <div>
            <span class="font-mono match-badge-tag">[02 // ASESOR INTERACTIVO]</span>
            <h2 class="match-heading">¿Qué bicicleta hace match contigo?</h2>
          </div>
          <div class="step-counter-box font-mono" id="wizard-step-label">
            Paso 1 de 3
          </div>
        </div>

        <!-- Step 1: Terrain -->
        <div id="step-terrain" class="wizard-panel">
          <p class="wizard-prompt">Selecciona el terreno donde más ruedas:</p>
          <div class="wizard-cards-grid">
            <button type="button" class="wizard-card-opt" data-terrain="MTB">
              <div class="opt-svg-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
              </div>
              <strong class="opt-title">Senderos &amp; MTB</strong>
              <p class="opt-desc">Raíces, terracerías de la Riviera y aventura todoterreno.</p>
            </button>
            <button type="button" class="wizard-card-opt" data-terrain="Ruta">
              <div class="opt-svg-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </div>
              <strong class="opt-title">Ruta &amp; Asfalto</strong>
              <p class="opt-desc">Velocidad aerodinámica, cadencia y fondos de resistencia.</p>
            </button>
            <button type="button" class="wizard-card-opt" data-terrain="Gravel">
              <div class="opt-svg-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
              </div>
              <strong class="opt-title">Gravel &amp; Mixto</strong>
              <p class="opt-desc">50% asfalto y 50% caminos de terracería con libertad total.</p>
            </button>
          </div>
        </div>

        <!-- Step 2: Goal -->
        <div id="step-goal" class="wizard-panel" style="display: none;">
          <p class="wizard-prompt">¿Cuál es tu objetivo de uso?</p>
          <div class="wizard-cards-grid">
            <button type="button" class="wizard-card-opt" data-goal="iniciacion">
              <div class="opt-svg-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <strong class="opt-title">Iniciación &amp; Paseo</strong>
              <p class="opt-desc">Disfrutar el fin de semana y empezar a rodar seguro.</p>
            </button>
            <button type="button" class="wizard-card-opt" data-goal="entrenamiento">
              <div class="opt-svg-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
              </div>
              <strong class="opt-title">Entrenamiento &amp; Fondo</strong>
              <p class="opt-desc">Rodadas constantes de 40 a 100km buscando superarte.</p>
            </button>
            <button type="button" class="wizard-card-opt" data-goal="competencia">
              <div class="opt-svg-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              </div>
              <strong class="opt-title">Carreras &amp; Alta Gama</strong>
              <p class="opt-desc">Máxima ligereza, precisión de cambio y competencia.</p>
            </button>
          </div>
          <button type="button" class="btn-step-prev font-mono" id="btn-back-terrain">← Volver al paso 1</button>
        </div>

        <!-- Step 3: Size -->
        <div id="step-size" class="wizard-panel" style="display: none;">
          <p class="wizard-prompt">¿Cuál es tu rango de estatura?</p>
          <div class="wizard-cards-grid">
            <button type="button" class="wizard-card-opt" data-size="S">
              <div class="opt-svg-box font-mono font-bold text-lg text-rose-500">S</div>
              <strong class="opt-title">1.55 m – 1.68 m</strong>
              <p class="opt-desc">Talla Pequeña (Cuadro 48-51 cm)</p>
            </button>
            <button type="button" class="wizard-card-opt" data-size="M">
              <div class="opt-svg-box font-mono font-bold text-lg text-rose-500">M</div>
              <strong class="opt-title">1.68 m – 1.78 m</strong>
              <p class="opt-desc">Talla Mediana (Cuadro 52-54 cm)</p>
            </button>
            <button type="button" class="wizard-card-opt" data-size="L">
              <div class="opt-svg-box font-mono font-bold text-lg text-rose-500">L</div>
              <strong class="opt-title">1.78 m – 1.90 m</strong>
              <p class="opt-desc">Talla Grande (Cuadro 55-58 cm)</p>
            </button>
          </div>
          <button type="button" class="btn-step-prev font-mono" id="btn-back-goal">← Volver al paso 2</button>
        </div>

        <!-- Dynamic Live Result Box with Smart Lead Capture Form -->
        <div id="step-result" class="result-display-panel" style="display: none;">
          <div class="result-match-indicator font-mono">
            <span class="match-ping"></span>
            <span>98% MATCH RECOMENDADO EN TIENDA</span>
          </div>

          <div class="result-two-col">
            <div class="result-media-container">
              <img id="res-img" src="/img/bicis/merida-scultura-1.webp" alt="Bicicleta recomendada" />
            </div>

            <div class="result-info-container">
              <span class="result-category-label font-mono" id="res-cat">RUTA &amp; ENTRENAMIENTO</span>
              <h3 class="result-model-name" id="res-title">Merida Scultura 300 Shimano Tiagra</h3>
              <div class="result-price-tag font-mono" id="res-price">$19,800 MXN</div>
              <p class="result-description-text" id="res-desc">
                Cuadro ligero de aluminio con horquilla de carbono, grupo Shimano Tiagra 2x10 vel y ergonomía rápida para asfalto.
              </p>

              <!-- SMART CRO LEAD CAPTURE ENGINE -->
              <div class="lead-capture-card font-mono">
                <span class="lead-capture-tag">[ENTREGA DE FICHA &amp; DISPONIBILIDAD]</span>
                <p class="lead-capture-desc">
                  Recibe la ficha técnica completa de geometría, opciones de financiamiento y aviso de disponibilidad por WhatsApp o Correo:
                </p>

                <form id="lead-capture-form" class="lead-form-grid">
                  <input
                    type="text"
                    id="lead-contact-input"
                    placeholder="Tu WhatsApp (10 dígitos) o Correo"
                    required
                    class="lead-input"
                  />
                  <button type="submit" class="btn btn-primary lead-submit-btn" id="lead-submit-btn">
                    <span>Recibir Ficha Técnica ↗</span>
                  </button>
                </form>
                <div id="lead-success-msg" class="lead-success-feedback" style="display: none;">
                  ✓ Ficha registrada. Te contactaremos con la información técnica y opciones de apartado.
                </div>
              </div>

              <div class="result-actions-row" style="margin-top: 1rem;">
                <a href="#" id="res-wa-btn" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
                  Apartar de Inmediato por WhatsApp
                </a>
                <button type="button" class="btn btn-outline" id="btn-restart-match">
                  Reiniciar Asesor ↻
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- BENTO SECTION 3: INVENTARIO FÍSICO -->
      <div class="bento-row bento-drops-grid" id="sec-drops">
        
        <!-- Bike 1: Merida Scultura 300 -->
        <div class="bento-tile drop-card-tile">
          <div class="drop-media-viewport">
            <img src="/img/bicis/merida-scultura-1.webp" alt="Merida Scultura 300" />
            <div class="badge-status-live font-mono">● DISPONIBLE</div>
            <div class="badge-price-floating font-mono">$19,800 MXN</div>
          </div>
          <div class="drop-content-block">
            <span class="drop-edition-num font-mono">[DISPONIBLE EN TIENDA // RUTA]</span>
            <h3 class="drop-bike-title">Merida Scultura 300 Shimano Tiagra</h3>
            <p class="drop-bike-summary">Talla S/M (52 cm) • Cuadro aluminio + horquilla carbono • 2x10 vel.</p>
            <a
              href="https://wa.me/529841381493?text=Hola,%20me%20interesa%20la%20Merida%20Scultura%20300%20disponible%20en%20tienda."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp drop-full-btn"
            >
              Apartar por WhatsApp
            </a>
          </div>
        </div>

        <!-- Bike 2: Oferta Relampago MTB R29 -->
        <div class="bento-tile drop-card-tile">
          <div class="drop-media-viewport">
            <img src="/img/bicis/mtb-relampago-1.webp" alt="Oferta Relámpago MTB" />
            <div class="badge-status-live font-mono" style="background: rgba(113, 113, 122, 0.9); color: #F4F4F5;">● VENDIDA</div>
            <div class="badge-price-floating font-mono">$7,900 MXN</div>
          </div>
          <div class="drop-content-block">
            <span class="drop-edition-num font-mono">[UNIDAD VENDIDA // MTB]</span>
            <h3 class="drop-bike-title">Oferta Relámpago MTB R29 Shimano</h3>
            <p class="drop-bike-summary">Talla M • Frenos de disco hidráulicos • Suspensión delantera • 2x8 vel.</p>
            <a
              href="https://wa.me/529841381493?text=Hola,%20vi%20la%20MTB%20R29%20vendida,%20%C2%BFtienen%20otra%20similar%20en%20tienda?"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline drop-full-btn"
            >
              Pedir Bicicleta Similar
            </a>
          </div>
        </div>

      </div>

      <!-- BENTO SECTION 4: COMMUNITY & RIDERS CLUB -->
      <div class="bento-tile tile-riders-club" id="sec-riders">
        <div class="riders-header-flex">
          <div>
            <span class="riders-chapter-tag font-mono">[04 // COMUNIDAD ACTIVA]</span>
            <h2 class="riders-main-heading">The Garage Ride &amp; Clásica 7:30 XCO</h2>
          </div>
          <a href="/comunidad" class="font-mono riders-feed-link">
            <span>Ver Feed de Instagram</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>
        </div>

        <p class="riders-narrative">
          Salidas sabatinas grupales hacia Cenotes, Tulum y rutas costeras con vehículo barredora, hidratación oficial Wayfar y soporte técnico en ruta.
        </p>

        <div class="riders-cta-group">
          <a
            href="https://wa.me/529841381493?text=Hola,%20quiero%20unirme%20a%20la%20pr%C3%B3xima%20rodada%20de%20The%20Garage%20Ride."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Unirme a la Próxima Rodada
          </a>
          <a href="/inventario" class="btn btn-outline">
            Explorar Catálogo Completo ({bicis.length} unidades) →
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- FLOATING DOCK -->
  <nav class="floating-dock-nav" aria-label="Navegación Rápida">
    <button type="button" class="dock-nav-btn active" data-target="sec-hero">01 Inicio</button>
    <button type="button" class="dock-nav-btn" data-target="sec-matchmaker">02 Asesor</button>
    <button type="button" class="dock-nav-btn" data-target="sec-drops">03 Bicicletas</button>
    <button type="button" class="dock-nav-btn" data-target="sec-riders">04 Comunidad</button>
    <a href="/inventario" class="dock-nav-btn dock-catalog-accent font-mono">Catálogo ↗</a>
  </nav>

  <!-- LUXURY FIRST-VISIT PADDOCK CLUB DRAWER TRIGGER -->
  <div id="paddock-club-drawer" class="paddock-club-bar font-mono">
    <div class="paddock-inner-content">
      <div class="paddock-text-block">
        <span class="paddock-badge">[BASSO PADDOCK CLUB]</span>
        <span class="paddock-headline">¿Buscas una talla o modelo específico de Basso Bikes Italia?</span>
      </div>
      <div class="paddock-action-block">
        <a
          href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20unirme%20al%20Paddock%20Club%20para%20recibir%20alertas%20de%20arribos%20de%20Basso%20Bikes."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary paddock-cta-btn"
        >
          Recibir Alertas de Arribo ↗
        </a>
        <button type="button" class="paddock-close-btn" id="paddock-close" aria-label="Cerrar">✕</button>
      </div>
    </div>
  </div>
</Base>

<style>
  .bento-wrapper {
    width: 100%;
    padding: var(--space-6) 0 var(--space-9) 0;
  }

  /* Status Strip */
  .status-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-5);
  }

  .status-indicator-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22C55E;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.35);
  }

  .status-badge-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  .ig-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #FB7185;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }
  .ig-live-badge:hover {
    opacity: 0.8;
  }

  /* Bento Tiles Base */
  .bento-tile {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    transition: all 0.3s var(--ease-spring);
    overflow: hidden;
  }

  .bento-tile:hover {
    border-color: var(--border-accent);
    box-shadow: 0 20px 48px -12px rgba(225, 29, 72, 0.14);
  }

  /* Bento Hero Grid */
  .bento-hero-grid {
    display: grid;
    grid-template-columns: 1.45fr 0.85fr;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .tile-hero-main {
    padding: clamp(2rem, 4vw, 3.5rem);
    background: radial-gradient(circle at top right, rgba(225, 29, 72, 0.16) 0%, var(--surface-card) 65%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 480px;
  }

  .meta-pill-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .tag-distributor {
    background: rgba(225, 29, 72, 0.12);
    border: 1px solid rgba(225, 29, 72, 0.35);
    color: #FB7185;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .tag-region {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.045em;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .headline-contrast {
    color: var(--text-muted);
    font-weight: 800;
  }

  .hero-body-text {
    color: var(--text-secondary);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    max-width: 640px;
  }

  .tile-hero-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-hairline);
  }

  /* Workshop Surgery Side Tile */
  .tile-taller-side {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: linear-gradient(180deg, #18181C 0%, #101013 100%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .taller-meta-row {
