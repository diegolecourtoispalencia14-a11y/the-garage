---
import Base from '../layouts/Base.astro';
import BiciCard from '../components/BiciCard.astro';
import Filtros from '../components/Filtros.astro';
import { getCollection } from 'astro:content';

const bicisEntries = await getCollection('bicis');
const orderMap: Record<string, number> = {
  Disponible: 1,
  Apartada: 2,
  Vendida: 3,
};

const bicis = bicisEntries
  .map(e => e.data)
  .sort((a, b) => {
    const orderA = orderMap[a.disponibilidad] || 99;
    const orderB = orderMap[b.disponibilidad] || 99;
    if (orderA !== orderB) return orderA - orderB;
    return (b.destacada ? 1 : 0) - (a.destacada ? 1 : 0);
  });
---

<Base
  title="THE GARAGE • BIKE EXPERTS | Distribuidor Basso & Lee Cougan • Playa del Carmen"
  description="Vitrina oficial de The Garage en Playa del Carmen. Distribuidores oficiales de Basso, Lee Cougan, taller SRAM y comunidad ciclista en la Riviera Maya."
>
  <!-- Hero Section con Identidad de Comunidad y Distribuidor Oficial -->
  <section style="background: radial-gradient(circle at top right, #F1F5F9 0%, #FFFFFF 60%); border-bottom: 2px solid #0F172A; padding: 3.5rem 0 2.5rem 0;">
    <div class="container">
      <div style="max-width: 880px;">
        
        <!-- Badges Bar -->
        <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.45rem; background: #0F172A; color: #FFFFFF; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #FF5722;"></span>
            THE GARAGE • BIKE EXPERTS
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FFF7ED; border: 1.5px solid #FFEDD5; color: #C2410C; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">
            🇮🇹 BASSO & LEE COUGAN OFICIAL
          </div>
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            style="display: inline-flex; align-items: center; gap: 0.35rem; background: #FDF2F8; border: 1.5px solid #FCE7F3; color: #BE185D; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; transition: transform 0.15s ease;"
            onmouseover="this.style.transform='scale(1.03)'"
            onmouseout="this.style.transform='scale(1)'"
          >
            📸 Instagram @thegarage.pdc
          </a>
        </div>

        <h1 class="title-xl" style="margin-bottom: 1.15rem; color: #0F172A;">
          Bicicletas de clase mundial & taller experto en el Caribe.
        </h1>
        <p class="subtitle" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 2rem;">
          Bienvenido a <strong>The Garage</strong>. Punto de encuentro ciclista en Playa del Carmen, distribuidores oficiales de <strong>Basso Bikes</strong> y <strong>Lee Cougan</strong>, servicio de taller especializado SRAM y organizadores de rodadas en la Riviera Maya.
        </p>

        <!-- Trust Pillars Bar -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; background: #FFFFFF; padding: 0.85rem 1.15rem; border-radius: var(--radius-md); border: 1.5px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.4rem;">🇮🇹</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Basso & Lee Cougan</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Gravel, Ruta & MTB Pro</span>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; background: #FFFFFF; padding: 0.85rem 1.15rem; border-radius: var(--radius-md); border: 1.5px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.4rem;">🔧</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Taller & SRAM AXS</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Mantenimiento certificado</span>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; background: #FFFFFF; padding: 0.85rem 1.15rem; border-radius: var(--radius-md); border: 1.5px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.4rem;">🤝</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Comunidad & Rodadas</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Salidas semanales PDC</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Inventory Gallery Section -->
  <section style="padding: 2.75rem 0 4rem 0;">
    <div class="container">
      
      <!-- Interactive Filter Bar -->
      <Filtros />

      <!-- Bike Cards Grid -->
      <div class="bici-grid">
        {bicis.map((bici, index) => (
          <BiciCard bici={bici} priority={index === 0} />
        ))}
      </div>

      <!-- Instagram Community Showcase (El Ciclo de Comunidad) -->
      <div style="margin-top: 4rem; background: #FFFFFF; border: 2px solid var(--border); border-radius: var(--radius-xl); padding: 2.5rem 2rem; box-shadow: var(--shadow-md);">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; margin-bottom: 2rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span style="font-size: 0.8rem; font-weight: 800; color: #E1306C; text-transform: uppercase; letter-spacing: 0.1em;">
                📸 EXTENSIÓN OFICIAL DE INSTAGRAM
              </span>
            </div>
            <h2 class="title-lg" style="color: var(--secondary);">La Venta No Es El Fin, Es El Inicio De La Rodada</h2>
            <p class="subtitle" style="font-size: 0.95rem; margin-top: 0.25rem; max-width: 650px;">
              Síguenos en <strong>@thegarage.pdc</strong> para ver llegadas de Basso y Lee Cougan, servicios de taller, nutrición Wayfar y las fechas de las rodadas comunitarias.
            </p>
          </div>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a
              href="/comunidad"
              class="btn btn-primary"
              style="padding: 0.75rem 1.25rem; font-size: 0.9rem;"
            >
              Ver Galería de Comunidad →
            </a>
            <a
              href="https://www.instagram.com/thegarage.pdc/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              style="background: linear-gradient(45deg, #F58529, #D62976, #962FBF, #4F5BD5); color: #FFFFFF; padding: 0.75rem 1.25rem; font-size: 0.9rem;"
            >
              Instagram @thegarage.pdc ↗
            </a>
          </div>
        </div>

        <!-- Pillars of the Community Cycle -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
          <div style="background: #F8FAFC; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem;">
            <div style="font-size: 1.5rem; margin-bottom: 0.25rem;">✨</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">1. Inspiración</strong>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Bicicletas italianas Basso, MTB Lee Cougan y montajes custom en nuestro taller.</p>
          </div>
          <div style="background: #F8FAFC; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem;">
            <div style="font-size: 1.5rem; margin-bottom: 0.25rem;">📏</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">2. Exploración & Fit</strong>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Calculadora de tallas y prueba física de rodaje en nuestro local de Cataluña.</p>
          </div>
          <div style="background: #F8FAFC; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem;">
            <div style="font-size: 1.5rem; margin-bottom: 0.25rem;">🌴</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">3. Rodadas & Amigos</strong>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Salidas a cenotes y carreteras de la Riviera Maya con soporte de mecánicos.</p>
          </div>
          <div style="background: #F8FAFC; border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem;">
            <div style="font-size: 1.5rem; margin-bottom: 0.25rem;">🔧</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">4. Taller de por Vida</strong>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">Primer mantenimiento gratis, purgas de frenos y refacciones oficiales SRAM.</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Base>
