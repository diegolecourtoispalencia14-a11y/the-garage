---
import Base from '../layouts/Base.astro';
import BiciCard from '../components/BiciCard.astro';
import Filtros from '../components/Filtros.astro';
import { getCollection } from 'astro:content';

const bicisEntries = await getCollection('bicis');
const orderMap: Record<string, number> = {
  Disponible: 1,
  Apartada: 2,
  Vendida: 3,
};

const bicis = bicisEntries
  .map(e => e.data)
  .sort((a, b) => {
    const orderA = orderMap[a.disponibilidad] || 99;
    const orderB = orderMap[b.disponibilidad] || 99;
    if (orderA !== orderB) return orderA - orderB;
    return (b.destacada ? 1 : 0) - (a.destacada ? 1 : 0);
  });
---

<Base
  title="THE GARAGE • BIKE EXPERTS | Catálogo de Bicicletas en Playa del Carmen"
  description="Vitrina oficial de The Garage Bike Experts en Playa del Carmen. Bicicletas MTB, Ruta y Urbanas disponibles para entrega en toda la Riviera Maya. Aparta por WhatsApp."
>
  <!-- Hero Section with Official Branding -->
  <section style="background: linear-gradient(180deg, #FFFFFF 0%, #F1F5F9 100%); border-bottom: 2px solid #0F172A; padding: 3rem 0 2.5rem 0;">
    <div class="container">
      <div style="max-width: 820px;">
        <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #0F172A; color: #FFFFFF; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #FF5722;"></span>
            BIKE EXPERTS
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FFF7ED; border: 1px solid #FFEDD5; color: #C2410C; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">
            📍 Playa del Carmen, Q.R.
          </div>
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            style="display: inline-flex; align-items: center; gap: 0.35rem; background: #FDF2F8; border: 1px solid #FCE7F3; color: #BE185D; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800;"
          >
            📸 Instagram @thegarage.pdc
          </a>
        </div>

        <h1 class="title-xl" style="margin-bottom: 1rem; color: #0F172A;">
          Tu próxima bicicleta está en The Garage.
        </h1>
        <p class="subtitle" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 1.75rem;">
          Vitrina en tiempo real de <strong>The Garage • Bike Experts</strong>. Revisa los modelos en tienda, checa fotos reales y <strong>aparta o consulta por WhatsApp</strong> en menos de un minuto. Envíos y entregas en toda la Riviera Maya.
        </p>

        <!-- Value props bar -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.65rem; background: #FFFFFF; padding: 0.75rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.25rem;">🔧</span>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--secondary);">Asesoría experta & prueba en tienda</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.65rem; background: #FFFFFF; padding: 0.75rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.25rem;">💬</span>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--secondary);">Apartado directo por WhatsApp</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.65rem; background: #FFFFFF; padding: 0.75rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.25rem;">🚚</span>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--secondary);">Entrega Tulum, Cancún y Riviera</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Inventory Gallery Section -->
  <section style="padding: 2.5rem 0 4rem 0;">
    <div class="container">
      
      <!-- Interactive Filter Bar -->
      <Filtros />

      <!-- Bike Cards Grid -->
      <div class="bici-grid">
        {bicis.map((bici, index) => (
          <BiciCard bici={bici} priority={index === 0} />
        ))}
      </div>

      <!-- Bottom Assistance Banner -->
      <div style="margin-top: 3.5rem; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; border-radius: var(--radius-lg); padding: 2.5rem 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; box-shadow: var(--shadow-lg); border: 2px solid #334155;">
        <div style="max-width: 600px;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.1em;">THE GARAGE • BIKE EXPERTS</span>
          </div>
          <h2 class="title-lg" style="color: #FFFFFF; margin-bottom: 0.5rem;">¿Buscas una talla o componente en específico?</h2>
          <p style="color: #CBD5E1; font-size: 0.95rem; line-height: 1.5;">
            Recibimos bicicletas nuevas y seminuevas constantemente. Escríbenos directamente a WhatsApp y te decimos qué viene en camino o te apartamos tu modelo ideal.
          </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <a
            href="https://wa.me/529841381493?text=Hola,%20estoy%20buscando%20una%20bicicleta%20y%20me%20gustar%C3%ADa%20asesor%C3%ADa%20personalizada."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-lg"
          >
            Hablar con un asesor en WhatsApp
          </a>
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            style="color: #94A3B8; font-size: 0.8rem; text-align: center; text-decoration: underline;"
          >
            Ver más fotos en Instagram @thegarage.pdc
          </a>
        </div>
      </div>

    </div>
  </section>
</Base>
