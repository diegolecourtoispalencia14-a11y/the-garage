---
import Base from '../layouts/Base.astro';
import BiciCard from '../components/BiciCard.astro';
import Filtros from '../components/Filtros.astro';
import { getCollection } from 'astro:content';

const bicisEntries = await getCollection('bicis');
const orderMap: Record<string, number> = {
  Disponible: 1,
  Apartada: 2,
  Vendida: 3,
};

const bicis = bicisEntries
  .map(e => e.data)
  .sort((a, b) => {
    const orderA = orderMap[a.disponibilidad] || 99;
    const orderB = orderMap[b.disponibilidad] || 99;
    if (orderA !== orderB) return orderA - orderB;
    return (b.destacada ? 1 : 0) - (a.destacada ? 1 : 0);
  });
---

<Base
  title="THE GARAGE • BIKE EXPERTS | Catálogo de Bicicletas en Playa del Carmen"
  description="Vitrina oficial de The Garage Bike Experts en Playa del Carmen. Bicicletas MTB, Ruta y Urbanas disponibles para entrega en toda la Riviera Maya. Aparta por WhatsApp."
>
  <!-- Hero Section with Specialized/Go Rigo Go High-Performance Aesthetic -->
  <section style="background: radial-gradient(circle at top right, #F1F5F9 0%, #FFFFFF 60%); border-bottom: 2px solid #0F172A; padding: 3.5rem 0 2.5rem 0;">
    <div class="container">
      <div style="max-width: 860px;">
        
        <!-- Badges Bar -->
        <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.45rem; background: #0F172A; color: #FFFFFF; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #FF5722;"></span>
            BIKE EXPERTS
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FFF7ED; border: 1.5px solid #FFEDD5; color: #C2410C; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">
            📍 Playa del Carmen, Q.R.
          </div>
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            style="display: inline-flex; align-items: center; gap: 0.35rem; background: #FDF2F8; border: 1.5px solid #FCE7F3; color: #BE185D; padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 800; transition: transform 0.15s ease;"
            onmouseover="this.style.transform='scale(1.03)'"
            onmouseout="this.style.transform='scale(1)'"
          >
            📸 Instagram @thegarage.pdc
          </a>
        </div>

        <h1 class="title-xl" style="margin-bottom: 1.15rem; color: #0F172A;">
          Bicicletas listas para rodar en la Riviera Maya.
        </h1>
        <p class="subtitle" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 2rem;">
          Vitrina en tiempo real de <strong>The Garage • Bike Experts</strong>. Bicicletas nuevas y seminuevas certificadas por nuestro taller mecánico. <strong>Aparta o agenda tu prueba física por WhatsApp en menos de 1 minuto</strong>.
        </p>

        <!-- Trust Pillars Bar (Specialized-Style) -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; background: #FFFFFF; padding: 0.85rem 1.15rem; border-radius: var(--radius-md); border: 1.5px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.4rem;">🔧</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Taller & Certificación</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Revisión mecánica integral</span>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; background: #FFFFFF; padding: 0.85rem 1.15rem; border-radius: var(--radius-md); border: 1.5px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.4rem;">📍</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Prueba de Manejo</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Cataluña, Playa del Carmen</span>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; background: #FFFFFF; padding: 0.85rem 1.15rem; border-radius: var(--radius-md); border: 1.5px solid var(--border); box-shadow: var(--shadow-sm);">
            <span style="font-size: 1.4rem;">🚚</span>
            <div>
              <strong style="font-size: 0.85rem; color: var(--secondary); display: block;">Entrega en la Riviera</strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Tulum, Cancún, Cozumel</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Inventory Gallery Section -->
  <section style="padding: 2.75rem 0 4rem 0;">
    <div class="container">
      
      <!-- Interactive Filter Bar -->
      <Filtros />

      <!-- Bike Cards Grid -->
      <div class="bici-grid">
        {bicis.map((bici, index) => (
          <BiciCard bici={bici} priority={index === 0} />
        ))}
      </div>

      <!-- Instagram Community & Workshop Banner (Go Rigo Go Style) -->
      <div style="margin-top: 4rem; background: #FFFFFF; border: 2px solid var(--border); border-radius: var(--radius-xl); padding: 2.5rem 2rem; box-shadow: var(--shadow-md);">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; margin-bottom: 2rem;">
          <div>
            <span style="font-size: 0.8rem; font-weight: 800; color: #E1306C; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.25rem;">
              📸 COMUNIDAD & TALLER EN VIVO
            </span>
            <h2 class="title-lg" style="color: var(--secondary);">Síguenos en Instagram @thegarage.pdc</h2>
            <p class="subtitle" style="font-size: 0.95rem; margin-top: 0.25rem;">
              Historias de rodadas, nuevos arribos de inventario y trabajos de taller mecánico en tiempo real.
            </p>
          </div>
          <a
            href="https://www.instagram.com/thegarage.pdc/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn"
            style="background: linear-gradient(45deg, #F58529, #D62976, #962FBF, #4F5BD5); color: #FFFFFF; padding: 0.75rem 1.4rem; font-size: 0.95rem;"
          >
            Ver Instagram Oficial ↗
          </a>
        </div>

        <!-- Social Proof Highlights -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="background: #F8FAFC; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; text-align: center;">
            <div style="font-size: 1.75rem; margin-bottom: 0.25rem;">🏆</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">Marcas Líderes</strong>
            <span style="font-size: 0.8rem; color: var(--text-muted);">Trek, Specialized, Giant, Cannondale</span>
          </div>
          <div style="background: #F8FAFC; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; text-align: center;">
            <div style="font-size: 1.75rem; margin-bottom: 0.25rem;">⚡</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">Apartado Ágil</strong>
            <span style="font-size: 0.8rem; color: var(--text-muted);">Anticipo mínimo y liquidas al recibir</span>
          </div>
          <div style="background: #F8FAFC; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.25rem; text-align: center;">
            <div style="font-size: 1.75rem; margin-bottom: 0.25rem;">🌴</div>
            <strong style="font-size: 0.9rem; color: var(--secondary); display: block;">Hecho en Playa</strong>
            <span style="font-size: 0.8rem; color: var(--text-muted);">Asesoría para ciclistas del Caribe</span>
          </div>
        </div>
      </div>

      <!-- Bottom Assistance Banner -->
      <div style="margin-top: 2.5rem; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; border-radius: var(--radius-xl); padding: 2.5rem 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; box-shadow: var(--shadow-xl); border: 2px solid #334155;">
        <div style="max-width: 600px;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.1em;">THE GARAGE • BIKE EXPERTS</span>
          </div>
          <h2 class="title-lg" style="color: #FFFFFF; margin-bottom: 0.5rem;">¿Buscas una bicicleta a tu medida?</h2>
          <p style="color: #CBD5E1; font-size: 0.95rem; line-height: 1.5;">
            Recibimos bicicletas nuevas y seminuevas constantemente. Dinos qué presupuesto y disciplina buscas y te asesoramos personalmente.
          </p>
        </div>
        <div>
          <a
            href="https://wa.me/529841381493?text=Hola,%20estoy%20buscando%20una%20bicicleta%20y%20me%20gustar%C3%ADa%20asesor%C3%ADa%20personalizada."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-lg"
          >
            Hablar con un asesor en WhatsApp
          </a>
        </div>
      </div>

    </div>
  </section>
</Base>
