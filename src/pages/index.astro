<script>
  function initBikeFinder() {
    let terrain = 'MTB';
    let goal = 'entrenamiento';
    let size = 'M';

    const step1 = document.getElementById('wizard-step-1');
    const step2 = document.getElementById('wizard-step-2');
    const step3 = document.getElementById('wizard-step-3');
    const stepResult = document.getElementById('wizard-result');

    const tab1 = document.getElementById('step-tab-1');
    const tab2 = document.getElementById('step-tab-2');
    const tab3 = document.getElementById('step-tab-3');

    // Terrain Selection
    const terrainBtns = document.querySelectorAll<HTMLButtonElement>('[data-terrain]');
    terrainBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        terrain = btn.getAttribute('data-terrain') || 'MTB';
        if (step1 && step2 && tab1 && tab2) {
          step1.style.display = 'none';
          step2.style.display = 'block';
          tab1.classList.remove('active');
          tab2.classList.add('active');
        }
      });
    });

    // Goal Selection
    const goalBtns = document.querySelectorAll<HTMLButtonElement>('[data-goal]');
    goalBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        goal = btn.getAttribute('data-goal') || 'entrenamiento';
        if (step2 && step3 && tab2 && tab3) {
          step2.style.display = 'none';
          step3.style.display = 'block';
          tab2.classList.remove('active');
          tab3.classList.add('active');
        }
      });
    });

    // Size Selection & Calculate Result
    const sizeBtns = document.querySelectorAll<HTMLButtonElement>('[data-size]');
    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        size = btn.getAttribute('data-size') || 'M';
        calculateResult();
      });
    });

    // Back Buttons
    document.getElementById('back-to-1')?.addEventListener('click', () => {
      if (step1 && step2 && tab1 && tab2) {
        step2.style.display = 'none';
        step1.style.display = 'block';
        tab2.classList.remove('active');
        tab1.classList.add('active');
      }
    });

    document.getElementById('back-to-2')?.addEventListener('click', () => {
      if (step2 && step3 && tab2 && tab3) {
        step3.style.display = 'none';
        step2.style.display = 'block';
        tab3.classList.remove('active');
        tab2.classList.add('active');
      }
    });

    // Restart
    document.getElementById('restart-finder')?.addEventListener('click', () => {
      if (step1 && stepResult && tab1 && tab3) {
        stepResult.style.display = 'none';
        step1.style.display = 'block';
        tab3.classList.remove('active');
        tab1.classList.add('active');
      }
    });

    function calculateResult() {
      const resImg = document.getElementById('res-img') as HTMLImageElement;
      const resCat = document.getElementById('res-cat');
      const resTitle = document.getElementById('res-title');
      const resPrice = document.getElementById('res-price');
      const resDesc = document.getElementById('res-desc');
      const resWa = document.getElementById('res-wa-link') as HTMLAnchorElement;

      let modelTitle = 'Merida Scultura 300 Shimano Tiagra';
      let modelPrice = '$19,800 MXN';
      let modelCat = 'RUTA & ENTRENAMIENTO • TALLA ' + size;
      let modelImg = '/img/bicis/merida-scultura-tiagra-1.webp';
      let modelDesc = 'Ideal para tu objetivo de rendimiento en asfalto. Cuadro ligero de aluminio con horquilla de carbono, grupo Shimano Tiagra 2x10 vel y ergonomía rápida.';

      if (terrain === 'MTB' || goal === 'iniciacion') {
        modelTitle = 'Oferta Relámpago MTB R29 Shimano';
        modelPrice = '$7,900 MXN';
        modelCat = 'MONTAÑA & SENDEROS • TALLA ' + size;
        modelImg = '/img/bicis/oferta-relampago-mtb-r29-1.webp';
        modelDesc = 'Perfecta para senderos de la Riviera Maya y paseos todo terreno. Rodada 29", suspensión delantera, transmisión Shimano y frenos de disco hidráulicos.';
      } else if (goal === 'competencia') {
        modelTitle = 'Basso Bikes Italia Custom Build';
        modelPrice = 'Cotización Personalizada';
        modelCat = 'COMPETENCIA & ÉLITE • TALLA ' + size;
        modelImg = '/img/instagram/live-ig-thegarage.pdcDG6tlpFv-Pq.jpg';
        modelDesc = 'Cuadro monocasco de carbono Torayca hecho a mano en Italia, grupo electrónico y ruedas de carbono para el más alto nivel competitivo.';
      }

      if (resImg) resImg.src = modelImg;
      if (resCat) resCat.textContent = modelCat;
      if (resTitle) resTitle.textContent = modelTitle;
      if (resPrice) resPrice.textContent = modelPrice;
      if (resDesc) resDesc.textContent = modelDesc;
      if (resWa) {
        resWa.href = `https://wa.me/529841381493?text=${encodeURIComponent(`Hola, completé el test interactivo en la web y mi resultado fue: ${modelTitle} (${modelPrice}). Me gustaría más información.`)}`;
      }

      if (step3 && stepResult && tab3) {
        step3.style.display = 'none';
        stepResult.style.display = 'block';
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBikeFinder);
  } else {
    initBikeFinder();
  }
</script>
