---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const bicisEntries = await getCollection('bicis');
const bicis = bicisEntries.map(e => e.data);
---

<Base
  title="THE GARAGE • BIKE EXPERTS | Boutique Ciclista & Taller en Playa del Carmen"
  description="Distribuidor oficial Basso Bikes Italia en Playa del Carmen. Taller especializado SRAM/Shimano, nutrición Wayfar, rodadas The Garage Ride y asesoría personalizada."
>
  <!-- Main Bento Container -->
  <main class="bento-container">
    
    <!-- Simulation Top Bar -->
    <div class="top-status-bar">
      <div class="status-left">
        <span class="status-dot-pulse"></span>
        <span class="status-text font-mono">TIENDA &amp; TALLER ABIERTO • CATALUÑA CASA 19, PDC</span>
      </div>
      <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer" class="ig-pill font-mono">
        📸 @thegarage.pdc ↗
      </a>
    </div>

    <!-- BENTO SECTION 1: HERO & TALLER CIRUGÍA -->
    <div class="bento-grid-hero" id="sec-hero">
      
      <!-- Big Hero Bento Box -->
      <div class="bento-card bento-hero-main">
        <div>
          <div class="hero-badges-row">
            <span class="badge-basso font-mono">
              DISTRIBUIDOR OFICIAL BASSO BIKES
            </span>
            <span class="badge-location font-mono">PLAYA DEL CARMEN, Q.R.</span>
          </div>

          <h1 class="hero-title">
            Ingeniería italiana.<br />
            <span class="hero-title-accent">Pasión en el Caribe.</span>
          </h1>

          <p class="hero-description">
            Bicicletas de ruta, gravel y montaña de alto rendimiento. Distribuidores oficiales de <strong>Basso Bikes</strong> en la Riviera Maya, servicio técnico de precisión SRAM/Shimano y nutrición <strong>Wayfar</strong>.
          </p>
        </div>

        <div class="hero-action-footer">
          <a href="#sec-matchmaker" class="btn btn-hero-match">
            🎯 Probar Asesor de Bicicleta
          </a>
          <a
            href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20hacer%20una%20consulta%20con%20un%20experto%20de%20The%20Garage."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
          >
            <span>💬 Concierge WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Side Bento Box: Taller de Cirugía -->
      <div class="bento-card bento-taller-side">
        <div>
          <div class="taller-top-meta">
            <span class="font-mono taller-tag">01 // CIRUGÍA TALLER</span>
            <span class="taller-open-badge">
              <span class="open-dot"></span> Abierto Hoy
            </span>
          </div>
          <h2 class="taller-title">Ajuste &amp; Calibración Milimétrica</h2>
          <p class="taller-desc">
            Transmisiones electrónicas SRAM AXS &amp; Shimano Di2, purgado de frenos hidráulicos y mantenimiento mayor de suspensiones.
          </p>
        </div>

        <div class="taller-specs-list">
          <div class="taller-spec-item font-mono">
            <span>1er Mantenimiento:</span>
            <strong>Gratis a 30 días</strong>
          </div>
          <div class="taller-spec-item font-mono">
            <span>Nutrición Deportiva:</span>
            <strong style="color: #FB7185;">Punto Oficial Wayfar</strong>
          </div>
          <div class="taller-spec-item font-mono">
            <span>Diagnóstico:</span>
            <strong>Sin Costo en Tienda</strong>
          </div>
        </div>
      </div>

    </div>

    <!-- BENTO SECTION 2: INTERACTIVE MATCHMAKER -->
    <div class="bento-card bento-matchmaker-card" id="sec-matchmaker">
      <div class="matchmaker-header">
        <div>
          <span class="font-mono matchmaker-tag">02 // ASESOR INTERACTIVO</span>
          <h2 class="matchmaker-title">¿Qué bicicleta hace match contigo?</h2>
        </div>
        <div class="matchmaker-step-badge font-mono" id="wizard-step-label">
          Paso 1 de 3
        </div>
      </div>

      <!-- Step 1: Terrain -->
      <div id="step-terrain" class="match-step-box">
        <p class="step-instruction">Selecciona el tipo de terreno donde más ruedas:</p>
        <div class="match-options-grid">
          <button type="button" class="match-opt-btn" data-terrain="MTB">
            <span class="opt-emoji">🌲</span>
            <strong>Senderos &amp; MTB</strong>
            <span>Raíces, terracerías de la Riviera y aventura todoterreno.</span>
          </button>
          <button type="button" class="match-opt-btn" data-terrain="Ruta">
            <span class="opt-emoji">⚡</span>
            <strong>Ruta &amp; Asfalto</strong>
            <span>Velocidad aerodinámica, cadencia y fondos largos en carretera.</span>
          </button>
          <button type="button" class="match-opt-btn" data-terrain="Gravel">
            <span class="opt-emoji">🌴</span>
            <strong>Gravel &amp; Mixto</strong>
            <span>50% asfalto y 50% terracería con libertad total.</span>
          </button>
        </div>
      </div>

      <!-- Step 2: Goal (Hidden initially) -->
      <div id="step-goal" class="match-step-box" style="display: none;">
        <p class="step-instruction">¿Cuál es tu objetivo de uso?</p>
        <div class="match-options-grid">
          <button type="button" class="match-opt-btn" data-goal="iniciacion">
            <span class="opt-emoji">🌱</span>
            <strong>Iniciación &amp; Paseo</strong>
            <span>Disfrutar el fin de semana y empezar a rodar seguro.</span>
          </button>
          <button type="button" class="match-opt-btn" data-goal="entrenamiento">
            <span class="opt-emoji">🔥</span>
            <strong>Entrenamiento &amp; Fondo</strong>
            <span>Rodadas constantes de 40 a 100km buscando superarte.</span>
          </button>
          <button type="button" class="match-opt-btn" data-goal="competencia">
            <span class="opt-emoji">🏆</span>
            <strong>Carreras &amp; Alta Gama</strong>
            <span>Máxima ligereza, precisión de cambio y competencia.</span>
          </button>
        </div>
        <button type="button" class="btn-step-back font-mono" id="btn-back-terrain">← Volver al paso anterior</button>
      </div>

      <!-- Step 3: Size (Hidden initially) -->
      <div id="step-size" class="match-step-box" style="display: none;">
        <p class="step-instruction">¿Cuál es tu rango de estatura?</p>
        <div class="match-options-grid">
          <button type="button" class="match-opt-btn" data-size="S">
            <span class="opt-emoji">📏</span>
            <strong>1.55 m – 1.68 m</strong>
            <span>Talla Pequeña (S / 48-51 cm)</span>
          </button>
          <button type="button" class="match-opt-btn" data-size="M">
            <span class="opt-emoji">📏</span>
            <strong>1.68 m – 1.78 m</strong>
            <span>Talla Mediana (M / 52-54 cm)</span>
          </button>
          <button type="button" class="match-opt-btn" data-size="L">
            <span class="opt-emoji">📏</span>
            <strong>1.78 m – 1.90 m</strong>
            <span>Talla Grande (L / 55-58 cm)</span>
          </button>
        </div>
        <button type="button" class="btn-step-back font-mono" id="btn-back-goal">← Volver al paso anterior</button>
      </div>

      <!-- Dynamic Result -->
      <div id="step-result" class="match-result-card" style="display: none;">
        <div class="result-badge font-mono">✨ 98% MATCH ENCONTRADO EN TIENDA</div>
        <div class="result-content-grid">
          <div class="result-image-box">
            <img id="res-img" src="/img/bicis/merida-scultura-tiagra-1.webp" alt="Bicicleta recomendada" />
          </div>
          <div class="result-data-box">
            <span class="result-meta font-mono" id="res-cat">RUTA &amp; ENTRENAMIENTO</span>
            <h3 class="result-bike-title" id="res-title">Merida Scultura 300 Shimano Tiagra</h3>
            <div class="result-bike-price" id="res-price">$19,800 MXN</div>
            <p class="result-bike-desc" id="res-desc">
              Cuadro ligero de aluminio con horquilla de carbono, grupo Shimano Tiagra 2x10 vel y ergonomía rápida para asfalto.
            </p>
            <div class="result-btn-row">
              <a href="#" id="res-wa-btn" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
                Apartar esta Unidad por WhatsApp
              </a>
              <button type="button" class="btn btn-outline" id="btn-restart-match" style="color: #FFFFFF; border-color: #3F3F46;">
                Reiniciar Test ↻
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- BENTO SECTION 3: SPOTLIGHT DROPS (Real Store Inventory) -->
    <div class="bento-drops-grid" id="sec-drops">
      
      <!-- Drop 1: Merida -->
      <div class="bento-card drop-card-item">
        <div class="drop-media-wrap">
          <img src="/img/bicis/merida-scultura-tiagra-1.webp" alt="Merida Scultura 300" />
          <div class="drop-pill-status font-mono">● DISPONIBLE</div>
          <div class="drop-pill-price font-mono">$19,800 MXN</div>
        </div>
        <div class="drop-info-wrap">
          <span class="font-mono drop-num">DROP 01 // RUTA</span>
          <h3 class="drop-name">Merida Scultura 300 Shimano Tiagra</h3>
          <p class="drop-specs">Talla S/M (52 cm) • Cuadro aluminio + horquilla carbono • 2x10 vel.</p>
          <a
            href="https://wa.me/529841381493?text=Hola,%20me%20interesa%20la%20Merida%20Scultura%20300%20disponible%20en%20tienda."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-drop-action"
          >
            Apartar por WhatsApp
          </a>
        </div>
      </div>

      <!-- Drop 2: MTB R29 -->
      <div class="bento-card drop-card-item">
        <div class="drop-media-wrap">
          <img src="/img/bicis/oferta-relampago-mtb-r29-1.webp" alt="Oferta Relámpago MTB" />
          <div class="drop-pill-status font-mono" style="background: rgba(113, 113, 122, 0.85);">● VENDIDA</div>
          <div class="drop-pill-price font-mono">$7,900 MXN</div>
        </div>
        <div class="drop-info-wrap">
          <span class="font-mono drop-num">DROP 02 // MTB</span>
          <h3 class="drop-name">Oferta Relámpago MTB R29 Shimano</h3>
          <p class="drop-specs">Talla M • Frenos de disco hidráulicos • Suspensión delantera • 2x8 vel.</p>
          <a
            href="https://wa.me/529841381493?text=Hola,%20vi%20la%20MTB%20R29%20vendida,%20%C2%BFtienen%20otra%20similar%20en%20tienda?"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-drop-action"
            style="color: #A1A1AA; border-color: #3F3F46;"
          >
            Pedir Bicicleta Similar
          </a>
        </div>
      </div>

    </div>

    <!-- BENTO SECTION 4: COMMUNITY & RIDERS CLUB -->
    <div class="bento-card bento-riders-card" id="sec-riders">
      <div class="riders-header-row">
        <div>
          <span class="font-mono riders-tag">04 // COMUNIDAD ACTIVA</span>
          <h2 class="riders-title">The Garage Ride &amp; Clásica 7:30 XCO</h2>
        </div>
        <a href="https://www.instagram.com/thegarage.pdc/" target="_blank" rel="noopener noreferrer" class="font-mono riders-ig-link">
          Ver Perfil @thegarage.pdc ↗
        </a>
      </div>

      <p class="riders-desc">
        Salidas sabatinas hacia Cenotes, Tulum y rutas costeras con vehículo barredora, hidratación oficial Wayfar y soporte técnico en ruta.
      </p>

      <div class="riders-actions-row">
        <a
          href="https://wa.me/529841381493?text=Hola,%20quiero%20unirme%20a%20la%20pr%C3%B3xima%20rodada%20de%20The%20Garage%20Ride."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-hero-match"
        >
          Unirme a la Próxima Rodada
        </a>
        <a href="/comunidad" class="btn btn-outline" style="color: #FFFFFF; border-color: #3F3F46;">
          Explorar Muro de Fotos Reales →
        </a>
      </div>
    </div>

  </main>

  <!-- FLOATING DOCK (Shopify Editions Signature Navigation) -->
  <nav class="floating-dock" aria-label="Navegación Rápida">
    <button type="button" class="dock-pill active" data-target="sec-hero">01 Hero</button>
    <button type="button" class="dock-pill" data-target="sec-matchmaker">02 Asesor</button>
    <button type="button" class="dock-pill" data-target="sec-drops">03 Drops</button>
    <button type="button" class="dock-pill" data-target="sec-riders">04 Riders</button>
    <a href="/inventario" class="dock-pill font-mono dock-cat-link">Catálogo ↗</a>
  </nav>
</Base>

<style>
  .font-mono {
    font-family: var(--font-mono);
  }

  .bento-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 8rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Top Status Bar */
  .top-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .status-dot-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22C55E;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.35);
  }

  .status-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: #D4D4D8;
    letter-spacing: 0.05em;
  }

  .ig-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: #FB7185;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .ig-pill:hover {
    opacity: 0.8;
  }

  /* Bento Cards Base */
  .bento-card {
    position: relative;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    transition: all 0.3s var(--ease-spring);
    overflow: hidden;
  }

  .bento-card:hover {
    border-color: rgba(225, 29, 72, 0.35);
    box-shadow: 0 16px 36px -8px rgba(225, 29, 72, 0.12);
  }

  /* Bento Grid Hero */
  .bento-grid-hero {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 1.5rem;
  }

  .bento-hero-main {
    padding: 3rem 2.5rem;
    background: radial-gradient(circle at top right, rgba(225, 29, 72, 0.15) 0%, #141418 70%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 440px;
  }

  .hero-badges-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .badge-basso {
    background: rgba(225, 29, 72, 0.12);
    border: 1px solid rgba(225, 29, 72, 0.3);
    color: #FB7185;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .badge-location {
    font-size: 0.7rem;
    color: #71717A;
  }

  .hero-title {
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
  }

  .hero-title-accent {
    color: #A1A1AA;
    font-weight: 800;
  }

  .hero-description {
    color: #A1A1AA;
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 560px;
  }

  .hero-action-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-hero-match {
    background: #FFFFFF;
    color: #09090B;
    font-weight: 800;
    padding: 0.75rem 1.6rem;
  }
  .btn-hero-match:hover {
    background: #E4E4E7;
    transform: translateY(-2px);
  }

  /* Bento Side: Taller */
  .bento-taller-side {
    padding: 2rem;
    background: linear-gradient(180deg, #18181B 0%, #121215 100%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .taller-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .taller-tag {
    font-size: 0.7rem;
    color: #71717A;
    letter-spacing: 0.08em;
  }
  .taller-open-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #4ADE80;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .open-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22C55E;
  }

  .taller-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }
  .taller-desc {
    font-size: 0.85rem;
    color: #A1A1AA;
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .taller-specs-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .taller-spec-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #71717A;
  }
  .taller-spec-item strong {
    color: #F4F4F5;
  }

  /* Matchmaker Section */
  .bento-matchmaker-card {
    padding: 2.5rem;
  }
  .matchmaker-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .matchmaker-tag {
    font-size: 0.72rem;
    color: #FB7185;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .matchmaker-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #FFFFFF;
    margin-top: 0.25rem;
  }
  .matchmaker-step-badge {
    font-size: 0.75rem;
    background: #27272A;
    color: #D4D4D8;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .step-instruction {
    font-size: 0.95rem;
    color: #A1A1AA;
    margin-bottom: 1.25rem;
  }

  .match-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .match-opt-btn {
    background: #18181B;
    border: 1.5px solid #27272A;
    border-radius: 16px;
    padding: 1.5rem 1.25rem;
    text-align: left;
    color: #FFFFFF;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition: all 0.2s var(--ease-spring);
  }
  .match-opt-btn:hover {
    border-color: #E11D48;
    background: #27272A;
    transform: translateY(-3px);
  }
  .opt-emoji {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  .match-opt-btn strong {
    font-size: 1.05rem;
    display: block;
    margin-bottom: 0.25rem;
  }
  .match-opt-btn span {
    font-size: 0.8rem;
    color: #A1A1AA;
    line-height: 1.45;
  }

  .btn-step-back {
    background: transparent;
    border: none;
    color: #71717A;
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .btn-step-back:hover {
    color: #FFFFFF;
  }

  /* Result Box */
  .result-badge {
    display: inline-block;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid #22C55E;
    color: #4ADE80;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }
  .result-content-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
    align-items: center;
  }
  .result-image-box {
    aspect-ratio: 1/1;
    border-radius: 16px;
    overflow: hidden;
    background: #09090B;
  }
  .result-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .result-meta {
    font-size: 0.75rem;
    color: #A1A1AA;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .result-bike-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0.35rem 0;
  }
  .result-bike-price {
    font-size: 1.5rem;
    font-weight: 900;
    color: #22C55E;
    margin-bottom: 0.85rem;
  }
  .result-bike-desc {
    font-size: 0.88rem;
    color: #A1A1AA;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .result-btn-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Drops Section */
  .bento-drops-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .drop-card-item {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .drop-media-wrap {
    position: relative;
    aspect-ratio: 16/10;
    border-radius: 16px;
    overflow: hidden;
    background: #09090B;
    margin-bottom: 1.25rem;
  }
  .drop-media-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-spring);
  }
  .drop-card-item:hover .drop-media-wrap img {
    transform: scale(1.04);
  }
  .drop-pill-status {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(34, 197, 94, 0.9);
    color: #09090B;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .drop-pill-price {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(0, 0, 0, 0.75);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
  }
  .drop-num {
    font-size: 0.7rem;
    color: #71717A;
    letter-spacing: 0.08em;
  }
  .drop-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0.25rem 0;
  }
  .drop-specs {
    font-size: 0.82rem;
    color: #A1A1AA;
    margin-bottom: 1.25rem;
  }
  .btn-drop-action {
    width: 100%;
    padding: 0.65rem 1rem;
    font-size: 0.85rem;
    text-align: center;
  }

  /* Riders Card */
  .bento-riders-card {
    padding: 3rem 2.5rem;
  }
  .riders-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .riders-tag {
    font-size: 0.72rem;
    color: #4ADE80;
    letter-spacing: 0.08em;
  }
  .riders-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #FFFFFF;
    margin-top: 0.25rem;
  }
  .riders-ig-link {
    font-size: 0.78rem;
    color: #FB7185;
    text-decoration: none;
  }
  .riders-ig-link:hover {
    text-decoration: underline;
  }
  .riders-desc {
    font-size: 0.95rem;
    color: #A1A1AA;
    line-height: 1.65;
    max-width: 680px;
    margin-bottom: 2rem;
  }
  .riders-actions-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Floating Dock Navigation */
  .floating-dock {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(18, 18, 22, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 1000;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }

  .dock-pill {
    padding: 8px 14px;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 700;
    color: #A1A1AA;
    transition: all 0.2s var(--ease-spring);
    cursor: pointer;
    border: none;
    background: transparent;
    white-space: nowrap;
    text-decoration: none;
  }

  .dock-pill:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  .dock-pill.active {
    background: #FFFFFF;
    color: #09090B;
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.2);
  }

  .dock-cat-link {
    color: #FB7185;
  }

  @media (max-width: 860px) {
    .bento-grid-hero {
      grid-template-columns: 1fr;
    }
    .bento-drops-grid {
      grid-template-columns: 1fr;
    }
    .result-content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initLiveBentoExperience() {
    // Dock Smooth Scroll
    const dockPills = document.querySelectorAll<HTMLElement>('.dock-pill[data-target]');
    dockPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const targetId = pill.getAttribute('data-target');
        if (targetId) {
          document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth' });
          dockPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
        }
      });
    });

    // Matchmaker Wizard
    let terrain = 'MTB';
    let goal = 'entrenamiento';
    let size = 'M';

    const stepTerrain = document.getElementById('step-terrain');
    const stepGoal = document.getElementById('step-goal');
    const stepSize = document.getElementById('step-size');
    const stepResult = document.getElementById('step-result');
    const stepLabel = document.getElementById('wizard-step-label');

    // Select Terrain
    document.querySelectorAll<HTMLButtonElement>('[data-terrain]').forEach(btn => {
      btn.addEventListener('click', () => {
        terrain = btn.getAttribute('data-terrain') || 'MTB';
        if (stepTerrain && stepGoal && stepLabel) {
          stepTerrain.style.display = 'none';
          stepGoal.style.display = 'block';
          stepLabel.textContent = 'Paso 2 de 3';
        }
      });
    });

    // Select Goal
    document.querySelectorAll<HTMLButtonElement>('[data-goal]').forEach(btn => {
      btn.addEventListener('click', () => {
        goal = btn.getAttribute('data-goal') || 'entrenamiento';
        if (stepGoal && stepSize && stepLabel) {
          stepGoal.style.display = 'none';
          stepSize.style.display = 'block';
          stepLabel.textContent = 'Paso 3 de 3';
        }
      });
    });

    // Select Size & Render Result
    document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach(btn => {
      btn.addEventListener('click', () => {
        size = btn.getAttribute('data-size') || 'M';
        renderResult();
      });
    });

    // Back to Terrain
    document.getElementById('btn-back-terrain')?.addEventListener('click', () => {
      if (stepTerrain && stepGoal && stepLabel) {
        stepGoal.style.display = 'none';
        stepTerrain.style.display = 'block';
        stepLabel.textContent = 'Paso 1 de 3';
      }
    });

    // Back to Goal
    document.getElementById('btn-back-goal')?.addEventListener('click', () => {
      if (stepGoal && stepSize && stepLabel) {
        stepSize.style.display = 'none';
        stepGoal.style.display = 'block';
        stepLabel.textContent = 'Paso 2 de 3';
      }
    });

    // Restart
    document.getElementById('btn-restart-match')?.addEventListener('click', () => {
      if (stepTerrain && stepResult && stepLabel) {
        stepResult.style.display = 'none';
        stepTerrain.style.display = 'block';
        stepLabel.textContent = 'Paso 1 de 3';
      }
    });

    function renderResult() {
      const resImg = document.getElementById('res-img') as HTMLImageElement;
      const resCat = document.getElementById('res-cat');
      const resTitle = document.getElementById('res-title');
      const resPrice = document.getElementById('res-price');
      const resDesc = document.getElementById('res-desc');
      const resWa = document.getElementById('res-wa-btn') as HTMLAnchorElement;

      let modelTitle = 'Merida Scultura 300 Shimano Tiagra';
      let modelPrice = '$19,800 MXN';
      let modelCat = 'RUTA & ENTRENAMIENTO • TALLA ' + size;
      let modelImg = '/img/bicis/merida-scultura-tiagra-1.webp';
      let modelDesc = 'Ideal para tu objetivo de rendimiento en asfalto. Cuadro ligero de aluminio con horquilla de carbono, grupo Shimano Tiagra 2x10 vel y ergonomía rápida.';

      if (terrain === 'MTB' || goal === 'iniciacion') {
        modelTitle = 'Oferta Relámpago MTB R29 Shimano';
        modelPrice = '$7,900 MXN';
        modelCat = 'MONTAÑA & SENDEROS • TALLA ' + size;
        modelImg = '/img/bicis/oferta-relampago-mtb-r29-1.webp';
        modelDesc = 'Perfecta para senderos de la Riviera Maya y paseos todo terreno. Rodada 29", suspensión delantera, transmisión Shimano y frenos de disco hidráulicos.';
      } else if (goal === 'competencia') {
        modelTitle = 'Basso Bikes Italia Custom Build';
        modelPrice = 'Cotización Personalizada';
        modelCat = 'COMPETENCIA & ÉLITE • TALLA ' + size;
        modelImg = '/img/instagram/live-ig-thegarage.pdcDG6tlpFv-Pq.jpg';
        modelDesc = 'Cuadro monocasco de carbono Torayca hecho a mano en Italia, grupo electrónico y ruedas de carbono para el más alto nivel competitivo.';
      }

      if (resImg) resImg.src = modelImg;
      if (resCat) resCat.textContent = modelCat;
      if (resTitle) resTitle.textContent = modelTitle;
      if (resPrice) resPrice.textContent = modelPrice;
      if (resDesc) resDesc.textContent = modelDesc;
      if (resWa) {
        resWa.href = `https://wa.me/529841381493?text=${encodeURIComponent(`Hola, completé el asesor en la web y mi match fue: ${modelTitle} (${modelPrice}). Me gustaría apartarla.`)}`;
      }

      if (stepSize && stepResult && stepLabel) {
        stepSize.style.display = 'none';
        stepResult.style.display = 'block';
        stepLabel.textContent = 'Match Listo';
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveBentoExperience);
  } else {
    initLiveBentoExperience();
  }
</script>
