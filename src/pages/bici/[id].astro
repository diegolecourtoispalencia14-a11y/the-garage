---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const bicis = await getCollection('bicis');
  return bicis.map((bici) => ({
    params: { id: bici.id },
    props: { bici: bici.data },
  }));
}

const { bici } = Astro.props;

const precioFormateado = bici.precio.toLocaleString('es-MX', {
  style: 'currency',
  currency: bici.moneda || 'MXN',
  maximumFractionDigits: 0,
});

const isVendida = bici.disponibilidad === 'Vendida';
const isApartada = bici.disponibilidad === 'Apartada';

const textoBoton = isVendida
  ? "Preguntar por modelo similar"
  : isApartada
    ? "Consultar disponibilidad / Apartar"
    : "Apartar esta bicicleta por WhatsApp";

const fotos = bici.fotos && bici.fotos.length > 0 ? bici.fotos : ['/img/the-garage-logo-white.png'];
const defaultWaMsg = `Hola, me interesa la ${bici.marca} ${bici.modelo} (${precioFormateado}). ¿Sigue disponible en tienda?`;
const waUrl = `https://wa.me/529841381493?text=${encodeURIComponent(bici.mensajeWhatsApp || defaultWaMsg)}`;
---

<Base
  title={`${bici.marca} ${bici.modelo} (${bici.talla}) | The Garage Playa del Carmen`}
  description={`${bici.marca} ${bici.modelo} en The Garage Bike Experts, Playa del Carmen. Talla ${bici.talla}, ${bici.estado}, ${precioFormateado} MXN. Entrega en toda la Riviera Maya.`}
  image={fotos[0]}
  tipo="product"
>
  <div class="bici-detail-page">
    <div class="container-fluid">
      
      <!-- Breadcrumb Bar -->
      <nav class="breadcrumb-strip font-mono" aria-label="Ruta de navegación">
        <a href="/inventario" class="breadcrumb-link">INVENTARIO</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-cat">{bici.categoria.toUpperCase()}</span>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{bici.marca} {bici.modelo}</span>
      </nav>

      <!-- Main Product Split -->
      <div class="product-layout-grid">
        
        <!-- Left: Gallery Viewport -->
        <div class="gallery-column">
          <div class="main-photo-viewport">
            <img
              id="main-photo"
              src={fotos[0]}
              alt={`${bici.marca} ${bici.modelo} - Playa del Carmen`}
              loading="eager"
            />
            <div class="photo-status-badge font-mono">
              ● {bici.disponibilidad.toUpperCase()}
            </div>
            <div class="photo-condition-badge font-mono">
              {bici.estado.toUpperCase()}
            </div>
          </div>

          <!-- Thumbnails -->
          {fotos.length > 1 && (
            <div class="thumbs-row">
              {fotos.map((foto, i) => (
                <button
                  type="button"
                  class="thumb-btn-tile"
                  onclick={`document.getElementById('main-photo').src = '${foto}'`}
                >
                  <img src={foto} alt={`Foto ${i + 1}`} />
                </button>
              ))}
            </div>
          )}

          <!-- Workshop Seal Card -->
          <div class="workshop-seal-tile">
            <div class="seal-icon-box font-mono">[CERT]</div>
            <div>
              <h4 class="seal-title">Inspección de Taller Certificada</h4>
              <p class="seal-desc">
                Tornillería torqueada con torquímetro mecánico, lubricación y <strong>1er reajuste gratis a los 30 días</strong> en Cataluña Casa 19.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Technical Fiche & Purchase -->
        <div class="specs-column">
          <div class="specs-card-box">
            <div class="meta-header-row font-mono">
              <span class="spec-edition-tag">FICHA TÉCNICA // {bici.categoria.toUpperCase()}</span>
              <span class="spec-size-badge">TALLA {bici.talla}</span>
            </div>

            <h1 class="bike-headline-title">{bici.marca} {bici.modelo}</h1>
            <div class="bike-price-headline font-mono">{precioFormateado}</div>

            <p class="bike-long-desc">{bici.descripcion}</p>

            <!-- Technical Table -->
            <div class="specs-data-table font-mono">
              <div class="spec-data-row">
                <span class="spec-data-key">Cuadro / Chasis</span>
                <span class="spec-data-val">{bici.specs.cuadro}</span>
              </div>
              <div class="spec-data-row">
                <span class="spec-data-key">Grupo / Transmisión</span>
                <span class="spec-data-val">{bici.specs.grupo}</span>
              </div>
              <div class="spec-data-row">
                <span class="spec-data-key">Sistema de Frenos</span>
                <span class="spec-data-val">{bici.specs.frenos}</span>
              </div>
              <div class="spec-data-row">
                <span class="spec-data-key">Rodada / Ruedas</span>
                <span class="spec-data-val">{bici.specs.rodada}</span>
              </div>
              <div class="spec-data-row">
                <span class="spec-data-key">Color / Acabado</span>
                <span class="spec-data-val">{bici.color}</span>
              </div>
            </div>

            <!-- Conversion Action -->
            <div class="detail-action-group">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-whatsapp detail-main-btn"
              >
                <span>{textoBoton}</span>
              </a>
              <a
                href="/guia-tallas"
                class="btn btn-outline detail-secondary-btn"
              >
                Comprobar Talla en Calculadora →
              </a>
            </div>

            <div class="delivery-notice font-mono">
              <span>Entrega inmediata en Playa del Carmen, Tulum, Puerto Aventuras y Cancún.</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</Base>

<style>
  .bici-detail-page {
    padding: var(--space-5) 0 var(--space-9) 0;
  }

  .breadcrumb-strip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--text-muted);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-6);
  }

  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb-link:hover {
    color: #FFFFFF;
  }
  .breadcrumb-sep {
    color: var(--text-dim);
  }
  .breadcrumb-cat {
    color: #FB7185;
    font-weight: 700;
  }
  .breadcrumb-current {
    color: var(--text-primary);
  }

  .product-layout-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .main-photo-viewport {
    position: relative;
    aspect-ratio: 1/1;
    background: #09090B;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .main-photo-viewport img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-status-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(34, 197, 94, 0.95);
    color: #09090B;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .photo-condition-badge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .thumbs-row {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    overflow-x: auto;
  }
  .thumb-btn-tile {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-hairline);
    background: #09090B;
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    flex-shrink: 0;
  }
  .thumb-btn-tile:hover {
    border-color: #E11D48;
  }
  .thumb-btn-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .workshop-seal-tile {
    margin-top: var(--space-5);
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .seal-icon-box {
    background: rgba(225, 29, 72, 0.15);
    color: #FB7185;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
  }
  .seal-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }
  .seal-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .specs-card-box {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 3.5vw, 3rem);
  }

  .meta-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .spec-edition-tag {
    font-size: 0.75rem;
    color: #FB7185;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .spec-size-badge {
    background: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .bike-headline-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: var(--space-2);
  }

  .bike-price-headline {
    font-size: 2rem;
    font-weight: 900;
    color: #22C55E;
    margin-bottom: var(--space-4);
  }

  .bike-long-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-5);
  }

  .specs-data-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-6);
  }
  .spec-data-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
  }
  .spec-data-key {
    color: var(--text-muted);
  }
  .spec-data-val {
    color: var(--text-primary);
    font-weight: 700;
  }

  .detail-action-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .detail-main-btn {
    width: 100%;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
  }
  .detail-secondary-btn {
    width: 100%;
    padding: 0.75rem 1.5rem;
    font-size: 0.88rem;
    text-align: center;
  }

  .delivery-notice {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-align: center;
  }

  @media (max-width: 900px) {
    .product-layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
