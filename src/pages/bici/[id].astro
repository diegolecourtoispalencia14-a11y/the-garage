---
import Base from '../../layouts/Base.astro';
import BadgeDisponibilidad from '../../components/BadgeDisponibilidad.astro';
import BotonWhatsApp from '../../components/BotonWhatsApp.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const bicis = await getCollection('bicis');
  return bicis.map((bici) => ({
    params: { id: bici.id },
    props: { bici: bici.data },
  }));
}

const { bici } = Astro.props;

const precioFormateado = bici.precio.toLocaleString('es-MX', {
  style: 'currency',
  currency: bici.moneda || 'MXN',
  maximumFractionDigits: 0,
});

const isVendida = bici.disponibilidad === 'Vendida';
const isApartada = bici.disponibilidad === 'Apartada';

const textoBoton = isVendida
  ? "Preguntar por modelo similar"
  : isApartada
    ? "Consultar disponibilidad / Apartar"
    : "Apartar esta bicicleta por WhatsApp";

const fotos = bici.fotos && bici.fotos.length > 0 ? bici.fotos : ['/img/the-garage-logo-transparent.png'];
---

<Base
  title={`${bici.marca} ${bici.modelo} (${bici.talla}) | The Garage Playa del Carmen`}
  description={`${bici.marca} ${bici.modelo} en venta en The Garage Bike Experts, Playa del Carmen. Talla ${bici.talla}, ${bici.estado}, ${precioFormateado} MXN. Entrega en toda la Riviera Maya.`}
  image={fotos[0]}
  tipo="product"
>
  <div style="background: #FFFFFF; border-bottom: 1px solid var(--border); padding: 0.85rem 0;">
    <div class="container">
      <nav aria-label="Ruta de navegación" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">
        <a href="/" style="color: var(--text-muted); text-decoration: underline;">Catálogo</a>
        <span>/</span>
        <span style="color: var(--primary); font-weight: 700;">{bici.categoria}</span>
        <span>/</span>
        <span style="color: var(--secondary);">{bici.marca} {bici.modelo}</span>
      </nav>
    </div>
  </div>

  <section style="padding: 2rem 0 5rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start;">
        
        <!-- Galería de Fotos -->
        <div>
          <!-- Foto Principal -->
          <div style="position: relative; aspect-ratio: 1/1; background-color: #F8FAFC; border-radius: var(--radius-xl); border: 2px solid var(--border); overflow: hidden; box-shadow: var(--shadow-md);">
            <img
              id="main-photo"
              src={fotos[0]}
              alt={`${bici.marca} ${bici.modelo} - Playa del Carmen`}
              style="width: 100%; height: 100%; object-fit: cover;"
              loading="eager"
              fetchpriority="high"
            />
            <div style="position: absolute; top: 1rem; left: 1rem; z-index: 2;">
              <BadgeDisponibilidad disponibilidad={bici.disponibilidad} esMuestra={bici.esMuestra} />
            </div>
            <div style="position: absolute; bottom: 1rem; right: 1rem; z-index: 2;">
              <span class={`badge ${bici.estado === 'Nueva' ? 'badge-nueva' : 'badge-seminueva'}`}>
                {bici.estado}
              </span>
            </div>
          </div>

          <!-- Miniaturas si hay más de 1 foto -->
          {fotos.length > 1 && (
            <div style="display: flex; gap: 0.75rem; margin-top: 1rem; overflow-x: auto; padding-bottom: 0.5rem;">
              {fotos.map((foto, i) => (
                <button
                  type="button"
                  class="thumb-btn"
                  onclick={`document.getElementById('main-photo').src = '${foto}'`}
                  style="flex: 0 0 70px; height: 70px; border-radius: var(--radius-sm); border: 2px solid var(--border); overflow: hidden; background: #F8FAFC; cursor: pointer; padding: 0;"
                >
                  <img src={foto} alt={`Foto ${i + 1}`} style="width: 100%; height: 100%; object-fit: cover;" />
                </button>
              ))}
            </div>
          )}

          <!-- Sello de Taller / Tienda -->
          <div style="margin-top: 2rem; background: #F8FAFC; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
              <div style="width: 40px; height: 40px; border-radius: 50%; background: #0F172A; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 1.25rem;">
                🚲
              </div>
              <div>
                <h4 style="font-weight: 800; font-size: 0.95rem; color: var(--secondary);">Inspección & Taller The Garage</h4>
                <p style="font-size: 0.8rem; color: var(--text-muted);">Revisada por mecánicos profesionales en Playa del Carmen</p>
              </div>
            </div>
            <ul style="list-style: none; font-size: 0.85rem; line-height: 1.8; color: #334155;">
              <li>✓ Ajuste de cambios y tensión de cadena realizado</li>
              <li>✓ Purga y calibración de frenos hidráulicos</li>
              <li>✓ Ajuste ergonómico de altura y manillar gratuito al entregar</li>
            </ul>
          </div>
        </div>

        <!-- Información de Compra y Especificaciones -->
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
            <span style="font-size: 0.85rem; font-weight: 900; color: var(--primary); text-transform: uppercase; letter-spacing: 0.1em;">
              THE GARAGE • {bici.categoria}
            </span>
          </div>

          <h1 class="title-xl" style="margin-bottom: 0.75rem; line-height: 1.15;">
            {bici.marca} {bici.modelo}
          </h1>

          <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1.5rem;">
            <span style="font-size: 2.25rem; font-weight: 900; color: var(--secondary); letter-spacing: -0.03em;">
              {precioFormateado}
            </span>
            <span style="font-size: 1rem; font-weight: 700; color: var(--text-muted);">
              {bici.moneda || 'MXN'} (Pesos Mexicanos)
            </span>
          </div>

          <!-- Botón de Acción Principal -->
          <div style="background: #FFFFFF; border: 2px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
            <p style="font-size: 0.9rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.85rem;">
              ¿Te interesa esta bicicleta?
            </p>
            <BotonWhatsApp
              mensaje={bici.mensajeWhatsApp}
              texto={textoBoton}
              tamano="lg"
              fullWidth={true}
            />
            <p style="font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-top: 0.75rem;">
              ⚡ Respuesta inmediata de nuestro equipo en Playa del Carmen
            </p>
          </div>

          <!-- Cuadrícula de Especificaciones Físicas -->
          <h3 class="title-md" style="margin-bottom: 1rem; color: var(--secondary); border-bottom: 2px solid #0F172A; padding-bottom: 0.4rem;">
            Ficha Técnica & Componentes
          </h3>

          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.85rem; margin-bottom: 2rem;">
            <div style="background: #FFFFFF; border: 1px solid var(--border); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
              <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block;">Talla de Cuadro</span>
              <strong style="font-size: 1rem; color: var(--secondary);">{bici.talla}</strong>
            </div>
            <div style="background: #FFFFFF; border: 1px solid var(--border); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
              <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block;">Color</span>
              <strong style="font-size: 1rem; color: var(--secondary);">{bici.color}</strong>
            </div>

            {bici.specs?.cuadro && (
              <div style="background: #FFFFFF; border: 1px solid var(--border); padding: 0.85rem 1rem; border-radius: var(--radius-md); grid-column: span 2;">
                <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block;">Material del Cuadro</span>
                <strong style="font-size: 0.95rem; color: var(--secondary);">{bici.specs.cuadro}</strong>
              </div>
            )}

            {bici.specs?.grupo && (
              <div style="background: #FFFFFF; border: 1px solid var(--border); padding: 0.85rem 1rem; border-radius: var(--radius-md); grid-column: span 2;">
                <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block;">Transmisión / Grupo</span>
                <strong style="font-size: 0.95rem; color: var(--secondary);">{bici.specs.grupo}</strong>
              </div>
            )}

            {bici.specs?.frenos && (
              <div style="background: #FFFFFF; border: 1px solid var(--border); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
                <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block;">Sistema de Frenos</span>
                <strong style="font-size: 0.95rem; color: var(--secondary);">{bici.specs.frenos}</strong>
              </div>
            )}

            {bici.specs?.rodada && (
              <div style="background: #FFFFFF; border: 1px solid var(--border); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
                <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: block;">Rodada de Llanta</span>
                <strong style="font-size: 0.95rem; color: var(--secondary);">{bici.specs.rodada}</strong>
              </div>
            )}
          </div>

          <!-- Módulo de Prueba Física en Tienda -->
          <div style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF; padding: 1.5rem; border-radius: var(--radius-lg); border: 2px solid #334155;">
            <h4 style="font-weight: 800; font-size: 1.05rem; margin-bottom: 0.4rem;">📍 ¿Quieres rodarla y probar la talla?</h4>
            <p style="font-size: 0.85rem; color: #CBD5E1; line-height: 1.5; margin-bottom: 1rem;">
              Visítanos en <strong>Av. Ich Xeel CASA 19, Cataluña</strong>, Playa del Carmen. Puedes rodarla frente al local antes de decidir.
            </p>
            <a
              href={`https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20agendar%20una%20visita%20para%20probar%20la%20${encodeURIComponent(bici.marca + ' ' + bici.modelo)}.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
              style="width: 100%; border-color: #475569; color: #0F172A; background: #FFFFFF; font-weight: 800;"
            >
              Agendar prueba de manejo en tienda
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Sticky Mobile Bar (Conversión con el pulgar) -->
  <div class="sticky-mobile-bar">
    <div>
      <span style="font-size: 0.75rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; display: block;">Precio en Tienda</span>
      <span style="font-size: 1.25rem; font-weight: 900; color: var(--secondary);">{precioFormateado}</span>
    </div>
    <a
      href={`https://wa.me/529841381493?text=${encodeURIComponent(bici.mensajeWhatsApp)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-whatsapp"
      style="padding: 0.7rem 1.25rem; font-size: 0.9rem;"
    >
      Apartar por WhatsApp
    </a>
  </div>
</Base>
