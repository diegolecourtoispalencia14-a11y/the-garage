---
// src/pages/bici/[id].astro
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { MASTER_PRODUCTS, getRelatedProducts, type ProductItem } from '../../data/allProducts';

export async function getStaticPaths() {
  // 1. Content collection bicis
  const contentBicis = await getCollection('bicis');
  const contentPaths = contentBicis.map((b) => ({
    params: { id: b.id },
    props: {
      rawBici: {
        id: b.id,
        name: `${b.data.marca} ${b.data.modelo}`,
        brand: b.data.marca,
        cat: b.data.categoria || 'Bicicletas',
        sku: b.data.sku || b.id,
        price: b.data.precio,
        stock: b.data.disponibilidad === 'Vendida' ? 0 : 1,
        talla: b.data.talla,
        color: b.data.color,
        estado: b.data.estado,
        specs: typeof b.data.specs === 'object'
          ? `Cuadro: ${b.data.specs.cuadro} • Grupo: ${b.data.specs.grupo} • Frenos: ${b.data.specs.frenos} • Rodada: ${b.data.specs.rodada}`
          : String(b.data.specs || ''),
        specsObj: typeof b.data.specs === 'object' ? b.data.specs : null,
        fotos: b.data.fotos && b.data.fotos.length > 0 ? b.data.fotos : ['https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=1200&q=80'],
        descripcion: b.data.descripcion || '',
        mensajeWhatsApp: b.data.mensajeWhatsApp,
        precioRenta: b.data.precioRenta,
        modalidad: b.data.modalidad
      }
    }
  }));

  // 2. Master store catalog products (mapped by id, sku, lowercase sku, slug and aliases)
  const masterPaths: any[] = [];
  const registeredIds = new Set<string>();

  contentPaths.forEach(cp => registeredIds.add(cp.params.id.toLowerCase()));

  // Aliases mapping (so any code like TRK-MAR5 or TRK-M5-24 or trek-marlin-5-2024 works)
  const aliasMap: Record<string, string[]> = {
    'TRK-MAR5': ['trk-mar5', 'trk-m5-24', 'trek-marlin-5-2024', '2'],
    'SPZ-RIP-12': ['spz-rip-12', 'specialized-riprock-r12'],
    'BAS-PALT2': ['bas-palt2', 'bas-plt2-c', 'basso-palta-ii-custom', '1'],
    'SPZ-ALZ-SP': ['spz-alz-sp', 'spz-alz-e5', 'specialized-allez-e5', '3'],
    'GNT-TAL2': ['gnt-tal2', 'gnt-tl2-29', 'giant-talon-2-2024', '4'],
    'MER-SCU300': ['mer-scu300', 'merida-scultura-tiagra', 'merida-scultura-300-tiagra'],
    'SHI-CS-M6100': ['shi-cs-m6100', 'p1', '5'],
    'SRM-NXE-RD': ['srm-nxe-rd', 'p3', '6'],
    'SHI-CRK-M6100': ['shi-crk-m6100', 'p4', '7'],
    'KMC-X12': ['kmc-x12', 'p2', '8'],
    'SHI-MT200': ['shi-mt200', 'p5', '9'],
    'SRM-LVL-T': ['srm-lvl-t', '10'],
    'SHI-B01S': ['shi-b01s', 'p7', '11'],
    'MAX-ARD-29': ['max-ard-29', 'p8', '12'],
    'SCH-MP-35': ['sch-mp-35', '13'],
    'MCH-29P': ['mch-29p', '14'],
    'STA-240': ['sta-240', 'p10', '15'],
    'RF-ATL-35': ['rf-atl-35', '16'],
    'SHI-TIA-90': ['shi-tia-90', '17'],
    'FZK-ALI-G': ['fzk-ali-g', '18'],
    'KS-LEV-150': ['ks-lev-150', '19'],
    'POC-AXR-M': ['poc-axr-m', 'p12', '20'],
    'GIR-FXT2': ['gir-fxt2', 'p13', '21'],
    'SPZ-PRO4': ['spz-pro4', 'p14', '22'],
    'CAS-GAB3-M': ['cas-gab3-m', 'p17', '23'],
    'END-MT500-2': ['end-mt500-2', '24'],
    'SHI-ME5-38': ['shi-me5-38', 'shi-me5-42', 'p15', '25'],
    'FOX-RNG-GL': ['fox-rng-gl', 'p16', '26'],
    'MAU-G100': ['mau-g100', 'mau-g100-12', 'p18', '27'],
    'H5-ELEC47': ['h5-elec47', 'p19', '28'],
    'CMB-POD620': ['cmb-pod620', 'cmb-pod710', 'p20', '29'],
    'GAR-EDG530': ['gar-edg530', 'p21', '30'],
    'GAR-SCAD': ['gar-scad', 'gar-scad2', 'p22', '31'],
    'ANK-20K': ['ank-20k', '32'],
    'BON-AL9': ['bon-al9', 'p23', '33'],
    'RNR-GOLD-4': ['rnr-gold-4', 'p24', '34'],
    'TPK-JB': ['tpk-jb', 'tpk-jb3', 'p25', '35'],
    'REM-TT02': ['rem-tt02', '36'],
    'LEZ-MD1800': ['lez-md1800', 'p26', '37'],
    'CAT-RX3': ['cat-rx3', 'p27', '38'],
    'API-BCK': ['api-bck', 'api-bck-4l', 'p28', '39'],
    'TPK-AWL': ['tpk-awl', '40']
  };

  MASTER_PRODUCTS.forEach((p) => {
    const rawData = {
      id: p.id,
      name: p.name,
      brand: p.brand,
      cat: p.cat,
      sku: p.sku,
      price: p.price,
      precioRenta: p.precioRenta,
      modalidad: p.modalidad,
      stock: p.stock,
      talla: p.talla,
      color: p.color,
      estado: p.estado || 'Seminueva',
      specs: p.specs,
      specsObj: null,
      fotos: p.fotos,
      descripcion: p.specs,
      mensajeWhatsApp: `Hola The Garage, me interesa el producto ${p.name} (${p.sku}). ¿Tienen disponibilidad en tienda física en Playa del Carmen?`
    };

    const keysToAdd = [p.id, p.sku, p.sku.toLowerCase()];
    if (p.slug) {
      keysToAdd.push(p.slug);
      keysToAdd.push(p.slug.toLowerCase());
    }
    if (aliasMap[p.sku]) {
      keysToAdd.push(...aliasMap[p.sku]);
    }

    keysToAdd.forEach(key => {
      const k = String(key).trim();
      if (!registeredIds.has(k.toLowerCase())) {
        registeredIds.add(k.toLowerCase());
        masterPaths.push({
          params: { id: k },
          props: { rawBici: rawData }
        });
      }
    });
  });

  return [...contentPaths, ...masterPaths];
}

const { rawBici } = Astro.props;

// Format prices (+3.5% online fee note)
const webPrice = Math.round(rawBici.price * 1.035);
const precioFormateado = rawBici.price.toLocaleString('es-MX', {
  style: 'currency',
  currency: 'MXN',
  maximumFractionDigits: 0,
});
const webPrecioFormateado = webPrice.toLocaleString('es-MX', {
  style: 'currency',
  currency: 'MXN',
  maximumFractionDigits: 0,
});

const isAgotado = rawBici.stock <= 0;
const isFreeShipping = rawBici.price >= 500;
const fotos = rawBici.fotos && rawBici.fotos.length > 0
  ? rawBici.fotos
  : ['https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=1200&q=80'];

const defaultWaMsg = `Hola The Garage, me interesa ${rawBici.name} (${precioFormateado}). ¿Tienen entrega hoy o atención con cita previa en Playa del Carmen?`;
const waUrl = `https://wa.me/529841381493?text=${encodeURIComponent(rawBici.mensajeWhatsApp || defaultWaMsg)}`;

// Generate related products (cross-selling)
const relatedProducts = getRelatedProducts(rawBici as any, 4);

// Pass JSON to client
const productJson = JSON.stringify({
  id: rawBici.id,
  sku: rawBici.sku,
  name: rawBici.name,
  brand: rawBici.brand,
  cat: rawBici.cat,
  price: rawBici.price,
  webPrice: webPrice,
  stock: rawBici.stock,
  fotos: fotos
});
---

<Base
  title={`${rawBici.name} | The Garage Bike Experts Playa del Carmen`}
  description={`${rawBici.name} en The Garage Playa del Carmen. ${precioFormateado} MXN. Taller a puerta cerrada en Cataluña con cita previa o envío express en Riviera Maya.`}
  image={fotos[0]}
  tipo="product"
>
  <div class="bici-detail-page">
    <div class="container-fluid" style="max-width: 1240px; margin: 0 auto; padding: 0 1.5rem;">
      
      <!-- Top Free Shipping Notification (Playa del Carmen) -->
      <div class="shipping-top-pill">
        <span style="display:inline-flex; align-items:center; gap:0.5rem; justify-content:center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <strong>Envío Gratis en compras desde $500 MXN en Playa del Carmen</strong> (Didi Moto o Retiro con Cita Previa)
        </span>
      </div>

      <!-- Breadcrumb Bar -->
      <nav class="breadcrumb-strip font-mono" aria-label="Ruta de navegación">
        <a href="/inventario" class="breadcrumb-link">INVENTARIO</a>
        <span class="breadcrumb-sep">/</span>
        <a href={`/inventario?cat=${encodeURIComponent(rawBici.cat)}`} class="breadcrumb-cat">{rawBici.cat.toUpperCase()}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{rawBici.name}</span>
      </nav>

      <!-- Main Product Split -->
      <div class="product-layout-grid">
        
        <!-- Left: Gallery Viewport & Thumbnails -->
        <div class="gallery-column">
          <div class="main-photo-viewport">
            <img
              id="main-photo"
              src={fotos[0]}
              alt={`${rawBici.name} - The Garage Playa del Carmen`}
              loading="eager"
            />
            
            <!-- Badges -->
            <div class="photo-badges-layer">
              <span class={`photo-status-badge font-mono ${isAgotado ? 'badge-out' : 'badge-stock'}`}>
                ● {isAgotado ? 'AGOTADO EN TIENDA' : 'DISPONIBLE EN TIENDA FÍSICA'}
              </span>
              {isFreeShipping && (
                <span class="photo-shipping-badge font-mono">
                  ENVÍO GRATIS (PDC)
                </span>
              )}
            </div>

            {rawBici.estado && (
              <div class="photo-condition-badge font-mono">
                {rawBici.estado.toUpperCase()}
              </div>
            )}
          </div>

          <!-- Thumbnails Row -->
          {fotos.length > 1 && (
            <div class="thumbs-row">
              {fotos.map((foto: string, i: number) => (
                <button
                  type="button"
                  class={`thumb-btn-tile ${i === 0 ? 'active' : ''}`}
                  onclick={`document.getElementById('main-photo').src = '${foto}'; document.querySelectorAll('.thumb-btn-tile').forEach(b => b.classList.remove('active')); this.classList.add('active');`}
                  title={`Ver fotografía ${i + 1}`}
                >
                  <img src={foto} alt={`${rawBici.name} foto ${i + 1}`} />
                </button>
              ))}
            </div>
          )}

          <!-- Workshop Seal Card -->
          <div class="workshop-seal-tile">
            <div class="seal-icon-box font-mono">CERT</div>
            <div>
              <h4 class="seal-title">Garantía & Taller The Garage</h4>
              <p class="seal-desc">
                Inspección mecánica profesional, ajuste de torque certificado y <strong>1er reajuste gratis a los 30 días</strong> en nuestro taller especializado de Cataluña (Cita Previa), Playa del Carmen.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Technical Fiche, Pricing & Actions -->
        <div class="specs-column">
          <div class="specs-card-box">
            
            <!-- Meta Tag Row -->
            <div class="meta-header-row font-mono">
              <span class="spec-edition-tag">{rawBici.brand.toUpperCase()} // {rawBici.cat.toUpperCase()}</span>
              {rawBici.talla && <span class="spec-size-badge">TALLA {rawBici.talla}</span>}
            </div>

            <h1 class="bike-headline-title">{rawBici.name}</h1>
            
            <!-- Price Display -->
            <div class="price-container-box">
              <div class="bike-price-headline font-mono">{precioFormateado}</div>
              <div class="price-online-note font-mono">
                Precio tienda física • Pago en línea: <strong>{webPrecioFormateado}</strong> (+3.5% pasarela)
              </div>
            </div>

            <!-- Description -->
            <p class="bike-long-desc">{rawBici.descripcion || rawBici.specs}</p>

            <!-- Technical Specifications Table -->
            <div class="specs-data-table font-mono">
              {rawBici.brand && (
                <div class="spec-data-row">
                  <span class="spec-data-key">Marca Oficial</span>
                  <span class="spec-data-val">{rawBici.brand}</span>
                </div>
              )}
              {rawBici.sku && (
                <div class="spec-data-row">
                  <span class="spec-data-key">Código SKU</span>
                  <span class="spec-data-val">{rawBici.sku}</span>
                </div>
              )}
              {rawBici.color && (
                <div class="spec-data-row">
                  <span class="spec-data-key">Color / Acabado</span>
                  <span class="spec-data-val">{rawBici.color}</span>
                </div>
              )}
              {rawBici.specsObj ? (
                <>
                  <div class="spec-data-row">
                    <span class="spec-data-key">Cuadro / Chasis</span>
                    <span class="spec-data-val">{rawBici.specsObj.cuadro}</span>
                  </div>
                  <div class="spec-data-row">
                    <span class="spec-data-key">Transmisión</span>
                    <span class="spec-data-val">{rawBici.specsObj.grupo}</span>
                  </div>
                  <div class="spec-data-row">
                    <span class="spec-data-key">Frenos</span>
                    <span class="spec-data-val">{rawBici.specsObj.frenos}</span>
                  </div>
                  <div class="spec-data-row">
                    <span class="spec-data-key">Rodada / Ruedas</span>
                    <span class="spec-data-val">{rawBici.specsObj.rodada}</span>
                  </div>
                </>
              ) : (
                <div class="spec-data-row" style="flex-direction:column; gap:0.25rem; align-items:flex-start;">
                  <span class="spec-data-key">Especificaciones Técnicas</span>
                  <span class="spec-data-val" style="font-weight:400; line-height:1.5;">{rawBici.specs}</span>
                </div>
              )}
              <div class="spec-data-row">
                <span class="spec-data-key">Disponibilidad en Tienda</span>
                <span class="spec-data-val" style="color:#34c759;">
                  {rawBici.stock > 0 ? `En Almacén (${rawBici.stock} unidades)` : 'Consultar pedido'}
                </span>
              </div>
            </div>

            {rawBici.precioRenta && (
              <div style="background:linear-gradient(135deg, rgba(0,113,227,0.12), rgba(52,199,89,0.08)); border:1px solid rgba(0,113,227,0.28); border-radius:12px; padding:0.9rem 1.15rem; margin-bottom:1.25rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
                <div>
                  <div style="display:flex; align-items:center; gap:0.4rem; color:#2997ff; font-weight:700; font-size:0.82rem; text-transform:uppercase; letter-spacing:0.04em;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="m12 17.5 2.5-7.5H6l3.5 7.5"/><path d="M12 17.5 9.5 10H6"/><path d="m15 5-3 5"/></svg>
                    <span>¿Prefieres Rentarla o Probarla Antes de Comprar?</span>
                  </div>
                  <p style="margin:0.25rem 0 0; font-size:0.8rem; color:#d4d4d8;">
                    Disponible en flota de renta por <strong>${rawBici.precioRenta} MXN / día</strong> (casco y candado incluidos). Si decides comprarla, ¡te bonificamos la renta!
                  </p>
                </div>
                <a href="/renta" style="background:#0071e3; color:#ffffff; text-decoration:none; font-weight:700; font-size:0.8rem; padding:0.45rem 0.9rem; border-radius:8px; display:inline-flex; align-items:center; gap:0.35rem; white-space:nowrap;">
                  <span>Ver Renta &rarr;</span>
                </a>
              </div>
            )}

            <!-- Scarcity / High Demand Alert -->
            <div class="urgency-banner font-mono">
              <span class="status-dot"></span> 
              <span>STOCK FÍSICO INMEDIATO EN PLAYA DEL CARMEN // TALLER CATALUÑA (CITA PREVIA)</span>
            </div>

            <!-- Primary Actions: Add to Cart + WhatsApp Buy -->
            <div class="detail-action-group">
              <button
                type="button"
                id="btn-add-to-cart-page"
                class="btn-dualtone-cart-main"
              >
                <span class="btn-cart-label">Agregar al Carrito de Compra</span>
                <span class="btn-cart-pill">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                </span>
              </button>

              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-dualtone-wa-main"
              >
                <span class="btn-wa-label">Apartar o Consultar por WhatsApp</span>
                <span class="btn-wa-pill">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.152.57 4.17 1.564 5.91l-1.564 5.708 5.867-1.538c1.701.928 3.652 1.458 5.727 1.458 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/></svg>
                </span>
              </a>

              {rawBici.cat === 'Bicicletas' && (
                <a
                  href="/guia-tallas"
                  class="btn-glass-secondary"
                  style="text-align:center; padding:0.85rem; border-radius:12px; text-decoration:none; font-weight:600; font-size:0.9rem; display:flex; align-items:center; justify-content:center; gap:0.5rem;"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                  <span>Comprobar Talla en Calculadora Virtual →</span>
                </a>
              )}
            </div>

            <!-- Delivery & Local Pick-up Notice -->
            <div class="delivery-notice font-mono" style="display:flex; align-items:center; gap:0.6rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34c759" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Entrega express en Playa del Carmen, Tulum y Puerto Aventuras. Retiro con cita en taller Cataluña.</span>
            </div>

          </div>
        </div>

      </div>

      
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- SOCIAL PROOF: RESEÑAS VERIFICADAS GOOGLE BUSINESS PROFILE (4.95 / 5)  -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <section class="prod-google-reviews-section">
        <div class="prod-google-box">
          <div class="prod-google-header">
            <div class="prod-google-brand">
              <svg width="28" height="28" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.35 24 12 24Z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15Z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
              </svg>
              <div>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <strong style="font-size:1.15rem; color:#f5f5f7;">Google Reviews · 4.95 / 5.0</strong>
                  <span style="background:rgba(52,199,89,0.15); color:#34c759; font-size:0.7rem; font-weight:800; padding:0.15rem 0.5rem; border-radius:100px; text-transform:uppercase;">Verificado</span>
                </div>
