<!-- Pass Product JSON to Client Script -->
<script is:inline define:vars={{ productJson }}>
(function () {
  const currentProduct = JSON.parse(productJson);

  // 1. Hook "Agregar al Carrito" button
  const addBtn = document.getElementById('btn-add-to-cart-page');
  if (addBtn) {
    addBtn.addEventListener('click', () => {
      if (typeof window.cartAdd === 'function') {
        window.cartAdd({
          id: currentProduct.sku || currentProduct.id,
          name: currentProduct.name,
          price: currentProduct.price,
          icon: ''
        });
      } else {
        alert(`Agregado: ${currentProduct.name} (${currentProduct.price} MXN)`);
      }
    });
  }

  // 2. Track viewed product in BehaviorTracker & localStorage
  try {
    const history = JSON.parse(localStorage.getItem('tg_viewed_products') || '[]');
    const filtered = history.filter(item => item.id !== currentProduct.id);
    filtered.unshift({
      id: currentProduct.id,
      name: currentProduct.name,
      cat: currentProduct.cat,
      brand: currentProduct.brand,
      ts: Date.now()
    });
    localStorage.setItem('tg_viewed_products', JSON.stringify(filtered.slice(0, 10)));

    // Track session event for CRM 360°
    const sessions = JSON.parse(localStorage.getItem('tg_sessions') || '[]');
    sessions.push({
      type: 'bike_detail_view',
      label: `Vio ${currentProduct.name}`,
      cat: currentProduct.cat,
      ts: new Date().toISOString()
    });
    localStorage.setItem('tg_sessions', JSON.stringify(sessions.slice(-30)));
  } catch(e) {}

  // 3. Smart Algorithm: Render Personalized Recommendations
  try {
    const section = document.getElementById('smart-recommendations-section');
    const container = document.getElementById('pers-products-grid');
    const profileLabel = document.getElementById('pers-profile-label');
    if (!section || !container) return;

    // Detect user preference from CRM or sessions
    const crmData = JSON.parse(localStorage.getItem('bicisaas_crm') || '[]');
    const history = JSON.parse(localStorage.getItem('tg_viewed_products') || '[]');
    
    let preferredDiscipline = 'Aventura / MTB';
    if (currentProduct.cat === 'Bicicletas' && currentProduct.name.toLowerCase().includes('gravel')) {
      preferredDiscipline = 'Gravel & Bikepacking';
    } else if (currentProduct.name.toLowerCase().includes('scultura') || currentProduct.name.toLowerCase().includes('allez')) {
      preferredDiscipline = 'Carretera & Velocidad';
    }

    if (profileLabel) {
      profileLabel.textContent = `Basado en tu interés por ${currentProduct.name} y tu perfil de ciclista (${preferredDiscipline}).`;
    }

    // Dynamic personalized items
    const smartItems = [
      { id: 'p12', name: 'Casco POC Axion Race MIPS', brand: 'POC', price: 4800, img: 'https://images.unsplash.com/photo-1559348349-86f1f65817fe?auto=format&fit=crop&w=600&q=80', cat: 'Cascos & Seguridad' },
      { id: 'p21', name: 'Ciclocomputador Garmin Edge 530', brand: 'Garmin', price: 8500, img: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=600&q=80', cat: 'Electrónica & GPS' },
      { id: 'p24', name: 'Lubricante Seco Rock N Roll Gold', brand: 'Rock N Roll', price: 250, img: 'https://images.unsplash.com/photo-1581783898377-1c85bf937427?auto=format&fit=crop&w=600&q=80', cat: 'Herramientas & Taller' },
      { id: 'p20', name: 'Bidón Camelbak Podium Chill 710ml', brand: 'Camelbak', price: 420, img: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=600&q=80', cat: 'Nutrición & Hidratación' }
    ].filter(item => item.id !== currentProduct.id).slice(0, 4);

    container.innerHTML = smartItems.map(item => `
      <div class="rel-card" style="background:#141416; border:1px solid rgba(255,255,255,0.08); border-radius:14px; overflow:hidden; display:flex; flex-direction:column;">
        <a href="/bici/${item.id}" class="rel-card-img-wrap" style="position:relative; width:100%; height:190px; overflow:hidden; display:block; background:#1c1c1f;">
          <img src="${item.img}" alt="${item.name}" loading="lazy" style="width:100%; height:100%; object-fit:cover; display:block;" />
          <span class="rel-cat-badge font-mono" style="position:absolute; bottom:0.5rem; left:0.5rem; background:rgba(0,0,0,0.75); color:#e4e4e7; font-size:0.65rem; font-weight:700; padding:0.2rem 0.5rem; border-radius:4px; backdrop-filter:blur(4px);">${item.cat}</span>
        </a>
        <div class="rel-card-body" style="padding:1rem; display:flex; flex-direction:column; flex:1;">
          <span class="rel-brand font-mono" style="font-size:0.68rem; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.05em;">${item.brand}</span>
          <h4 class="rel-name" style="font-size:0.95rem; font-weight:700; margin:0.25rem 0 0.5rem; line-height:1.3;">
            <a href="/bici/${item.id}" style="color:#ffffff; text-decoration:none;">${item.name}</a>
          </h4>
          <div class="rel-price font-mono" style="font-size:1.1rem; font-weight:800; color:#34c759; margin-top:auto; margin-bottom:0.75rem;">${item.price.toLocaleString('es-MX')}</div>
          <div class="rel-actions" style="display:grid; grid-template-columns:1fr auto; gap:0.5rem;">
            <a href="/bici/${item.id}" class="rel-btn-view" style="display:inline-flex; align-items:center; justify-content:center; padding:0.45rem 0.8rem; border-radius:8px; background:rgba(255,255,255,0.08); color:#f4f4f5; font-size:0.8rem; font-weight:600; text-decoration:none; border:1px solid rgba(255,255,255,0.15);">Ver Detalle</a>
            <button
              type="button"
              class="rel-btn-cart"
              style="padding:0.45rem 0.85rem; border-radius:8px; background:#0071e3; color:white; font-weight:700; font-size:0.85rem; border:none; cursor:pointer; display:inline-flex; align-items:center; justify-content:center;"
              onclick="if(window.cartAdd){window.cartAdd({id:'${item.id}',name:'${item.name.replace(/'/g, "\\'")}',price:${item.price},icon:''})}"
              title="Agregar al carrito"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            </button>
          </div>
        </div>
      </div>
    `).join('');

    section.style.display = 'block';
  } catch(e) {}
})();
</script>

