---
import Base from '../layouts/Base.astro';
---

<Base
  title="Calculadora Biomecánica de Tallas | The Garage Playa del Carmen"
  description="Calcula tu talla exacta de bicicleta de montaña, ruta o urbana según tu estatura con precisión milimétrica. Asesoría directa en The Garage Playa del Carmen."
>
  <div class="guia-page-wrap">
    <div class="container-fluid">

      <!-- Header Section -->
      <section class="guia-header-section">
        <div class="guia-badges font-mono">
          <span class="badge-tag-red">[HERRAMIENTA BIOMECÁNICA]</span>
          <span class="badge-tag-dim">PRECISIÓN DE CUADRO</span>
        </div>
        <h1 class="title-xl" style="margin-bottom: 0.75rem;">
          Calculadora de Tallas de Bicicleta.
        </h1>
        <p class="subtitle" style="max-width: 720px;">
          Rodar en la talla correcta previene fatiga muscular, molestias lumbares y maximiza la transferencia de potencia. Consulta tu medida exacta para cuadro de Ruta, Montaña y Urbana.
        </p>
      </section>

      <!-- Interactive Calculator Grid -->
      <section class="calc-grid-section">
        
        <!-- Controls Column -->
        <div class="calc-card-controls">
          <span class="font-mono text-xs text-zinc-400 font-bold uppercase tracking-wider mb-4 block">
            01 // SELECCIÓN DE PARÁMETROS
          </span>

          <!-- Discipline Selector -->
          <div class="calc-form-group">
            <label class="calc-label font-mono">Tipo de Disciplina:</label>
            <div class="disc-pill-grid">
              <button type="button" class="disc-pill-btn active" data-disc="MTB">
                <span>MTB / Montaña</span>
              </button>
              <button type="button" class="disc-pill-btn" data-disc="Ruta">
                <span>Ruta / Asfalto</span>
              </button>
              <button type="button" class="disc-pill-btn" data-disc="Urbana">
                <span>Gravel / Urbana</span>
              </button>
            </div>
          </div>

          <!-- Height Slider -->
          <div class="calc-form-group">
            <div class="slider-meta-header">
              <label class="calc-label font-mono">Estatura del Ciclista:</label>
              <span class="slider-number-display font-mono" id="slider-height-display">175 cm</span>
            </div>
            
            <input
              type="range"
              id="calc-height-range"
              min="145"
              max="205"
              value="175"
              class="luxury-slider"
            />
            <div class="slider-bounds-row font-mono">
              <span>145 cm</span>
              <span>205 cm</span>
            </div>
          </div>
        </div>

        <!-- Dynamic Output Result Column -->
        <div class="calc-card-result">
          <span class="font-mono text-xs text-emerald-400 font-bold uppercase tracking-wider mb-4 block">
            02 // RESULTADO BIOMECÁNICO
          </span>

          <div class="result-box-top">
            <div class="talla-highlight-block">
              <span class="talla-letra font-mono" id="result-letter">M</span>
              <span class="talla-dimension font-mono" id="result-dimension">52 - 54 cm</span>
            </div>
            <div class="talla-description-block">
              <h3 class="talla-title" id="result-title">Talla Mediana Recomendada</h3>
              <p class="talla-desc" id="result-desc">
                Ideal para estaturas entre 168 cm y 178 cm. Excelente balance entre reactividad, control aerodinámico y confort en fondos prolongados.
              </p>
            </div>
          </div>

          <div class="result-action-footer">
            <a
              href="https://wa.me/529841381493?text=Hola,%20calcul%C3%A9%20mi%20talla%20(Talla%20M,%20175cm)%20y%20quiero%20conocer%20las%20bicicletas%20disponibles."
              id="calc-wa-btn"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              style="width: 100%;"
            >
              Consultar Modelos en mi Talla por WhatsApp
            </a>
          </div>
        </div>

      </section>

    </div>
  </div>
</Base>

<style>
  .guia-page-wrap {
    padding: var(--space-6) 0 var(--space-9) 0;
  }

  .guia-header-section {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-7);
  }

  .guia-badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 0.72rem;
  }
  .badge-tag-red {
    color: #FB7185;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .badge-tag-dim {
    color: var(--text-muted);
  }

  .calc-grid-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .calc-card-controls,
  .calc-card-result {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 3.5vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .calc-form-group {
    margin-bottom: var(--space-5);
  }

  .calc-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--space-3);
  }

  .disc-pill-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .disc-pill-btn {
    background: var(--surface-subtle);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    padding: 0.75rem 0.5rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s var(--ease-spring);
  }
  .disc-pill-btn:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
  }
  .disc-pill-btn.active {
    background: #FFFFFF;
    color: #09090B;
    border-color: #FFFFFF;
  }

  .slider-meta-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-2);
  }

  .slider-number-display {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brand-red);
  }

  .luxury-slider {
    width: 100%;
    height: 8px;
    border-radius: var(--radius-full);
    background: #27272A;
    outline: none;
    cursor: pointer;
    accent-color: var(--brand-red);
    margin-bottom: var(--space-2);
  }

  .slider-bounds-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .result-box-top {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .talla-highlight-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--surface-elevated);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    min-width: 120px;
  }
  .talla-letra {
    font-size: 3rem;
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1;
  }
  .talla-dimension {
    font-size: 0.75rem;
    color: #4ADE80;
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .talla-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: var(--space-2);
  }
  .talla-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .calc-grid-section {
      grid-template-columns: 1fr;
    }
    .result-box-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  function initLuxuryCalculator() {
    const slider = document.getElementById('calc-height-range') as HTMLInputElement;
    const heightDisplay = document.getElementById('slider-height-display');
    const discButtons = document.querySelectorAll<HTMLButtonElement>('.disc-pill-btn');
    
    const resLetter = document.getElementById('result-letter');
    const resDimension = document.getElementById('result-dimension');
    const resTitle = document.getElementById('result-title');
    const resDesc = document.getElementById('result-desc');
    const waBtn = document.getElementById('calc-wa-btn') as HTMLAnchorElement;

    let currentDisc = 'MTB';

    discButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        discButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentDisc = btn.getAttribute('data-disc') || 'MTB';
        updateSize();
      });
    });

    slider?.addEventListener('input', () => {
      if (heightDisplay) heightDisplay.textContent = `${slider.value} cm`;
      updateSize();
    });

    function updateSize() {
      const h = parseInt(slider.value, 10);
      let letter = 'M';
      let dimension = '17" - 18"';
      let title = 'Talla Mediana Recomendada';
      let desc = 'Excelente balance para tu estatura de ' + h + ' cm. Ajuste ideal para control y eficiencia de pedaleo.';

      if (h < 160) {
        letter = 'XS';
        dimension = currentDisc === 'Ruta' ? '46 - 48 cm' : '13" - 14"';
        title = 'Talla Extra Pequeña';
        desc = 'Cuadro compacto para estaturas menores a 160 cm con excelente alcance al manubrio.';
      } else if (h <= 168) {
        letter = 'S';
        dimension = currentDisc === 'Ruta' ? '49 - 51 cm' : '15" - 16"';
        title = 'Talla Pequeña (S)';
        desc = 'Ajuste ágil y maniobrable para estaturas entre 160 y 168 cm.';
      } else if (h <= 178) {
        letter = 'M';
        dimension = currentDisc === 'Ruta' ? '52 - 54 cm' : '17" - 18"';
        title = 'Talla Mediana (M)';
        desc = 'El estándar más versátil para estaturas entre 168 y 178 cm.';
      } else if (h <= 188) {
        letter = 'L';
        dimension = currentDisc === 'Ruta' ? '55 - 57 cm' : '19" - 20"';
        title = 'Talla Grande (L)';
        desc = 'Cuadro con mayor longitud para estaturas entre 178 y 188 cm.';
      } else {
        letter = 'XL';
        dimension = currentDisc === 'Ruta' ? '58 - 61 cm' : '21" - 22"';
        title = 'Talla Extra Grande (XL)';
        desc = 'Máxima extensión y distancia de tubo superior para ciclistas de más de 188 cm.';
      }

      if (resLetter) resLetter.textContent = letter;
      if (resDimension) resDimension.textContent = dimension;
      if (resTitle) resTitle.textContent = title;
      if (resDesc) resDesc.textContent = desc;
      if (waBtn) {
        waBtn.href = `https://wa.me/529841381493?text=${encodeURIComponent(`Hola, calculé mi talla (${title}, ${letter} - ${dimension}, estatura ${h}cm en ${currentDisc}) en la web y me gustaría ver modelos disponibles.`)}`;
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuxuryCalculator);
  } else {
    initLuxuryCalculator();
  }
</script>
