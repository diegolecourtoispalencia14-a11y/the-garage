---
import Base from '../layouts/Base.astro';

const zones = [
  {
    num: "01",
    tag: "ENTREGA INMEDIATA",
    tagColor: "#4ADE80",
    name: "Playa del Carmen (Local)",
    desc: "Entrega el mismo día o recolección directa en tienda física en Cataluña Casa 19. Ajuste biomecánico de altura y manillar incluido.",
    status: "Mismo Día / Tienda Física"
  },
  {
    num: "02",
    tag: "ENTREGA PROGRAMADA 24-48 HRS",
    tagColor: "#38BDF8",
    name: "Tulum & Puerto Aventuras",
    desc: "Envíos directos a tu domicilio en Tulum Centro, La Veleta, Aldea Zama, Akumal y Puerto Aventuras.",
    status: "Ruta Directa"
  },
  {
    num: "03",
    tag: "ENTREGA PROGRAMADA 24-48 HRS",
    tagColor: "#38BDF8",
    name: "Cancún & Puerto Morelos",
    desc: "Coordinación de entrega a domicilio en Cancún (Zona Urbana, Huayacán) y punto medio en Puerto Morelos.",
    status: "Ruta Directa"
  },
  {
    num: "04",
    tag: "ENVÍO VÍA FERRY",
    tagColor: "#C084FC",
    name: "Isla Cozumel",
    desc: "Entrega protegida en la terminal de ferry de Playa del Carmen o envío seguro vía paquetería marítima de carga.",
    status: "Terminal Ferry PDC"
  },
  {
    num: "05",
    tag: "RUTA ESPECIAL",
    tagColor: "#FB923C",
    name: "Valladolid, Yucatán",
    desc: "Ruta periódica hacia el oriente de Yucatán con bicicletas totalmente ensambladas y calibradas listas para rodar.",
    status: "Envío Programado"
  }
];
---

<Base
  title="Entregas & Cobertura en Riviera Maya y Valladolid | The Garage"
  description="Servicio de entrega personal de bicicletas en Playa del Carmen, Tulum, Cancún, Puerto Morelos, Cozumel y Valladolid, Yucatán. Compra segura por WhatsApp en The Garage Bike Experts."
>
  <div class="cobertura-page-wrap">
    <div class="container-fluid">

      <!-- Header Section -->
      <section class="cobertura-header-section">
        <div class="cobertura-badges font-mono">
          <span class="badge-red">[06 // LOGÍSTICA &amp; COBERTURA]</span>
          <span class="badge-dim">RIVIERA MAYA &amp; PENÍNSULA DE YUCATÁN</span>
        </div>
        <h1 class="title-xl" style="margin-bottom: 0.75rem;">
          Llevamos tu bicicleta calibrada hasta tu puerta.
        </h1>
        <p class="subtitle" style="max-width: 760px;">
          Nuestra base física está en <strong>Cataluña, Playa del Carmen</strong>, pero realizamos entregas de bicicletas ensambladas, ajustadas y listas para rodar en los principales municipios de Quintana Roo y Yucatán.
        </p>
      </section>

      <!-- Zones Grid -->
      <section class="zones-grid-section">
        <div class="zones-grid">
          {zones.map((z) => (
            <div class="zone-bento-card">
              <div class="zone-top-row font-mono">
                <span class="zone-number">[{z.num}]</span>
                <span class="zone-tag" style={`color: ${z.tagColor}; border-color: ${z.tagColor};`}>
                  {z.tag}
                </span>
              </div>
              <h2 class="zone-title">{z.name}</h2>
              <p class="zone-desc">{z.desc}</p>
              <div class="zone-footer font-mono">
                <span class="zone-status-label">Modalidad:</span>
                <strong class="zone-status-val">{z.status}</strong>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA Box -->
      <section class="cobertura-cta-box">
        <div class="cta-inner-content">
          <span class="font-mono text-xs text-rose-400 font-bold uppercase tracking-wider block mb-2">
            [COTIZACIÓN DIRECTA]
          </span>
          <h2 class="title-lg" style="color: #FFFFFF; margin-bottom: 0.5rem;">
            ¿Deseas cotizar la entrega de una bicicleta a tu localidad?
          </h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 640px; margin: 0 auto var(--space-5) auto;">
            Escríbenos por WhatsApp con tu ubicación y el modelo que te interesa para coordinar fecha y costo exacto de entrega.
          </p>
          <a
            href="https://wa.me/529841381493?text=Hola,%20me%20gustar%C3%ADa%20cotizar%20la%20entrega%20de%20una%20bicicleta%20en%20mi%20localidad."
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
            style="padding: 0.85rem 2rem;"
          >
            <span>Cotizar Entrega por WhatsApp</span>
          </a>
        </div>
      </section>

    </div>
  </div>
</Base>

<style>
  .cobertura-page-wrap {
    padding: var(--space-6) 0 var(--space-9) 0;
  }

  .cobertura-header-section {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: var(--space-7);
  }

  .cobertura-badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 0.72rem;
  }
  .badge-red {
    color: #FB7185;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .badge-dim {
    color: var(--text-muted);
  }

  .zones-grid-section {
    margin-bottom: var(--space-7);
  }

  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  .zone-bento-card {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s var(--ease-spring), border-color 0.25s ease;
  }
  .zone-bento-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
  }

  .zone-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .zone-number {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 700;
  }
  .zone-tag {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid currentColor;
    background: rgba(255, 255, 255, 0.03);
  }

  .zone-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .zone-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .zone-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-hairline);
  }
  .zone-status-label {
    color: var(--text-muted);
  }
  .zone-status-val {
    color: var(--text-primary);
  }

  .cobertura-cta-box {
    background: linear-gradient(135deg, #18181C 0%, #101013 100%);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 5vw, 4rem) var(--space-5);
    text-align: center;
  }
</style>
