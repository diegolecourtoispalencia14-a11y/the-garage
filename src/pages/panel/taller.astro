---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { Icon } from 'astro-icon/components';
import { INITIAL_SERVICE_ORDERS } from '../../data/workshopOrders';

const initialOrdersJson = JSON.stringify(INITIAL_SERVICE_ORDERS);
---

<PanelLayout title="Taller & Órdenes de Servicio | BiciSaaS">
  <!-- Top Header & Breadcrumb -->
  <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem;">
        <span style="background:rgba(52,199,89,0.12); color:var(--accent-green); font-size:0.75rem; font-weight:700; padding:0.2rem 0.65rem; border-radius:100px; display:inline-flex; align-items:center; gap:0.35rem;">
          <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-green);"></span> Taller de Cirugía Mecánica
        </span>
        <span style="font-size:0.8rem; color:var(--text-secondary);">The Garage · Cataluña, Playa del Carmen</span>
      </div>
      <h1 style="font-size:1.75rem; font-weight:700; color:var(--text-primary); letter-spacing:-0.02em; margin:0 0 0.25rem;">
        Gestión de Taller & Órdenes de Servicio.
      </h1>
      <p style="color:var(--text-secondary); font-size:0.9rem; margin:0;">
        Control de banco de trabajo, asignación de mecánicos, semáforos de cobro en caja y enlace directo a contabilidad.
      </p>
    </div>

    <!-- Top Action Buttons -->
    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
      <button class="btn-secondary" id="btn-filter-my-jobs" style="font-size:0.85rem; padding:0.55rem 1rem;">
        <Icon name="mdi:account-wrench" width="18" height="18" /> Mis Trabajos Asignados
      </button>
      <button class="btn-primary" id="btn-open-new-order" style="font-size:0.88rem; padding:0.55rem 1.15rem; border-radius:10px;">
        <Icon name="mdi:plus" width="18" height="18" /> + Nueva Orden de Servicio
      </button>
    </div>
  </div>

  <!-- KPI Metrics Row -->
  <div class="kpi-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
    <div class="kpi-card bento-card" style="padding:1rem 1.25rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--text-secondary);">Órdenes Activas</span>
        <Icon name="mdi:wrench-outline" width="18" height="18" style="color:var(--text-secondary);" />
      </div>
      <div id="kpi-total-orders" style="font-size:1.6rem; font-weight:700; color:var(--text-primary);">6</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Bicicletas en taller</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-green);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-green);">Listas Entrega</span>
        <Icon name="mdi:check-circle-outline" width="18" height="18" style="color:var(--accent-green);" />
      </div>
      <div id="kpi-ready-orders" style="font-size:1.6rem; font-weight:700; color:var(--accent-green);">2</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Esperando al cliente</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-red);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-red);">Por Cobrar en Caja</span>
        <Icon name="mdi:cash-remove" width="18" height="18" style="color:var(--accent-red);" />
      </div>
      <div id="kpi-pending-balance" style="font-size:1.6rem; font-weight:700; color:var(--accent-red);">$3,930</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Saldos pendientes entrega</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-blue);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-blue);">Marco Ramírez</span>
        <Icon name="mdi:account-tie-hat" width="18" height="18" style="color:var(--accent-blue);" />
      </div>
      <div id="kpi-marco-orders" style="font-size:1.6rem; font-weight:700; color:var(--accent-blue);">5</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Jefe de Taller (Asignadas)</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-orange);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-orange);">Facturación Taller</span>
        <Icon name="mdi:cash-register" width="18" height="18" style="color:var(--accent-orange);" />
      </div>
      <div id="kpi-total-revenue" style="font-size:1.6rem; font-weight:700; color:var(--accent-orange);">$7,930</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Valor total de órdenes</div>
    </div>
  </div>

  <!-- Filters & Search Bar -->
  <div class="bento-card" style="padding:1rem 1.25rem; margin-bottom:1.5rem; display:flex; gap:1rem; flex-wrap:wrap; align-items:center; justify-content:space-between;">
    <div style="display:flex; gap:0.65rem; flex-wrap:wrap; align-items:center; flex:1; min-width:300px;">
      <!-- Search Input -->
      <div style="position:relative; flex:1; min-width:240px;">
        <Icon name="mdi:magnify" width="18" height="18" style="position:absolute; left:0.75rem; top:50%; transform:translateY(-50%); color:var(--text-secondary);" />
        <input type="text" id="search-orders" placeholder="Buscar folio, cliente, teléfono o modelo de bicicleta..." style="width:100%; padding:0.5rem 0.75rem 0.5rem 2.4rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;" />
      </div>

      <!-- Mechanic Filter -->
      <select id="filter-mechanic" style="padding:0.5rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-panel); color:var(--text-primary); font-size:0.82rem;">
        <option value="all">Todos los Mecánicos</option>
        <option value="Marco Ramírez">Marco Ramírez (Jefe de Taller)</option>
        <option value="Diego Lecourtois">Diego Lecourtois</option>
      </select>

      <!-- Payment Status Filter -->
      <select id="filter-payment" style="padding:0.5rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-panel); color:var(--text-primary); font-size:0.82rem;">
        <option value="all">Todos los Estados de Pago</option>
        <option value="pagado_total">Pagado Completo (Listo entregar)</option>
        <option value="anticipo">Con Anticipo (Resta Saldo)</option>
        <option value="pendiente_cobro">Por Cobrar en Mostrador (100%)</option>
      </select>
    </div>

    <!-- View Switcher Tabs -->
    <div style="display:flex; gap:0.25rem; background:var(--bg-base); padding:0.25rem; border-radius:8px; border:1px solid var(--border-subtle);">
      <button class="view-mode-btn active" data-view="kanban" style="padding:0.35rem 0.75rem; border:none; border-radius:6px; background:var(--bg-panel); color:var(--text-primary); font-size:0.78rem; font-weight:700; cursor:pointer;">
        Tablero Kanban
      </button>
      <button class="view-mode-btn" data-view="table" style="padding:0.35rem 0.75rem; border:none; border-radius:6px; background:transparent; color:var(--text-secondary); font-size:0.78rem; font-weight:600; cursor:pointer;">
        Lista Contable
      </button>
    </div>
  </div>

  <!-- VIEW 1: KANBAN BOARD -->
  <div id="view-kanban" class="kanban-wrapper" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem; align-items:start;">
    <!-- Column 1: Agendado / Recepción -->
    <div class="kanban-column bento-card" style="padding:1rem; min-height:500px; background:var(--bg-panel);">
      <div class="col-title-bar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border-subtle);">
        <div style="font-weight:700; font-size:0.85rem; color:var(--text-primary); display:flex; align-items:center; gap:0.4rem;">
          <span style="width:8px; height:8px; border-radius:50%; background:#86868b;"></span>
          <span>RECEPCIÓN / AGENDADO</span>
        </div>
        <span class="badge-col-count" id="count-col-agendado" style="font-size:0.75rem; background:var(--bg-base); padding:0.15rem 0.5rem; border-radius:100px; font-weight:700;">0</span>
      </div>
      <div class="kanban-cards-list" id="cards-col-agendado" style="display:flex; flex-direction:column; gap:0.85rem;"></div>
    </div>

    <!-- Column 2: En Proceso / Banco de Trabajo -->
    <div class="kanban-column bento-card" style="padding:1rem; min-height:500px; background:var(--bg-panel); border-top:3px solid var(--accent-blue);">
      <div class="col-title-bar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border-subtle);">
        <div style="font-weight:700; font-size:0.85rem; color:var(--accent-blue); display:flex; align-items:center; gap:0.4rem;">
          <span style="width:8px; height:8px; border-radius:50%; background:var(--accent-blue);"></span>
          <span>EN BANCO DE TRABAJO</span>
        </div>
        <span class="badge-col-count" id="count-col-en_proceso" style="font-size:0.75rem; background:var(--bg-base); padding:0.15rem 0.5rem; border-radius:100px; font-weight:700;">3</span>
      </div>
      <div class="kanban-cards-list" id="cards-col-en_proceso" style="display:flex; flex-direction:column; gap:0.85rem;"></div>
    </div>

    <!-- Column 3: Esperando Refacción -->
    <div class="kanban-column bento-card" style="padding:1rem; min-height:500px; background:var(--bg-panel); border-top:3px solid var(--accent-orange);">
      <div class="col-title-bar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border-subtle);">
        <div style="font-weight:700; font-size:0.85rem; color:var(--accent-orange); display:flex; align-items:center; gap:0.4rem;">
          <span style="width:8px; height:8px; border-radius:50%; background:var(--accent-orange);"></span>
          <span>ESPERANDO REFACCIÓN</span>
        </div>
        <span class="badge-col-count" id="count-col-esperando_refaccion" style="font-size:0.75rem; background:var(--bg-base); padding:0.15rem 0.5rem; border-radius:100px; font-weight:700;">1</span>
      </div>
      <div class="kanban-cards-list" id="cards-col-esperando_refaccion" style="display:flex; flex-direction:column; gap:0.85rem;"></div>
    </div>

    <!-- Column 4: Listo para Entrega -->
    <div class="kanban-column bento-card" style="padding:1rem; min-height:500px; background:var(--bg-panel); border-top:3px solid var(--accent-green);">
      <div class="col-title-bar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border-subtle);">
        <div style="font-weight:700; font-size:0.85rem; color:var(--accent-green); display:flex; align-items:center; gap:0.4rem;">
          <span style="width:8px; height:8px; border-radius:50%; background:var(--accent-green);"></span>
          <span>LISTO PARA ENTREGA</span>
        </div>
        <span class="badge-col-count" id="count-col-listo_entrega" style="font-size:0.75rem; background:var(--bg-base); padding:0.15rem 0.5rem; border-radius:100px; font-weight:700;">2</span>
      </div>
      <div class="kanban-cards-list" id="cards-col-listo_entrega" style="display:flex; flex-direction:column; gap:0.85rem;"></div>
    </div>

    <!-- Column 5: Entregado & Liquidado -->
    <div class="kanban-column bento-card" style="padding:1rem; min-height:500px; background:var(--bg-panel); opacity:0.85;">
      <div class="col-title-bar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border-subtle);">
        <div style="font-weight:700; font-size:0.85rem; color:var(--text-secondary); display:flex; align-items:center; gap:0.4rem;">
          <Icon name="mdi:archive-check-outline" width="16" height="16" />
          <span>ENTREGADO & LIQUIDADO</span>
        </div>
        <span class="badge-col-count" id="count-col-entregado" style="font-size:0.75rem; background:var(--bg-base); padding:0.15rem 0.5rem; border-radius:100px; font-weight:700;">0</span>
      </div>
      <div class="kanban-cards-list" id="cards-col-entregado" style="display:flex; flex-direction:column; gap:0.85rem;"></div>
    </div>
  </div>

  <!-- VIEW 2: DETAILED ACCOUNTING TABLE -->
  <div id="view-table" class="bento-card" style="display:none; padding:1.25rem;">
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:0.88rem; text-align:left;">
        <thead>
          <tr style="border-bottom:1px solid var(--border-color); color:var(--text-secondary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em;">
            <th style="padding:0.75rem 0.5rem;">Folio</th>
            <th style="padding:0.75rem 0.5rem;">Cliente</th>
            <th style="padding:0.75rem 0.5rem;">Bicicleta</th>
            <th style="padding:0.75rem 0.5rem;">Mecánico</th>
            <th style="padding:0.75rem 0.5rem;">Servicio</th>
            <th style="padding:0.75rem 0.5rem;">Entrega</th>
            <th style="padding:0.75rem 0.5rem;">Total</th>
            <th style="padding:0.75rem 0.5rem;">Pagado</th>
            <th style="padding:0.75rem 0.5rem;">Saldo Pendiente</th>
            <th style="padding:0.75rem 0.5rem;">Estatus Cobro</th>
            <th style="padding:0.75rem 0.5rem; text-align:right;">Acciones</th>
          </tr>
        </thead>
        <tbody id="workshop-table-body">
          <!-- Populated via JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══════════════════════ MODALS ═══════════════════════ -->

  <!-- MODAL 1: NUEVA ORDEN DE SERVICIO -->
  <div id="modal-new-order" class="modal-backdrop" style="display:none;">
    <div class="modal-box bento-card" style="max-width:680px; width:95%; max-height:90vh; overflow-y:auto; padding:2rem; position:relative;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border-subtle); padding-bottom:0.75rem;">
        <div>
          <h2 style="font-size:1.3rem; font-weight:700; margin:0 0 0.2rem; color:var(--text-primary);">Ingresar Orden de Taller</h2>
          <p style="font-size:0.82rem; color:var(--text-secondary); margin:0;">Recepción de bicicleta, asignación de mecánico y registro de anticipo en caja.</p>
        </div>
        <button type="button" class="btn-icon close-modal-btn" data-modal="modal-new-order" style="font-size:1.25rem; cursor:pointer;">&times;</button>
      </div>

      <form id="form-new-order" style="display:flex; flex-direction:column; gap:1.1rem;">
        <!-- Datos de Cliente -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Nombre del Cliente *</label>
            <input type="text" id="order-client-name" required placeholder="Ej. Rodrigo Palacios" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;" />
          </div>
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Teléfono / WhatsApp *</label>
            <input type="tel" id="order-client-phone" required placeholder="Ej. 984 123 4567" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;" />
          </div>
        </div>

        <!-- Servicio & Categoría -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Bicicleta (Marca y Modelo) *</label>
            <input type="text" id="order-bike-model" required placeholder="Ej. Basso Palta 2 Carbon" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;" />
          </div>
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Tipo / Disciplina</label>
            <select id="order-bike-type" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;">
              <option value="Gravel">Gravel</option>
              <option value="Ruta">Ruta</option>
              <option value="MTB">MTB</option>
              <option value="Urbana">Urbana</option>
              <option value="E-Bike">E-Bike</option>
            </select>
          </div>
        </div>

        <!-- Mecánico Asignado y Promesa de Entrega -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Mecánico Asignado *</label>
            <select id="order-assigned-mechanic" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;">
              <option value="Marco Ramírez">Marco Ramírez (Jefe de Taller)</option>
              <option value="Diego Lecourtois">Diego Lecourtois</option>
            </select>
          </div>
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Fecha Promesa de Entrega *</label>
            <input type="date" id="order-due-date" required style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;" />
          </div>
        </div>

        <!-- Paquete de Servicio y Prioridad -->
        <div style="display:grid; grid-template-columns:2fr 1fr; gap:0.75rem;">
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Paquete / Cirugía Solicitada</label>
            <select id="order-service-package" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;">
              <option value="Servicio General Gravel/Ruta" data-price="1200">Servicio General Gravel/Ruta ($1,200)</option>
              <option value="Afinación y Calibración Shimano" data-price="650">Afinación y Calibración Shimano ($650)</option>
              <option value="Purga Hidráulica Frenos Par" data-price="550">Purga Hidráulica Frenos Par ($550)</option>
              <option value="Mantenimiento de Mazas y Baleros" data-price="450">Mantenimiento de Mazas y Baleros ($450)</option>
              <option value="Armado y Nivelación de Ruedas" data-price="400">Armado y Nivelación de Ruedas ($400)</option>
              <option value="Inspección y Diagnóstico Express" data-price="250">Inspección y Diagnóstico Express ($250)</option>
            </select>
          </div>
          <div>
            <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Prioridad</label>
            <select id="order-priority" style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem;">
              <option value="normal">Normal</option>
              <option value="alta">Alta</option>
              <option value="urgente">Urgente (+ Express)</option>
            </select>
          </div>
        </div>

        <!-- Notas / Diagnóstico Inicial -->
        <div>
          <label style="font-size:0.8rem; font-weight:700; color:var(--text-primary); display:block; margin-bottom:0.35rem;">Diagnóstico Inicial / Síntomas reportados por cliente</label>
          <textarea id="order-diagnosis" rows="2" placeholder="Ej. Ruidos en centro, purga de frenos y cambio de balatas traseras..." style="width:100%; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem; resize:vertical;"></textarea>
        </div>

        <!-- Finanzas: Costo total y Anticipo en Caja -->
        <div style="background:var(--bg-base); border:1px solid var(--border-color); border-radius:10px; padding:1rem;">
          <div style="font-weight:700; font-size:0.85rem; color:var(--text-primary); margin-bottom:0.6rem; display:flex; align-items:center; gap:0.4rem;">
            <Icon name="mdi:cash-register" width="18" height="18" color="var(--accent-blue)" /> Cotización & Cobro de Anticipo en Caja
          </div>
          
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
            <div>
              <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); display:block; margin-bottom:0.25rem;">Costo Total Estimado (MXN)</label>
