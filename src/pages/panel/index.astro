---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { Icon } from "astro-icon/components";
---

<PanelLayout title="Centro de Comando Inteligente | BiciSaaS">

  <!-- ═════════════════════════ TOP HEADER & ROLE-LENS BAR ═════════════════════════ -->
  <div class="dash-top-bar">
    <div>
      <div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.35rem; flex-wrap:wrap;">
        <span id="role-status-badge" class="dash-status-pill">
          <span class="status-dot"></span>
          <span id="role-status-text">Dirección General · Acceso Completo</span>
        </span>
        <span class="location-tag">The Garage · Playa del Carmen, Quintana Roo</span>
        <!-- Local Riviera Maya Weather Context Widget -->
        <span class="weather-pill" title="Clima actual en Playa del Carmen · Condiciones ideales para salidas y rentas">
          <Icon name="mdi:weather-sunny" width="15" height="15" style="color:#ff9f0a;" />
          <span>31°C · Soleado PDC · Viento 14 km/h E · Temporada Alta</span>
        </span>
      </div>
      <h1 id="dashboard-greeting" class="dash-greeting">Buenos días, Diego Lecourtois.</h1>
      <p id="dashboard-subgreeting" class="dash-subgreeting">
        Centro de Comando Operativo, Taller &amp; Caja · <strong>Lunes, 7 de Septiembre de 2026</strong>
      </p>
    </div>

    <!-- Right Controls: Role-Lens Switcher & Quick Action Shortcuts -->
    <div class="dash-top-actions">
      <!-- Role-Lens Switcher (Exclusive to Admin account to preview specific staff cockpits) -->
      <div class="role-lens-box" id="admin-role-lens-box" style="display:none;">
        <span class="lens-label">
          <Icon name="mdi:eye-outline" width="14" height="14" /> Perspectiva:
        </span>
        <div class="lens-pills">
          <button class="lens-btn active" id="lens-admin" type="button" onclick="switchDashboardLens('admin')" title="Ver panorama ejecutivo 360°">
            Dirección
          </button>
          <button class="lens-btn" id="lens-mecanico" type="button" onclick="switchDashboardLens('mecanico')" title="Ver cockpit de cirugía mecánica">
            Taller
          </button>
          <button class="lens-btn" id="lens-ventas" type="button" onclick="switchDashboardLens('ventas')" title="Ver mostrador, cobros y rentas">
            Mostrador
          </button>
        </div>
      </div>

      <!-- Quick Action Shortcuts -->
      <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
        <a href="/panel/taller" class="btn-quick-action" title="Abrir nueva orden de servicio en taller">
          <Icon name="mdi:wrench-outline" width="16" height="16" /> + Orden Taller
        </a>
        <a href="/panel/rentas" class="btn-quick-action" title="Registrar salida de bicicleta de alquiler">
          <Icon name="mdi:bike-fast" width="16" height="16" /> + Salida Renta
        </a>
        <a href="/panel/sitio-web" class="btn-quick-action primary" title="Abrir punto de venta rápido">
          <Icon name="mdi:cash-register" width="16" height="16" /> POS Mostrador
        </a>
      </div>
    </div>
  </div>

  <!-- ═════════════════════════ ZONA 1: PULSO OPERATIVO DEL DÍA (4 KPI CARDS) ═════════════════════════ -->
  <div class="kpi-row-grid">
    
    <!-- KPI 1: Caja Hoy & Ventas Mostrador -->
    <div class="bento-kpi-card highlight-green" onclick="window.location.href='/panel/contabilidad'" title="Ver libro diario y corte de caja">
      <div class="bento-kpi-header">
        <span class="bento-kpi-title">Pulso de Caja (Hoy)</span>
        <span class="bento-kpi-badge badge-green">Día Activo</span>
      </div>
      <div class="bento-kpi-val" id="val-kpi-cash">$18,450.00 <span class="val-currency">MXN</span></div>
      <div class="bento-kpi-breakdown">
        <span class="breakdown-item">Efectivo en Gaveta: <strong id="val-cash-drawer">$3,850</strong></span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item">Tarjeta/MP: <strong id="val-cash-cards">$14,600</strong></span>
      </div>
      <div class="bento-kpi-sub">
        <span style="color:var(--accent-green); font-weight:600;">Arqueo verificado</span> · Total mes Sep: <strong>$166,650 MXN</strong>
      </div>
    </div>

    <!-- KPI 2: Taller Activo & Cirugías -->
    <div class="bento-kpi-card highlight-blue" onclick="window.location.href='/panel/taller'" title="Ver banco de trabajo y cirugías activas">
      <div class="bento-kpi-header">
        <span class="bento-kpi-title">Cirugía en Taller</span>
        <span class="bento-kpi-badge badge-blue">6 Órdenes</span>
      </div>
      <div class="bento-kpi-val" id="val-kpi-workshop">2 <span class="val-sublabel">Listas Entrega</span></div>
      <div class="bento-kpi-breakdown">
        <span class="breakdown-item" style="color:var(--accent-green);">2 listos</span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item" style="color:var(--accent-blue);">3 en proceso</span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item" style="color:var(--accent-orange);">1 espera pieza</span>
      </div>
      <div class="bento-kpi-sub">
        Marco Ramírez: <strong>5 asignadas</strong> · SLA: <strong style="color:var(--accent-green);">96.4%</strong>
      </div>
    </div>

    <!-- KPI 3: Flota en Renta & Horómetros -->
    <div class="bento-kpi-card highlight-orange" onclick="window.location.href='/panel/rentas'" title="Ver estado de unidades en alquiler">
      <div class="bento-kpi-header">
        <span class="bento-kpi-title">Flota de Rentas</span>
        <span class="bento-kpi-badge badge-orange">8 Unidades</span>
      </div>
      <div class="bento-kpi-val" id="val-kpi-rentals">1 <span class="val-sublabel">En Calle (Turista)</span></div>
      <div class="bento-kpi-breakdown">
        <span class="breakdown-item" style="color:var(--accent-blue);">1 rodando</span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item" style="color:var(--accent-green);">6 disponibles</span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item" style="color:var(--accent-red);">1 servicio</span>
      </div>
      <div class="bento-kpi-sub">
        <span style="color:var(--accent-red); font-weight:600;">1 unidad horómetro 47h</span> · Depósitos: <strong>$4,500 MXN</strong>
      </div>
    </div>

    <!-- KPI 4: Equipo & Asistencia en Tienda -->
    <div class="bento-kpi-card highlight-purple" onclick="window.location.href='/panel/empleados'" title="Ver checador y colaboradores en turno">
      <div class="bento-kpi-header">
        <span class="bento-kpi-title">Colaboradores Hoy</span>
        <span class="bento-kpi-badge badge-purple">100% Presentes</span>
      </div>
      <div class="bento-kpi-val" id="val-kpi-team">3 <span class="val-sublabel">En Turno Activo</span></div>
      <div class="bento-kpi-breakdown">
        <span class="breakdown-item">Diego L. (Admin)</span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item">Marco R. (Mecánico)</span>
        <span class="breakdown-divider">·</span>
        <span class="breakdown-item">Sofía M.</span>
      </div>
      <div class="bento-kpi-sub">
        Puntualidad de tienda: <strong style="color:var(--accent-green);">100%</strong> · Sin ausencias
      </div>
    </div>

  </div>

  <!-- ═════════════════════════ ZONA 2: RADAR CENTRAL ADAPTATIVO ═════════════════════════ -->
  <div class="dash-split-grid">
    
    <!-- COLUMNA IZQUIERDA (60%): Radar de Urgencias & Monitor de Bahías de Taller -->
    <div class="dash-col-main">
      
      <!-- Card 1: Radar de Urgencias & Entregas de Hoy -->
      <div class="dash-card">
        <div class="dash-card-header">
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <div class="icon-bubble red"><Icon name="mdi:alert-circle-outline" width="18" height="18" /></div>
            <div>
              <h2 class="dash-card-title">Radar de Urgencias &amp; Entregas Programadas (Hoy)</h2>
              <p class="dash-card-desc">Bicicletas listas por entregar, saldos por cobrar y unidades que retornan hoy 7 de Septiembre.</p>
            </div>
          </div>
          <span class="urgent-badge" id="radar-count-badge">4 Prioritarias</span>
        </div>

        <div class="urgent-list">
          
          <!-- Item 1: Basso Palta 2 (Listo para entrega con saldo pendiente) -->
          <div class="urgent-item border-red">
            <div class="urgent-left">
              <div class="urgent-folio">SRV-2026-089 · Taller</div>
              <div class="urgent-name">Basso Palta 2 Carbon Gravel</div>
              <div class="urgent-client">Cliente: <strong>Rodrigo Palacios</strong> (984-120-3344) · Mecánico: Marco Ramírez</div>
              <div class="urgent-detail">
                <span>Servicio: <strong>Cirugía Mayor / Purga Hidráulica</strong></span>
                <span class="tag-status ready">Listo para Entrega</span>
              </div>
            </div>
            <div class="urgent-right">
              <div class="urgent-amount-box">
                <span class="amount-label">Saldo por Cobrar:</span>
                <span class="amount-val red">$1,300.00 MXN</span>
              </div>
              <div style="display:flex; gap:0.4rem; margin-top:0.4rem;">
                <button class="btn-action-urgent primary" type="button" onclick="openQuickCollectModal('SRV-2026-089', 'Rodrigo Palacios', 'Basso Palta 2 Carbon', 1300, 2800)">
                  Cobrar en POS
                </button>
                <a href="https://wa.me/529841203344?text=Hola%20Rodrigo,%20tu%20Basso%20Palta%202%20ya%20est%C3%A1%20lista%20en%20The%20Garage.%20Saldo%20pendiente:%20$1,300%20MXN." target="_blank" class="btn-action-urgent icon-only" title="Avisar por WhatsApp">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Item 2: Specialized Allez Sport (Garantía 30 días, saldo $0) -->
          <div class="urgent-item border-green">
            <div class="urgent-left">
              <div class="urgent-folio">SRV-2026-090 · Taller</div>
              <div class="urgent-name">Specialized Allez Sport Carretera</div>
              <div class="urgent-client">Cliente: <strong>Mariana Gómez</strong> (984-765-4321) · Mecánico: Marco Ramírez</div>
              <div class="urgent-detail">
                <span>Servicio: <strong>Primer chequeo gratuito 30 días</strong></span>
                <span class="tag-status ready">QA Aprobado</span>
              </div>
            </div>
            <div class="urgent-right">
              <div class="urgent-amount-box">
                <span class="amount-label">Saldo por Cobrar:</span>
                <span class="amount-val green">$0.00 (Pagado)</span>
              </div>
              <div style="display:flex; gap:0.4rem; margin-top:0.4rem;">
                <button class="btn-action-urgent secondary" type="button" onclick="completeDelivery('SRV-2026-090', 'Mariana Gómez')">
                  Marcar Entregada
                </button>
              </div>
            </div>
          </div>

          <!-- Item 3: Trek Marlin 5 Gen 3 (Renta Turista que retorna hoy) -->
          <div class="urgent-item border-blue">
            <div class="urgent-left">
              <div class="urgent-folio">REN-2026-041 · Alquiler Flota</div>
              <div class="urgent-name">Trek Marlin 5 Gen 3 (Unidad #04)</div>
              <div class="urgent-client">Turista: <strong>Alexander Klein</strong> (Alemania) · Hotel Playacar</div>
              <div class="urgent-detail">
                <span>Vencimiento: <strong>Hoy a las 18:00 hrs</strong></span>
                <span class="tag-status active">En Renta</span>
              </div>
            </div>
            <div class="urgent-right">
              <div class="urgent-amount-box">
                <span class="amount-label">Depósito en Garantía:</span>
                <span class="amount-val blue">$1,500.00 MXN</span>
              </div>
              <div style="display:flex; gap:0.4rem; margin-top:0.4rem;">
                <a href="/panel/rentas" class="btn-action-urgent primary">
                  Check-in Recepción
                </a>
              </div>
            </div>
          </div>

          <!-- Item 4: Scott Scale 965 (Esperando refacción Magura) -->
          <div class="urgent-item border-orange">
            <div class="urgent-left">
              <div class="urgent-folio">SRV-2026-093 · Taller</div>
              <div class="urgent-name">Scott Scale 965 XC Hardtail</div>
              <div class="urgent-client">Cliente: <strong>Gabriel Garza</strong> · Mecánico: Marco Ramírez</div>
              <div class="urgent-detail">
                <span>Estado: <strong>Esperando Kit Sellos &amp; Oliva Magura</strong></span>
                <span class="tag-status warning">Pieza por Recibir</span>
              </div>
            </div>
            <div class="urgent-right">
              <div class="urgent-amount-box">
                <span class="amount-label">Costo Total:</span>
                <span class="amount-val orange">$1,130.00 MXN</span>
              </div>
              <div style="display:flex; gap:0.4rem; margin-top:0.4rem;">
                <a href="/panel/taller" class="btn-action-urgent secondary">
                  Ver en Taller
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Card 2: Monitor de Bahías de Trabajo & Cirugía Mecánica -->
      <div class="dash-card">
        <div class="dash-card-header">
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <div class="icon-bubble green"><Icon name="mdi:wrench-outline" width="18" height="18" /></div>
            <div>
              <h2 class="dash-card-title">Monitor de Bahías de Trabajo en Tiempo Real</h2>
              <p class="dash-card-desc">Ocupación de mesas de cirugía mecánica, avance técnico y SLA de servicio.</p>
            </div>
          </div>
          <a href="/panel/taller" class="dash-link-more">Gestionar Taller ↗</a>
        </div>

        <div class="bays-grid">
          
          <!-- Bahía 1: Ocupada por Marco -->
          <div class="bay-box active">
            <div class="bay-header">
              <div style="display:flex; align-items:center; gap:0.4rem;">
                <span class="bay-badge occupied">Bahía 1 · En Operación</span>
                <span class="bay-tech">Marco Ramírez</span>
              </div>
              <span class="bay-timer">42 min transcurridos</span>
            </div>
            <div class="bay-body">
              <div class="bay-bike-title">Basso Palta 2 Carbon Gravel</div>
              <div class="bay-task">Purga de frenos hidráulicos GRX + centrado de disco 160mm</div>
              <!-- Mini Progress Bar -->
              <div class="progress-bar-wrap">
                <div class="progress-bar-fill" style="width: 85%;"></div>
              </div>
              <div class="bay-checklist">
                <span class="chk-item done">Torque manubrio (6 Nm)</span>
                <span class="chk-item done">Purga aceite Shimano</span>
                <span class="chk-item done">Calibración cambios</span>
                <span class="chk-item pending">Rodada de prueba final</span>
              </div>
            </div>
            <div class="bay-footer">
              <span style="font-size:0.75rem; color:var(--text-secondary);">Tiempo restante est: <strong>15 minutos</strong></span>
              <button class="btn-bay-finish" type="button" onclick="alert('Servicio finalizado. Orden movida a Lista para Entrega y notificada a caja.');">
                Concluir Servicio
              </button>
            </div>
          </div>

          <!-- Bahía 2: Disponible para ensamble express -->
          <div class="bay-box free">
            <div class="bay-header">
              <span class="bay-badge available">Bahía 2 · Disponible</span>
              <span class="bay-tech" style="color:var(--text-muted);">Sin mecánico asignado</span>
            </div>
            <div class="bay-body free-body">
              <div style="display:flex; justify-content:center; margin-bottom:0.4rem;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-secondary);"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
              <div style="font-size:0.95rem; font-weight:700; color:var(--text-primary);">Banco de Trabajo Despejado</div>
              <p style="font-size:0.8rem; color:var(--text-secondary); margin:0.2rem 0 0.8rem;">
                Listo para recibir revisión express de 15 min, ensamble de bici nueva o mantenimiento de flota.
              </p>
              <a href="/panel/taller" class="btn-secondary" style="font-size:0.8rem; padding:0.4rem 0.85rem; border-radius:8px; text-decoration:none;">
                + Asignar Trabajo a Bahía
              </a>
            </div>
            <div class="bay-footer">
              <span style="font-size:0.75rem; color:var(--text-secondary);">Herramientas Park Tool y torquímetros calibrados hoy.</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- COLUMNA DERECHA (40%): Salud Financiera, Arqueo de Cajón & Atajos Rápidos -->
    <div class="dash-col-side">
      
      <!-- Card 3: Arqueo de Cajón en Vivo & Salud Financiera -->
      <div class="dash-card">
        <div class="dash-card-header">
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <div class="icon-bubble orange"><Icon name="mdi:finance" width="18" height="18" /></div>
            <div>
              <h2 class="dash-card-title">Arqueo de Cajón &amp; Finanzas</h2>
              <p class="dash-card-desc">Desglose de liquidez disponible en tienda física.</p>
            </div>
          </div>
          <a href="/panel/contabilidad" class="dash-link-more">Contabilidad ↗</a>
        </div>

        <div class="finance-drawer-box">
          <div class="finance-drawer-row">
            <div class="fd-label">
              <span class="fd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg></span>
              <div>
                <strong>Efectivo Físico en Cajón</strong>
                <span class="fd-sub">Fondo $2,000 + $1,850 ventas en efectivo</span>
              </div>
            </div>
            <div class="fd-val green">$3,850.00 MXN</div>
          </div>

          <div class="finance-drawer-row">
            <div class="fd-label">
              <span class="fd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></span>
              <div>
                <strong>Terminales Bancarias &amp; MP</strong>
                <span class="fd-sub">Clip / Mercado Pago (Lote activo hoy)</span>
              </div>
            </div>
            <div class="fd-val blue">$14,600.00 MXN</div>
          </div>

          <div class="finance-drawer-row">
            <div class="fd-label">
              <span class="fd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
              <div>
                <strong>Cuentas por Cobrar (Taller)</strong>
                <span class="fd-sub">Saldos pendientes al entregar bicicletas</span>
              </div>
            </div>
            <div class="fd-val red">$3,930.00 MXN</div>
          </div>

          <div class="finance-drawer-row">
            <div class="fd-label">
              <span class="fd-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
              <div>
                <strong>Depósitos en Custodia (Rentas)</strong>
                <span class="fd-sub">Garantías activas devueltas al retornar</span>
              </div>
            </div>
            <div class="fd-val purple">$4,500.00 MXN</div>
          </div>

          <!-- Bottom Summary -->
          <div class="finance-drawer-total">
            <div>
              <span style="font-size:0.75rem; color:var(--text-secondary); text-transform:uppercase; font-weight:700; display:block;">Resultado Mes (Sep 2026)</span>
              <strong style="font-size:1.15rem; color:var(--text-primary);">+$134,400.00 MXN Netos</strong>
            </div>
            <span class="margin-pill">Margen: 80.6%</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Accesos Directos Operativos -->
      <div class="dash-card">
        <div class="dash-card-header">
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <div class="icon-bubble purple"><Icon name="mdi:lightning-bolt" width="18" height="18" /></div>
            <div>
              <h2 class="dash-card-title">Acciones Rápidas Operativas</h2>
              <p class="dash-card-desc">Atajos directos para agilizar el mostrador.</p>
            </div>
          </div>
        </div>

        <div class="shortcuts-grid">
          
          <a href="/panel/taller" class="shortcut-btn">
            <span class="sc-icon" style="background:rgba(52,199,89,0.15); color:var(--accent-green);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span>
            <div>
              <strong>+ Orden Taller</strong>
              <span>Recibir bicicleta a servicio</span>
            </div>
          </a>

          <a href="/panel/rentas" class="shortcut-btn">
