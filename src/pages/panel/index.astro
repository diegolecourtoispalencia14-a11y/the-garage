  <!-- ═════════════════════════ CLIENT SCRIPT: REACTIVITY & ROLE LENS ═════════════════════════ -->
  <script is:inline>
    // Global active collection item
    let activeCollectItem = null;

    // ─── 1. Role-Lens Switcher Logic (Exclusivo para Administrador / Dueño) ───
    window.switchDashboardLens = function(lens) {
      // Security guard: only admin can switch perspective
      try {
        const session = JSON.parse(localStorage.getItem('bicisaas_session') || '{}');
        if (session.role && session.role !== 'admin') {
          return;
        }
      } catch(e) {}

      document.querySelectorAll('.lens-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById('lens-' + lens);
      if (activeBtn) activeBtn.classList.add('active');

      const greeting = document.getElementById('dashboard-greeting');
      const subgreeting = document.getElementById('dashboard-subgreeting');
      const roleText = document.getElementById('role-status-text');

      if (lens === 'admin') {
        if (roleText) roleText.textContent = 'Dirección General · Acceso Completo';
        if (greeting) greeting.textContent = 'Buenos días, Diego Lecourtois.';
        if (subgreeting) subgreeting.innerHTML = 'Centro de Comando Operativo, Taller & Caja · <strong>Lunes, 7 de Septiembre de 2026</strong>';
      } else if (lens === 'mecanico') {
        if (roleText) roleText.textContent = 'Vista Previa Taller · (Marco Ramírez)';
        if (greeting) greeting.textContent = 'Mesa de Cirugía: Marco Ramírez.';
        if (subgreeting) subgreeting.innerHTML = '5 órdenes activas asignadas · <strong>Prioridad de entrega HOY: Basso Palta 2 & Specialized Allez</strong>';
      } else if (lens === 'ventas') {
        if (roleText) roleText.textContent = 'Vista Previa Mostrador · (Ventas & POS)';
        if (greeting) greeting.textContent = 'Atención a Clientes & Recepción.';
        if (subgreeting) subgreeting.innerHTML = '4 clientes citados hoy para recoger bicicleta · <strong>Saldo por cobrar en caja: $3,930 MXN</strong>';
      }
    };

    // ─── 2. Quick Collect Modal (Cobro POS Express) ───
    window.openQuickCollectModal = function(folio, client, bike, balance, total) {
      activeCollectItem = { folio, client, bike, balance, total };
      document.getElementById('qc-folio-sub').textContent = 'Folio: ' + folio;
      document.getElementById('qc-client-name').textContent = client;
      document.getElementById('qc-bike-name').textContent = bike;
      document.getElementById('qc-total-cost').textContent = '$' + Number(total).toLocaleString('es-MX') + '.00 MXN';
      document.getElementById('qc-balance-due').textContent = '$' + Number(balance).toLocaleString('es-MX') + '.00 MXN';

      const overlay = document.getElementById('dash-collect-modal');
      if (overlay) overlay.style.display = 'flex';
    };

    window.closeQuickCollectModal = function() {
      const overlay = document.getElementById('dash-collect-modal');
      if (overlay) overlay.style.display = 'none';
      activeCollectItem = null;
    };

    window.confirmQuickCollect = function() {
      if (!activeCollectItem) return;
      const method = document.querySelector('input[name="qc-method"]:checked')?.value || 'Efectivo';
      
      // Register in local ledger if exists
      try {
        const LEDGER_KEY = 'bicisaas_ledger_2026';
        const ledger = JSON.parse(localStorage.getItem(LEDGER_KEY) || '[]');
        ledger.push({
          id: 'mov-' + Date.now(),
          date: '2026-09-07',
          type: 'income',
          concept: 'Liquidación Taller: ' + activeCollectItem.folio + ' (' + activeCollectItem.client + ')',
          category: 'Servicios de Taller',
          method: method,
          amount: activeCollectItem.balance,
          fiscalMonth: '2026-09'
        });
        localStorage.setItem(LEDGER_KEY, JSON.stringify(ledger));
      } catch(e) {}

      alert(`Saldo de Taller Cobrado Exitosamente.\n\n• Folio: ${activeCollectItem.folio}\n• Cliente: ${activeCollectItem.client}\n• Importe liquidado: ${activeCollectItem.balance.toLocaleString('es-MX')} MXN\n• Forma de pago: ${method}\n\nLa orden quedó liquidada y el ingreso fue asentado en Contabilidad 2026.`);
      closeQuickCollectModal();

      // Update UI badge
      const badge = document.getElementById('radar-count-badge');
      if (badge) badge.textContent = '3 Prioritarias';
    };

    window.completeDelivery = function(folio, client) {
      if (confirm(`¿Confirmar entrega de bicicleta para ${client} (${folio})?\n\nEl servicio tiene saldo $0 (Garantía 30 días o liquidado previamente).`)) {
        alert(`Bicicleta entregada a satisfacción de ${client}.\nOrden archivada exitosamente.`);
      }
    };

    // Close modal on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeQuickCollectModal();
    });

    // ─── 3. Personalización por Rol: Exclusividad del Switcher para Admin ───
    try {
      const session = JSON.parse(localStorage.getItem('bicisaas_session') || '{}');
      const lensBox = document.getElementById('admin-role-lens-box');
      const roleBadge = document.getElementById('role-status-badge');
      const roleText = document.getElementById('role-status-text');
      const greeting = document.getElementById('dashboard-greeting');
      const subgreeting = document.getElementById('dashboard-subgreeting');

      if (session && session.role === 'admin') {
        // SOLO el administrador puede ver y usar la barra de perspectivas
        if (lensBox) lensBox.style.display = 'flex';
        switchDashboardLens('admin');
      } else if (session && session.role === 'mecanico') {
        // Ocultar barra completamente para el mecánico
        if (lensBox) lensBox.style.display = 'none';
        if (roleText) roleText.textContent = 'Cirugía Mecánica · Modo Taller';
        if (roleBadge) {
          roleBadge.style.background = 'rgba(52, 199, 89, 0.12)';
          roleBadge.style.color = 'var(--accent-green)';
        }
        if (greeting) greeting.textContent = `Mesa de Cirugía: ${session.name || 'Marco Ramírez'}.`;
        if (subgreeting) subgreeting.innerHTML = '5 órdenes activas asignadas · <strong>Prioridad de entrega HOY: Basso Palta 2 & Specialized Allez</strong>';
      } else if (session && session.role === 'ventas') {
        // Ocultar barra completamente para asesor comercial
        if (lensBox) lensBox.style.display = 'none';
        if (roleText) roleText.textContent = 'Mostrador, Cobros & Rentas · Modo POS';
        if (roleBadge) {
          roleBadge.style.background = 'rgba(255, 149, 0, 0.12)';
          roleBadge.style.color = 'var(--accent-orange)';
        }
        if (greeting) greeting.textContent = `Atención a Clientes: ${session.name || 'Laura Vásquez'}.`;
        if (subgreeting) subgreeting.innerHTML = '4 clientes citados hoy para recoger bicicleta · <strong>Saldo por cobrar en caja: $3,930 MXN</strong>';
      } else {
        // Fallback por defecto
        if (lensBox) lensBox.style.display = 'none';
      }
    } catch(e) {}
  </script>

