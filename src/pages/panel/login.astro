---
import { Icon } from 'astro-icon/components';
import { DEFAULT_STAFF } from '../../data/authConfig';
const defaultStaffJson = JSON.stringify(DEFAULT_STAFF);
---
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Acceso al Sistema | The Garage BiciSaaS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    :root {
      --bg-dark: #09090b;
      --surface-card: #18181b;
      --surface-elevated: #202024;
      --border-card: #27272a;
      --border-subtle: #3f3f46;
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --accent-blue: #0071e3;
      --accent-blue-glow: rgba(0, 113, 227, 0.4);
      --accent-green: #30d158;
      --accent-orange: #ff9f0a;
      --radius-lg: 16px;
      --radius-xl: 24px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
      overflow-x: hidden;
    }

    /* Ambient luxury glow */
    .ambient-glow-1 {
      position: absolute;
      top: -15%;
      left: 20%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(0, 113, 227, 0.15) 0%, rgba(0,0,0,0) 70%);
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
    }
    .ambient-glow-2 {
      position: absolute;
      bottom: -15%;
      right: 20%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(48, 209, 88, 0.1) 0%, rgba(0,0,0,0) 70%);
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
    }

    .login-container {
      width: 100%;
      max-width: 460px;
      position: relative;
      z-index: 10;
    }

    /* Brand Header */
    .brand-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 0.35rem 0.9rem;
      border-radius: 100px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 1rem;
      backdrop-filter: blur(12px);
    }
    .brand-logo-icon {
      width: 52px;
      height: 52px;
      background: linear-gradient(135deg, #18181b, #27272a);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.2);
    }
    .brand-title {
      font-size: 1.65rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #fff;
      margin-bottom: 0.35rem;
    }
    .brand-subtitle {
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    /* Login Box */
    .login-box {
      background: var(--surface-card);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-xl);
      padding: 2.25rem 2rem;
      box-shadow: 0 24px 48px -12px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.05);
      backdrop-filter: blur(20px);
    }

    .form-group {
      margin-bottom: 1.35rem;
    }
    .form-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }
    .form-control-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .form-control-wrap .input-icon {
      position: absolute;
      left: 1rem;
      color: var(--text-muted);
      pointer-events: none;
    }
    .form-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 0.85rem 1rem 0.85rem 2.85rem;
      color: #fff;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      outline: none;
    }
    .form-input:focus {
      border-color: var(--accent-blue);
      box-shadow: 0 0 0 3px var(--accent-blue-glow);
    }
    .form-input::placeholder {
      color: #71717a;
      font-size: 0.88rem;
    }
    .toggle-password {
      position: absolute;
      right: 0.85rem;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      padding: 0.35rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s;
    }
    .toggle-password:hover {
      color: #fff;
    }

    /* Submit Button */
    .btn-submit {
      width: 100%;
      padding: 0.9rem;
      background: linear-gradient(135deg, #0071e3, #0056b3);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 4px 16px rgba(0, 113, 227, 0.4);
      transition: all 0.2s ease;
      margin-top: 1.5rem;
    }
    .btn-submit:hover {
      background: linear-gradient(135deg, #007bf0, #0060c4);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(0, 113, 227, 0.5);
    }
    .btn-submit:active {
      transform: translateY(0);
    }

    /* Alert Message */
    .auth-alert {
      display: none;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 0.82rem;
      font-weight: 500;
      margin-bottom: 1.25rem;
      align-items: center;
      gap: 0.6rem;
    }
    .auth-alert.error {
      display: flex;
      background: rgba(255, 69, 58, 0.15);
      border: 1px solid rgba(255, 69, 58, 0.3);
      color: #ff6b64;
    }
    .auth-alert.success {
      display: flex;
      background: rgba(48, 209, 88, 0.15);
      border: 1px solid rgba(48, 209, 88, 0.3);
      color: #30d158;
    }

    /* Footer Note */
    .login-footer {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: #71717a;
    }
  </style>
</head>
<body>

  <div class="ambient-glow-1"></div>
  <div class="ambient-glow-2"></div>

  <div class="login-container">
    <!-- Brand Header -->
    <div class="brand-header">
      <div class="brand-badge">
        <span style="width:7px; height:7px; border-radius:50%; background:var(--accent-green); box-shadow:0 0 8px var(--accent-green);"></span>
        The Garage Bike Experts • Playa del Carmen
      </div>
      <div class="brand-logo-icon">
        <Icon name="mdi:bicycle" width="30" height="30" color="#0071e3" />
      </div>
      <h1 class="brand-title">BiciSaaS Management</h1>
      <p class="brand-subtitle">Ingreso seguro para Taller, Ventas y Dirección General</p>
    </div>

    <!-- Login Box -->
    <div class="login-box">
      <!-- Dynamic Status Alert -->
      <div id="auth-alert" class="auth-alert">
        <Icon name="mdi:alert-circle-outline" width="18" height="18" />
        <span id="auth-alert-text">Credenciales incorrectas.</span>
      </div>

      <form id="login-form">
        <!-- Usuario / Correo -->
        <div class="form-group">
          <label class="form-label" for="login-email">
            <span>Usuario / Correo Oficial</span>
          </label>
          <div class="form-control-wrap">
            <span class="input-icon">
              <Icon name="mdi:account-outline" width="18" height="18" />
            </span>
            <input 
              type="text" 
              id="login-email" 
              class="form-input" 
              placeholder="ej. admin@thegarage.mx o taller" 
              required 
              autocomplete="username"
              autofocus
            />
          </div>
        </div>

        <!-- PIN / Contraseña -->
        <div class="form-group">
          <div class="form-label">
            <span>PIN de Acceso / Contraseña</span>
            <span style="font-size:0.75rem; color:var(--text-muted); font-weight:400;">4 dígitos</span>
          </div>
          <div class="form-control-wrap">
            <span class="input-icon">
              <Icon name="mdi:lock-outline" width="18" height="18" />
            </span>
            <input 
              type="password" 
              id="login-pin" 
              class="form-input" 
              placeholder="••••" 
              maxlength="12" 
              required 
              autocomplete="current-password"
            />
            <button type="button" class="toggle-password" id="btn-toggle-password" title="Ver / Ocultar PIN">
              <Icon name="mdi:eye-outline" width="18" height="18" id="eye-icon" />
            </button>
          </div>
        </div>

        <!-- Remember Me Checkbox -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; font-size:0.82rem; color:var(--text-muted);">
          <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
            <input type="checkbox" id="remember-session" checked style="accent-color:var(--accent-blue);" />
            <span>Mantener sesión activa en esta terminal</span>
          </label>
        </div>

        <!-- Honeypot anti-bot protection (invisible to legitimate users) -->
        <div style="opacity:0; position:absolute; top:0; left:-9000px; height:0; width:0; z-index:-1;" aria-hidden="true">
          <input type="text" id="login-company-hp" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-submit" id="btn-submit">
          <Icon name="mdi:login-variant" width="18" height="18" />
          <span>Ingresar al Sistema</span>
        </button>
      </form>
    </div>

    <!-- Footer Note -->
    <div class="login-footer">
      <p>The Garage Bike Experts · BiciSaaS Enterprise</p>
      <p style="margin-top:0.25rem;">Av. Ich Xeel, Cataluña, Playa del Carmen · Terminal Protegida</p>
    </div>
  </div>

  <script src="../../utils/securityLogger.ts"></script>
  <script is:inline define:vars={{ defaultStaffJson }}>
    const DEFAULT_STAFF = JSON.parse(defaultStaffJson);

    function logSecurityEvent(type, level, details, userContext) {
      if (typeof window !== 'undefined' && typeof window.recordSecurityLog === 'function') {
        window.recordSecurityLog(type, level, details, userContext);
        return;
      }
      try {
        const raw = localStorage.getItem('bicisaas_audit_log');
        const logs = raw ? JSON.parse(raw) : [];
        logs.unshift({
          timestamp: new Date().toISOString(),
          type,
          level,
          user: (userContext && userContext.user) || 'anon',
          role: (userContext && userContext.role) || 'guest',
          path: window.location.pathname,
          details: details || {}
        });
        if (logs.length > 50) logs.length = 50;
        localStorage.setItem('bicisaas_audit_log', JSON.stringify(logs));
      } catch(_) {}
    }

    // Toggle password visibility
    const toggleBtn = document.getElementById('btn-toggle-password');
    const pinInput = document.getElementById('login-pin');
    if (toggleBtn && pinInput) {
      toggleBtn.addEventListener('click', () => {
        const isPassword = pinInput.type === 'password';
        pinInput.type = isPassword ? 'text' : 'password';
      });
    }

    // Read redirect param or expiration notification
    const urlParams = new URLSearchParams(window.location.search);
    let redirectUrl = urlParams.get('redirect') || '/panel';
    if (redirectUrl.indexOf('/panel/login') !== -1) {
      redirectUrl = '/panel';
    }
    const reason = urlParams.get('reason');

    if (reason === 'expired' || reason === 'unauthorized') {
      // Invalidate existing session immediately to break any redirect loop
      localStorage.removeItem('bicisaas_session');
      localStorage.removeItem('bicisaas_user_role');
      document.cookie = 'bicisaas_auth=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';

      const alertEl = document.getElementById('auth-alert');
      const alertText = document.getElementById('auth-alert-text');
      if (alertEl && alertText) {
        alertEl.className = 'auth-alert error';
        if (reason === 'expired') {
          alertText.textContent = 'Tu sesión ha caducado por inactividad. Ingresa con tus credenciales.';
        } else {
          alertText.textContent = 'Acceso no autorizado o permisos insuficientes. Ingresa con una cuenta autorizada.';
        }
      }
    }

    // Cryptographic hash helper using native Web Crypto API
    async function hashPinClient(pin, salt) {
      const enc = new TextEncoder();
      const data = enc.encode(String(pin).trim() + String(salt));
      const hashBuffer = await crypto.subtle.digest('SHA-256', data);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    // Check if user is already logged in with valid non-expired session (ONLY if NO reason in URL)
    try {
      if (!reason) {
        const activeSession = JSON.parse(localStorage.getItem('bicisaas_session') || 'null');
        if (activeSession && activeSession.userId) {
          const now = Date.now();
          if (activeSession.expiresAt && now > activeSession.expiresAt) {
            localStorage.removeItem('bicisaas_session');
          } else {
            const alertEl = document.getElementById('auth-alert');
            const alertText = document.getElementById('auth-alert-text');
            if (alertEl && alertText) {
              alertEl.className = 'auth-alert success';
              alertText.innerHTML = `Sesión activa: <strong>${activeSession.name}</strong> (${activeSession.roleLabel}). <a href="${redirectUrl}" style="color:inherit; font-weight:700; text-decoration:underline; margin-left:8px;">Continuar al Panel ➔</a>`;
            }
          }
        }
      }
    } catch(e) {}

    // Authentication function
    function getStaffList() {
      try {
        const raw = localStorage.getItem('bicisaas_staff_accounts');
        if (!raw) {
          localStorage.setItem('bicisaas_staff_accounts', JSON.stringify(DEFAULT_STAFF));
          return DEFAULT_STAFF;
        }
        return JSON.parse(raw);
      } catch(e) {
        return DEFAULT_STAFF;
      }
    }

    // Brute Force Lockout & Anti-Automation (OWASP A07)
    const MAX_LOGIN_ATTEMPTS = 5;
    const LOCKOUT_DURATION_MS = 60 * 1000; // 60 segundos de bloqueo tras 5 fallos

    function getLoginAttempts() {
      try {
        const raw = localStorage.getItem('bicisaas_login_attempts');
        return raw ? JSON.parse(raw) : { count: 0, lockedUntil: null };
      } catch(_) {
        return { count: 0, lockedUntil: null };
      }
    }

    function saveLoginAttempts(attempts) {
      try {
        localStorage.setItem('bicisaas_login_attempts', JSON.stringify(attempts));
      } catch(_) {}
    }

    function clearLoginAttempts() {
      try {
        localStorage.removeItem('bicisaas_login_attempts');
      } catch(_) {}
    }

    let lockoutTimer = null;

    function checkLockoutStatus() {
      const attempts = getLoginAttempts();
      const now = Date.now();
      const submitBtn = document.getElementById('btn-submit');
      const alertEl = document.getElementById('auth-alert');
      const alertText = document.getElementById('auth-alert-text');

      if (attempts.lockedUntil && now < attempts.lockedUntil) {
        const remainingSec = Math.ceil((attempts.lockedUntil - now) / 1000);
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `<span>Acceso bloqueado (${remainingSec}s)</span>`;
        }
        if (alertEl && alertText) {
          alertEl.className = 'auth-alert error';
          alertText.textContent = `Demasiados intentos fallidos. Acceso bloqueado por seguridad (${remainingSec}s restantes).`;
        }

        if (lockoutTimer) clearInterval(lockoutTimer);
        lockoutTimer = setInterval(() => {
          const updatedNow = Date.now();
          if (updatedNow >= attempts.lockedUntil) {
            clearInterval(lockoutTimer);
            clearLoginAttempts();
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<svg style="width:18px; height:18px; margin-right:0.4rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg><span>Ingresar al Sistema</span>';
            }
            if (alertEl) alertEl.style.display = 'none';
          } else {
            const sec = Math.ceil((attempts.lockedUntil - updatedNow) / 1000);
            if (submitBtn) submitBtn.innerHTML = `<span>Acceso bloqueado (${sec}s)</span>`;
            if (alertText) alertText.textContent = `Demasiados intentos fallidos. Acceso bloqueado por seguridad (${sec}s restantes).`;
          }
        }, 1000);
        return true;
      }
      return false;
    }

    // Initialize lockout check on load
    checkLockoutStatus();

    async function doLogin(email, pin) {
      // 1. Check if terminal is currently locked out
      if (checkLockoutStatus()) {
        return false;
      }

      // 2. Anti-bot honeypot check
      const hpField = document.getElementById('login-company-hp');
      if (hpField && hpField.value.trim().length > 0) {
        console.warn('Bot detection triggered in login form');
        logSecurityEvent('HONEYPOT_TRIGGERED', 'SECURITY_ALERT', { field: 'login-company-hp' });
        return genericAuthError();
      }

      const staffList = getStaffList();
      const cleanEmail = email.trim().toLowerCase();
      const cleanPin = pin.trim();

      const alertEl = document.getElementById('auth-alert');
      const alertText = document.getElementById('auth-alert-text');

      const matched = staffList.find(u => 
        (u.email.toLowerCase() === cleanEmail || 
         u.name.toLowerCase() === cleanEmail || 
         u.id.toLowerCase() === cleanEmail ||
         (cleanEmail === 'admin' && u.role === 'admin') ||
         (cleanEmail === 'taller' && u.role === 'mecanico') ||
         (cleanEmail === 'ventas' && u.role === 'ventas'))
      );

      // Generic authentication failure with rate-limit counter
      const genericAuthError = () => {
        const attempts = getLoginAttempts();
        attempts.count = (attempts.count || 0) + 1;

        if (attempts.count >= MAX_LOGIN_ATTEMPTS) {
          attempts.lockedUntil = Date.now() + LOCKOUT_DURATION_MS;
          saveLoginAttempts(attempts);
          logSecurityEvent('BRUTE_FORCE_LOCKOUT', 'SECURITY_ALERT', {
            targetUser: cleanEmail,
            attemptCount: attempts.count,
            lockoutSeconds: 60
          });
          checkLockoutStatus();
          return false;
        }

        saveLoginAttempts(attempts);
        const remaining = MAX_LOGIN_ATTEMPTS - attempts.count;
        logSecurityEvent('AUTH_FAILURE', 'WARN', {
          targetUser: cleanEmail,
          attemptsRemaining: remaining
        });
        alertEl.className = 'auth-alert error';
        alertText.textContent = `Credenciales no válidas. ${remaining} intento${remaining === 1 ? '' : 's'} restante${remaining === 1 ? '' : 's'}.`;
        pinInput.value = '';
        pinInput.focus();
        return false;
      };

      if (!matched) {
        return genericAuthError();
      }

      if (matched.status === 'suspended') {
        alertEl.className = 'auth-alert error';
        alertText.textContent = 'Esta cuenta se encuentra suspendida. Contacta al Administrador.';
        return false;
      }

      // Verify PIN via SHA-256 hash + salt (or legacy plain pin migration)
      let pinValid = false;
      if (matched.pinHash && matched.pinSalt) {
        const enteredHash = await hashPinClient(cleanPin, matched.pinSalt);
        pinValid = (enteredHash === matched.pinHash);
      } else if (matched.pin) {
        pinValid = (matched.pin === cleanPin);
        if (pinValid) {
          // Automatic migration from plain text to secure hash
          const salt = 'thegarage_salt_' + matched.id + '_' + Date.now().toString(36);
          matched.pinSalt = salt;
          matched.pinHash = await hashPinClient(cleanPin, salt);
          delete matched.pin;
          localStorage.setItem('bicisaas_staff_accounts', JSON.stringify(staffList));
        }
      }

      if (!pinValid) {
        return genericAuthError();
      }

      // Reset login attempt counters upon successful authentication
      clearLoginAttempts();

      logSecurityEvent('AUTH_SUCCESS', 'INFO', {
        userId: matched.id,
        role: matched.role
      }, { user: matched.name, role: matched.role });

      // Generate secure session with ID rotation and inactivity expiration
      const now = Date.now();
      const sessionId = typeof crypto.randomUUID === 'function' 
        ? crypto.randomUUID() 
        : (Date.now().toString(36) + Math.random().toString(36).slice(2));

      // Normalize allowed modules to lowercase slugs (e.g. "Sitio Web" -> "sitio-web")
      const defaultRoleMods = {
        'admin': ['dashboard', 'crm', 'inventario', 'rentas', 'taller', 'contabilidad', 'analytics', 'sitio-web', 'empleados', 'mi-perfil'],
        'mecanico': ['dashboard', 'crm', 'inventario', 'taller', 'mi-perfil'],
        'ventas': ['dashboard', 'crm', 'inventario', 'rentas', 'mi-perfil'],
        'personalizado': ['dashboard', 'mi-perfil']
      };
      const rawAllowed = (matched.allowedModules && matched.allowedModules.length > 0)
        ? matched.allowedModules
        : (defaultRoleMods[matched.role] || ['dashboard', 'mi-perfil']);
      const normalizedAllowed = rawAllowed.map(m => String(m).toLowerCase().trim().replace(/\s+/g, '-'));

      const session = {
        userId: matched.id,
        name: matched.name,
        email: matched.email,
        role: matched.role,
        roleLabel: matched.roleLabel,
        avatar: matched.avatar,
        monogram: matched.monogram || (matched.name ? matched.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase() : 'US'),
        allowedModules: normalizedAllowed,
        title: matched.title,
        color: matched.color,
        loggedAt: new Date().toISOString(),
        lastActivity: now,
        expiresAt: now + (8 * 60 * 60 * 1000), // 8 hours inactivity timeout
        sessionId: sessionId
      };

      localStorage.setItem('bicisaas_session', JSON.stringify(session));
      localStorage.setItem('bicisaas_user_role', matched.role === 'admin' ? 'admin' : matched.id);

      // Synchronize edge auth cookie for Cloudflare Pages perimeter guard
      document.cookie = 'bicisaas_auth=' + encodeURIComponent(sessionId) + '; path=/; SameSite=Lax; max-age=' + (8 * 3600);

      alertEl.className = 'auth-alert success';
      alertText.textContent = `Bienvenido, ${matched.name}. Accediendo como ${matched.roleLabel}...`;

      const submitBtn = document.getElementById('btn-submit');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Verificando credenciales...</span>';
      }

      // Safe destination check based on RBAC & allowedModules:
      let target = redirectUrl;
      if (!target || target.indexOf('/panel/login') !== -1 || !target.startsWith('/panel')) {
        target = '/panel';
      }
      const pathToMod = {
        '/panel': 'dashboard',
        '/panel/crm': 'crm',
        '/panel/empleados': 'empleados',
        '/panel/mi-perfil': 'mi-perfil',
        '/panel/inventario': 'inventario',
        '/panel/rentas': 'rentas',
        '/panel/taller': 'taller',
        '/panel/contabilidad': 'contabilidad',
        '/panel/analytics': 'analytics',
        '/panel/sitio-web': 'sitio-web'
      };
      const modToPath = {
        'dashboard': '/panel',
        'crm': '/panel/crm',
        'empleados': '/panel/empleados',
        'mi-perfil': '/panel/mi-perfil',
        'inventario': '/panel/inventario',
        'rentas': '/panel/rentas',
        'taller': '/panel/taller',
        'contabilidad': '/panel/contabilidad',
        'analytics': '/panel/analytics',
        'sitio-web': '/panel/sitio-web'
      };

      if (matched.role !== 'admin') {
        const requiredMod = pathToMod[target];
        if (requiredMod && !normalizedAllowed.includes(requiredMod)) {
          const firstAllowed = normalizedAllowed[0];
          target = firstAllowed ? (modToPath[firstAllowed] || '/panel') : '/panel/mi-perfil';
        }
      }

      setTimeout(() => {
        window.location.href = target;
      }, 700);

      return true;
    }

    // Form submit
    const form = document.getElementById('login-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.getElementById('login-email').value;
        const pin = document.getElementById('login-pin').value;
        doLogin(email, pin);
      });
    }
  </script>

</body>
</html>
