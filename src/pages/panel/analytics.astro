(function() {
  // Chart Rendering
  const MONTHS = ['Abr 2026', 'May 2026', 'Jun 2026', 'Jul 2026', 'Ago 2026', 'Sep 2026 (Actual)'];
  const REVENUE = [48500, 54200, 68900, 62100, 74300, 167750];
  const COGS    = [24000, 26500, 31000, 29000, 34000, 72000];

  function drawRevenueChart() {
    const canvas = document.getElementById('revenue-chart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.parentElement.clientWidth - 48;
    const H = 210;
    canvas.width = W;
    canvas.height = H;

    ctx.clearRect(0, 0, W, H);
    const maxVal = 190000;
    const padX = 40;
    const padY = 25;
    const plotW = W - padX * 2;
    const plotH = H - padY * 2;

    // Grid lines
    ctx.strokeStyle = 'rgba(128,128,128,0.15)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padY + (plotH / 4) * i;
      ctx.beginPath();
      ctx.moveTo(padX, y);
      ctx.lineTo(W - padX, y);
      ctx.stroke();
    }

    // Revenue line
    ctx.strokeStyle = '#0071e3';
    ctx.lineWidth = 3;
    ctx.beginPath();
    REVENUE.forEach((val, i) => {
      const x = padX + (plotW / (MONTHS.length - 1)) * i;
      const y = padY + plotH - (val / maxVal) * plotH;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // COGS / Margin line
    ctx.strokeStyle = '#34c759';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    REVENUE.forEach((rev, i) => {
      const margin = rev - COGS[i];
      const x = padX + (plotW / (MONTHS.length - 1)) * i;
      const y = padY + plotH - (margin / maxVal) * plotH;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // X Labels & Points
    ctx.fillStyle = '#86868b';
    ctx.font = '11px -apple-system, sans-serif';
    ctx.textAlign = 'center';
    MONTHS.forEach((m, i) => {
      const x = padX + (plotW / (MONTHS.length - 1)) * i;
      ctx.fillText(m, x, H - 6);

      const revY = padY + plotH - (REVENUE[i] / maxVal) * plotH;
      ctx.fillStyle = '#0071e3';
      ctx.beginPath();
      ctx.arc(x, revY, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#86868b';
    });
  }

  // Aging Stock Renderer
  function renderAgingStock() {
    const list = document.getElementById('aging-stock-list');
    if (!list) return;

    const items = [
      { name: 'Merida Scultura 300 (Talla S)', days: 104, stock: 1, cost: '$18,500 MXN', type: 'urgent', action: 'Transferir a Flota Renta', actionClass: 'rent' },
      { name: 'Llantas Continental GP5000 700x25c', days: 78, stock: 4, cost: '$5,200 MXN', type: 'warning', action: 'Armar Bundle Servicio Taller', actionClass: 'bundle' },
      { name: 'Casco Kask Mojito 3 (Talla L)', days: 65, stock: 2, cost: '$4,800 MXN', type: 'warning', action: 'Descuento 15% Tienda', actionClass: 'bundle' },
      { name: 'Basso Palta 2 Carbon Gravel', days: 22, stock: 1, cost: '$85,000 MXN', type: 'normal', action: 'Fast-Mover (OK)', actionClass: 'bundle' }
    ];

    list.innerHTML = '';
    items.forEach(item => {
      list.innerHTML += `
        <div class="stock-aging-row ${item.type}">
          <div>
            <div class="sar-name">${item.name}</div>
            <div class="sar-meta">${item.days} días en tienda · Stock: ${item.stock} pza · Capital congelado: ${item.cost}</div>
          </div>
          <button class="sar-action ${item.actionClass}">${item.action}</button>
        </div>
      `;
    });
  }

  // Global deep-dive modal opener helper
  window.openDeepModal = function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) modal.style.display = 'flex';
  };

  // Bind 6 KPI Deep-Dive Modals
  const deepMap = [
    { boxId: 'box-gmroi', modalId: 'modal-deep-gmroi' },
    { boxId: 'box-ltv', modalId: 'modal-deep-ltv' },
    { boxId: 'box-efficiency', modalId: 'modal-deep-efficiency' },
    { boxId: 'box-ticket', modalId: 'modal-deep-ticket' },
    { boxId: 'box-doh', modalId: 'modal-deep-doh' },
    { boxId: 'box-deadstock', modalId: 'modal-deep-deadstock' },
  ];

  deepMap.forEach(item => {
    const box = document.getElementById(item.boxId);
    const modal = document.getElementById(item.modalId);
    if (box && modal) {
      box.addEventListener('click', () => {
        modal.style.display = 'flex';
      });
      box.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          modal.style.display = 'flex';
        }
      });
    }
  });

  document.querySelectorAll('.close-deep-modal').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.modal-overlay').forEach(m => {
        if (m.id.startsWith('modal-deep-')) m.style.display = 'none';
      });
    });
  });

  // Close modals on overlay backdrop click or Escape key
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.style.display = 'none';
    });
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-overlay').forEach(m => {
        if (m.id.startsWith('modal-deep-')) m.style.display = 'none';
      });
    }
  });

  // Predictive Simulator What-If Logic
  let currentSeason = 'alta';

  function calculateSimulation() {
    const fleetAdd = parseInt(document.getElementById('slider-fleet').value, 10);
    const mechanics = parseInt(document.getElementById('slider-mechanics').value, 10);
    const laborRate = parseInt(document.getElementById('slider-labor').value, 10);

    document.getElementById('val-fleet').textContent = '+' + fleetAdd + ' Bicis';
    document.getElementById('val-mechanics').textContent = mechanics + ' Mecánicos';
    document.getElementById('val-labor').textContent = '$' + laborRate + ' MXN';

    const isHigh = currentSeason === 'alta';
    const seasonMultiplier = isHigh ? 1.45 : 0.85;

    const retailRev = 110000 * seasonMultiplier;
    const totalFleet = 5 + fleetAdd;
    const dailyRate = isHigh ? 650 : 450;
    const occupancy = isHigh ? 0.72 : 0.40;
    const rentalRev = totalFleet * 30 * dailyRate * occupancy;

    const servicesPerDay = 3.5;
    const workshopDays = 26;
    const workshopLaborRev = mechanics * servicesPerDay * workshopDays * laborRate;
    const workshopPartsRev = workshopLaborRev * 0.45;
    const workshopRev = workshopLaborRev + workshopPartsRev;

    const totalMonthlyRev = Math.round(retailRev + rentalRev + workshopRev);
    const cogsEstimated = Math.round((retailRev * 0.72) + (rentalRev * 0.15) + (workshopRev * 0.28));
    const grossMargin = totalMonthlyRev - cogsEstimated;

    const fixedCosts = 28000 + (mechanics * 10000);
    const breakEven = Math.round(fixedCosts / (grossMargin / totalMonthlyRev));

    const fleetCapEx = fleetAdd * 12000;
    const monthlyNetRentalGain = (rentalRev * 0.85);
    const roiMonths = fleetAdd > 0 ? (fleetCapEx / (monthlyNetRentalGain / (5 + fleetAdd) * fleetAdd)).toFixed(1) : '0';

    document.getElementById('res-monthly-rev').textContent = '$' + totalMonthlyRev.toLocaleString('es-MX') + ' MXN';
    document.getElementById('res-gross-margin').textContent = '$' + grossMargin.toLocaleString('es-MX') + ' MXN';
    document.getElementById('res-break-even').textContent = '$' + breakEven.toLocaleString('es-MX') + ' MXN';
    document.getElementById('res-roi').textContent = fleetAdd > 0 ? roiMonths + ' Meses' : 'Inmediato';
  }

  ['slider-fleet', 'slider-mechanics', 'slider-labor'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateSimulation);
  });

  document.querySelectorAll('.season-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.season-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      currentSeason = this.getAttribute('data-season');
      const ind = document.getElementById('current-season-indicator');
      if (currentSeason === 'alta') {
        ind.innerHTML = 'Temporada Alta Activa (Caribe & Ironman)';
        ind.style.borderColor = 'rgba(255, 149, 0, 0.3)';
        ind.style.color = 'var(--accent-orange)';
      } else {
        ind.innerHTML = 'Temporada Regular (Comunidad Local & Mantenimiento)';
        ind.style.borderColor = 'rgba(0, 113, 227, 0.3)';
        ind.style.color = 'var(--accent-blue)';
      }
      calculateSimulation();
    });
  });

  document.getElementById('btn-jump-simulator')?.addEventListener('click', () => {
    document.getElementById('simulator-section')?.scrollIntoView({ behavior: 'smooth' });
  });

  window.addEventListener('resize', drawRevenueChart);
  setTimeout(() => {
    drawRevenueChart();
    renderAgingStock();
    calculateSimulation();
  }, 100);
})();
</script>
