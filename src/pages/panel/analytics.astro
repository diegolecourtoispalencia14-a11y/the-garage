---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { Icon } from 'astro-icon/components';
---
<PanelLayout title="Analytics & Proyecciones Pro | BiciSaaS">
  <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
    <div>
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
        <span class="badge-pro">Retail BI & Predictive Machine</span>
        <span style="font-size:0.8rem; color:var(--text-secondary);">Benchmarked vs Ascend RPM & Baremetrics</span>
      </div>
      <h1 class="page-title">Analytics, GMROI y Proyecciones.</h1>
      <p class="text-muted">Unit economics, retorno sobre inventario, eficiencia de taller y simulador estacional Riviera Maya.</p>
    </div>
    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
      <span class="season-badge" id="current-season-indicator">
        <Icon name="mdi:weather-sunny" width="16" height="16" /> Temporada Alta Activa (Caribe)
      </span>
      <button class="btn-primary" id="btn-jump-simulator">
        <Icon name="mdi:chart-timeline-variant-shimmer" width="18" height="18" /> Abrir Simulador What-If
      </button>
    </div>
  </div>

  <!-- Interactive KPI Row (Clickable Deep-Dive Drill-Downs) -->
  <div class="kpi-strip">
    <!-- Box 1: GMROI -->
    <div class="kpi-box clickable" id="box-gmroi" role="button" tabindex="0" onclick="window.openDeepModal('modal-deep-gmroi')" title="Ver fórmula y desglose del Retorno de Margen Bruto">
      <div class="kpi-top">
        <span class="kpi-l">GMROI Global (Stock)</span>
        <span class="drill-hint" onclick="window.openDeepModal('modal-deep-gmroi'); event.stopPropagation();">Explicación ↗</span>
      </div>
      <span class="kpi-v green" id="a-gmroi">3.8x</span>
      <span class="kpi-trend">+$3.80 por cada $1 en stock</span>
    </div>

    <!-- Box 2: LTV -->
    <div class="kpi-box clickable" id="box-ltv" role="button" tabindex="0" onclick="window.openDeepModal('modal-deep-ltv')" title="Ver composición del valor de vida del ciclista a 24 meses">
      <div class="kpi-top">
        <span class="kpi-l">LTV Promedio Ciclista</span>
        <span class="drill-hint" onclick="window.openDeepModal('modal-deep-ltv'); event.stopPropagation();">Detalle ↗</span>
      </div>
      <span class="kpi-v blue" id="a-ltv">$64,800</span>
      <span class="kpi-trend">Compra + 24m Servicios</span>
    </div>

    <!-- Box 3: Eficiencia Taller -->
    <div class="kpi-box clickable" id="box-efficiency" role="button" tabindex="0" onclick="window.openDeepModal('modal-deep-efficiency')" title="Ver utilización de bahías por mecánico y tiempo improductivo">
      <div class="kpi-top">
        <span class="kpi-l">Eficiencia Taller (Bahías)</span>
        <span class="drill-hint" onclick="window.openDeepModal('modal-deep-efficiency'); event.stopPropagation();">Bahías ↗</span>
      </div>
      <span class="kpi-v green" id="a-efficiency">84.2%</span>
      <span class="kpi-trend">65.5 hrs facturadas / 78h</span>
    </div>

    <!-- Box 4: Ticket Taller -->
    <div class="kpi-box clickable" id="box-ticket" role="button" tabindex="0" onclick="window.openDeepModal('modal-deep-ticket')" title="Ver composición Mano de Obra vs Refacciones vendidas">
      <div class="kpi-top">
        <span class="kpi-l">Ticket Promedio Taller</span>
        <span class="drill-hint" onclick="window.openDeepModal('modal-deep-ticket'); event.stopPropagation();">Ticket ↗</span>
      </div>
      <span class="kpi-v" id="a-taller-ticket">$1,480</span>
      <span class="kpi-trend">Mano de obra + refacciones</span>
    </div>

    <!-- Box 5: DOH -->
    <div class="kpi-box clickable" id="box-doh" role="button" tabindex="0" onclick="window.openDeepModal('modal-deep-doh')" title="Ver velocidad de inventario por familias y benchmarks">
      <div class="kpi-top">
        <span class="kpi-l">Días de Inventario (DOH)</span>
        <span class="drill-hint" onclick="window.openDeepModal('modal-deep-doh'); event.stopPropagation();">Rotación ↗</span>
      </div>
      <span class="kpi-v orange" id="a-doh">42 días</span>
      <span class="kpi-trend">Rotación saludable &lt; 60d</span>
    </div>

    <!-- Box 6: Dead Stock -->
    <div class="kpi-box clickable" id="box-deadstock" role="button" tabindex="0" onclick="window.openDeepModal('modal-deep-deadstock')" title="Ver artículos causantes y costo financiero de piso">
      <div class="kpi-top">
        <span class="kpi-l">Dead Stock Inmovilizado</span>
        <span class="drill-hint" onclick="window.openDeepModal('modal-deep-deadstock'); event.stopPropagation();">Auditar ↗</span>
      </div>
      <span class="kpi-v red" id="a-dead-stock">$28,500</span>
      <span class="kpi-trend">3 artículos &gt; 90 días</span>
    </div>
  </div>

  <div class="analytics-grid">

    <!-- Revenue & Profit Trend Chart (Canvas) -->
    <div class="bento-card" style="grid-column:span 2;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
        <h3 style="display:flex; align-items:center; gap:0.5rem; font-size:1.05rem;">
          <Icon name="mdi:chart-line" width="20" height="20" color="var(--accent-blue)" /> Tendencia Histórica: Ingresos vs Costo de Venta (COGS)
        </h3>
        <div style="display:flex; gap:0.75rem; font-size:0.78rem;">
          <span style="display:flex; align-items:center; gap:0.35rem;"><span style="width:10px; height:10px; border-radius:50%; background:var(--accent-blue);"></span> Ingreso Bruto</span>
          <span style="display:flex; align-items:center; gap:0.35rem;"><span style="width:10px; height:10px; border-radius:50%; background:var(--accent-green);"></span> Margen Operativo</span>
        </div>
      </div>
      <canvas id="revenue-chart" height="210"></canvas>
    </div>

    <!-- GMROI by Category -->
    <div class="bento-card">
      <h3 style="margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem; font-size:1.05rem;">
        <Icon name="mdi:scale-balance" width="20" height="20" color="var(--accent-green)" /> GMROI por Categoría
      </h3>
      <p style="font-size:0.78rem; color:var(--text-secondary); margin-bottom:1rem;">
        Retorno de margen bruto por peso invertido en stock:
      </p>
      <div class="gmroi-list">
        <div class="gmroi-row">
          <div class="gmroi-info">
            <strong>Mano de Obra Taller</strong>
            <span>Casi nula inversión en stock</span>
          </div>
          <div class="gmroi-metric green">14.2x</div>
        </div>
        <div class="gmroi-row">
          <div class="gmroi-info">
            <strong>Flota de Rentas</strong>
            <span>Recuperación de inversión en 4 meses</span>
          </div>
          <div class="gmroi-metric purple">4.8x</div>
        </div>
        <div class="gmroi-row">
          <div class="gmroi-info">
            <strong>Refacciones &amp; Consumibles</strong>
            <span>Alta rotación de pastillas y cadenas</span>
          </div>
          <div class="gmroi-metric blue">3.4x</div>
        </div>
        <div class="gmroi-row">
          <div class="gmroi-info">
            <strong>Venta Bicicletas Nuevas</strong>
            <span>Capital intensivo (alto ticket)</span>
          </div>
          <div class="gmroi-metric orange">1.9x</div>
        </div>
      </div>
    </div>

    <!-- Dead Stock & Aging Alert -->
    <div class="bento-card" style="grid-column:span 2;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h3 style="display:flex; align-items:center; gap:0.5rem; font-size:1.05rem;">
          <Icon name="mdi:alert-octagon-outline" width="20" height="20" color="var(--accent-red)" /> Envejecimiento de Stock &amp; Acciones Sugeridas
        </h3>
        <span class="badge red">Auditoría DOH</span>
      </div>
      <div id="aging-stock-list" style="display:flex; flex-direction:column; gap:0.75rem;"></div>
    </div>

    <!-- Workshop Technician Productivity -->
    <div class="bento-card">
      <h3 style="margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem; font-size:1.05rem;">
        <Icon name="mdi:account-hard-hat-outline" width="20" height="20" color="var(--accent-blue)" /> Productividad de Mecánicos
      </h3>
      <div class="tech-productivity-list">
        <div class="tech-item">
          <div style="display:flex; justify-content:space-between; margin-bottom:0.35rem;">
            <strong style="font-size:0.88rem;">Marco Ramírez (Suspensiones)</strong>
            <span style="font-weight:700; color:var(--accent-green); font-size:0.85rem;">88.5% (35.4 hrs)</span>
          </div>
          <div class="progress-bar-wrap"><div class="progress-bar green" style="width:88.5%;"></div></div>
          <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--text-secondary); margin-top:0.25rem;">
            <span>12 servicios concluidos</span>
            <span>$11,200 MXN MO facturada</span>
          </div>
        </div>
        <div class="tech-item">
          <div style="display:flex; justify-content:space-between; margin-bottom:0.35rem;">
            <strong style="font-size:0.88rem;">Carlos Mendoza (Gravel / Ruta)</strong>
            <span style="font-weight:700; color:var(--accent-blue); font-size:0.85rem;">79.0% (31.6 hrs)</span>
          </div>
          <div class="progress-bar-wrap"><div class="progress-bar blue" style="width:79%;"></div></div>
          <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--text-secondary); margin-top:0.25rem;">
            <span>9 servicios concluidos</span>
            <span>$8,450 MXN MO facturada</span>
          </div>
        </div>
      </div>
      <div style="margin-top:1.25rem; padding:0.75rem; background:var(--bg-base); border-radius:8px; font-size:0.78rem; color:var(--text-secondary);">
        <strong>Tasa de Recuperación:</strong> El taller factura $375 MXN de mano de obra efectiva por cada hora de nómina pagada.
      </div>
    </div>

    <!-- Cohort Retention Funnel -->
    <div class="bento-card">
      <h3 style="margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem; font-size:1.05rem;">
        <Icon name="mdi:account-sync" width="20" height="20" color="#af52de" /> Ciclo de Retención del Ciclista
      </h3>
      <div class="cohort-funnel">
        <div class="funnel-step">
          <div class="step-label">1. Compra de Bicicleta Nueva</div>
          <div class="step-bar" style="width:100%;">100% (Base Adquirida)</div>
        </div>
        <div class="funnel-step">
          <div class="step-label">2. Ajuste 30 Días (Post-Venta)</div>
          <div class="step-bar green" style="width:68%;">68% de Retención</div>
        </div>
        <div class="funnel-step">
          <div class="step-label">3. Servicio General (6 Meses)</div>
          <div class="step-bar blue" style="width:44%;">44% Ciclistas Frecuentes</div>
        </div>
        <div class="funnel-step">
          <div class="step-label">4. Upgrade Accesorios / Rodadas</div>
          <div class="step-bar purple" style="width:31%;">31% Embajadores VIP</div>
        </div>
      </div>
    </div>

    <!-- SIMULADOR WHAT-IF (PREDICTIVE ENGINE) -->
    <div class="bento-card simulator-card" id="simulator-section" style="grid-column:span 3;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.5rem; margin-bottom:1.5rem;">
        <div>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <span class="badge purple">Algoritmo Predictivo</span>
            <span style="font-size:0.8rem; color:var(--text-secondary);">The Garage · Playa del Carmen &amp; Riviera Maya</span>
          </div>
          <h2 style="font-size:1.35rem; font-weight:700; margin-top:0.35rem; display:flex; align-items:center; gap:0.5rem;">
            <Icon name="mdi:chart-timeline-variant-shimmer" width="24" height="24" color="var(--accent-blue)" /> Simulador de Escenarios "What-If"
          </h2>
          <p class="text-muted" style="font-size:0.9rem; margin-top:0.25rem;">
            Modela el impacto financiero al ajustar flota de renta, capacidad de mecánicos en taller y precios estacionales para Ironman Cozumel / Invierno.
          </p>
        </div>

        <!-- Season Toggle Selector -->
        <div class="season-toggle-box">
          <button class="season-btn active" data-season="alta">
            <Icon name="mdi:weather-sunny" width="16" height="16" /> Temporada Alta (Nov–Abril)
          </button>
          <button class="season-btn" data-season="baja">
            <Icon name="mdi:weather-rainy" width="16" height="16" /> Temporada Baja (Mayo–Oct)
          </button>
        </div>
      </div>

      <div class="simulator-grid">
        <!-- Sliders Controls -->
        <div class="sim-controls">
          <div class="sim-group">
            <div class="sim-header">
              <label>Bicicletas Adicionales en Renta</label>
              <span class="sim-val" id="val-fleet">+5 Bicis</span>
            </div>
            <input type="range" min="0" max="15" value="5" step="1" id="slider-fleet" class="sim-range" />
            <span class="sim-hint">Inversión est. ~$12,000 MXN por bici (MTB/Gravel)</span>
          </div>

          <div class="sim-group">
            <div class="sim-header">
              <label>Capacidad de Taller (Mecánicos)</label>
              <span class="sim-val" id="val-mechanics">2 Mecánicos</span>
            </div>
            <input type="range" min="1" max="4" value="2" step="1" id="slider-mechanics" class="sim-range" />
            <span class="sim-hint">Capacidad actual: 8 servicios diarios combinados</span>
          </div>

          <div class="sim-group">
            <div class="sim-header">
              <label>Tarifa Promedio Servicio de Taller</label>
              <span class="sim-val" id="val-labor">$650 MXN</span>
            </div>
            <input type="range" min="350" max="1200" value="650" step="50" id="slider-labor" class="sim-range" />
            <span class="sim-hint">Precio base mano de obra general</span>
          </div>
        </div>

        <!-- Projection Results Dashboard -->
        <div class="sim-results">
          <div class="sim-res-box">
            <span class="sim-res-label">Ingreso Mensual Proyectado</span>
            <span class="sim-res-val green" id="res-monthly-rev">$178,500 MXN</span>
            <span class="sim-res-sub" id="res-rev-diff">+28.5% vs histórico actual</span>
          </div>

          <div class="sim-res-box">
            <span class="sim-res-label">Margen Bruto Proyectado</span>
            <span class="sim-res-val blue" id="res-gross-margin">$94,200 MXN</span>
            <span class="sim-res-sub">52.8% Margen consolidado</span>
          </div>

          <div class="sim-res-box">
            <span class="sim-res-label">Punto de Equilibrio (Break-even)</span>
            <span class="sim-res-val" id="res-break-even">$48,000 MXN</span>
            <span class="sim-res-sub">Se alcanza el día 9 del mes</span>
          </div>

          <div class="sim-res-box">
            <span class="sim-res-label">Retorno Inversión Flota (ROI)</span>
            <span class="sim-res-val purple" id="res-roi">3.2 Meses</span>
            <span class="sim-res-sub">Recuperación acelerada por alta demanda</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- 6 EXPLANATORY DEEP-DIVE DRILL-DOWN MODALS                               -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <!-- MODAL 1: DEEP-DIVE GMROI -->
  <div id="modal-deep-gmroi" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:680px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size:1.25rem; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
            <Icon name="mdi:scale-balance" width="22" height="22" color="var(--accent-green)" /> GMROI: Retorno de Margen sobre Stock
          </h2>
          <p class="text-muted" style="font-size:0.8rem; margin:0;">Gross Margin Return on Investment · Ascend Retail Machine Standard</p>
        </div>
        <button class="btn-icon close-deep-modal">&times;</button>
      </div>
      <div class="modal-body" style="padding:1.5rem; display:flex; flex-direction:column; gap:1.25rem;">
        <div class="deep-hero-box">
          <div class="deep-hero-metric green">3.8x GMROI</div>
          <p style="font-size:0.88rem; color:var(--text-primary); margin:0.35rem 0 0; line-height:1.4;">
            Por cada <strong>$1.00 MXN</strong> que The Garage mantiene invertido en stock en tienda, el negocio genera <strong>$3.80 MXN de margen de utilidad bruta anualizada</strong>.
          </p>
        </div>

        <div class="formula-card">
          <div style="font-size:0.75rem; color:var(--text-secondary); text-transform:uppercase; font-weight:700;">Fórmula Matemática Aplicada:</div>
          <div class="formula-text">GMROI = Margen Bruto Anualizado ($) / Costo Promedio del Inventario ($)</div>
        </div>

        <div>
          <h4 style="font-size:0.9rem; font-weight:700; margin-bottom:0.6rem;">Desglose por Categoría Comercial:</h4>
          <div class="deep-list">
            <div class="deep-item">
              <div>
                <strong>Mano de Obra Taller (14.2x)</strong>
                <p>Excelente: Pura habilidad técnica sin inversión congelada en estantes.</p>
              </div>
              <span class="badge green">Extraordinario</span>
            </div>
            <div class="deep-item">
              <div>
                <strong>Flota de Rentas Turísticas (4.8x)</strong>
                <p>Muy alto: Las bicicletas de renta se pagan solas en 3 a 4 meses en el Caribe.</p>
              </div>
              <span class="badge purple">Excelente</span>
            </div>
            <div class="deep-item">
              <div>
                <strong>Refacciones &amp; Consumibles (3.4x)</strong>
                <p>Saludable: Cadenas KMC, balatas Shimano y sellador giran cada 28 días.</p>
              </div>
              <span class="badge blue">Saludable</span>
            </div>
            <div class="deep-item">
              <div>
                <strong>Venta de Bicicletas Nuevas (1.9x)</strong>
                <p>Capital intensivo: Bicis de alto ticket (> $50k) tardan más en rotar.</p>
              </div>
              <span class="badge orange">A Optimizar</span>
            </div>
          </div>
        </div>

        <div style="background:var(--bg-base); padding:0.85rem; border-radius:8px; font-size:0.8rem; color:var(--text-secondary);">
          <strong>Recomendación del Asesor:</strong> Para subir de 3.8x a 4.5x, mantén el inventario de bicis caras bajo pedido o preventa y redirige liquidez a refacciones y flota de renta.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary close-deep-modal">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- MODAL 2: DEEP-DIVE LTV -->
  <div id="modal-deep-ltv" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:680px;">
      <div class="modal-header">
        <div>
          <h2 style="font-size:1.25rem; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
            <Icon name="mdi:account-sync" width="22" height="22" color="var(--accent-blue)" /> LTV: Ciclo de Vida del Ciclista (24 Meses)
          </h2>
          <p class="text-muted" style="font-size:0.8rem; margin:0;">Customer Lifetime Value &amp; Retención en Playa del Carmen</p>
        </div>
        <button class="btn-icon close-deep-modal">&times;</button>
      </div>
      <div class="modal-body" style="padding:1.5rem; display:flex; flex-direction:column; gap:1.25rem;">
        <div class="deep-hero-box">
          <div class="deep-hero-metric blue">$64,800 MXN</div>
          <p style="font-size:0.88rem; color:var(--text-primary); margin:0.35rem 0 0; line-height:1.4;">
            Es el gasto monetario acumulado promedio que un cliente ciclista aporta a The Garage en una ventana de <strong>24 meses</strong> desde su primera compra.
          </p>
        </div>

        <div>
          <h4 style="font-size:0.9rem; font-weight:700; margin-bottom:0.6rem;">¿De qué se compone este valor?</h4>
          <div class="deep-list">
            <div class="deep-item">
              <div>
                <strong>Compra Inicial de Bicicleta</strong>
                <p>Ticket promedio de adquisición (Basso, Specialized, Giant o Trek).</p>
              </div>
              <strong style="font-size:1.05rem;">$38,500 MXN (59.4%)</strong>
            </div>
            <div class="deep-item">
              <div>
                <strong>Servicios Preventivos de Taller</strong>
                <p>4 mantenimientos regulares durante los dos primeros años ($1,480 c/u).</p>
              </div>
              <strong style="font-size:1.05rem; color:var(--accent-green);">$5,920 MXN (9.1%)</strong>
            </div>
            <div class="deep-item">
              <div>
                <strong>Refacciones de Reemplazo por Desgaste</strong>
                <p>Cambio de 2 cadenas, 3 juegos de balatas, 4 cubiertas y líquido tubeless.</p>
              </div>
              <strong style="font-size:1.05rem; color:var(--accent-blue);">$6,800 MXN (10.5%)</strong>
            </div>
            <div class="deep-item">
              <div>
                <strong>Equipamiento, Ropa &amp; Accesorios</strong>
                <p>Casco POC, zapatillas Shimano, ciclocomputador Garmin, luces y jerseys.</p>
              </div>
              <strong style="font-size:1.05rem; color:#af52de;">$13,580 MXN (21.0%)</strong>
            </div>
          </div>
        </div>

        <div style="background:rgba(52,199,89,0.08); border:1px solid rgba(52,199,89,0.25); padding:0.85rem; border-radius:8px; font-size:0.8rem; color:var(--text-primary);">
          <strong>Eficiencia de Adquisición (CAC vs LTV):</strong> Con un costo de adquisición por publicidad de $1,200 MXN, el ratio <strong>LTV:CAC es de 54:1</strong>, lo que demuestra la enorme lealtad del cliente ciclista cuando el taller brinda servicio de excelencia.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary close-deep-modal">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- MODAL 3: DEEP-DIVE EFICIENCIA TALLER -->
  <div id="modal-deep-efficiency" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:680px;">
      <div class="modal-header">
        <div>
