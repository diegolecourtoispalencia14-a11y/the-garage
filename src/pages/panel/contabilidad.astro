---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { Icon } from 'astro-icon/components';
---
<PanelLayout title="Contabilidad & Caja Pro | BiciSaaS">
  <!-- Page Header & Calendar Navigation Bar -->
  <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.25rem;">
    <div>
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
        <span class="badge-pro">Enterprise Ledger & POS Cash</span>
        <span style="font-size:0.8rem; color:var(--text-secondary);" id="live-fiscal-badge">Ejercicio Fiscal 2026 · PDC</span>
      </div>
      <h1 class="page-title">Contabilidad y Caja Z.</h1>
      <p class="text-muted">Arqueo diario de caja, separación de márgenes, libro diario y depósitos en garantía.</p>
    </div>

    <!-- Calendarized Navigation Bar (Full Year 2026 + Month Opener) -->
    <div class="calendar-bar">
      <div class="month-nav-controls">
        <button class="btn-cal-nav" id="btn-prev-month" title="Mes Anterior">
          <Icon name="mdi:chevron-left" width="20" height="20" />
        </button>
        <select id="month-select" class="select-month-control">
          <option value="2026-01">Enero 2026</option>
          <option value="2026-02">Febrero 2026</option>
          <option value="2026-03">Marzo 2026</option>
          <option value="2026-04">Abril 2026</option>
          <option value="2026-05">Mayo 2026</option>
          <option value="2026-06">Junio 2026</option>
          <option value="2026-07">Julio 2026</option>
          <option value="2026-08">Agosto 2026</option>
          <option value="2026-09" selected>Septiembre 2026 (Actual)</option>
          <option value="2026-10">Octubre 2026</option>
          <option value="2026-11">Noviembre 2026</option>
          <option value="2026-12">Diciembre 2026 (Ironman)</option>
        </select>
        <button class="btn-cal-nav" id="btn-next-month" title="Mes Siguiente">
          <Icon name="mdi:chevron-right" width="20" height="20" />
        </button>
      </div>

      <button class="btn-secondary" id="btn-open-new-month" onclick="window.openNewMonthModal()" style="font-size:0.82rem; padding:0.5rem 0.9rem;">
        <Icon name="mdi:calendar-plus" width="16" height="16" /> + Aperturar Mes
      </button>

      <button class="btn-secondary" id="btn-open-cierre-z" style="background:rgba(0,113,227,0.1); border-color:rgba(0,113,227,0.25); color:var(--accent-blue);">
        <Icon name="mdi:cash-register" width="18" height="18" /> Arqueo de Caja Z
      </button>
      <button class="btn-primary" id="btn-export-ledger">
        <Icon name="mdi:download-outline" width="18" height="18" /> Exportar CSV
      </button>
    </div>
  </div>

  <!-- Interactive KPI Row (Clickable Drill-Down Buttons) -->
  <div class="kpi-row">
    <!-- KPI 1: Ingresos Totales -->
    <div class="kpi-card green clickable" id="kpi-card-income" role="button" tabindex="0" onclick="window.openDrilldown('modal-dd-income')" title="Ver desglose detallado de ingresos por canal y métodos">
      <div class="kpi-top">
        <Icon name="mdi:trending-up" width="26" height="26" />
        <span class="drill-hint">Auditar ↗</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Ingresos Totales</span>
        <span class="kpi-value" id="kpi-income">$0</span>
        <span class="kpi-sub" id="kpi-income-sub">Bicis, Taller & Rentas</span>
      </div>
    </div>

    <!-- KPI 2: Egresos / Costos -->
    <div class="kpi-card red clickable" id="kpi-card-expenses" role="button" tabindex="0" onclick="window.openDrilldown('modal-dd-expenses')" title="Ver desglose de costos fijos, insumos y deducibilidad">
      <div class="kpi-top">
        <Icon name="mdi:trending-down" width="26" height="26" />
        <span class="drill-hint">Auditar ↗</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Egresos / Costos</span>
        <span class="kpi-value" id="kpi-expenses">$0</span>
        <span class="kpi-sub" id="kpi-expenses-sub">Operación & Stock</span>
      </div>
    </div>

    <!-- KPI 3: Margen Neto Operativo -->
    <div class="kpi-card blue clickable" id="kpi-card-margin" role="button" tabindex="0" onclick="window.openDrilldown('modal-dd-margin')" title="Ver Estado de Resultados P&L simplificado">
      <div class="kpi-top">
        <Icon name="mdi:scale-balance" width="26" height="26" />
        <span class="drill-hint">P&L ↗</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Margen Neto Operativo</span>
        <span class="kpi-value" id="kpi-balance">$0</span>
        <span class="kpi-sub" id="kpi-margin-pct">0% Rentabilidad</span>
      </div>
    </div>

    <!-- KPI 4: Efectivo en Cajón (Hoy) -->
    <div class="kpi-card teal clickable" id="kpi-card-drawer" role="button" tabindex="0" onclick="window.openDrilldown('modal-dd-drawer')" title="Ver arqueo en vivo, caja chica y retiros a caja fuerte">
      <div class="kpi-top">
        <Icon name="mdi:cash-check" width="26" height="26" />
        <span class="drill-hint">Cajón ↗</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Efectivo en Cajón (Hoy)</span>
        <span class="kpi-value" id="kpi-cash-drawer">$0</span>
        <span class="kpi-sub" id="kpi-drawer-status">Fondo $2,000 + Cobros</span>
      </div>
    </div>

    <!-- KPI 5: Cuentas por Cobrar -->
    <div class="kpi-card orange clickable" id="kpi-card-receivable" role="button" tabindex="0" onclick="window.openDrilldown('modal-dd-receivable')" title="Ver cartera vencida, deudores y recordatorios WhatsApp">
      <div class="kpi-top">
        <Icon name="mdi:account-clock-outline" width="26" height="26" />
        <span class="drill-hint">Cartera ↗</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Cuentas por Cobrar</span>
        <span class="kpi-value" id="kpi-receivable">$0</span>
        <span class="kpi-sub" id="kpi-receivable-sub">Taller & Apartados</span>
      </div>
    </div>

    <!-- KPI 6: Depósitos en Garantía -->
    <div class="kpi-card purple clickable" id="kpi-card-escrow" role="button" tabindex="0" onclick="window.openDrilldown('modal-dd-escrow')" title="Ver depósitos de rentas en custodia temporal">
      <div class="kpi-top">
        <Icon name="mdi:shield-lock-outline" width="26" height="26" />
        <span class="drill-hint">Escrow ↗</span>
      </div>
      <div class="kpi-body">
        <span class="kpi-label">Depósitos en Garantía</span>
        <span class="kpi-value" id="kpi-escrow">$0</span>
        <span class="kpi-sub">Escrow Rentas Activas</span>
      </div>
    </div>
  </div>

  <!-- Accounting View Tabs -->
  <div class="accounting-view-tabs">
    <button class="view-tab active" data-view="diario">
      <Icon name="mdi:book-open-outline" width="18" height="18" /> Libro Diario & Flujos
    </button>
    <button class="view-tab" data-view="cierre-z">
      <Icon name="mdi:calculator-variant-outline" width="18" height="18" /> Arqueo y Cierre Z (Denominaciones)
    </button>
    <button class="view-tab" data-view="margenes">
      <Icon name="mdi:chart-pie" width="18" height="18" /> Rentabilidad por Unidad de Negocio
    </button>
    <button class="view-tab" data-view="cuentas">
      <Icon name="mdi:hand-coin-outline" width="18" height="18" /> Cobros de Taller & Depósitos en Garantía
    </button>
  </div>

  <!-- VIEW 1: LIBRO DIARIO (3 COLUMNS) -->
  <div id="view-diario" class="accounting-grid">
    <!-- Columna 1: Ingresos / Ventas -->
    <div class="bento-card ledger-col">
      <div class="col-header">
        <h3><span class="dot green"></span> Ingresos Registrados</h3>
        <button class="btn-add-row" id="btn-add-income">+ Agregar</button>
      </div>
      <div class="ledger-list" id="income-list"></div>
    </div>

    <!-- Columna 2: Caja Chica / Gastos Fijos -->
    <div class="bento-card ledger-col">
      <div class="col-header">
        <h3><span class="dot red"></span> Caja Chica & Egresos</h3>
        <button class="btn-add-row" id="btn-add-expense">+ Agregar</button>
      </div>
      <div class="ledger-list" id="expense-list"></div>
    </div>

    <!-- Columna 3: Cuentas Pendientes -->
    <div class="bento-card ledger-col">
      <div class="col-header">
        <h3><span class="dot orange"></span> Obligaciones Pendientes</h3>
        <button class="btn-add-row" id="btn-add-debt">+ Agregar</button>
      </div>
      <!-- Sub tabs -->
      <div class="debt-tabs">
        <button class="debt-tab active" data-tab="cobrar">Por Cobrar (Clientes)</button>
        <button class="debt-tab" data-tab="pagar">Por Pagar (Proveedores)</button>
      </div>
      <div class="ledger-list" id="debt-list"></div>
    </div>
  </div>

  <!-- VIEW 2: ARQUEO Y CIERRE Z (DENOMINATION COUNTER) -->
  <div id="view-cierre-z" class="bento-card" style="display:none; padding:2rem;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.5rem; margin-bottom:2rem; border-bottom:1px solid var(--border-subtle); padding-bottom:1.5rem;">
      <div>
        <h2 style="font-size:1.35rem; font-weight:700; display:flex; align-items:center; gap:0.6rem;">
          <Icon name="mdi:cash-register" width="24" height="24" color="var(--accent-blue)" /> Corte Z y Cuadratura de Caja Diaria
        </h2>
        <p class="text-muted" style="margin-top:0.35rem; font-size:0.9rem;">
          Procedimiento de auditoría ciega: ingresa el conteo de billetes y monedas en físico para conciliar contra las transacciones registradas en mostrador.
        </p>
      </div>
      <div style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap;">
        <div style="background:var(--bg-base); padding:0.6rem 1rem; border-radius:12px; border:1px solid var(--border-subtle); text-align:right;">
          <div style="font-size:0.75rem; color:var(--text-secondary); text-transform:uppercase;">Fondo Inicial Fijo</div>
          <div style="font-size:1.1rem; font-weight:700; color:var(--accent-blue);">$2,000 MXN</div>
        </div>
        <button class="btn-primary" id="btn-save-cierre-z" style="background:var(--accent-green); border-color:var(--accent-green);">
          <Icon name="mdi:check-decagram" width="18" height="18" /> Realizar Corte Z & Guardar Auditoría
        </button>
      </div>
    </div>

    <div class="cierre-z-grid">
      <!-- Calculadora de Billetes -->
      <div class="denom-box">
        <h3 class="denom-title"><Icon name="mdi:cash-multiple" width="20" height="20" color="var(--accent-green)" /> Billetes Físicos</h3>
        <div class="denom-table">
          <div class="denom-row">
            <span class="denom-tag">$1,000</span>
            <input type="number" min="0" value="0" class="denom-input" data-val="1000" id="bill-1000" />
            <span class="denom-subtotal" id="sub-1000">$0</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$500</span>
            <input type="number" min="0" value="2" class="denom-input" data-val="500" id="bill-500" />
            <span class="denom-subtotal" id="sub-500">$1,000</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$200</span>
            <input type="number" min="0" value="4" class="denom-input" data-val="200" id="bill-200" />
            <span class="denom-subtotal" id="sub-200">$800</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$100</span>
            <input type="number" min="0" value="7" class="denom-input" data-val="100" id="bill-100" />
            <span class="denom-subtotal" id="sub-100">$700</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$50</span>
            <input type="number" min="0" value="8" class="denom-input" data-val="50" id="bill-50" />
            <span class="denom-subtotal" id="sub-50">$400</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$20</span>
            <input type="number" min="0" value="5" class="denom-input" data-val="20" id="bill-20" />
            <span class="denom-subtotal" id="sub-20">$100</span>
          </div>
        </div>
      </div>

      <!-- Calculadora de Monedas -->
      <div class="denom-box">
        <h3 class="denom-title"><Icon name="mdi:circle-multiple-outline" width="20" height="20" color="var(--accent-orange)" /> Monedas Fraccionarias</h3>
        <div class="denom-table">
          <div class="denom-row">
            <span class="denom-tag">$20 M.</span>
            <input type="number" min="0" value="1" class="denom-input" data-val="20" id="coin-20" />
            <span class="denom-subtotal" id="sub-c20">$20</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$10 M.</span>
            <input type="number" min="0" value="12" class="denom-input" data-val="10" id="coin-10" />
            <span class="denom-subtotal" id="sub-10">$120</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$5 M.</span>
            <input type="number" min="0" value="16" class="denom-input" data-val="5" id="coin-5" />
            <span class="denom-subtotal" id="sub-5">$80</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$2 M.</span>
            <input type="number" min="0" value="15" class="denom-input" data-val="2" id="coin-2" />
            <span class="denom-subtotal" id="sub-2">$30</span>
          </div>
          <div class="denom-row">
            <span class="denom-tag">$1 M.</span>
            <input type="number" min="0" value="20" class="denom-input" data-val="1" id="coin-1" />
            <span class="denom-subtotal" id="sub-1">$20</span>
          </div>
        </div>
      </div>

      <!-- Resumen de Cuadratura & Descuadre -->
      <div class="audit-summary-card">
        <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
          <Icon name="mdi:scale-balance" width="20" height="20" color="var(--accent-blue)" /> Balance de Cuadratura
        </h3>
        
        <div class="audit-row">
          <span class="audit-label">Fondo de Apertura (Cambio)</span>
          <span class="audit-value">$2,000.00</span>
        </div>
        <div class="audit-row">
          <span class="audit-label">+ Ventas en Efectivo Registradas</span>
          <span class="audit-value green" id="audit-cash-sales">+$1,270.00</span>
        </div>
        <div class="audit-row">
          <span class="audit-label">- Pagos Caja Chica del Día</span>
          <span class="audit-value red" id="audit-cash-payouts">-$0.00</span>
        </div>
        <div class="audit-divider"></div>
        <div class="audit-row highlight">
          <span class="audit-label">Efectivo Teórico en Sistema</span>
          <span class="audit-value" id="audit-expected">$3,270.00</span>
        </div>
        <div class="audit-row highlight">
          <span class="audit-label">Efectivo Físico Contado</span>
          <span class="audit-value bold" id="audit-counted">$3,270.00</span>
        </div>
        
        <!-- Descuadre Banner -->
        <div class="variance-banner balanced" id="variance-box">
          <div class="var-title" id="variance-title">Caja Cuadrada Sin Diferencias</div>
          <div class="var-amount" id="variance-diff">$0.00 MXN</div>
        </div>

        <div style="margin-top:1.25rem; font-size:0.8rem; color:var(--text-secondary); line-height:1.4;">
          <strong>Política de Cierre The Garage:</strong> Al hacer el corte, se dejan exactamente $2,000 en el cajón para el siguiente turno y el excedente se deposita en caja fuerte blindada.
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 3: MARGENES Y UNIDADES DE NEGOCIO -->
  <div id="view-margenes" class="bento-card" style="display:none; padding:2rem;">
    <div style="margin-bottom:1.5rem;">
      <h2 style="font-size:1.35rem; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
        <Icon name="mdi:finance" width="24" height="24" color="var(--accent-green)" /> Desglose de Rentabilidad por Flujo de Negocio
      </h2>
      <p class="text-muted" style="margin-top:0.25rem; font-size:0.9rem;">
        Comparativa de margen bruto y contribución real de cada área operativa (Bicicletas Nuevas, Taller de Mano de Obra, Refacciones y Rentas).
      </p>
    </div>

    <div class="margins-grid">
      <!-- Tarjeta 1: Venta Bicis -->
      <div class="margin-card">
        <div class="m-head">
          <span class="m-icon"><Icon name="mdi:bicycle" width="22" height="22" /></span>
          <div>
            <div class="m-title">Venta de Bicicletas</div>
            <div class="m-sub">Alto ticket · Capital intensivo</div>
          </div>
        </div>
        <div class="m-metric">
          <span class="m-val" id="margin-val-bikes">$127,850</span>
          <span class="m-badge orange">28.5% Margen</span>
        </div>
        <p class="m-desc">Genera volumen de facturación y atrae nuevos ciclistas que posteriormente contratan servicios y compran accesorios.</p>
      </div>

      <!-- Tarjeta 2: Taller Mano de Obra -->
      <div class="margin-card highlight-green">
        <div class="m-head">
          <span class="m-icon" style="color:var(--accent-green);"><Icon name="mdi:wrench" width="22" height="22" /></span>
          <div>
            <div class="m-title">Mano de Obra Taller</div>
            <div class="m-sub">Alta rentabilidad · Talento técnico</div>
          </div>
        </div>
        <div class="m-metric">
          <span class="m-val" id="margin-val-labor">$14,950</span>
          <span class="m-badge green">91.2% Margen</span>
        </div>
        <p class="m-desc">La unidad de mayor margen neto. Pura eficiencia operativa de los mecánicos con costo de consumibles casi nulo.</p>
      </div>

      <!-- Tarjeta 3: Refacciones y Componentes -->
      <div class="margin-card">
        <div class="m-head">
          <span class="m-icon" style="color:var(--accent-blue);"><Icon name="mdi:cog-outline" width="22" height="22" /></span>
          <div>
            <div class="m-title">Refacciones & Consumibles</div>
            <div class="m-sub">Cadenas, pastillas, cubiertas</div>
          </div>
        </div>
        <div class="m-metric">
          <span class="m-val" id="margin-val-parts">$18,100</span>
          <span class="m-badge blue">48.0% Margen</span>
        </div>
        <p class="m-desc">Venta anexa a los servicios del taller y reemplazo por desgaste. Rotación continua con proveedores Shimano y Maxxis.</p>
      </div>

      <!-- Tarjeta 4: Flota de Rentas -->
      <div class="margin-card highlight-purple">
        <div class="m-head">
          <span class="m-icon" style="color:#af52de;"><Icon name="mdi:bike-fast" width="22" height="22" /></span>
          <div>
            <div class="m-title">Flota de Rentas Turísticas</div>
            <div class="m-sub">Flujo recurrente · Riviera Maya</div>
          </div>
        </div>
        <div class="m-metric">
          <span class="m-val" id="margin-val-rentals">$6,850</span>
          <span class="m-badge purple">84.5% Margen</span>
        </div>
        <p class="m-desc">Excelente flujo de efectivo en temporada alta (Nov-Abril). Los depósitos en garantía se conservan en escrow hasta la devolución.</p>
      </div>
    </div>

    <!-- Fiscal / SAT Estimation Bar -->
    <div style="margin-top:2rem; background:var(--bg-base); border-radius:var(--radius-lg); padding:1.5rem; border:1px solid var(--border-subtle);">
      <h4 style="font-size:0.95rem; font-weight:700; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.5rem;">
        <Icon name="mdi:file-document-outline" width="18" height="18" color="var(--accent-blue)" /> Estimación Fiscal Preliminar (IVA 16% SAT México)
      </h4>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem;">
        <div style="background:var(--bg-surface); padding:1rem; border-radius:10px;">
          <div style="font-size:0.75rem; color:var(--text-secondary);">IVA Trasladado (Cobrado a clientes)</div>
          <div style="font-size:1.2rem; font-weight:700; color:var(--accent-green); margin-top:0.25rem;" id="sat-iva-trasladado">$22,041 MXN</div>
        </div>
        <div style="background:var(--bg-surface); padding:1rem; border-radius:10px;">
          <div style="font-size:0.75rem; color:var(--text-secondary);">IVA Acreditable (Deducible compras/renta)</div>
          <div style="font-size:1.2rem; font-weight:700; color:var(--accent-red); margin-top:0.25rem;" id="sat-iva-acreditable">-$9,310 MXN</div>
        </div>
        <div style="background:var(--bg-surface); padding:1rem; border-radius:10px;">
          <div style="font-size:0.75rem; color:var(--text-secondary);">Balance Estimado de IVA por Declarar</div>
          <div style="font-size:1.2rem; font-weight:700; color:var(--accent-orange); margin-top:0.25rem;" id="sat-iva-balance">$12,731 MXN</div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 4: CUENTAS POR COBRAR Y ESCROW -->
  <div id="view-cuentas" class="bento-card" style="display:none; padding:2rem;">
    <div style="margin-bottom:1.5rem;">
      <h2 style="font-size:1.35rem; font-weight:700; display:flex; align-items:center; gap:0.5rem;">
        <Icon name="mdi:hand-coin-outline" width="24" height="24" color="var(--accent-orange)" /> Cobros Pendientes de Taller & Depósitos en Garantía
      </h2>
      <p class="text-muted" style="margin-top:0.25rem; font-size:0.9rem;">
        Control de bicicletas listas para entrega con remanente por cobrar en mostrador, y resguardo de depósitos de renta en garantía.
      </p>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
      <!-- Saldos por Cobrar Taller -->
