      ]
    };
  }

  function getStorageKey(month) {
    return STORE_PREFIX + month.replace('-', '_');
  }

  function loadMonthData(month) {
    const key = getStorageKey(month);
    const raw = localStorage.getItem(key);
    if (raw) {
      try { return JSON.parse(raw); } catch(e) {}
    }
    // Backward compatibility with generic bicisaas_ledger
    if (month === '2026-09') {
      const generic = localStorage.getItem('bicisaas_ledger');
      if (generic) {
        try {
          const parsed = JSON.parse(generic);
          localStorage.setItem(key, JSON.stringify(parsed));
          return parsed;
        } catch(e) {}
      }
    }
    const emptyData = { income: [], expenses: [], cobrar: [], pagar: [] };
    localStorage.setItem(key, JSON.stringify(emptyData));
    return emptyData;
  }

  function saveMonthData(month, data) {
    localStorage.setItem(getStorageKey(month), JSON.stringify(data));
    if (month === '2026-09') localStorage.setItem('bicisaas_ledger', JSON.stringify(data));
  }

