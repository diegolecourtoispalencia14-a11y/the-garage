    updateAllViews();
  });

  document.getElementById('btn-prev-month')?.addEventListener('click', () => {
    const idx = monthSelect.selectedIndex;
    if (idx > 0) {
      monthSelect.selectedIndex = idx - 1;
      currentMonth = monthSelect.value;
      updateAllViews();
    }
  });

  document.getElementById('btn-next-month')?.addEventListener('click', () => {
    const idx = monthSelect.selectedIndex;
    if (idx < monthSelect.options.length - 1) {
      monthSelect.selectedIndex = idx + 1;
      currentMonth = monthSelect.value;
      updateAllViews();
    }
  });

  // Modal Aperturar Nuevo Mes
  const modalNewMonth = document.getElementById('modal-new-month');
  document.getElementById('btn-open-new-month')?.addEventListener('click', () => {
    modalNewMonth.style.display = 'flex';
  });
  document.getElementById('close-new-month-modal')?.addEventListener('click', () => {
    modalNewMonth.style.display = 'none';
  });
  document.getElementById('cancel-new-month-btn')?.addEventListener('click', () => {
    modalNewMonth.style.display = 'none';
  });

  document.getElementById('confirm-new-month-btn')?.addEventListener('click', () => {
    const selectedNewMonth = document.getElementById('new-month-input').value;
    if (!selectedNewMonth) return;

    // Check if option exists in select
    let opt = Array.from(monthSelect.options).find(o => o.value === selectedNewMonth);
    if (!opt) {
      const [year, monthNum] = selectedNewMonth.split('-');
      const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
      const monthName = monthNames[parseInt(monthNum, 10) - 1] || 'Mes ' + monthNum;
      opt = document.createElement('option');
      opt.value = selectedNewMonth;
      opt.textContent = monthName + ' ' + year + ' (Aperturado)';
      monthSelect.appendChild(opt);
    }

    monthSelect.value = selectedNewMonth;
    currentMonth = selectedNewMonth;

    // Initialize clean month data with opening float
    const freshData = { income: [], expenses: [], cobrar: [], pagar: [] };
    saveMonthData(selectedNewMonth, freshData);

    modalNewMonth.style.display = 'none';
    alert('Mes Fiscal ' + selectedNewMonth + ' aperturado con éxito.\n\n• Fondo de Caja inicial: $2,000 MXN\n• Cuentas por cobrar traspasadas\n• Periodo contable activado para registro de transacciones.');
    updateAllViews();
  });

  // Tab switching
  const viewTabs = document.querySelectorAll('.view-tab');
  viewTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      viewTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const view = tab.getAttribute('data-view');
      ['diario', 'cierre-z', 'margenes', 'cuentas'].forEach(v => {
        const el = document.getElementById('view-' + v);
        if (el) el.style.display = (v === view) ? (v === 'diario' ? 'grid' : 'block') : 'none';
      });
      if (view === 'cierre-z') calculateDenominations();
    });
  });

  document.getElementById('btn-open-cierre-z')?.addEventListener('click', () => {
    document.querySelector('.view-tab[data-view="cierre-z"]')?.click();
  });
  document.getElementById('btn-goto-cierre-z')?.addEventListener('click', () => {
    document.getElementById('modal-dd-drawer').style.display = 'none';
    document.querySelector('.view-tab[data-view="cierre-z"]')?.click();
  });

  // KPI Calculations & DOM Updates
  function updateKPIs(data) {
    const income = data.income.reduce((s, x) => s + x.amount, 0);
    const expenses = data.expenses.reduce((s, x) => s + x.amount, 0);
    const receivable = data.cobrar.reduce((s, x) => s + x.amount, 0);
    const net = income - expenses;
    const marginPct = income > 0 ? Math.round((net / income) * 100) : 0;

    document.getElementById('kpi-income').textContent = fmt(income);
    document.getElementById('kpi-expenses').textContent = fmt(expenses);
    document.getElementById('kpi-balance').textContent = fmt(net);
    document.getElementById('kpi-margin-pct').textContent = marginPct + '% Rentabilidad Neta';
    document.getElementById('kpi-receivable').textContent = fmt(receivable);

    const cashIncome = data.income
      .filter(x => x.method === 'Efectivo')
      .reduce((s, x) => s + x.amount, 0);
    const totalCashInDrawer = 2000 + cashIncome;
    document.getElementById('kpi-cash-drawer').textContent = fmt(totalCashInDrawer);
    document.getElementById('audit-cash-sales').textContent = '+' + fmt(cashIncome);
    document.getElementById('audit-expected').textContent = fmt(totalCashInDrawer);

    document.getElementById('kpi-escrow').textContent = '$4,000';

    const balEl = document.getElementById('kpi-balance');
    balEl.style.color = net >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';

    // Update Drill-Down Modals DOM
    document.getElementById('dd-income-total').textContent = fmt(income) + ' MXN';
    document.getElementById('dd-expenses-total').textContent = fmt(expenses) + ' MXN';
    document.getElementById('dd-margin-total').textContent = fmt(net) + ' MXN';
    document.getElementById('dd-margin-pct').textContent = 'Rentabilidad Neta: ' + marginPct + '%';
    document.getElementById('dd-drawer-total').textContent = fmt(totalCashInDrawer) + ' MXN';
    document.getElementById('dd-receivable-total').textContent = fmt(receivable) + ' MXN';

    const monthLabel = monthSelect.options[monthSelect.selectedIndex]?.text || currentMonth;
    document.getElementById('dd-income-period').textContent = 'Periodo: ' + monthLabel;
    document.getElementById('dd-expenses-period').textContent = 'Periodo: ' + monthLabel;
    document.getElementById('dd-margin-period').textContent = 'Periodo: ' + monthLabel;
    document.getElementById('live-fiscal-badge').textContent = 'Periodo: ' + monthLabel + ' · PDC';

    // P&L Table in Margin Drill-down
    const cogs = Math.round(income * 0.43);
    const grossProfit = income - cogs;
    const ebitda = grossProfit - expenses;
    document.getElementById('pnl-gross-income').textContent = fmt(income) + ' MXN';
    document.getElementById('pnl-cogs').textContent = '-' + fmt(cogs) + ' MXN';
    document.getElementById('pnl-gross-profit').textContent = fmt(grossProfit) + ' MXN (' + Math.round((grossProfit/income)*100) + '%)';
    document.getElementById('pnl-opex').textContent = '-' + fmt(expenses) + ' MXN';
    document.getElementById('pnl-ebitda').textContent = fmt(ebitda) + ' MXN (' + Math.round((ebitda/income)*100) + '%)';

    // SAT Taxes update
    const ivaTrasladado = Math.round(income * 0.16);
    const ivaAcreditable = Math.round(expenses * 0.16);
    const ivaBalance = ivaTrasladado - ivaAcreditable;
    document.getElementById('sat-iva-trasladado').textContent = fmt(ivaTrasladado) + ' MXN';
    document.getElementById('sat-iva-acreditable').textContent = '-' + fmt(ivaAcreditable) + ' MXN';
    document.getElementById('sat-iva-balance').textContent = fmt(ivaBalance) + ' MXN';
  }

  
  // Global modal opener helpers
  window.openDrilldown = function(modalId) {
    const m = document.getElementById(modalId);
    if (m) m.style.display = 'flex';
  };
  window.openNewMonthModal = function() {
    const m = document.getElementById('modal-new-month');
    if (m) m.style.display = 'flex';
  };

  // Close modals on overlay backdrop click or Escape key
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.style.display = 'none';
    });
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-overlay').forEach(m => m.style.display = 'none');
    }
  });

  // Bind 6 KPI Drill-Down Modals
  const drillMap = [
    { cardId: 'kpi-card-income', modalId: 'modal-dd-income' },
    { cardId: 'kpi-card-expenses', modalId: 'modal-dd-expenses' },
    { cardId: 'kpi-card-margin', modalId: 'modal-dd-margin' },
    { cardId: 'kpi-card-drawer', modalId: 'modal-dd-drawer' },
    { cardId: 'kpi-card-receivable', modalId: 'modal-dd-receivable' },
    { cardId: 'kpi-card-escrow', modalId: 'modal-dd-escrow' },
  ];

  drillMap.forEach(item => {
    const card = document.getElementById(item.cardId);
    const modal = document.getElementById(item.modalId);
    if (card && modal) {
      card.addEventListener('click', () => {
        modal.style.display = 'flex';
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          modal.style.display = 'flex';
        }
      });
    }
  });

  document.querySelectorAll('.close-dd-modal').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.modal-overlay').forEach(m => {
        if (m.id.startsWith('modal-dd-')) m.style.display = 'none';
      });
    });
  });

  // Denominations Counter & Cierre Z logic
  function calculateDenominations() {
    let sumBills = 0;
    let sumCoins = 0;

    const bills = [
      { id: 'bill-1000', val: 1000, subId: 'sub-1000' },
      { id: 'bill-500',  val: 500,  subId: 'sub-500' },
      { id: 'bill-200',  val: 200,  subId: 'sub-200' },
      { id: 'bill-100',  val: 100,  subId: 'sub-100' },
      { id: 'bill-50',   val: 50,   subId: 'sub-50' },
      { id: 'bill-20',   val: 20,   subId: 'sub-20' },
    ];

    bills.forEach(b => {
      const el = document.getElementById(b.id);
      const qty = parseInt(el?.value || '0', 10) || 0;
      const sub = qty * b.val;
      sumBills += sub;
      const subEl = document.getElementById(b.subId);
      if (subEl) subEl.textContent = fmt(sub);
    });

    const coins = [
      { id: 'coin-20', val: 20, subId: 'sub-c20' },
      { id: 'coin-10', val: 10, subId: 'sub-10' },
      { id: 'coin-5',  val: 5,  subId: 'sub-5' },
      { id: 'coin-2',  val: 2,  subId: 'sub-2' },
      { id: 'coin-1',  val: 1,  subId: 'sub-1' },
    ];

    coins.forEach(c => {
      const el = document.getElementById(c.id);
      const qty = parseInt(el?.value || '0', 10) || 0;
      const sub = qty * c.val;
      sumCoins += sub;
      const subEl = document.getElementById(c.subId);
      if (subEl) subEl.textContent = fmt(sub);
    });

    const totalCounted = sumBills + sumCoins;
    document.getElementById('audit-counted').textContent = fmt(totalCounted);

    const data = loadMonthData(currentMonth);
    const cashIncome = data.income
      .filter(x => x.method === 'Efectivo')
      .reduce((s, x) => s + x.amount, 0);
    const expected = 2000 + cashIncome;
    const diff = totalCounted - expected;

    const varBox = document.getElementById('variance-box');
    const varTitle = document.getElementById('variance-title');
    const varDiff = document.getElementById('variance-diff');

    varBox.className = 'variance-banner';
    if (diff === 0) {
      varBox.classList.add('balanced');
      varTitle.textContent = 'Caja Cuadrada Sin Diferencias';
      varDiff.textContent = '$0.00 MXN (Exacto)';
    } else if (diff > 0) {
      varBox.classList.add('surplus');
      varTitle.textContent = '▲ Sobrante en Caja Registrado';
      varDiff.textContent = '+' + fmt(diff) + ' MXN';
    } else {
      varBox.classList.add('deficit');
      varTitle.textContent = '▼ Faltante en Caja Detectado';
      varDiff.textContent = '-' + fmt(Math.abs(diff)) + ' MXN';
    }
  }

  document.querySelectorAll('.denom-input').forEach(inp => {
    inp.addEventListener('input', calculateDenominations);
  });

  // Save Cierre Z
  document.getElementById('btn-save-cierre-z')?.addEventListener('click', () => {
    const counted = document.getElementById('audit-counted').textContent;
    const diff = document.getElementById('variance-diff').textContent;
    const session = JSON.parse(localStorage.getItem('bicisaas_session') || '{}');
    const cashierName = session.userName || 'Diego Lecourtois';

    const record = {
      month: currentMonth,
      date: new Date().toISOString().split('T')[0],
      time: new Date().toLocaleTimeString(),
      cashier: cashierName,
      countedTotal: counted,
      diff: diff,
      fixedFloatRetained: '$2,000 MXN'
    };
    localStorage.setItem(Z_KEY, JSON.stringify(record));
    alert('Corte Z Oficial Registrado Exitosamente\n\n• Periodo: ' + currentMonth + '\n• Cajero Responsable: ' + cashierName + '\n• Efectivo Contado: ' + counted + '\n• Descuadre: ' + diff + '\n• Retiro a Caja de Seguridad: Realizado\n• Fondo Permanente en Cajón: $2,000 MXN');
  });

  // Render Ledger List
  function renderList(containerId, items, type) {
    const el = document.getElementById(containerId);
    if (!el) return;
    el.innerHTML = '';
    if (items.length === 0) {
      el.innerHTML = '<p style="color:var(--text-secondary); font-size:0.85rem; text-align:center; padding:1.5rem;">Sin transacciones en este mes</p>';
      return;
    }
    items.forEach(item => {
      el.innerHTML += `
        <div class="ledger-item ${type}">
          <div class="item-meta">
            <span class="item-desc">${item.desc}</span>
            <div style="display:flex; gap:0.5rem; align-items:center;">
              <span class="item-cat">${item.cat || ''}</span>
              ${item.method ? `<span style="font-size:0.7rem; background:rgba(0,113,227,0.1); color:var(--accent-blue); padding:0.1rem 0.4rem; border-radius:4px;">${item.method}</span>` : ''}
            </div>
            ${item.party ? `<span class="item-party">${item.party}</span>` : ''}
            <span class="item-date">${item.date}</span>
          </div>
          <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.4rem;">
            <span class="item-amount ${type}">${fmt(item.amount)}</span>
            <button class="btn-tiny" onclick="deleteEntry('${type}', ${item.id})" title="Eliminar"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
          </div>
        </div>
      `;
    });
  }

  // Render Cuentas por Cobrar Taller & Escrow Tab
  function renderCuentasTab() {
    const debtList = document.getElementById('workshop-debt-list');
    if (debtList) {
      try {
        const rawOrders = localStorage.getItem('bicisaas_workshop_orders');
        const orders = rawOrders ? JSON.parse(rawOrders) : [];
        const pendingOrders = orders.filter(o => o.status !== 'entregado' && (o.balanceDue || 0) > 0);
        if (pendingOrders.length === 0) {
          debtList.innerHTML = '<div style="color:var(--text-secondary); text-align:center; padding:1.5rem; font-size:0.85rem;">No hay saldos pendientes por cobrar en taller</div>';
        } else {
          debtList.innerHTML = pendingOrders.map(o => `
            <div class="escrow-row">
              <div>
                <div class="escrow-title">${o.bikeBrand || ''} ${o.bikeModel || ''} (${o.folio || ''})</div>
                <div class="escrow-meta">Cliente: ${o.clientName || 'Cliente'} · ${o.status || ''}</div>
              </div>
              <div style="text-align:right;">
                <div class="escrow-amount" style="color:var(--accent-orange);">$${Number(o.balanceDue || 0).toLocaleString('es-MX')} MXN</div>
                <span style="font-size:0.7rem; color:var(--accent-green);">Total: $${Number(o.totalCost || 0).toLocaleString('es-MX')}</span>
              </div>
            </div>
          `).join('');
        }
      } catch(e) {
        debtList.innerHTML = '<div style="color:var(--text-secondary); text-align:center; padding:1.5rem; font-size:0.85rem;">No hay saldos pendientes por cobrar en taller</div>';
      }
    }

    const escrowList = document.getElementById('escrow-list');
    if (escrowList) {
      try {
        const rawContracts = localStorage.getItem('thegarage_rental_contracts');
        const contracts = rawContracts ? JSON.parse(rawContracts) : [];
        const activeEscrows = contracts.filter(c => c.status === 'activa' && c.depositStatus === 'retenido');
        if (activeEscrows.length === 0) {
          escrowList.innerHTML = '<div style="color:var(--text-secondary); text-align:center; padding:1.5rem; font-size:0.85rem;">No hay depósitos en garantía activos</div>';
        } else {
          escrowList.innerHTML = activeEscrows.map(c => `
            <div class="escrow-row">
              <div>
                <div class="escrow-title">${c.bikeModel || 'Bicicleta'} (${c.folio || ''})</div>
                <div class="escrow-meta">Cliente: ${c.clientName || 'Cliente'} · ${c.hotelOrAddress || ''}</div>
              </div>
              <div style="text-align:right;">
                <div class="escrow-amount" style="color:#af52de;">$${Number(c.depositFee || 0).toLocaleString('es-MX')} MXN</div>
                <span style="font-size:0.7rem; color:var(--text-secondary);">En Retención Temporal</span>
              </div>
            </div>
          `).join('');
        }
      } catch(e) {
        escrowList.innerHTML = '<div style="color:var(--text-secondary); text-align:center; padding:1.5rem; font-size:0.85rem;">No hay depósitos en garantía activos</div>';
      }
    }
  }

  let activeDebtTab = 'cobrar';

  function updateAllViews() {
    const data = loadMonthData(currentMonth);
    renderList('income-list', data.income, 'income');
    renderList('expense-list', data.expenses, 'expense');
    renderList('debt-list', data[activeDebtTab], activeDebtTab);
    updateKPIs(data);
    calculateDenominations();
    renderCuentasTab();
  }

  window.deleteEntry = function(type, id) {
    if (!confirm('¿Eliminar este registro contable del mes activo?')) return;
    const data = loadMonthData(currentMonth);
    const key = type === 'income' ? 'income' : type === 'expense' ? 'expenses' : type;
    data[key] = data[key].filter(x => x.id !== id);
    saveMonthData(currentMonth, data);
    updateAllViews();
  };

  // Debt tabs
  document.querySelectorAll('.debt-tab').forEach(tab => {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.debt-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      activeDebtTab = this.dataset.tab;
      const data = loadMonthData(currentMonth);
      renderList('debt-list', data[activeDebtTab], activeDebtTab);
    });
  });

  // Modal manual transaction logic
  let currentModalType = 'income';
  const txModal = document.getElementById('tx-modal');

  function openModal(type) {
    currentModalType = type;
    const titles = { income: 'Nuevo Ingreso', expense: 'Nuevo Gasto (Caja Chica)', cobrar: 'Nueva Deuda por Cobrar', pagar: 'Nueva Deuda por Pagar' };
    document.getElementById('tx-modal-title').textContent = titles[type];
    document.getElementById('tx-desc').value = '';
    document.getElementById('tx-amount').value = '';
    document.getElementById('tx-date').value = currentMonth + '-15';

    const partyGroup = document.getElementById('tx-party-group');
    const catGroup = document.getElementById('tx-cat-group');
    const partyLabel = document.getElementById('tx-party-label');
    const catSelect = document.getElementById('tx-cat');

    if (type === 'cobrar' || type === 'pagar') {
      partyGroup.style.display = 'block';
      partyLabel.textContent = type === 'cobrar' ? 'Nombre del Cliente' : 'Nombre del Proveedor';
      catSelect.innerHTML = type === 'cobrar'
        ? '<option>Venta a Crédito</option><option>Apartado / Anticipo</option><option>Servicio de Taller Pendiente</option>'
        : '<option>Compra a Proveedor</option><option>Servicios Externos</option><option>Flete o Aduana</option>';
    } else {
      partyGroup.style.display = 'none';
      catSelect.innerHTML = type === 'income'
        ? '<option>Venta de Bicicleta</option><option>Venta de Accesorio</option><option>Servicio de Taller (Mano de Obra)</option><option>Refacciones Taller</option><option>Renta de Bicicletas</option><option>Apartado / Anticipo</option>'
        : '<option>Renta Local</option><option>Luz / CFE</option><option>Agua</option><option>Internet / WiFi</option><option>Salarios</option><option>Insumos Taller</option><option>Otros Gastos</option>';
    }

    txModal.style.display = 'flex';
  }

  document.getElementById('btn-add-income')?.addEventListener('click', () => openModal('income'));
  document.getElementById('btn-add-expense')?.addEventListener('click', () => openModal('expense'));
  document.getElementById('btn-add-debt')?.addEventListener('click', () => openModal(activeDebtTab));

  document.getElementById('tx-modal-close')?.addEventListener('click', () => txModal.style.display = 'none');
  document.getElementById('tx-modal-cancel')?.addEventListener('click', () => txModal.style.display = 'none');

  document.getElementById('tx-modal-save')?.addEventListener('click', () => {
    const desc = document.getElementById('tx-desc').value.trim();
    const amount = parseFloat(document.getElementById('tx-amount').value) || 0;
    const cat = document.getElementById('tx-cat').value;
    const method = document.getElementById('tx-method').value;
    const party = document.getElementById('tx-party').value.trim();
    const date = document.getElementById('tx-date').value || (currentMonth + '-01');

    if (!desc || amount <= 0) { alert('Por favor ingresa descripción y un monto válido.'); return; }

    const data = loadMonthData(currentMonth);
    const entry = { id: Date.now(), desc, cat, amount, date, method };
    if (party) entry.party = party;

    const keyMap = { income: 'income', expense: 'expenses', cobrar: 'cobrar', pagar: 'pagar' };
    data[keyMap[currentModalType]].unshift(entry);
    saveMonthData(currentMonth, data);
    txModal.style.display = 'none';
    updateAllViews();
  });

  // Export CSV
  document.getElementById('btn-export-ledger')?.addEventListener('click', () => {
    const data = loadMonthData(currentMonth);
    let rows = [['Periodo', 'Tipo', 'Descripción', 'Categoría', 'Método', 'Tercero', 'Monto MXN', 'Fecha']];
    data.income.forEach(x => rows.push([currentMonth, 'Ingreso', x.desc, x.cat, x.method || '', '', x.amount, x.date]));
    data.expenses.forEach(x => rows.push([currentMonth, 'Gasto', x.desc, x.cat, x.method || '', '', x.amount, x.date]));
    data.cobrar.forEach(x => rows.push([currentMonth, 'Por Cobrar', x.desc, x.cat||'', '', x.party||'', x.amount, x.date]));
    data.pagar.forEach(x => rows.push([currentMonth, 'Por Pagar', x.desc, x.cat||'', '', x.party||'', x.amount, x.date]));
    const csv = 'data:text/csv;charset=utf-8,' + rows.map(r => r.join(',')).join('\n');
    const link = document.createElement('a');
    link.href = encodeURI(csv);
    link.download = `corte_contable_${currentMonth}.csv`;
    link.click();
  });

  // Init on load
  updateAllViews();
})();
</script>
