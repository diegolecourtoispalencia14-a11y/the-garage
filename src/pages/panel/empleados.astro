    if (filterAss) {
      filterAss.innerHTML = '<option value="">Todos los colaboradores</option>' +
        '<option value="__unassigned__">Sin asignar</option>' +
        emps.map(e => `<option value="${e.id}">${e.name}</option>`).join('');
