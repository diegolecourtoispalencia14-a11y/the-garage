<script is:inline define:vars={{ initialOperationsDataJson, defaultStaffJson, saasModulesJson }}>
(function() {
  const OPS_HIST_KEY = 'bicisaas_operations_history';
  const ACTIVE_MONTH_KEY = 'bicisaas_active_op_month';
  const today = new Date().toISOString().slice(0,10);

  // 1. Load or Initialize Multi-Month Operational History
  const rawSeed = (function() {
    try {
      return JSON.parse(initialOperationsDataJson || '[]');
    } catch(e) {
      return [];
    }
  })();

  function loadHistory() {
    try {
      const saved = localStorage.getItem(OPS_HIST_KEY);
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch(e) {}
    saveHistory(rawSeed);
    return JSON.parse(JSON.stringify(rawSeed));
  }

  function saveHistory(hist) {
    localStorage.setItem(OPS_HIST_KEY, JSON.stringify(hist));
  }

  let history = loadHistory();

  // Find or determine active month
  let activeMonthId = localStorage.getItem(ACTIVE_MONTH_KEY);
  if (!activeMonthId || !history.some(m => m.id === activeMonthId)) {
    const activeOne = history.find(m => !m.isClosed) || history[history.length - 1];
    activeMonthId = activeOne ? activeOne.id : '2026-09';
    localStorage.setItem(ACTIVE_MONTH_KEY, activeMonthId);
  }

  let selectedMonthId = activeMonthId;

  function getMonth(id) {
    return history.find(m => m.id === id) || history[history.length - 1];
  }

  function getActiveMonth() {
    return getMonth(activeMonthId);
  }

  function getSelectedMonth() {
    return getMonth(selectedMonthId);
  }

  function isViewingHistorical() {
    return selectedMonthId !== activeMonthId;
  }

  function saveSelectedMonth(updatedMonth) {
    const idx = history.findIndex(m => m.id === selectedMonthId);
    if (idx !== -1) {
      history[idx] = updatedMonth;
      saveHistory(history);
    }
  }

  // Time & priority helpers
  function currentTime() { return new Date().toTimeString().slice(0,5); }
  function calcHours(inn, out) {
    if (!inn) return '0.0';
    const [ih,im] = inn.split(':').map(Number);
    const [oh,om] = (out || currentTime()).split(':').map(Number);
    const diff = (oh*60+om - ih*60-im);
    return Math.max(0, diff/60).toFixed(1);
  }

  function getMonthLabel(m) {
    if (!m) return 'Septiembre 2026';
    if (m.label && m.label !== 'undefined') return m.label;
    if (m.name && m.name !== 'undefined') return m.name;
    if (m.monthName) return m.monthName;
    if (m.id) {
      const parts = m.id.split('-');
      if (parts.length === 2) {
        const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        const mIdx = parseInt(parts[1], 10) - 1;
        if (mIdx >= 0 && mIdx < 12) {
          return `${monthNames[mIdx]} ${parts[0]}`;
        }
      }
      return m.id;
    }
    return 'Septiembre 2026';
  }

  function getPriorityBadge(priority) {
    const p = (priority || 'media').toLowerCase();
    const labels = { alta: 'Alta', media: 'Media', baja: 'Baja' };
    const dotClass = p === 'alta' ? 'danger' : (p === 'media' ? 'warning' : '');
    return `<span class="task-prio-tag ${p}"><span class="pulse-dot ${dotClass}" style="width:6px; height:6px; margin-right:4px;"></span>${labels[p] || 'Media'}</span>`;
  }

  /* ══ RENDER: Operations Month Control Bar ══ */
  function renderMonthControls() {
    const select = document.getElementById('op-month-selector');
    const badge = document.getElementById('op-month-badge');
    const banner = document.getElementById('historical-banner');
    const histTitle = document.getElementById('historical-title');
    const histDesc = document.getElementById('historical-desc');

    if (!select) return;

    // Populate dropdown with all months in history (newest first)
    const sorted = [...history].sort((a, b) => b.id.localeCompare(a.id));
    select.innerHTML = sorted.map(m => {
      const isActive = m.id === activeMonthId;
      const statusText = isActive ? 'Activo' : 'Cerrado';
      const label = getMonthLabel(m);
      return `<option value="${m.id}" ${m.id === selectedMonthId ? 'selected' : ''}>${label} (${statusText})</option>`;
    }).join('');

    const currentM = getSelectedMonth();
    const isHistorical = isViewingHistorical();
    const curLabel = getMonthLabel(currentM);

    if (badge) {
      if (isHistorical) {
        badge.style.background = 'rgba(255,149,0,0.12)';
        badge.style.color = '#ff9500';
        badge.innerHTML = '<span class="pulse-dot warning" style="width:6px; height:6px;"></span> Mes Cerrado (Historial)';
      } else {
        badge.style.background = 'rgba(52,199,89,0.12)';
        badge.style.color = 'var(--accent-green)';
        badge.innerHTML = '<span class="pulse-dot" style="width:6px; height:6px;"></span> Mes Activo';
      }
    }

    if (banner) {
      if (isHistorical) {
        banner.style.display = 'flex';
        if (histTitle) histTitle.textContent = `Modo Histórico de Consulta: ${curLabel} (Solo Lectura)`;
        if (histDesc) histDesc.textContent = `Estás consultando los registros archivados de ${curLabel}. Las tareas, horas de asistencia y métricas se encuentran congeladas para auditoría SAT y SLA.`;
      } else {
        banner.style.display = 'none';
      }
    }

    // Disable or hint buttons in historical mode
    const btnNewTask = document.getElementById('btn-new-task');
    const btnNewEmp = document.getElementById('btn-new-employee');
    if (btnNewTask) {
      btnNewTask.style.opacity = isHistorical ? '0.5' : '1';
      btnNewTask.title = isHistorical ? 'Cambia al mes activo para crear tareas' : 'Nueva Tarea';
    }
    if (btnNewEmp) {
      btnNewEmp.style.opacity = isHistorical ? '0.5' : '1';
    }
  }

  // Switch Month
  function switchMonth(newMonthId) {
    selectedMonthId = newMonthId;
    renderMonthControls();
    populateAssigneeSelects();
    renderAll();
  }

  const opSelector = document.getElementById('op-month-selector');
  if (opSelector) {
    opSelector.addEventListener('change', (e) => {
      switchMonth(e.target.value);
    });
  }

  const btnReturn = document.getElementById('btn-return-current-month');
  if (btnReturn) {
    btnReturn.addEventListener('click', () => {
      switchMonth(activeMonthId);
    });
  }

  /* ══ NEW MONTH MODAL ══ */
  const btnOpenNewMonth = document.getElementById('btn-open-new-month');
  const modalNewMonth = document.getElementById('modal-new-month');
  const nmClose = document.getElementById('new-month-close');
  const nmCancel = document.getElementById('new-month-cancel');
  const nmSave = document.getElementById('new-month-save');

  if (btnOpenNewMonth && modalNewMonth) {
    btnOpenNewMonth.addEventListener('click', () => {
      // Propose next month ID and label
      const parts = activeMonthId.split('-');
      let year = parseInt(parts[0], 10);
      let month = parseInt(parts[1], 10);
      month += 1;
      if (month > 12) { month = 1; year += 1; }
      const nextId = `${year}-${month < 10 ? '0' + month : month}`;
      const monthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
      const nextLabel = `${monthNames[month - 1]} ${year}`;

      document.getElementById('nm-id').value = nextId;
      document.getElementById('nm-label').value = nextLabel;
      modalNewMonth.style.display = 'flex';
    });
  }

  [nmClose, nmCancel].forEach(el => {
    if (el) el.addEventListener('click', () => { modalNewMonth.style.display = 'none'; });
  });

  if (nmSave) {
    nmSave.addEventListener('click', () => {
      const id = document.getElementById('nm-id').value.trim();
      const label = document.getElementById('nm-label').value.trim();
      const rolloverTasks = document.getElementById('nm-rollover-tasks').checked;
      const resetHours = document.getElementById('nm-reset-hours').checked;
      const initBenchmarks = document.getElementById('nm-init-benchmarks').checked;

      if (!id || !label) {
        alert('Por favor ingresa el código y nombre del nuevo mes.');
        return;
      }

      if (history.some(m => m.id === id)) {
        alert(`El ciclo mensual "${id}" ya existe en la base de datos.`);
        return;
      }

      // 1. Close current active month
      const currentActive = getActiveMonth();
      currentActive.isClosed = true;

      // 2. Prepare Rollover Tasks
      let newTasks = [];
      if (rolloverTasks) {
        const pending = (currentActive.tasks || []).filter(t => t.status !== 'done');
        newTasks = pending.map((t, idx) => ({
          ...t,
          id: 't-roll-' + Date.now() + '-' + idx,
          notes: `[Rollover de ${currentActive.label}] ${t.notes || ''}`
        }));
      }

      // 3. Prepare Employees (reset clock-in and month hours if checked)
      const baseEmployees = currentActive.employees || [];
      const newEmployees = baseEmployees.map(e => ({
        ...e,
        clockIn: null,
        clockOut: null,
        hoursMonth: resetHours ? 0 : e.hoursMonth,
        tasksMonthDone: 0,
        tasksMonthAssigned: newTasks.filter(t => t.assignee === e.id).length
      }));

      // 4. Default Benchmarks
      const defaultBenchmarks = initBenchmarks ? [
        { name: "Mantenimiento General Integral", description: "Limpieza ultrasonido, lubricación, ajuste de conos y cambios", standardTime: "90 min", realTime: "75 min", diff: "-15 min (16.7%)", volume: "0 bicicletas", quality: "100% Meta" },
        { name: "Purga de Frenos Hidráulicos (Par)", description: "Shimano Mineral / SRAM DOT 5.1 con cambio de balatas", standardTime: "35 min", realTime: "28 min", diff: "-7 min (20.0%)", volume: "0 bicicletas", quality: "100% Meta" },
        { name: "Ajuste y Sincronización de Transmisión", description: "Alineación de patilla con herramienta Park Tool DAG-2.2", standardTime: "20 min", realTime: "17 min", diff: "-3 min (15.0%)", volume: "0 bicicletas", quality: "100% Meta" },
        { name: "Ensamble de Bicicleta Nueva (Box to Trail)", description: "Armado, torqueado según fabricante, tubelizado y puesta a punto", standardTime: "120 min", realTime: "105 min", diff: "-15 min (12.5%)", volume: "0 bicicletas", quality: "100% Meta" },
        { name: "Conversión a Tubeless + Sellador Stan's NoTubes", description: "Encintado sellado, válvulas de aluminio y talonado con compresor", standardTime: "30 min", realTime: "24 min", diff: "-6 min (20.0%)", volume: "0 ruedas", quality: "100% Meta" },
        { name: "Centrado y Tensión de Rayos en Rueda", description: "Tensiómetro digital y corrección lateral/radial < 0.2mm", standardTime: "40 min", realTime: "33 min", diff: "-7 min (17.5%)", volume: "0 ruedas", quality: "100% Meta" }
      ] : [];

      // 5. Default Leaderboard
      const defaultLeaderboard = [
        { place: 1, placeLabel: "1er Lugar", cardClass: "gold", initials: "MR", color: "#34c759", name: "Marco Ramírez", role: "Técnico Master Taller", score: "100% Meta", stats: [{ label: "0", value: "servicios" }, { label: "0", value: "garantías" }, { label: "5.0", value: "CSAT" }], highlight: "Líder técnico de taller certificado" },
        { place: 2, placeLabel: "2do Lugar", cardClass: "silver", initials: "LV", color: "#ff9500", name: "Laura Vásquez", role: "Asesora de Ventas & CRM", score: "100% Meta", stats: [{ label: "$0k", value: "cerrados" }, { label: "0", value: "prospectos" }, { label: "< 15m", value: "resp." }], highlight: "Atención comercial y asesoría VIP" },
        { place: 3, placeLabel: "3er Lugar", cardClass: "bronze", initials: "DL", color: "#0071e3", name: "Diego López", role: "Operaciones & Administración", score: "100% SLA", stats: [{ label: "100%", value: "arqueos" }, { label: "0", value: "faltantes" }, { label: "0h", value: "activas" }], highlight: "Gestión de compras e inventario" },
        { place: 4, placeLabel: "Logística Express", cardClass: "neutral", initials: "ST", color: "#af52de", name: "Sofía Torres", role: "Mensajería & Entregas", score: "100% A Tiempo", stats: [{ label: "0", value: "envíos" }, { label: "35m", value: "promedio" }, { label: "0", value: "demoras" }], highlight: "Cobertura express Riviera Maya" }
      ];

      // 6. Build new operational month
      const newMonth = {
        id,
        label,
        isClosed: false,
        kpis: {
          slaEfficiency: "100.0%",
          avgWorkshopTime: "1h 15m",
          deliveredServices: "0 Servicios",
          csat: "5.0 / 5.0",
          activeHeadcount: newEmployees.length,
          revenueWorkforce: "$0 MXN"
        },
        leaderboard: defaultLeaderboard,
        benchmarks: defaultBenchmarks,
        reviews: [],
        tasks: newTasks,
        employees: newEmployees
      };

      history.push(newMonth);
      saveHistory(history);

      activeMonthId = id;
      selectedMonthId = id;
      localStorage.setItem(ACTIVE_MONTH_KEY, id);

      modalNewMonth.style.display = 'none';
      renderMonthControls();
      populateAssigneeSelects();
      renderAll();

      alert(`Ciclo mensual "${label}" iniciado con éxito. Se traspasaron ${newTasks.length} tareas pendientes y se reinició el reloj checador.`);
    });
  }

  /* ══ POPULATE ASSIGNEE SELECTS ══ */
  function populateAssigneeSelects() {
    const cur = getSelectedMonth();
    const emps = cur.employees || [];
    const sel = document.getElementById('t-assignee');
    if (sel) {
      sel.innerHTML = '<option value="">Sin asignar (auto-delegar)</option>' +
