  /* ══ SECTION TABS SWITCHING ══ */
  function switchTab(sectionName) {
    document.querySelectorAll('.stab').forEach(t => {
      t.classList.toggle('active', t.dataset.section === sectionName);
    });
    ['asistencia','tareas','rendimiento','seguridad'].forEach(sec => {
      const el = document.getElementById('section-' + sec);
      if (el) {
        el.style.display = (sec === sectionName) ? 'block' : 'none';
      }
    });
    if (sectionName === 'seguridad') {
      renderSecurityStaffCards();
    }
    try {
      history.replaceState(null, '', '#' + sectionName);
    } catch(e) {}
  }

  document.querySelectorAll('.stab').forEach(tab => {
    tab.addEventListener('click', function() {
      const s = this.dataset.section;
      if (s) switchTab(s);
    });
  });

  function checkHash() {
    const hash = window.location.hash.replace('#', '');
    if (['asistencia', 'tareas', 'rendimiento', 'seguridad'].includes(hash)) {
      switchTab(hash);
    }
  }

  // Filter listeners for Kanban
  ['task-search','filter-priority','filter-category','filter-assignee'].forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', renderKanban);
      el.addEventListener('change', renderKanban);
    }
  });

  /* ══ SEGURIDAD & PINs SAAS (RBAC) & GESTIÓN DE COLABORADORES ══ */
  const DEFAULT_STAFF_SECURITY = (function() {
    try {
      return JSON.parse(defaultStaffJson || '[]');
    } catch(e) {
      return [];
    }
  })();

  const SAAS_MODULES_LIST = (function() {
    try {
      return JSON.parse(saasModulesJson || '[]');
    } catch(e) {
      return [];
    }
  })();

  async function hashPinClient(pin, salt) {
    const enc = new TextEncoder();
    const data = enc.encode(String(pin).trim() + String(salt));
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  function generateSaltClient() {
    if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
      const bytes = new Uint8Array(16);
      crypto.getRandomValues(bytes);
      return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    return Math.random().toString(36).substring(2) + Date.now().toString(36);
  }

  function getSecurityStaff() {
    try {
      const raw = localStorage.getItem('bicisaas_staff_accounts');
      if (!raw) {
        localStorage.setItem('bicisaas_staff_accounts', JSON.stringify(DEFAULT_STAFF_SECURITY));
        return DEFAULT_STAFF_SECURITY;
      }
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.length > 0) {
        // Automatic legacy migration: convert any plain text pin to pinHash
        let needsSave = false;
        parsed.forEach(emp => {
          if (emp.pin && !emp.pinHash) {
            emp.pinSalt = 'thegarage_salt_' + emp.id + '_' + Date.now().toString(36);
            // Synchronous fallback salt placeholder until updated
            emp.pinHash = 'migrating';
            needsSave = true;
          }
        });
        return parsed;
      }
      return DEFAULT_STAFF_SECURITY;
    } catch(e) {
      return DEFAULT_STAFF_SECURITY;
    }
  }

  function saveSecurityStaff(staffList) {
    localStorage.setItem('bicisaas_staff_accounts', JSON.stringify(staffList));
    renderSecurityStaffCards();
  }

  function selectColorSwatch(color) {
    const swatches = document.querySelectorAll('.color-swatch');
    swatches.forEach(s => {
      if (s.getAttribute('data-color') === color) {
        s.classList.add('active');
        s.style.outline = '2px solid ' + color;
        s.style.borderColor = '#fff';
      } else {
        s.classList.remove('active');
        s.style.outline = 'none';
        s.style.borderColor = 'transparent';
      }
    });
    const colorInput = document.getElementById('su-color');
    if (colorInput) colorInput.value = color;
  }

  function setModulePreset(preset) {
    const checkboxes = document.querySelectorAll('.su-module-checkbox');
    if (preset === 'all' || preset === 'admin') {
      checkboxes.forEach(cb => { cb.checked = true; });
    } else if (preset === 'taller' || preset === 'mecanico') {
      const allowed = ['dashboard', 'crm', 'inventario', 'taller', 'mi-perfil'];
      checkboxes.forEach(cb => { cb.checked = allowed.includes(cb.value); });
    } else if (preset === 'ventas') {
      const allowed = ['dashboard', 'crm', 'inventario', 'rentas', 'mi-perfil'];
      checkboxes.forEach(cb => { cb.checked = allowed.includes(cb.value); });
    } else if (preset === 'clear') {
      checkboxes.forEach(cb => { cb.checked = cb.value === 'mi-perfil'; });
    }
  }

