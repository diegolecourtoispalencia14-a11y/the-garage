  window.togglePinView = function(empId) {
    const input = document.getElementById('pin-input-' + empId);
    if (input) {
      input.type = input.type === 'password' ? 'text' : 'password';
    }
  };

  window.updateStaffPin = async function(empId) {
    const input = document.getElementById('pin-input-' + empId);
    if (!input) return;
    const newPin = input.value.trim();
    if (!newPin || newPin.length < 4) {
      alert('El PIN debe tener al menos 4 caracteres numéricos.');
      return;
    }

    const staffList = getSecurityStaff();
    const target = staffList.find(e => e.id === empId);
    if (target) {
      target.pinSalt = target.pinSalt || generateSaltClient();
      target.pinHash = await hashPinClient(newPin, target.pinSalt);
      delete target.pin;
      saveSecurityStaff(staffList);
      input.value = '';
      input.placeholder = '•••• (PIN actualizado y cifrado)';
      alert('PIN actualizado y protegido con hash seguro para ' + target.name + ' (' + target.roleLabel + ').');
    }
  };

