---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { Icon } from 'astro-icon/components';
import { initialOperationsData } from '../../data/operationsDatabase';
import { DEFAULT_STAFF, SAAS_MODULES } from '../../data/authConfig';
const initialOperationsDataJson = JSON.stringify(initialOperationsData);
const defaultStaffJson = JSON.stringify(DEFAULT_STAFF);
const saasModulesJson = JSON.stringify(SAAS_MODULES);
---
<PanelLayout title="Gestión de Empleados | BiciSaaS">
  <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
        <span style="background:rgba(0,113,227,0.12); color:var(--accent-blue); font-size:0.75rem; font-weight:700; padding:0.2rem 0.65rem; border-radius:100px; display:inline-flex; align-items:center; gap:0.35rem;">
          <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-green);"></span> Taller & Tienda Activos
        </span>
        <span style="font-size:0.8rem; color:var(--text-secondary);">Playa del Carmen, Q. Roo</span>
      </div>
      <h1 class="page-title" style="font-size:1.85rem; font-weight:800; letter-spacing:-0.03em; margin:0 0 0.35rem; color:var(--text-primary);">Equipo, Tareas & Rendimiento</h1>
      <p class="text-muted" style="margin:0; font-size:0.92rem; color:var(--text-secondary);">Checador de asistencia, tablero kanban operativo y analíticas de productividad técnica.</p>
    </div>
    <div style="display:flex; gap:0.65rem; align-items:center; flex-wrap:wrap;">
      <button class="btn-secondary" id="btn-reload-demo" title="Recargar base de datos demo completa">
        <Icon name="mdi:refresh" width="18" height="18" /> Restaurar Datos Demo
      </button>
      <button class="btn-secondary" id="btn-new-employee">
        <Icon name="mdi:account-plus-outline" width="18" height="18" /> Nuevo Empleado
      </button>
      <button class="btn-primary" id="btn-new-task">
        <Icon name="mdi:plus-circle-outline" width="18" height="18" /> Nueva Tarea
      </button>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- BARRA DE CONTROL DE OPERACIONES: MULTI-MES & HISTORIAL SAT / ERP   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="operations-control-bar" style="background:var(--surface-card); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:0.9rem 1.25rem; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
    <div style="display:flex; align-items:center; gap:0.85rem; flex-wrap:wrap;">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <span style="font-size:0.75rem; text-transform:uppercase; font-weight:800; letter-spacing:0.05em; color:var(--text-secondary);">Ciclo Mensual Operativo:</span>
        <select id="op-month-selector" style="background:var(--bg-base); color:var(--text-primary); border:1px solid var(--border-subtle); padding:0.45rem 0.85rem; border-radius:var(--radius-sm); font-weight:700; font-size:0.88rem; outline:none; cursor:pointer;">
          <!-- Dynamically populated from operationsDatabase -->
        </select>
      </div>
      <span id="op-month-badge" style="background:rgba(52,199,89,0.12); color:var(--accent-green); font-size:0.75rem; font-weight:700; padding:0.25rem 0.75rem; border-radius:100px; display:inline-flex; align-items:center; gap:0.35rem;">
        <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-green);"></span> Mes Activo
      </span>
    </div>

    <div style="display:flex; align-items:center; gap:0.65rem;">
      <button class="btn-primary" id="btn-open-new-month" style="font-size:0.85rem; font-weight:700; display:inline-flex; align-items:center; gap:0.45rem; background:linear-gradient(135deg, #0071e3, #5e5ce6); border:none; box-shadow:0 4px 12px rgba(0,113,227,0.3);">
        <Icon name="mdi:calendar-plus" width="18" height="18" /> Iniciar Nuevo Mes
      </button>
    </div>
  </div>

  <!-- Historical Read-Only Alert Banner -->
  <div id="historical-banner" style="display:none; background:rgba(255,149,0,0.1); border:1px solid rgba(255,149,0,0.3); border-radius:var(--radius-md); padding:0.85rem 1.25rem; margin-bottom:1.5rem; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.75rem;">
    <div style="display:flex; align-items:center; gap:0.75rem;">
      <Icon name="mdi:archive-clock-outline" width="22" height="22" color="#ff9500" />
      <div>
        <strong style="color:#f5f5f7; font-size:0.9rem;" id="historical-title">Modo Histórico de Consulta (Solo Lectura)</strong>
        <p style="margin:0; font-size:0.8rem; color:#d4d4d8;" id="historical-desc">Estás consultando registros de un mes cerrado. Los datos de tareas, reloj checador y KPIs se muestran en modo auditoría.</p>
      </div>
    </div>
    <button class="btn-secondary" id="btn-return-current-month" style="font-size:0.78rem; padding:0.35rem 0.75rem;">
      Volver al Mes Actual ↗
    </button>
  </div>

  <!-- Section Tabs -->
  <div class="section-tabs" style="margin-bottom:1.75rem;">
    <button class="stab active" data-section="asistencia" id="tab-btn-asistencia">
      <Icon name="mdi:calendar-week" width="18" height="18" />
      <span>Asistencia & Horarios</span>
    </button>
    <button class="stab" data-section="tareas" id="tab-btn-tareas">
      <Icon name="mdi:checkbox-marked-circle-outline" width="18" height="18" />
      <span>Tablero de Tareas</span>
      <span class="tab-badge" id="tab-badge-tasks">0</span>
    </button>
    <button class="stab" data-section="rendimiento" id="tab-btn-rendimiento">
      <Icon name="mdi:chart-line" width="18" height="18" />
      <span>Rendimiento & KPIs</span>
      <span class="tab-badge green">96.4%</span>
    </button>
    <button class="stab" data-section="seguridad" id="tab-btn-seguridad">
      <Icon name="mdi:shield-key-outline" width="18" height="18" />
      <span>PINs & Seguridad SaaS</span>
      <span class="tab-badge" style="background:rgba(0,113,227,0.15); color:var(--accent-blue);">RBAC</span>
    </button>
  </div>

  <!-- ════ SECTION: Asistencia ════ -->
  <div id="section-asistencia">
    <!-- Status Cards -->
    <div class="emp-status-row" id="emp-status-row">
      <!-- JS rendered -->
    </div>

    <!-- Schedule Grid -->
    <div class="bento-card" style="padding:0; overflow:hidden; margin-top:1.5rem;">
      <div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center;">
        <h3 style="font-size:1rem; margin:0; display:flex; align-items:center; gap:0.5rem;">
          <Icon name="mdi:calendar-week" width="18" height="18" color="var(--accent-blue)" /> Horario Semanal
        </h3>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <button class="btn-secondary" id="btn-prev-week" style="padding:0.3rem 0.75rem; font-size:0.82rem;">‹ Anterior</button>
          <span id="week-label" style="font-size:0.88rem; font-weight:600; min-width:180px; text-align:center;"></span>
          <button class="btn-secondary" id="btn-next-week" style="padding:0.3rem 0.75rem; font-size:0.82rem;">Siguiente ›</button>
        </div>
      </div>
      <div style="overflow-x:auto;">
        <table class="schedule-table" id="schedule-table">
          <thead id="schedule-head"></thead>
          <tbody id="schedule-body"></tbody>
        </table>
      </div>
    </div>

    <!-- Clock Log -->
    <div class="bento-card" style="margin-top:1.5rem;">
      <h3 style="font-size:1rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
        <Icon name="mdi:clock-time-four-outline" width="18" height="18" color="var(--accent-orange)" /> Registro de Entradas (Esta Semana)
      </h3>
      <div id="clock-log"></div>
    </div>
  </div>

  <!-- ════ SECTION: Tareas ════ -->
  <div id="section-tareas" style="display:none;">
    <!-- Task KPIs -->
    <div class="task-kpis">
      <div class="task-kpi-card">
        <span class="tkpi-l">Total Activas</span>
        <span class="tkpi-v" id="tk-total">0</span>
        <span class="tkpi-sub">En flujo operativo</span>
      </div>
      <div class="task-kpi-card">
        <span class="tkpi-l">Pendientes</span>
        <span class="tkpi-v orange" id="tk-pending">0</span>
        <span class="tkpi-sub">Por iniciar</span>
      </div>
      <div class="task-kpi-card">
        <span class="tkpi-l">En Progreso</span>
        <span class="tkpi-v blue" id="tk-progress">0</span>
        <span class="tkpi-sub">Trabajándose ahora</span>
      </div>
      <div class="task-kpi-card">
        <span class="tkpi-l">Completadas Hoy</span>
        <span class="tkpi-v green" id="tk-done">0</span>
        <span class="tkpi-sub">Entregadas con éxito</span>
      </div>
      <div class="task-kpi-card">
        <span class="tkpi-l">Sin Asignar</span>
        <span class="tkpi-v red" id="tk-unassigned">0</span>
        <span class="tkpi-sub">Requieren atención</span>
      </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="task-toolbar" style="display:flex; gap:0.75rem; margin-bottom:1.25rem; flex-wrap:wrap; align-items:center;">
      <div class="task-search-wrap" style="flex:1; min-width:260px; display:flex; align-items:center; gap:0.5rem; background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:100px; padding:0.45rem 1rem;">
        <Icon name="mdi:magnify" width="18" height="18" style="color:var(--text-secondary);" />
        <input type="text" id="task-search-input" placeholder="Buscar por título, cliente, modelo de bici o notas..." style="border:none; background:transparent; outline:none; font-size:0.88rem; color:var(--text-primary); width:100%;" />
      </div>
      <div class="task-filters-wrap" style="display:flex; gap:0.5rem; flex-wrap:wrap;">
        <select id="filter-cat" class="toolbar-select" style="padding:0.45rem 0.85rem; border-radius:100px; border:1px solid var(--border-subtle); background:var(--bg-surface); color:var(--text-primary); font-size:0.82rem; font-weight:600; outline:none; cursor:pointer;">
          <option value="">Todas las categorías</option>
          <option value="Taller / Servicio">Taller / Servicio</option>
          <option value="CRM / Seguimiento">CRM / Seguimiento</option>
          <option value="Inventario">Inventario & Stock</option>
          <option value="Cobro / Cuentas">Cobro / Cuentas</option>
          <option value="Limpieza / Operación">Operación & Tienda</option>
          <option value="Otro">General / Otro</option>
        </select>
        <select id="filter-priority" class="toolbar-select" style="padding:0.45rem 0.85rem; border-radius:100px; border:1px solid var(--border-subtle); background:var(--bg-surface); color:var(--text-primary); font-size:0.82rem; font-weight:600; outline:none; cursor:pointer;">
          <option value="">Todas las prioridades</option>
          <option value="alta">Alta Prioridad</option>
          <option value="media">Media Prioridad</option>
          <option value="baja">Baja Prioridad</option>
        </select>
        <select id="filter-assignee" class="toolbar-select" style="padding:0.45rem 0.85rem; border-radius:100px; border:1px solid var(--border-subtle); background:var(--bg-surface); color:var(--text-primary); font-size:0.82rem; font-weight:600; outline:none; cursor:pointer;">
          <option value="">Todos los colaboradores</option>
        </select>
      </div>
    </div>

    <!-- Auto-Delegate Banner -->
    <div class="delegate-banner" id="delegate-banner">
      <div style="display:flex; align-items:flex-start; gap:0.9rem;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(0,113,227,0.15); display:flex; align-items:center; justify-content:center; color:var(--accent-blue); flex-shrink:0;">
          <Icon name="mdi:speedometer" width="22" height="22" />
        </div>
        <div>
          <strong style="font-size:0.95rem;">Delegación Automática por Carga de Trabajo</strong>
          <p style="margin:0.2rem 0 0; font-size:0.84rem; color:var(--text-secondary);">
            Hay <span id="unassigned-count" style="font-weight:700; color:var(--accent-red);">0</span> tareas sin asignar. El algoritmo analiza la disponibilidad técnica y asigna equitativamente para balancear la carga del taller.
          </p>
        </div>
      </div>
      <button class="btn-primary" id="btn-preview-delegate" style="white-space:nowrap;">
        <Icon name="mdi:eye-check-outline" width="18" height="18" /> Ver Propuesta & Delegar
      </button>
    </div>

    <!-- Kanban Board -->
    <div class="kanban-board">
      <div class="kanban-col">
        <div class="kanban-header orange">
          <span style="display:inline-flex; align-items:center; gap:0.45rem;"><Icon name="mdi:clock-outline" width="16" height="16" /> Pendiente</span><span class="kanban-count" id="kc-pending">0</span>
        </div>
        <div class="kanban-cards" id="kanban-pending"></div>
      </div>
      <div class="kanban-col">
        <div class="kanban-header blue">
          <span style="display:inline-flex; align-items:center; gap:0.45rem;"><Icon name="mdi:progress-wrench" width="16" height="16" /> En Progreso</span><span class="kanban-count" id="kc-progress">0</span>
        </div>
        <div class="kanban-cards" id="kanban-progress"></div>
      </div>
      <div class="kanban-col">
        <div class="kanban-header green">
          <span style="display:inline-flex; align-items:center; gap:0.45rem;"><Icon name="mdi:check-circle-outline" width="16" height="16" /> Completada</span><span class="kanban-count" id="kc-done">0</span>
        </div>
        <div class="kanban-cards" id="kanban-done"></div>
      </div>
    </div>
  </div>

  <!-- ════ SECTION: Rendimiento ════ -->
  <div id="section-rendimiento" style="display:none;">
    <!-- Top Executive KPIs -->
    <div class="perf-kpi-banner">
      <div class="perf-kpi-item">
        <div class="pkpi-icon" style="background:rgba(52,199,89,0.12); color:var(--accent-green);">
          <Icon name="mdi:trophy-outline" width="24" height="24" />
        </div>
        <div>
          <div class="pkpi-value" id="pkpi-sla-val">96.4%</div>
          <div class="pkpi-label">Eficiencia Operativa SLA</div>
          <div class="pkpi-trend" id="pkpi-sla-trend" style="color:var(--accent-green);">↑ +2.8% vs mes anterior</div>
        </div>
      </div>

      <div class="perf-kpi-item">
        <div class="pkpi-icon" style="background:rgba(0,113,227,0.12); color:var(--accent-blue);">
          <Icon name="mdi:speedometer" width="24" height="24" />
        </div>
        <div>
          <div class="pkpi-value" id="pkpi-time-val">1h 14m</div>
          <div class="pkpi-label">Tiempo Promedio Taller</div>
          <div class="pkpi-trend" id="pkpi-time-trend" style="color:var(--accent-blue);">-16 min vs meta estándar</div>
        </div>
      </div>

      <div class="perf-kpi-item">
        <div class="pkpi-icon" style="background:rgba(255,149,0,0.12); color:var(--accent-orange);">
          <Icon name="mdi:wrench-outline" width="24" height="24" />
        </div>
        <div>
          <div class="pkpi-value" id="pkpi-serv-val">42 Servicios</div>
          <div class="pkpi-label">Bicis Entregadas este Mes</div>
          <div class="pkpi-trend" id="pkpi-serv-trend" style="color:var(--text-secondary);">$68,400 MXN mano de obra</div>
        </div>
      </div>

      <div class="perf-kpi-item">
        <div class="pkpi-icon" style="background:rgba(175,82,222,0.12); color:#af52de;">
          <Icon name="mdi:star" width="24" height="24" />
        </div>
        <div>
          <div class="pkpi-value" id="pkpi-csat-val">4.95 / 5.0</div>
          <div class="pkpi-label">Satisfacción Cliente (CSAT)</div>
          <div class="pkpi-trend" id="pkpi-csat-trend" style="color:var(--accent-green);">Basado en 38 reseñas verificadas</div>
        </div>
      </div>
    </div>

    <!-- Leaderboard / Podio de Honor -->
    <div class="bento-card" style="margin-bottom:1.5rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h3 style="font-size:1.05rem; margin:0; display:flex; align-items:center; gap:0.5rem; font-weight:700;">
            <Icon name="mdi:trophy-outline" width="20" height="20" color="#ff9500" /> Cuadro de Honor & Productividad del Mes
          </h3>
          <p style="margin:0.2rem 0 0; font-size:0.82rem; color:var(--text-secondary);">Reconocimiento a técnicos y asesores destacados por volumen de entrega y calidad de atención</p>
        </div>
        <span id="perf-cycle-badge" style="background:rgba(255,149,0,0.12); color:var(--accent-orange); font-size:0.75rem; font-weight:700; padding:0.25rem 0.75rem; border-radius:100px;">
          Ciclo Septiembre 2026
        </span>
      </div>

      <div class="leaderboard-grid" id="perf-leaderboard-grid">
        <!-- 1er Lugar: Marco -->
        <div class="podium-card gold">
          <div class="podium-badge"><span class="corp-rank-pill rank-gold">01</span> 1er Lugar</div>
          <div class="podium-avatar" style="background:#34c759;">MR</div>
          <div class="podium-name">Marco Ramírez</div>
          <div class="podium-role">Técnico Master Taller</div>
          <div class="podium-score">98.5% Eficiencia</div>
          <div class="podium-stats">
            <div><strong>26</strong> servicios</div>
            <div><strong>0</strong> garantías</div>
            <div><strong>4.98</strong> CSAT</div>
          </div>
          <div class="podium-highlight">Especialista en transmisiones Shimano Di2 y purga hidráulica</div>
        </div>

        <!-- 2do Lugar: Laura -->
        <div class="podium-card silver">
          <div class="podium-badge"><span class="corp-rank-pill rank-silver">02</span> 2do Lugar</div>
          <div class="podium-avatar" style="background:#ff9500;">LV</div>
          <div class="podium-name">Laura Vásquez</div>
          <div class="podium-role">Asesora de Ventas & CRM</div>
          <div class="podium-score">95.2% Conversión</div>
          <div class="podium-stats">
            <div><strong>$158k</strong> cerrados</div>
            <div><strong>19</strong> prospectos</div>
            <div><strong>&lt; 15m</strong> resp.</div>
          </div>
          <div class="podium-highlight">Líder en colocación de bicicletas Basso y Specialized</div>
        </div>

        <!-- 3er Lugar: Diego -->
        <div class="podium-card bronze">
          <div class="podium-badge"><span class="corp-rank-pill rank-bronze">03</span> 3er Lugar</div>
          <div class="podium-avatar" style="background:#0071e3;">DL</div>
          <div class="podium-name">Diego López</div>
          <div class="podium-role">Operaciones & Administración</div>
          <div class="podium-score">96.0% SLA</div>
          <div class="podium-stats">
            <div><strong>100%</strong> arqueos</div>
            <div><strong>0</strong> faltantes</div>
            <div><strong>42h</strong> activas</div>
          </div>
          <div class="podium-highlight">Auditoría de inventario impecable y control fiscal SAT al 100%</div>
        </div>

        <!-- 4to: Sofía -->
        <div class="podium-card neutral">
          <div class="podium-badge"><span class="corp-rank-pill">LOG</span> Logística Express</div>
          <div class="podium-avatar" style="background:#af52de;">ST</div>
          <div class="podium-name">Sofía Torres</div>
          <div class="podium-role">Mensajería & Entregas</div>
          <div class="podium-score">100% A Tiempo</div>
          <div class="podium-stats">
            <div><strong>32</strong> envíos</div>
            <div><strong>38m</strong> promedio</div>
            <div><strong>0</strong> demoras</div>
          </div>
          <div class="podium-highlight">Cobertura total Playa del Carmen & Playacar en tiempo récord</div>
        </div>
      </div>
    </div>

    <!-- Individual Technician Scorecards (Dynamic Grid) -->
    <div style="margin-bottom:1.5rem;">
      <h3 style="font-size:1.05rem; margin:0 0 1rem; display:flex; align-items:center; gap:0.5rem; font-weight:700;">
        <Icon name="mdi:account-badge-outline" width="20" height="20" color="var(--accent-blue)" /> Fichas de Rendimiento Individual y Certificaciones
      </h3>
      <div class="perf-grid" id="perf-grid">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Workshop Service Benchmarks & Efficiency Matrix -->
    <div class="bento-card" style="margin-bottom:1.5rem; padding:0; overflow:hidden;">
      <div style="padding:1.25rem 1.5rem; border-bottom:1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
        <div>
          <h3 style="font-size:1rem; margin:0; display:flex; align-items:center; gap:0.5rem; font-weight:700;">
            <Icon name="mdi:wrench-outline" width="20" height="20" color="var(--accent-blue)" /> Matriz de Tiempos Estándar vs. Tiempo Real en Taller
          </h3>
          <p style="margin:0.2rem 0 0; font-size:0.8rem; color:var(--text-secondary);">Comparativa de eficiencia según tabulador Park Tool / Shimano Service Center</p>
        </div>
        <span id="perf-benchmark-gain" style="font-size:0.8rem; font-weight:700; color:var(--accent-green); background:rgba(52,199,89,0.1); padding:0.25rem 0.75rem; border-radius:100px;">
          +18.2% Ganancia de Eficiencia Global
        </span>
      </div>
      <div style="overflow-x:auto;">
        <table class="benchmark-table">
          <thead>
            <tr>
              <th>Tipo de Servicio Técnico</th>
              <th>Tiempo Estándar</th>
              <th>Tiempo Real Promedio</th>
              <th>Delta / Ahorro</th>
              <th>Volumen Mensual</th>
              <th>Tasa de Éxito</th>
            </tr>
          </thead>
          <tbody id="perf-benchmark-tbody">
            <tr>
              <td>
                <strong>Mantenimiento General Integral</strong>
                <div style="font-size:0.75rem; color:var(--text-secondary);">Limpieza ultrasonido, lubricación, ajuste de conos y cambios</div>
              </td>
              <td>90 min</td>
