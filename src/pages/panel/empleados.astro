  /* ══ RENDER: Status Cards (Asistencia) ══ */
  function renderStatusCards() {
    const cur = getSelectedMonth();
    const emps = cur.employees || [];
    const tasks = cur.tasks || [];
    const row = document.getElementById('emp-status-row');
    if (!row) return;

    row.innerHTML = emps.map(e => {
      const activeTask = tasks.find(t => t.assignee === e.id && t.status === 'progress');
      const isWorking = !!e.clockIn && !e.clockOut;
      const hours = e.clockIn ? calcHours(e.clockIn, e.clockOut) : '0.0';
      const statusBadge = e.clockOut
        ? '<span class="emp-badge-out">Salida</span>'
        : (e.clockIn ? '<span class="emp-badge-active">● Activo</span>' : '<span class="emp-badge-absent">Sin checar</span>');

      return `
        <div class="emp-status-card" style="border-top:3px solid ${e.color};">
          <div class="emp-top">
            <div class="emp-avatar" style="background:${e.color};">${e.initials}</div>
            <div class="emp-info">
              <span class="emp-name">${e.name}</span>
              <span class="emp-role">${e.role}</span>
            </div>
            ${statusBadge}
          </div>
          <div class="emp-meta-row">
            <span>Turno: <strong>${e.shift}</strong></span>
            <span>Entrada: <strong>${e.clockIn || '—'}</strong></span>
            <span>Horas hoy: <strong>${hours}h</strong></span>
          </div>
          <div class="emp-task-now">
            <span class="emp-task-label">Tarea Actual:</span>
            ${activeTask ? `<span class="emp-task-title">${activeTask.title}</span>` : '<span class="emp-task-none">Sin tarea en progreso</span>'}
          </div>
          ${!isViewingHistorical() ? `
            <div class="emp-actions">
              ${!e.clockIn ? `
                <button class="btn-clock in" onclick="clockAction('${e.id}','in')">Registrar Entrada</button>
              ` : (!e.clockOut ? `
                <button class="btn-clock out" onclick="clockAction('${e.id}','out')">Registrar Salida</button>
              ` : '<span style="font-size:0.75rem; color:var(--text-secondary);">Turno concluido</span>')}
            </div>
          ` : `
            <div class="emp-actions">
              <span style="font-size:0.75rem; color:var(--text-secondary);">Horas mes: <strong>${e.hoursMonth || 0}h</strong></span>
            </div>
          `}
        </div>
      `;
    }).join('');
  }

  window.clockAction = function(empId, type) {
    if (isViewingHistorical()) {
      alert('No es posible modificar el reloj checador en un mes cerrado.');
      return;
    }
    const cur = getSelectedMonth();
    const emp = (cur.employees || []).find(e => e.id === empId);
    if (!emp) return;
    const time = currentTime();
    if (type === 'in') { emp.clockIn = time; emp.clockOut = null; }
    else { emp.clockOut = time; }
    saveSelectedMonth(cur);
    renderAll();
  };

  /* ══ RENDER: Schedule Table ══ */
  function renderSchedule() {
    const head = document.getElementById('schedule-head');
    const body = document.getElementById('schedule-body');
    const label = document.getElementById('week-label');
    if (!head || !body) return;

    const cur = getSelectedMonth();
    const emps = cur.employees || [];
    const WEEK_DAYS = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];

    if (label) label.textContent = `Semana en curso · ${cur.label}`;

    head.innerHTML = `
      <tr>
        <th style="min-width:160px;">Colaborador</th>
        ${WEEK_DAYS.map(d => `<th>${d}</th>`).join('')}
        <th>Horas Mes</th>
      </tr>
    `;

    body.innerHTML = emps.map(e => `
      <tr>
        <td>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <div class="emp-avatar" style="background:${e.color}; width:28px; height:28px; font-size:0.75rem;">${e.initials}</div>
            <div>
              <div style="font-weight:600; font-size:0.85rem;">${e.name}</div>
