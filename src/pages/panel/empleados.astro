  const resetPinsBtn = document.getElementById('btn-reset-staff-pins');
  if (resetPinsBtn) {
    resetPinsBtn.addEventListener('click', () => {
      if (confirm('¿Restablecer las credenciales oficiales de fábrica?\n\n• Admin: admin@thegarage.mx (1984)\n• Taller: taller@thegarage.mx (2024)\n• Ventas: ventas@thegarage.mx (3030)')) {
        localStorage.setItem('bicisaas_staff_accounts', JSON.stringify(DEFAULT_STAFF_SECURITY));
        renderSecurityStaffCards();
        alert('Credenciales de fábrica restauradas.');
      }
    });
  }

  // Wire new employee button to open full staff user modal
  const btnNewEmployeeMain = document.getElementById('btn-new-employee');
  if (btnNewEmployeeMain) {
    btnNewEmployeeMain.addEventListener('click', (e) => {
      e.stopImmediatePropagation();
      openCreateStaffUser();
    });
  }

  /* ══ INITIALIZATION ══ */
  function renderAll() {
    renderStatusCards();
    renderSchedule();
    renderClockLog();
    renderKanban();
    renderPerformance();
  }

  renderMonthControls();
  populateAssigneeSelects();
  renderAll();
  checkHash();
})();
</script>
