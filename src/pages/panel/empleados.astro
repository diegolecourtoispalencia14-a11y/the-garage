            <input type="text" id="su-monogram" maxlength="3" placeholder="CM" style="text-transform:uppercase; text-align:center; font-weight:800; letter-spacing:1px;" />
          </div>
        </div>

        <!-- Color de Avatar & PIN -->
        <div style="display:grid; grid-template-columns:1fr 1.3fr; gap:1rem; align-items:flex-end;">
          <div class="form-group">
            <label>Color Identificador</label>
            <div style="display:flex; gap:0.5rem; align-items:center; margin-top:0.25rem;" id="su-color-palette">
              <button type="button" class="color-swatch active" data-color="#0071e3" style="width:28px; height:28px; border-radius:50%; background:#0071e3; border:2px solid #fff; cursor:pointer; outline:2px solid #0071e3;"></button>
              <button type="button" class="color-swatch" data-color="#30d158" style="width:28px; height:28px; border-radius:50%; background:#30d158; border:2px solid transparent; cursor:pointer;"></button>
              <button type="button" class="color-swatch" data-color="#ff9f0a" style="width:28px; height:28px; border-radius:50%; background:#ff9f0a; border:2px solid transparent; cursor:pointer;"></button>
              <button type="button" class="color-swatch" data-color="#af52de" style="width:28px; height:28px; border-radius:50%; background:#af52de; border:2px solid transparent; cursor:pointer;"></button>
              <button type="button" class="color-swatch" data-color="#ff375f" style="width:28px; height:28px; border-radius:50%; background:#ff375f; border:2px solid transparent; cursor:pointer;"></button>
              <button type="button" class="color-swatch" data-color="#64d2ff" style="width:28px; height:28px; border-radius:50%; background:#64d2ff; border:2px solid transparent; cursor:pointer;"></button>
              <input type="hidden" id="su-color" value="#0071e3" />
            </div>
          </div>

          <div class="form-group">
            <label>PIN de Terminal (4 a 8 dígitos) *</label>
            <div style="display:flex; gap:0.45rem;">
              <input type="password" id="su-pin" maxlength="8" placeholder="1234" style="font-family:monospace; letter-spacing:2px; font-weight:700;" required />
              <button type="button" class="btn-secondary" id="su-pin-toggle" title="Ver / Ocultar PIN" style="padding:0.45rem 0.65rem;">
                <Icon name="mdi:eye-outline" width="18" height="18" />
              </button>
              <button type="button" class="btn-secondary" id="su-pin-generate" title="Generar PIN aleatorio" style="padding:0.45rem 0.75rem; font-size:0.8rem; white-space:nowrap;">
                Generar PIN
              </button>
            </div>
          </div>
        </div>

        <!-- Matriz de Módulos Autorizados -->
        <div style="background:var(--bg-base); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:1rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.85rem; flex-wrap:wrap; gap:0.5rem;">
            <div>
              <strong style="font-size:0.9rem; color:var(--text-primary); display:block;">Módulos del Sistema Habilitados</strong>
              <span style="font-size:0.75rem; color:var(--text-secondary);">Selecciona qué áreas del panel puede consultar y operar este colaborador.</span>
            </div>
            <div style="display:flex; gap:0.35rem; flex-wrap:wrap;">
              <button type="button" class="btn-preset-chip" id="preset-all" style="font-size:0.72rem; padding:0.2rem 0.55rem; border-radius:4px; border:1px solid var(--border-subtle); background:var(--bg-surface); cursor:pointer; color:var(--text-primary);">Todos</button>
              <button type="button" class="btn-preset-chip" id="preset-taller" style="font-size:0.72rem; padding:0.2rem 0.55rem; border-radius:4px; border:1px solid var(--border-subtle); background:var(--bg-surface); cursor:pointer; color:var(--text-primary);">Taller</button>
              <button type="button" class="btn-preset-chip" id="preset-ventas" style="font-size:0.72rem; padding:0.2rem 0.55rem; border-radius:4px; border:1px solid var(--border-subtle); background:var(--bg-surface); cursor:pointer; color:var(--text-primary);">Ventas POS</button>
              <button type="button" class="btn-preset-chip" id="preset-clear" style="font-size:0.72rem; padding:0.2rem 0.55rem; border-radius:4px; border:1px solid var(--border-subtle); background:var(--bg-surface); cursor:pointer; color:var(--text-secondary);">Limpiar</button>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.6rem;" id="su-modules-grid">
            {SAAS_MODULES.map(m => (
              <label class="module-item-checkbox" style="display:flex; align-items:flex-start; gap:0.6rem; padding:0.55rem 0.75rem; border-radius:8px; border:1px solid var(--border-subtle); background:var(--bg-surface); cursor:pointer;">
                <input type="checkbox" class="su-module-checkbox" value={m.id} data-label={m.label} style="margin-top:0.2rem; accent-color:var(--accent-blue);" />
                <div>
                  <strong style="font-size:0.82rem; color:var(--text-primary); display:block;">{m.label}</strong>
                  <span style="font-size:0.72rem; color:var(--text-secondary); display:block; line-height:1.2;">{m.desc}</span>
                </div>
              </label>
            ))}
          </div>
        </div>
      </div>
      <div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
        <span id="su-modal-error" style="font-size:0.82rem; color:var(--accent-red); font-weight:600;"></span>
        <div style="display:flex; gap:0.65rem;">
          <button type="button" class="btn-secondary" id="su-cancel">Cancelar</button>
          <button type="button" class="btn-primary" id="su-save">Guardar Colaborador</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ════ MODAL: Confirmar Eliminación de Colaborador ════ -->
  <div id="modal-delete-staff-user" class="modal-overlay" style="display:none; z-index:10001;">
    <div class="modal-box" style="max-width:480px;">
      <div class="modal-header">
        <h2 style="display:flex; align-items:center; gap:0.5rem; font-size:1.15rem; color:var(--accent-red);">
          <Icon name="mdi:alert-circle-outline" width="22" height="22" /> Confirmar Revocación de Usuario
        </h2>
        <button class="btn-icon" id="del-staff-close" type="button"><Icon name="mdi:close" width="22" height="22" /></button>
      </div>
      <div class="modal-body" style="display:flex; flex-direction:column; gap:1rem;">
        <p style="margin:0; font-size:0.88rem; color:var(--text-secondary); line-height:1.5;">
          ¿Estás seguro de que deseas eliminar permanentemente a este colaborador? Su PIN de terminal será revocado de inmediato y no podrá volver a iniciar sesión.
        </p>

        <div style="background:rgba(255,59,48,0.06); border:1px solid rgba(255,59,48,0.2); border-radius:var(--radius-md); padding:0.85rem 1rem; display:flex; align-items:center; gap:0.75rem;" id="del-user-preview">
          <!-- Populated dynamically -->
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="del-staff-cancel" type="button">Cancelar</button>
        <button class="btn-primary" id="del-staff-confirm" type="button" style="background:var(--accent-red); border:none; box-shadow:0 4px 12px rgba(255,59,48,0.3);">
          Eliminar Definitivamente
        </button>
      </div>
    </div>
  </div>

</PanelLayout>

<style is:global>
  /* ══ CORPORATE STYLING & STATUS VECTORS ══ */
  .user-monogram {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
