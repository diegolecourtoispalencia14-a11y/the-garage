  async function saveStaffUser() {
    const id = document.getElementById('su-id').value.trim();
    const name = document.getElementById('su-name').value.trim();
    const title = document.getElementById('su-title').value.trim();
    const email = document.getElementById('su-email').value.trim().toLowerCase();
    const phone = document.getElementById('su-phone').value.trim();
    const role = document.getElementById('su-role').value;
    const status = document.getElementById('su-status').value;
    const color = document.getElementById('su-color').value || '#0071e3';
    const pin = document.getElementById('su-pin').value.trim();
    let monogram = document.getElementById('su-monogram').value.trim().toUpperCase();
    const errEl = document.getElementById('su-modal-error');

    if (!name || !title || !email) {
      if (errEl) errEl.textContent = 'Nombre, puesto y correo oficial son obligatorios.';
      return;
    }

    const staffList = getSecurityStaff();
    const existingEmp = id ? staffList.find(e => e.id === id) : null;

    if (!existingEmp && (!pin || pin.length < 4)) {
      if (errEl) errEl.textContent = 'El PIN de terminal debe tener al menos 4 dígitos para un nuevo colaborador.';
      return;
    }

    if (pin && pin.length > 0 && pin.length < 4) {
      if (errEl) errEl.textContent = 'El nuevo PIN debe tener al menos 4 dígitos.';
      return;
    }

    // Determine secure pinHash and pinSalt
    let pinSalt = existingEmp ? (existingEmp.pinSalt || generateSaltClient()) : generateSaltClient();
    let pinHash = existingEmp ? existingEmp.pinHash : undefined;

    if (pin && pin.length >= 4) {
      pinHash = await hashPinClient(pin, pinSalt);
    }

    if (!monogram) {
      monogram = name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() || 'US';
    }

    const existingWithEmail = staffList.find(e => e.email.toLowerCase() === email && e.id !== id);
    if (existingWithEmail) {
      if (errEl) errEl.textContent = `El correo ${email} ya pertenece a otro colaborador.`;
      return;
    }

    const selectedModules = [];
    document.querySelectorAll('.su-module-checkbox:checked').forEach(cb => {
      selectedModules.push(cb.value);
    });
    if (role === 'admin') {
      SAAS_MODULES_LIST.forEach(m => {
        if (!selectedModules.includes(m.id)) selectedModules.push(m.id);
      });
    }

    const roleLabels = {
      admin: 'Administrador / Dueño',
      mecanico: 'Mecánico Senior / Taller',
      ventas: 'Ventas & Mostrador',
      personalizado: 'Rol Personalizado'
    };

    let targetEmpId = id;
    if (id) {
      const idx = staffList.findIndex(e => e.id === id);
      if (idx !== -1) {
        staffList[idx] = {
          ...staffList[idx],
          name,
          title,
          email,
          phone,
          role,
          roleLabel: roleLabels[role] || 'Personalizado',
          status,
          color,
          pinHash,
          pinSalt,
          monogram,
          avatar: monogram,
          allowedModules: selectedModules
        };
        delete staffList[idx].pin; // Remover cualquier residuo en texto plano
      }
    } else {
      targetEmpId = 'e_' + Date.now().toString(36);
      staffList.push({
        id: targetEmpId,
        name,
        title,
        email,
        phone,
        role,
        roleLabel: roleLabels[role] || 'Personalizado',
        status,
        color,
        pinHash,
        pinSalt,
        monogram,
        avatar: monogram,
        allowedModules: selectedModules,
        createdAt: new Date().toISOString()
      });
    }

    saveSecurityStaff(staffList);

    // Synchronize with active month operation employees
    try {
      const curM = getSelectedMonth();
      if (curM && Array.isArray(curM.employees)) {
        const empIdx = curM.employees.findIndex(e => e.id === targetEmpId);
        if (empIdx !== -1) {
          curM.employees[empIdx].name = name;
          curM.employees[empIdx].initials = monogram;
          curM.employees[empIdx].role = title;
          curM.employees[empIdx].phone = phone || curM.employees[empIdx].phone;
          curM.employees[empIdx].color = color;
        } else {
          curM.employees.push({
            id: targetEmpId,
            name,
            initials: monogram,
            role: title,
            phone: phone || '9840000000',
            shift: 'Completo (10am–7pm)',
            days: 'Lun–Sáb',
            color,
            clockIn: null,
            clockOut: null,
            certs: ['Acceso SaaS'],
            hoursMonth: 0,
            tasksMonthDone: 0,
            tasksMonthAssigned: 0
          });
        }
        saveSelectedMonth(curM);
        populateAssigneeSelects();
        renderStatusCards();
        renderSchedule();
      }
    } catch(e) {
      console.error('Error syncing staff with operations:', e);
    }

    const modal = document.getElementById('modal-staff-user');
    if (modal) modal.style.display = 'none';
  }

  // Deletion logic with safeguards
  let userToDeleteId = null;

  window.openDeleteStaffUser = function(empId) {
    if (empId === 'e1') {
      alert('El Administrador Raíz (admin@thegarage.mx) no puede ser eliminado por políticas de seguridad del sistema.');
      return;
    }

    const staffList = getSecurityStaff();
    const emp = staffList.find(e => e.id === empId);
    if (!emp) return;

    if (emp.role === 'admin') {
      const adminCount = staffList.filter(e => e.role === 'admin').length;
      if (adminCount <= 1) {
        alert('No es posible eliminar al único administrador del sistema.');
        return;
      }
    }

    userToDeleteId = empId;
    const preview = document.getElementById('del-user-preview');
    if (preview) {
      preview.innerHTML = `
        <div class="user-monogram" style="background:${emp.color || '#0071e3'}20; color:${emp.color || '#0071e3'}; border:1px solid ${emp.color || '#0071e3'}44; width:38px; height:38px; font-size:0.88rem;">
