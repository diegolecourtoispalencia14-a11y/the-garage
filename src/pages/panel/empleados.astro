  /* ══ RENDER: Kanban Board (Tareas) ══ */
  function renderKanban() {
    const cur = getSelectedMonth();
    const tasks = cur.tasks || [];
    const emps = cur.employees || [];

    // Filter by search / priority / category / assignee
    const qSearch = (document.getElementById('task-search')?.value || '').toLowerCase();
    const qPrio   = document.getElementById('filter-priority')?.value || '';
    const qCat    = document.getElementById('filter-category')?.value || '';
    const qAss    = document.getElementById('filter-assignee')?.value || '';

    const filtered = tasks.filter(t => {
      if (qSearch && !t.title.toLowerCase().includes(qSearch) && !(t.notes || '').toLowerCase().includes(qSearch)) return false;
      if (qPrio && t.priority !== qPrio) return false;
      if (qCat && t.cat !== qCat) return false;
      if (qAss === '__unassigned__' && t.assignee) return false;
      if (qAss && qAss !== '__unassigned__' && t.assignee !== qAss) return false;
      return true;
    });

    // Counts
    const cPend = tasks.filter(t => t.status === 'pending').length;
    const cProg = tasks.filter(t => t.status === 'progress').length;
    const cDone = tasks.filter(t => t.status === 'done').length;

    const elTotal = document.getElementById('tk-total');
    const elPend  = document.getElementById('tk-pending');
    const elProg  = document.getElementById('tk-progress');
    const elDone  = document.getElementById('tk-done');
    const tabBadge = document.getElementById('tab-badge-tasks');

    if (elTotal) elTotal.textContent = tasks.length;
    if (elPend)  elPend.textContent  = cPend;
    if (elProg)  elProg.textContent  = cProg;
    if (elDone)  elDone.textContent  = cDone;
    if (tabBadge) tabBadge.textContent = cPend + cProg;

    ['pending','progress','done'].forEach(col => {
      const colEl = document.getElementById('col-' + col);
      const countEl = document.getElementById('cnt-' + col);
      if (countEl) countEl.textContent = tasks.filter(t => t.status === col).length;
      if (!colEl) return;

      const colTasks = filtered.filter(t => t.status === col);
      if (!colTasks.length) {
        colEl.innerHTML = '<div class="kanban-empty">No hay tareas en esta columna</div>';
        return;
      }

      colEl.innerHTML = colTasks.map(t => {
        const emp = emps.find(e => e.id === t.assignee);
        return `
          <div class="task-card" draggable="${!isViewingHistorical()}" data-task-id="${t.id}">
            <div class="task-card-top">
              <span class="task-cat-tag">${t.cat}</span>
              ${getPriorityBadge(t.priority)}
            </div>
            <div class="task-card-title">${t.title}</div>
            ${t.notes ? `<div class="task-card-notes">${t.notes}</div>` : ''}
            <div class="task-card-footer">
              <div class="task-card-assignee">
                ${emp ? `
                  <div class="emp-avatar" style="background:${emp.color}; width:24px; height:24px; font-size:0.65rem;">${emp.initials}</div>
                  <span>${emp.name.split(' ')[0]}</span>
                ` : '<span class="task-unassigned">Sin asignar</span>'}
              </div>
              <div style="display:flex; align-items:center; gap:0.4rem;">
                ${t.due ? `<span class="task-due font-mono">${t.due.slice(5)}</span>` : ''}
                ${!isViewingHistorical() ? `
                  <button class="btn-icon" onclick="moveTaskNext('${t.id}')" title="Avanzar estado">›</button>
                  <button class="btn-icon" onclick="deleteTask('${t.id}')" title="Eliminar" style="color:#ff3b30;">×</button>
                ` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    });
  }

  window.moveTaskNext = function(taskId) {
    if (isViewingHistorical()) { alert('El mes actual es solo lectura.'); return; }
    const cur = getSelectedMonth();
    const t = (cur.tasks || []).find(item => item.id === taskId);
    if (!t) return;
    if (t.status === 'pending') t.status = 'progress';
    else if (t.status === 'progress') t.status = 'done';
    else t.status = 'pending';
    saveSelectedMonth(cur);
    renderKanban();
    renderPerformance();
  };

  window.deleteTask = function(taskId) {
    if (isViewingHistorical()) { alert('El mes actual es solo lectura.'); return; }
    if (!confirm('¿Eliminar esta tarea del registro mensual?')) return;
    const cur = getSelectedMonth();
    cur.tasks = (cur.tasks || []).filter(t => t.id !== taskId);
    saveSelectedMonth(cur);
    renderKanban();
    renderPerformance();
  };

