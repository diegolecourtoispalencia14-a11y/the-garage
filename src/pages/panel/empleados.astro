        <div>
          <strong style="display:block; font-size:0.92rem; color:var(--text-primary);">${emp.name}</strong>
          <span style="font-size:0.8rem; color:var(--text-secondary);">${emp.email} · ${emp.roleLabel}</span>
        </div>
      `;
    }

    const modal = document.getElementById('modal-delete-staff-user');
    if (modal) modal.style.display = 'flex';
  };

  function confirmDeleteStaffUser() {
    if (!userToDeleteId || userToDeleteId === 'e1') return;

    let staffList = getSecurityStaff();
    staffList = staffList.filter(e => e.id !== userToDeleteId);
    saveSecurityStaff(staffList);

    try {
      const curM = getSelectedMonth();
      if (curM && Array.isArray(curM.employees)) {
        curM.employees = curM.employees.filter(e => e.id !== userToDeleteId);
        saveSelectedMonth(curM);
        populateAssigneeSelects();
        renderStatusCards();
        renderSchedule();
      }
    } catch(e) {}

    userToDeleteId = null;
    const modal = document.getElementById('modal-delete-staff-user');
    if (modal) modal.style.display = 'none';
  }

