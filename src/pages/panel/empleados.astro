    font-size: 0.92rem;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    font-family: inherit;
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-green);
