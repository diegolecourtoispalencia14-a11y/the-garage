  if (pTaller) pTaller.addEventListener('click', () => setModulePreset('taller'));
  if (pVentas) pVentas.addEventListener('click', () => setModulePreset('ventas'));
  if (pClear) pClear.addEventListener('click', () => setModulePreset('clear'));

