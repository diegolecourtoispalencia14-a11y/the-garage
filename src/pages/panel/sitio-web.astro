<script is:inline define:vars={{ staticData, masterData, defaultPayData, googleProfileData }}>
(function () {
  const INV_KEY   = 'bicisaas_inventory';
  const WEB_KEY   = 'bicisaas_web_bikes';
  const LEDGER_KEY= 'bicisaas_ledger';
  const CRM_KEY   = 'bicisaas_crm';

  const staticBikes = JSON.parse(staticData || '[]');
  const masterProducts = JSON.parse(masterData || '[]');
  const defaultPayCfg = JSON.parse(defaultPayData || '{}');
  const googleProfile = JSON.parse(googleProfileData || '{}');

  function fmt(n) { return '$' + Number(n).toLocaleString('es-MX', { minimumFractionDigits: 0 }); }

  /* ── Universal Product Aliasing & Canonical Identifiers ── */
  const PRODUCT_ALIASES = {
    'mer-scu300': ['mer-scu300', 'merida-scultura-tiagra', 'merida-scultura-300-tiagra'],
    'merida-scultura-tiagra': ['mer-scu300', 'merida-scultura-tiagra', 'merida-scultura-300-tiagra'],
    'merida-scultura-300-tiagra': ['mer-scu300', 'merida-scultura-tiagra', 'merida-scultura-300-tiagra'],
    'trk-mar5': ['trk-mar5', 'trk-m5-24', 'trek-marlin-5-2024', '2'],
    'trk-m5-24': ['trk-mar5', 'trk-m5-24', 'trek-marlin-5-2024', '2'],
    'trek-marlin-5-2024': ['trk-mar5', 'trk-m5-24', 'trek-marlin-5-2024', '2'],
    '2': ['trk-mar5', 'trk-m5-24', 'trek-marlin-5-2024', '2'],
    'bas-palt2': ['bas-palt2', 'bas-plt2-c', 'basso-palta-ii-custom', '1'],
    'bas-plt2-c': ['bas-palt2', 'bas-plt2-c', 'basso-palta-ii-custom', '1'],
    'basso-palta-ii-custom': ['bas-palt2', 'bas-plt2-c', 'basso-palta-ii-custom', '1'],
    '1': ['bas-palt2', 'bas-plt2-c', 'basso-palta-ii-custom', '1'],
    'spz-alz-sp': ['spz-alz-sp', 'spz-alz-e5', 'specialized-allez-e5', '3'],
    'spz-alz-e5': ['spz-alz-sp', 'spz-alz-e5', 'specialized-allez-e5', '3'],
    'specialized-allez-e5': ['spz-alz-sp', 'spz-alz-e5', 'specialized-allez-e5', '3'],
    '3': ['spz-alz-sp', 'spz-alz-e5', 'specialized-allez-e5', '3'],
    'gnt-tal2': ['gnt-tal2', 'gnt-tl2-29', 'giant-talon-2-2024', '4'],
    'gnt-tl2-29': ['gnt-tal2', 'gnt-tl2-29', 'giant-talon-2-2024', '4'],
    'giant-talon-2-2024': ['gnt-tal2', 'gnt-tl2-29', 'giant-talon-2-2024', '4'],
    '4': ['gnt-tal2', 'gnt-tl2-29', 'giant-talon-2-2024', '4']
  };

  function getAliases(id) {
    if (!id) return [];
    const str = String(id);
    const lower = str.toLowerCase();
    const set = new Set([str, lower, str.toUpperCase()]);
    const list = PRODUCT_ALIASES[lower] || PRODUCT_ALIASES[str] || [];
    list.forEach(a => {
      set.add(a);
      set.add(a.toLowerCase());
      set.add(a.toUpperCase());
    });
    return Array.from(set);
  }

  function getCanonicalKey(item) {
    const raw = String(item.sku || item.id || '').toLowerCase();
    const name = String(item.name || '').toLowerCase();
    if (raw.includes('mer-scu') || raw.includes('scultura') || name.includes('scultura')) return 'MER-SCU300';
    if (raw.includes('trk-mar') || raw.includes('marlin') || name.includes('marlin')) return 'TRK-MAR5';
    if (raw.includes('bas-pal') || raw.includes('palta') || name.includes('palta')) return 'BAS-PALT2';
    if (raw.includes('spz-alz') || raw.includes('allez') || name.includes('allez')) return 'SPZ-ALZ-SP';
    if (raw.includes('gnt-tal') || raw.includes('talon') || name.includes('talon')) return 'GNT-TAL2';
    return item.sku || item.id || name;
  }

  function findProductOverride(prod, overrides) {
    if (!overrides || typeof overrides !== 'object') return {};

    const candidateKeys = [
      ...getAliases(prod.sku),
      ...getAliases(prod.id),
      getCanonicalKey(prod),
      String(prod.id || ''),
      String(prod.sku || '')
    ];

    for (const key of candidateKeys) {
      if (key && overrides[key] && typeof overrides[key] === 'object') {
        return overrides[key];
      }
    }

    const prodName = String(prod.name || '').toLowerCase().trim();
    for (const [k, v] of Object.entries(overrides)) {
      if (!v || typeof v !== 'object') continue;
      const kLower = k.toLowerCase();
      if (v.name && String(v.name).toLowerCase().trim() === prodName) return v;
      if (prodName.includes('scultura') && (kLower.includes('scultura') || kLower.includes('mer-scu') || kLower.includes('merida'))) return v;
      if (prodName.includes('marlin') && (kLower.includes('marlin') || kLower.includes('trk-m') || kLower.includes('trek'))) return v;
      if (prodName.includes('palta') && (kLower.includes('palta') || kLower.includes('bas-p') || kLower.includes('basso'))) return v;
      if (prodName.includes('allez') && (kLower.includes('allez') || kLower.includes('spz-a') || kLower.includes('specialized'))) return v;
      if (prodName.includes('talon') && (kLower.includes('talon') || kLower.includes('gnt-t') || kLower.includes('giant'))) return v;
    }

    return {};
  }

  /* ── Load Unified Inventory ── */
  function loadUnifiedCatalog() {
    let inventory = JSON.parse(localStorage.getItem(INV_KEY) || '[]');
    const overrides = JSON.parse(localStorage.getItem(WEB_KEY) || '{}');

    // Seed master catalogue if inventory is empty
    if (!inventory.length && masterProducts.length) {
      inventory = masterProducts.map(p => ({
        id: p.id,
        name: p.name,
        brand: p.brand,
        cat: p.cat,
        sku: p.sku,
        price: p.price,
        cost: Math.round(p.price * 0.65),
        stock: p.stock !== undefined ? p.stock : 1,
        min: 1,
        talla: p.talla || '',
        color: p.color || '',
        fotos: p.fotos || [],
        publishedOnWeb: true,
        disponibilidad: (p.stock !== undefined ? p.stock : 1) > 0 ? 'Disponible' : 'Agotado'
      }));
      localStorage.setItem(INV_KEY, JSON.stringify(inventory));
    }

    // Make sure bikes from static collection exist in inventory
    staticBikes.forEach(sb => {
      const exists = inventory.find(p => p.sku === sb.id || p.name.toLowerCase().includes(sb.modelo.toLowerCase()));
      if (!exists) {
        inventory.push({
          id: sb.id,
          name: `${sb.marca} ${sb.modelo}`,
          brand: sb.marca,
          cat: 'Bicicletas',
          sku: sb.id,
          price: sb.precio,
          cost: Math.round(sb.precio * 0.65),
          stock: sb.disponibilidad === 'Vendida' ? 0 : 1,
          min: 1,
          talla: sb.talla,
          color: sb.color,
          fotos: sb.fotos || [],
          publishedOnWeb: true,
          disponibilidad: sb.disponibilidad
        });
      }
    });

    // Exclude rental fleet items (rental fleet is managed exclusively in /panel/rentas)
    const retailItems = inventory.filter(p => {
      const id = (p.id || '').toString();
      const sku = (p.sku || '').toString();
      const cat = (p.cat || '').toString();
      const name = (p.name || '').toLowerCase();
      if (id.startsWith('RENT-') || sku.startsWith('RENT-')) return false;
      if (cat === 'Renta' || cat === 'Flota Rentas' || cat === 'Rentas') return false;
      if (name.includes('renta de') || name.includes('flota renta')) return false;
      return true;
    });

    // Deduplicate items by canonical key
    const seenMap = new Map();
    const uniqueRetail = [];
    for (const item of retailItems) {
      const key = getCanonicalKey(item);
      if (!seenMap.has(key)) {
        seenMap.set(key, true);
        uniqueRetail.push(item);
      }
    }

    // Merge overrides
    return uniqueRetail.map(item => {
      const ov = findProductOverride(item, overrides);
      const isPublished = ov.publishedOnWeb !== undefined
        ? (ov.publishedOnWeb === true)
        : (item.publishedOnWeb !== undefined ? (item.publishedOnWeb === true) : true);

      return {
        ...item,
        ...ov,
        // Calculate web price with 3.5% commission
        webPrice: Math.round((ov.price || item.price) * 1.035),
        isPublished: isPublished
      };
    });
  }

  function saveItemOverride(id, fields) {
    const overrides = JSON.parse(localStorage.getItem(WEB_KEY) || '{}');
    const allAliases = getAliases(id);
    const canId = getCanonicalKey({ sku: id, id: id });
    if (canId && !allAliases.includes(canId)) allAliases.push(canId);

    allAliases.forEach(aliasKey => {
      if (aliasKey) {
        overrides[aliasKey] = { ...(overrides[aliasKey] || {}), ...fields };
      }
    });
    localStorage.setItem(WEB_KEY, JSON.stringify(overrides));

    // Also sync fields (such as publishedOnWeb, price, stock) to INV_KEY
    try {
      let inventory = JSON.parse(localStorage.getItem(INV_KEY) || '[]');
      let modified = false;
      inventory = inventory.map(item => {
        const itemCan = getCanonicalKey(item);
        const isMatch = allAliases.includes(item.id) ||
                        allAliases.includes(item.sku) ||
                        allAliases.includes(String(item.id)) ||
                        (canId && itemCan === canId);
        if (isMatch) {
          modified = true;
          return { ...item, ...fields };
        }
        return item;
      });
      if (modified) {
        localStorage.setItem(INV_KEY, JSON.stringify(inventory));
      }
    } catch(e) {}
  }

  function updateInventoryItem(id, updates) {
    let inventory = JSON.parse(localStorage.getItem(INV_KEY) || '[]');
    const allAliases = getAliases(id);
    const canId = getCanonicalKey({ sku: id, id: id });
    if (canId && !allAliases.includes(canId)) allAliases.push(canId);

    let modified = false;
    inventory = inventory.map(item => {
      const itemCan = getCanonicalKey(item);
      const isMatch = allAliases.includes(item.id) ||
                      allAliases.includes(item.sku) ||
                      allAliases.includes(String(item.id)) ||
                      (canId && itemCan === canId);
      if (isMatch) {
        modified = true;
        return { ...item, ...updates };
      }
      return item;
    });
    if (modified) {
      localStorage.setItem(INV_KEY, JSON.stringify(inventory));
    }
  }

  /* ── Render Catalog with Commercial Sections & Dual View (Shopify Style) ── */
  let searchQuery = '';
  let categoryFilter = '';
  let statusFilter = '';
  let selectedFamily = 'all';
  let currentViewMode = 'table'; // 'table' or 'pos'
  const selectedProductIds = new Set();
  let activeDrawerItem = null;

  function getCatSvg(cat) {
    if (cat === "Bicicletas") {
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5L8.5 7H12l2.5 4.5M12 11.5l3.5 6M5.5 17.5l4-10.5"/></svg>`;
    } else if (cat === "Herramientas & Taller" || cat === "Manubrio & Tija") {
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`;
    } else if (cat === "Transmisión & Drivetrain") {
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`;
    } else if (cat === "Electrónica & GPS") {
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>`;
    }
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>`;
  }

  function getItemFamily(item) {
    const cat = item.cat || '';
    const name = (item.name || '').toLowerCase();
    if (cat === 'Bicicletas') {
      return 'bicis';
    }
    if (cat.includes('Transmisión') || cat.includes('Drivetrain') || cat === 'Frenos' || cat.includes('Ruedas')) {
      return 'transmision';
    }
    if (cat.includes('Taller') || cat.includes('Herramientas') || name.includes('sellador') || name.includes('cadena') || name.includes('pastillas') || name.includes('grasa')) {
      return 'taller';
    }
    return 'boutique';
  }

  function getItemFamilyLabel(item) {
    const f = getItemFamily(item);
    const map = {
      bicis: 'Bicicleta Completa',
      transmision: 'Componentes & Transmisión',
      taller: 'Taller & Insumos',
      boutique: 'Boutique & Accesorios'
    };
    return map[f] || item.cat;
  }

  function renderCatalog() {
    const catalog = loadUnifiedCatalog();

    // 1. Update Global KPI counters
    const total = catalog.length;
    const published = catalog.filter(p => p.isPublished).length;
    const inStock = catalog.filter(p => p.stock > 0).length;
    const elTotal = document.getElementById('kpi-total-prods');
    const elPub = document.getElementById('kpi-published-prods');
    const elStock = document.getElementById('kpi-instock-prods');
    if (elTotal) elTotal.textContent = total;
    if (elPub) elPub.textContent = published;
    if (elStock) elStock.textContent = inStock;

    // 2. Calculate Section Counts for Family Tabs
    const familyCounts = { all: total, bicis: 0, transmision: 0, taller: 0, boutique: 0 };
    catalog.forEach(item => {
      const fam = getItemFamily(item);
      if (familyCounts[fam] !== undefined) familyCounts[fam]++;
    });
    ['all', 'bicis', 'transmision', 'taller', 'boutique'].forEach(f => {
      const el = document.getElementById('count-' + f);
      if (el) el.textContent = familyCounts[f];
    });

    // 3. Filter Items
    const filtered = catalog.filter(item => {
      // Family filter
      if (selectedFamily !== 'all') {
        const fam = getItemFamily(item);
        if (fam !== selectedFamily) return false;
      }

      // Search query
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const match = (item.name || '').toLowerCase().includes(q) ||
                      (item.brand || '').toLowerCase().includes(q) ||
                      (item.sku || '').toLowerCase().includes(q);
        if (!match) return false;
      }

      // Status filter
      if (statusFilter === 'published' && !item.isPublished) return false;
      if (statusFilter === 'hidden' && item.isPublished) return false;
      if (statusFilter === 'stock' && item.stock <= 0) return false;
      if (statusFilter === 'out' && item.stock > 0) return false;

      return true;
    });

    // 4. Handle Empty State
    const emptyEl = document.getElementById('catalog-empty-state');
    const tableWrap = document.getElementById('catalog-table-container');
    const posContainer = document.getElementById('catalog-pos-container');

    if (!filtered.length) {
      if (emptyEl) emptyEl.style.display = 'block';
      if (tableWrap) tableWrap.style.display = 'none';
      if (posContainer) posContainer.style.display = 'none';
      return;
    } else {
      if (emptyEl) emptyEl.style.display = 'none';
      if (currentViewMode === 'table') {
        if (tableWrap) tableWrap.style.display = 'block';
        if (posContainer) posContainer.style.display = 'none';
      } else {
        if (tableWrap) tableWrap.style.display = 'none';
        if (posContainer) posContainer.style.display = 'block';
      }
    }

    // 5. Render View A: Shopify Table
    const tbody = document.getElementById('catalog-table-body');
    if (tbody) {
      tbody.innerHTML = '';
      filtered.forEach(item => {
        const hasStock = item.stock > 0;
        const stockBadgeCls = !hasStock ? 'pill-out' : item.stock <= (item.min || 2) ? 'pill-low' : 'pill-ok';
        const stockText = !hasStock ? 'Agotado' : `${item.stock} disp.`;
        const catIcon = getCatSvg(item.cat);
        const imageSrc = (item.fotos && item.fotos[0]) ? item.fotos[0] : null;
        const isChecked = selectedProductIds.has(item.sku || String(item.id));

        const tr = document.createElement('tr');
        tr.className = 'st-row';
        tr.onclick = (e) => {
          if (e.target.closest('input[type="checkbox"]') || e.target.closest('button')) return;
          window.openProductDrawer(item.sku || item.id);
        };

        tr.innerHTML = `
          <td style="text-align:center;" onclick="event.stopPropagation();">
            <input type="checkbox" class="st-item-checkbox" data-id="${item.sku || item.id}" ${isChecked ? 'checked' : ''} onchange="window.toggleSelectProduct('${item.sku || item.id}', event)" />
          </td>
          <td>
            <div class="st-product-cell">
              ${imageSrc ? `<img src="${imageSrc}" alt="${item.name}" class="st-thumb" loading="lazy" />` : `<div class="st-thumb">${catIcon}</div>`}
              <div>
                <div class="st-title" title="${item.name}">${item.name}</div>
                <div class="st-meta">
                  <span>${item.brand || 'The Garage'}</span>
                  <span>· SKU: <strong>${item.sku || 'N/A'}</strong></span>
                  ${item.talla ? `<span>· Talla ${item.talla}</span>` : ''}
                </div>
              </div>
            </div>
          </td>
          <td>
            <span style="font-size:0.75rem; font-weight:600; color:var(--text-secondary); background:var(--bg-base); padding:0.25rem 0.55rem; border-radius:6px; border:1px solid var(--border-subtle); display:inline-block;">
              ${getItemFamilyLabel(item)}
            </span>
          </td>
          <td>
            <span class="status-pill ${stockBadgeCls}">
              ${stockText}
            </span>
          </td>
          <td>
            <strong style="font-size:0.95rem; color:var(--text-primary);">${fmt(item.price)}</strong>
          </td>
          <td>
            <span style="font-size:0.95rem; color:var(--accent-blue); font-weight:700;">${fmt(item.webPrice)}</span>
            <span style="font-size:0.7rem; color:var(--text-secondary); display:block;">+3.5% pasarela</span>
          </td>
          <td style="text-align:center;" onclick="event.stopPropagation();">
            <button class="zp-web-pill ${item.isPublished ? 'pub' : 'hid'}" type="button" style="position:static; cursor:pointer;" onclick="window.toggleWebPublish('${item.sku || item.id}')" title="Clic para alternar publicación web">
              ${item.isPublished ? 'En Web' : 'Oculto'}
            </button>
          </td>
          <td style="text-align:right;" onclick="event.stopPropagation();">
            <div style="display:inline-flex; gap:0.35rem; align-items:center;">
              <button class="zp-btn pos" type="button" style="padding:0.35rem 0.65rem; font-size:0.75rem;" onclick="window.openPOS('${item.sku || item.id}')" title="Cobrar venta en mostrador">
                POS
              </button>
              <button class="zp-btn" type="button" style="padding:0.35rem 0.65rem; font-size:0.75rem;" onclick="window.openProductDrawer('${item.sku || item.id}')" title="Ver ficha técnica completa">
                Ficha &rarr;
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // 6. Render View B: Clean POS Quick-Pick Grid
    const posGrid = document.getElementById('catalog-pos-grid');
    if (posGrid) {
      posGrid.innerHTML = '';
      filtered.forEach(item => {
        const hasStock = item.stock > 0;
        const stockBadgeCls = !hasStock ? 'pill-out' : item.stock <= (item.min || 2) ? 'pill-low' : 'pill-ok';
        const stockText = !hasStock ? 'Agotado' : `${item.stock} en tienda`;
        const catIcon = getCatSvg(item.cat);
        const imageSrc = (item.fotos && item.fotos[0]) ? item.fotos[0] : null;

        const card = document.createElement('div');
        card.className = 'pos-card';
        card.onclick = () => window.openPOS(item.sku || item.id);

        card.innerHTML = `
          <div class="pos-thumb-box">
            ${imageSrc ? `<img src="${imageSrc}" alt="${item.name}" loading="lazy" />` : `<span style="display:flex; justify-content:center; align-items:center; height:100%;">${catIcon}</span>`}
            <span class="status-pill ${stockBadgeCls}" style="position:absolute; top:0.5rem; right:0.5rem; font-size:0.7rem;">
              ${stockText}
            </span>
            <span class="zp-web-pill ${item.isPublished ? 'pub' : 'hid'}" style="position:absolute; top:0.5rem; left:0.5rem;">
              ${item.isPublished ? 'Web' : 'Off'}
            </span>
          </div>
          <div class="pos-card-body">
            <div style="font-size:0.72rem; color:var(--text-secondary); text-transform:uppercase; font-weight:600;">${item.brand || 'The Garage'}</div>
            <div class="pos-card-title" title="${item.name}">${item.name}</div>
            <div style="font-size:0.75rem; color:var(--text-secondary);">SKU: ${item.sku || 'N/A'}</div>
            <div class="pos-card-price">${fmt(item.price)} <span style="font-size:0.75rem; font-weight:500; color:var(--text-secondary);">MXN</span></div>
            <button class="btn-pos-charge" type="button" onclick="event.stopPropagation(); window.openPOS('${item.sku || item.id}')">
              +$ Cobrar en Caja
            </button>
          </div>
        `;
        posGrid.appendChild(card);
      });
    }

    updateBulkBar();
  }

  /* ── Drawer & Inspector Logic ── */
  window.openProductDrawer = function(id) {
    const catalog = loadUnifiedCatalog();
    const item = catalog.find(p => p.sku === id || p.id == id);
    if (!item) return;
    activeDrawerItem = item;

    document.getElementById('drw-family').textContent = getItemFamilyLabel(item);
    document.getElementById('drw-title').textContent = item.name;
    document.getElementById('drw-sku').textContent = item.sku || 'N/A';
    
    const catIcon = getCatSvg(item.cat);
    const imageSrc = (item.fotos && item.fotos[0]) ? item.fotos[0] : null;

    const body = document.getElementById('drw-body');
    body.innerHTML = `
      ${imageSrc ? `<img src="${imageSrc}" alt="${item.name}" class="drawer-hero-img" />` : `
        <div class="drawer-hero-img" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.5rem; background:linear-gradient(135deg, rgba(0, 113, 227, 0.08), rgba(52, 199, 89, 0.08));">
          <span style="display:flex; justify-content:center; align-items:center;">${catIcon}</span>
          <span style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">${item.cat}</span>
        </div>
      `}

      <!-- Precios & Margen Web -->
      <div class="drawer-section">
        <div class="drawer-sec-title">Estructura Comercial de Precios</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
          <div style="background:var(--bg-surface); padding:0.75rem; border-radius:8px; border:1px solid var(--border-subtle);">
            <span style="font-size:0.7rem; color:var(--text-secondary); text-transform:uppercase; font-weight:700; display:block;">PVP Mostrador</span>
            <strong style="font-size:1.15rem; color:var(--text-primary);">${fmt(item.price)}</strong>
          </div>
          <div style="background:var(--bg-surface); padding:0.75rem; border-radius:8px; border:1px solid rgba(0,113,227,0.25);">
            <span style="font-size:0.7rem; color:var(--accent-blue); text-transform:uppercase; font-weight:700; display:block;">PVP Tienda Web (+3.5%)</span>
            <strong style="font-size:1.15rem; color:var(--accent-blue);">${fmt(item.webPrice)}</strong>
          </div>
        </div>
        <div style="font-size:0.75rem; color:var(--text-secondary); line-height:1.35;">
          <em>El precio web incluye automáticamente la comisión bancaria (+3.5%) para proteger la rentabilidad neta de la tienda física.</em>
        </div>
      </div>

      <!-- Visibilidad y Canales -->
      <div class="drawer-section">
        <div class="drawer-sec-title">Canales de Venta & Publicación Online</div>
        <div style="display:flex; justify-content:space-between; align-items:center; background:var(--bg-surface); padding:0.75rem 1rem; border-radius:8px; border:1px solid var(--border-subtle);">
          <div>
            <strong style="font-size:0.88rem; display:block;">Publicar en thegarage.mx</strong>
            <span style="font-size:0.75rem; color:var(--text-secondary);">${item.isPublished ? 'Visible en catálogo público y checkout online' : 'Oculto de clientes web'}</span>
          </div>
          <label class="switch">
            <input type="checkbox" id="drw-toggle-pub" ${item.isPublished ? 'checked' : ''} onchange="window.toggleWebPublish('${item.sku || item.id}')" />
            <span class="slider round"></span>
          </label>
        </div>
      </div>

      <!-- Inventario Físico -->
      <div class="drawer-section">
        <div class="drawer-sec-title">Control de Existencias en Almacén</div>
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-size:0.85rem; font-weight:700;">Stock Físico Disponible:</div>
            <div style="font-size:0.78rem; color:var(--text-secondary);">Ubicación: Cataluña, Playa del Carmen</div>
          </div>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <button class="btn-stepper" type="button" onclick="window.quickAdjustStock('${item.sku || item.id}', -1)" title="Disminuir stock">-</button>
            <span style="font-size:1.15rem; font-weight:800; min-width:32px; text-align:center;">${item.stock}</span>
            <button class="btn-stepper" type="button" onclick="window.quickAdjustStock('${item.sku || item.id}', 1)" title="Aumentar stock">+</button>
          </div>
        </div>
        ${item.talla || item.color ? `
          <div style="display:flex; gap:0.5rem; font-size:0.78rem; margin-top:0.35rem; color:var(--text-secondary);">
            ${item.talla ? `<span>Talla: <strong>${item.talla}</strong></span>` : ''}
