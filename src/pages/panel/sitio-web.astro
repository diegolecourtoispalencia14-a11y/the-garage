---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { Icon } from 'astro-icon/components';
import { MASTER_PRODUCTS } from '../../data/allProducts';
import { GOOGLE_PROFILE_CONFIG } from '../../data/googleProfileConfig';
import { DEFAULT_PAYMENT_CONFIG } from '../../data/paymentConfig';

// Read the static bikes from content collections (build-time baseline)
import { getCollection } from 'astro:content';
const staticBicis = await getCollection('bicis');
const staticData = JSON.stringify(staticBicis.map(e => e.data));
const masterData = JSON.stringify(MASTER_PRODUCTS);
const defaultPayData = JSON.stringify(DEFAULT_PAYMENT_CONFIG);
const googleProfileData = JSON.stringify(GOOGLE_PROFILE_CONFIG);
---
<PanelLayout title="Gestión del Sitio Web & POS | BiciSaaS">
  <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
    <div>
      <h1 class="page-title">Gestión Web & Punto de Venta (POS).</h1>
      <p class="text-muted">Publica productos de tu almacén físico al sitio web con un clic y registra ventas directas con auto-sync contable.</p>
    </div>
    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
      <a href="/" target="_blank" class="btn-secondary" style="text-decoration:none;">
        <Icon name="mdi:open-in-new" width="18" height="18" /> Ver Sitio Público ↗
      </a>
      <a href="/inventario" target="_blank" class="btn-secondary" style="text-decoration:none;">
        <Icon name="mdi:bicycle" width="18" height="18" /> Ver Catálogo ↗
      </a>
      <button class="btn-primary" id="btn-add-bike">
        <Icon name="mdi:plus" width="18" height="18" /> Agregar Producto / Bici
      </button>
    </div>
  </div>

  <!-- Quick Nav Tabs -->
  <div class="section-tabs">
    <button class="stab active" data-section="catalog">Catálogo Unificado & POS</button>
    <button class="stab" data-section="crm-sync">Sincronización CRM & Pasarela</button>
    <button class="stab" data-section="firebase-sync"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-orange)" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg> Nube Google Firebase & Sync</button>
    <button class="stab" data-section="google-seo">Presencia Google & Reseñas (SEO)</button>
    <button class="stab" data-section="bot">Configuración del Bot</button>
  </div>

  <!-- ═══════════════════════ SECTION: Catalog & POS ═══════════════════════ -->
  <div id="section-catalog">
    
    <!-- Quick Metrics Row (Zoho Style) -->
    <div class="zoho-kpi-row">
      <div class="zoho-kpi-card">
        <span class="zk-label">Total Productos Almacén</span>
        <strong class="zk-value" id="kpi-total-prods">0</strong>
      </div>
      <div class="zoho-kpi-card">
        <span class="zk-label">Publicados en Sitio Web</span>
        <strong class="zk-value blue" id="kpi-published-prods">0</strong>
      </div>
      <div class="zoho-kpi-card">
        <span class="zk-label">En Stock (Físico)</span>
        <strong class="zk-value green" id="kpi-instock-prods">0</strong>
      </div>
      <div class="zoho-kpi-card">
        <span class="zk-label">Comisión Web Activa</span>
        <strong class="zk-value" style="color:#af52de;">+3.5%</strong>
      </div>
    </div>

    <!-- 1. Commercial Family Section Tabs (Segmented Bar) -->
    <div class="catalog-family-tabs">
      <button class="cft-tab active" data-family="all" type="button">
        <span class="cft-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg></span>
        <span class="cft-name">Todos los Artículos</span>
        <span class="cft-count" id="count-all">0</span>
      </button>
      <button class="cft-tab" data-family="bicis" type="button">
        <span class="cft-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5L8.5 7H12l2.5 4.5M12 11.5l3.5 6M5.5 17.5l4-10.5"/></svg></span>
        <span class="cft-name">Bicicletas Completas</span>
        <span class="cft-count" id="count-bicis">0</span>
      </button>
      <button class="cft-tab" data-family="transmision" type="button">
        <span class="cft-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
        <span class="cft-name">Componentes & Transmisión</span>
        <span class="cft-count" id="count-transmision">0</span>
      </button>
      <button class="cft-tab" data-family="taller" type="button">
        <span class="cft-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span>
        <span class="cft-name">Taller & Insumos</span>
        <span class="cft-count" id="count-taller">0</span>
      </button>
      <button class="cft-tab" data-family="boutique" type="button">
        <span class="cft-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
        <span class="cft-name">Boutique & Accesorios</span>
        <span class="cft-count" id="count-boutique">0</span>
      </button>
    </div>

    <!-- 2. Refined Search & Dual-View Toolbar -->
    <div class="catalog-toolbar">
      <div class="toolbar-left">
        <div class="zoho-search-wrap" style="flex:1; min-width:280px;">
          <Icon name="mdi:barcode-scan" width="18" height="18" style="color:var(--accent-blue);" />
          <input type="text" id="catalog-search" placeholder="Escanear código de barra o buscar por modelo, SKU..." />
        </div>
        <select id="catalog-status-filter" class="zoho-select">
          <option value="">Todos los Estados</option>
          <option value="published">Solo Publicados en Web</option>
          <option value="hidden">Solo Ocultos en Web</option>
          <option value="stock">En Stock Físico</option>
          <option value="out">Agotados</option>
        </select>
        <!-- Hidden select for compatibility -->
        <select id="catalog-cat-filter" class="zoho-select" style="display:none;">
          <option value="">Todas</option>
        </select>
      </div>

      <div class="toolbar-right">
        <!-- Dual View Mode Switcher -->
        <div class="view-mode-toggle">
          <button class="vmt-btn active" id="btn-view-table" type="button" title="Vista Lista de Gestión (Shopify Admin)">
            <Icon name="mdi:format-list-bulleted" width="17" height="17" /> Lista Gestión
          </button>
          <button class="vmt-btn" id="btn-view-pos" type="button" title="Vista Cuadrícula POS Rápido Mostrador">
            <Icon name="mdi:view-grid" width="17" height="17" /> POS Mostrador
          </button>
        </div>
      </div>
    </div>

    <!-- 3. View A: Shopify Admin Table View (Default) -->
    <div id="catalog-table-container" class="catalog-table-wrap">
      <table class="shopify-table">
        <thead>
          <tr>
            <th style="width:36px; text-align:center;"><input type="checkbox" id="th-select-all" title="Seleccionar todos" /></th>
            <th style="min-width:280px;">Artículo & SKU</th>
            <th>Familia / Categoría</th>
            <th>Stock Almacén</th>
            <th>PVP Mostrador</th>
            <th>Tienda Web (+3.5%)</th>
            <th style="text-align:center;">Canal Online</th>
            <th style="text-align:right; min-width:140px;">Acciones</th>
          </tr>
        </thead>
        <tbody id="catalog-table-body">
          <!-- Rendered dynamically by JS -->
        </tbody>
      </table>
    </div>

    <!-- 4. View B: Clean POS Quick-Pick Grid (Hidden in Table Mode) -->
    <div id="catalog-pos-container" style="display:none;">
      <div class="catalog-pos-grid" id="catalog-pos-grid">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>

    <!-- 5. Empty State Container -->
    <div id="catalog-empty-state" style="display:none; text-align:center; padding:3.5rem 1.5rem; background:var(--bg-surface); border-radius:12px; border:1px dashed var(--border-subtle); margin-top:1rem;">
      <div style="display:flex; justify-content:center; margin-bottom:0.5rem;"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-secondary);"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
      <h3 style="font-size:1.1rem; font-weight:700; margin:0 0 0.35rem;">No se encontraron artículos en esta sección</h3>
      <p class="text-muted" style="font-size:0.85rem; margin:0;">Prueba seleccionando "Todos los Artículos" o limpiando los filtros de búsqueda.</p>
    </div>
  </div>

  <!-- ═══════════════════════ SECTION: CRM Sync ═══════════════════════ -->
  <div id="section-crm-sync" style="display:none;">

    <!-- Payment Gateway & Checkout Configuration Card -->
    <div class="bento-card" style="margin-bottom:1.5rem; border:1px solid var(--border-subtle); background:var(--bg-surface);" id="card-gateway-settings">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem; border-bottom:1px solid var(--border-subtle); padding-bottom:1rem;">
        <div>
          <div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.25rem;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            <h3 style="margin:0; font-size:1.15rem; font-weight:700;">Control de Pasarela de Pagos (MercadoPago México & SPEI)</h3>
          </div>
          <p class="text-muted" style="margin:0; font-size:0.85rem;">Alterna entre Modo de Pruebas (Sandbox) y Modo Producción (Cobros Reales), gestiona credenciales y transferencias SPEI.</p>
        </div>
        
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <div id="gateway-status-badge" style="display:flex; align-items:center; gap:0.5rem; padding:0.45rem 1rem; border-radius:100px; font-size:0.82rem; font-weight:700; background:rgba(255,149,0,0.12); color:#ff9500; border:1px solid rgba(255,149,0,0.25);">
            <span id="gateway-status-dot" style="width:9px; height:9px; border-radius:50%; background:#ff9500; box-shadow:0 0 8px #ff9500;"></span>
            <span id="gateway-mode-label">Modo Sandbox (Pruebas)</span>
          </div>
          <button class="btn-primary" id="btn-toggle-gateway-mode" style="background:#0071e3; font-size:0.85rem; padding:0.55rem 1.1rem; cursor:pointer;">
            <Icon name="mdi:sync" width="18" height="18" /> <span id="btn-toggle-gateway-text">Cambiar a Modo Producción</span>
          </button>
        </div>
      </div>

      <!-- Mode explanation banner -->
      <div id="gateway-mode-alert" style="padding:0.9rem 1.1rem; border-radius:10px; margin-bottom:1.5rem; display:flex; gap:0.85rem; align-items:flex-start; background:rgba(255,149,0,0.08); border:1px solid rgba(255,149,0,0.25); color:#ff9500; font-size:0.85rem;">
        <span style="width:10px; height:10px; border-radius:50%; background:#ff9500; display:inline-block;"></span>
        <div>
          <strong id="gateway-alert-title" style="color:#f5f5f7; display:block; margin-bottom:0.25rem;">Actualmente en Modo Sandbox (Pruebas)</strong>
          <p id="gateway-alert-desc" style="margin:0; color:var(--text-secondary); line-height:1.4;">El checkout genera compras de prueba aprobadas sin cobrar a tarjetas reales. Los comprobantes dicen <em>"Modo de Prueba (Sandbox) — No se realizó un cobro real"</em>. Haz clic en "Cambiar a Modo Producción" para cobrar con tarjeta, SPEI y OXXO de manera oficial.</p>
        </div>
      </div>

      <!-- Form Grid -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.25rem;">
        
        <!-- Left: MercadoPago Production Credentials -->
        <div style="display:flex; flex-direction:column; gap:1rem; background:var(--bg-base); border:1px solid var(--border-subtle); border-radius:12px; padding:1.25rem;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:0.92rem; display:flex; align-items:center; gap:0.4rem; color:var(--text-primary);">
              Credenciales MercadoPago México
            </strong>
            <a href="https://www.mercadopago.com.mx/developers/panel/app" target="_blank" rel="noopener noreferrer" style="font-size:0.75rem; color:var(--accent-blue); text-decoration:none; display:inline-flex; align-items:center; gap:0.2rem; font-weight:600;">
              Abrir Developers MP ↗
            </a>
          </div>
          
          <div class="form-group">
            <label>MercadoPago Public Key</label>
            <input type="text" id="cfg-mp-public-key" placeholder="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            <span style="font-size:0.72rem; color:var(--text-secondary);">Clave pública visible para procesar cobros de forma segura.</span>
          </div>

          <div class="form-group">
            <label>MercadoPago Access Token</label>
            <input type="password" id="cfg-mp-access-token" placeholder="APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx" />
            <span style="font-size:0.72rem; color:var(--text-secondary);">Token privado de producción (se almacena de forma local y segura).</span>
          </div>

          <div class="form-group">
            <label>Link Directo de Cobro / Checkout Pro (Opcional)</label>
            <input type="url" id="cfg-mp-payment-link" placeholder="https://mpago.la/... o https://link.mercadopago.com.mx/..." />
            <span style="font-size:0.72rem; color:var(--text-secondary);">Link de Pago generado desde tu app de Mercado Pago para cobro inmediato.</span>
          </div>
        </div>

        <!-- Right: Business Rules & SPEI -->
        <div style="display:flex; flex-direction:column; gap:1rem; background:var(--bg-base); border:1px solid var(--border-subtle); border-radius:12px; padding:1.25rem;">
          <strong style="font-size:0.92rem; display:flex; align-items:center; gap:0.4rem; color:var(--text-primary);">
            SPEI Directo & Reglas de Envío
          </strong>

          <div class="form-group">
            <label>CLABE Interbancaria SPEI (18 dígitos)</label>
            <input type="text" id="cfg-spei-clabe" maxlength="18" placeholder="646690146012345678" />
            <span style="font-size:0.72rem; color:var(--text-secondary);">Transferencia bancaria sin intermediarios ni comisiones para The Garage.</span>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
            <div class="form-group">
              <label>Banco Receptor</label>
              <input type="text" id="cfg-spei-bank" placeholder="STP / BBVA México" />
            </div>
            <div class="form-group">
              <label>Beneficiario</label>
              <input type="text" id="cfg-spei-beneficiary" placeholder="The Garage Bike Experts" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
            <div class="form-group">
              <label>Comisión Pasarela Web (%)</label>
              <input type="number" id="cfg-fee-percent" step="0.1" min="0" max="15" placeholder="3.5" />
            </div>
            <div class="form-group">
              <label>Envío Gratis desde ($ MXN)</label>
              <input type="number" id="cfg-free-shipping" step="50" min="0" placeholder="500" />
            </div>
          </div>
        </div>

      </div>

      <!-- Action buttons -->
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--border-subtle);">
        <div style="display:flex; gap:0.75rem; align-items:center;">
          <button class="btn-primary" id="btn-save-gateway">
            <Icon name="mdi:content-save" width="18" height="18" /> Guardar Configuración de Pasarela
          </button>
          <span id="gateway-save-msg" style="font-size:0.85rem; color:var(--accent-green); display:none; font-weight:600;">Guardado con éxito</span>
        </div>
        <div style="display:flex; gap:0.75rem; align-items:center;">
          <a href="/checkout" target="_blank" class="btn-secondary" style="text-decoration:none;">
            <Icon name="mdi:open-in-new" width="16" height="16" /> Probar Checkout ↗
          </a>
          <a href="https://www.mercadopago.com.mx/developers/es/docs" target="_blank" rel="noopener noreferrer" class="btn-secondary" style="text-decoration:none;">
            <Icon name="mdi:open-in-new" width="16" height="16" /> Docs MercadoPago ↗
          </a>
        </div>
      </div>
    </div>

    <div class="bento-grid" style="margin-top:0;">
      <div class="bento-card">
        <h3 style="margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
          <Icon name="mdi:sync-circle" width="22" height="22" color="var(--accent-blue)" /> Estado de Sincronización
        </h3>
        <p class="text-muted" style="font-size:0.85rem; margin-bottom:1.5rem;">El panel lee los datos del chatbot del sitio web y los del CRM heredado automáticamente.</p>
        <div class="sync-status-grid">
          <div class="sync-item">
            <span class="sync-dot ok"></span>
            <div>
              <strong>Chatbot (GarageBot)</strong>
              <p class="text-muted" style="font-size:0.8rem;">Leads capturados en <code>the_garage_leads</code></p>
            </div>
            <span class="sync-count" id="sc-bot">0 registros</span>
          </div>
          <div class="sync-item">
            <span class="sync-dot ok"></span>
            <div>
              <strong>CRM Heredado (/admin/crm/)</strong>
              <p class="text-muted" style="font-size:0.8rem;">Prospectos del panel original</p>
            </div>
            <span class="sync-count" id="sc-legacy">0 registros</span>
          </div>
          <div class="sync-item">
            <span class="sync-dot ok"></span>
            <div>
              <strong>Clientes del Panel (BiciSaaS)</strong>
              <p class="text-muted" style="font-size:0.8rem;">Ingresados desde <code>/panel/crm</code></p>
            </div>
            <span class="sync-count" id="sc-panel">0 registros</span>
          </div>
          <div class="sync-item">
            <span class="sync-dot ok"></span>
            <div>
              <strong>Actividad Web (BehaviorTracker)</strong>
              <p class="text-muted" style="font-size:0.8rem;">Sesiones rastreadas en <code>tg_sessions</code></p>
            </div>
            <span class="sync-count" id="sc-sessions">0 sesiones</span>
          </div>
        </div>
        <button class="btn-primary" style="margin-top:1.5rem;" id="btn-full-sync">
          <Icon name="mdi:sync" width="18" height="18" /> Sincronizar Todo Ahora
        </button>
      </div>

      <div class="bento-card">
        <h3 style="margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
          <Icon name="mdi:link-variant" width="22" height="22" color="var(--accent-green)" /> Módulos Conectados & Pasarela
        </h3>
        <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
          <div class="module-link">
            <div>
              <strong>Inventario Maestro ↔ Sitio Web (POS)</strong>
              <p class="text-muted" style="font-size:0.8rem;">Ventas físicas o web descuentan stock en tiempo real y actualizan disponibilidad.</p>
            </div>
            <span class="status-pill pill-ok">Conectado</span>
          </div>
          <div class="module-link">
            <div>
              <strong>Pasarela MercadoPago (Sandbox / Live)</strong>
              <p class="text-muted" style="font-size:0.8rem;">Checkout activo con 3.5% de comisión online y envío gratis en compras mayores a $500.</p>
            </div>
            <span class="status-pill pill-ok">Listo</span>
          </div>
          <div class="module-link">
            <div>
              <strong>Auto-Sync Contabilidad</strong>
              <p class="text-muted" style="font-size:0.8rem;">Cada venta en POS o web genera un asiento contable automático en el Libro Diario.</p>
            </div>
            <span class="status-pill pill-ok">Activo</span>
          </div>
          <div class="module-link">
            <div>
              <strong>Generador de Fotos con IA</strong>
              <p class="text-muted" style="font-size:0.8rem;">Cloudflare Workers AI (Flux Schnell) activo para crear imágenes de producto de marketplace.</p>
            </div>
            <span class="status-pill pill-ok">Disponible</span>
          </div>
        </div>
