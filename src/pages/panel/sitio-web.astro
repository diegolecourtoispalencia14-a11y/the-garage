  // AI Generator
  document.getElementById('btn-generate-ai').addEventListener('click', async () => {
    const marca    = document.getElementById('bm-marca').value.trim() || 'The Garage';
    const modelo   = document.getElementById('bm-modelo').value.trim() || 'Bicicleta';
    const categoria= document.getElementById('bm-cat').value;
    const color    = document.getElementById('bm-color').value.trim() || 'negro';
    const estado   = document.getElementById('bm-estado').value;
    const styleEl  = document.querySelector('.style-opt.active input[type="radio"]');
    const stylePreset = styleEl ? styleEl.value : 'studio';

    const btn = document.getElementById('btn-generate-ai');
    const status = document.getElementById('ai-gen-status');
    const errEl  = document.getElementById('ai-gen-error');
    btn.style.opacity = '0.6'; btn.disabled = true;
    status.style.display = 'block'; errEl.style.display = 'none';

    try {
      const res = await fetch('/api/generate-product-image', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ marca, modelo, categoria, color, estado, stylePreset })
      });
      const data = await res.json();
      if (data.image) {
        setPreviewImage(data.image, true);
        if (data.sandbox) {
          errEl.style.color = 'var(--accent-orange)';
          errEl.textContent = 'ℹ ' + data.message;
          errEl.style.display = 'block';
        }
      } else {
        errEl.textContent = data.error || 'Error generando imagen.';
        errEl.style.display = 'block';
      }
    } catch(e) {
      errEl.textContent = 'Error conectando con el servicio de IA.';
      errEl.style.display = 'block';
    } finally {
      btn.style.opacity = '1'; btn.disabled = false;
      status.style.display = 'none';
    }
  });

