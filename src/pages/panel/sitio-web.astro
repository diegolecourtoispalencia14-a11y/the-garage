  /* ── Point of Sale (POS) Logic ── */
  let activePOSItem = null;

  window.openPOS = function(id) {
    const catalog = loadUnifiedCatalog();
    activePOSItem = catalog.find(p => p.sku === id || p.id == id);
    if (!activePOSItem) return;

    if (activePOSItem.stock <= 0) {
      if (!confirm(`El producto "${activePOSItem.name}" aparece como Agotado (stock: 0). ¿Deseas registrar la venta de todas formas?`)) {
        return;
      }
    }

    document.getElementById('pos-prod-name').textContent = activePOSItem.name;
    document.getElementById('pos-prod-stock').textContent = `${activePOSItem.stock} pz`;
    document.getElementById('pos-prod-price').textContent = fmt(activePOSItem.price);
    document.getElementById('pos-prod-webprice').textContent = fmt(activePOSItem.webPrice);

    document.getElementById('pos-qty').value = 1;
    document.getElementById('pos-qty').max = Math.max(1, activePOSItem.stock);

    // Populate Clients dropdown
    const clients = JSON.parse(localStorage.getItem(CRM_KEY) || '[]');
    const sel = document.getElementById('pos-client');
    sel.innerHTML = '<option value="">Cliente Mostrador (Público General)</option>';
    clients.forEach(c => {
      sel.innerHTML += `<option value="${c.id}">${c.name} (${c.phone})</option>`;
    });

    updatePOSTotal();
    document.getElementById('pos-modal').style.display = 'flex';
  };

  function updatePOSTotal() {
    if (!activePOSItem) return;
    const qty = parseInt(document.getElementById('pos-qty').value) || 1;
    const channel = document.getElementById('pos-channel').value;
    const unitPrice = channel === 'web' ? activePOSItem.webPrice : activePOSItem.price;
    const total = unitPrice * qty;
    document.getElementById('pos-total-display').textContent = fmt(total) + ' MXN';
  }

  document.getElementById('pos-qty').addEventListener('input', updatePOSTotal);
  document.getElementById('pos-channel').addEventListener('change', updatePOSTotal);

  document.getElementById('pos-confirm').addEventListener('click', () => {
    if (!activePOSItem) return;
    const qty = parseInt(document.getElementById('pos-qty').value) || 1;
    const channel = document.getElementById('pos-channel').value;
    const method = document.getElementById('pos-method').value;
    const clientId = document.getElementById('pos-client').value;

    const unitPrice = channel === 'web' ? activePOSItem.webPrice : activePOSItem.price;
    const totalSale = unitPrice * qty;
    const newStock = Math.max(0, activePOSItem.stock - qty);

    // 1. Update stock in inventory
    updateInventoryItem(activePOSItem.id || activePOSItem.sku, { stock: newStock });
    saveItemOverride(activePOSItem.sku || activePOSItem.id, {
      stock: newStock,
      disponibilidad: newStock === 0 ? 'Vendida' : 'Disponible'
    });

    // 2. Auto-record sale in Accounting (Libro Diario)
    try {
      const ledger = JSON.parse(localStorage.getItem(LEDGER_KEY) || '{"income":[],"expenses":[],"cobrar":[],"pagar":[]}');
      ledger.income.unshift({
        id: Date.now(),
        cat: activePOSItem.cat === 'Bicicletas' ? 'Venta de Bicicleta' : 'Venta de Accesorios / Refacciones',
        desc: `POS: ${qty}x ${activePOSItem.name} (${method})`,
        amount: totalSale,
        date: new Date().toISOString().slice(0, 10),
        channel: channel === 'web' ? 'Web' : 'Tienda Mostrador'
      });
      localStorage.setItem(LEDGER_KEY, JSON.stringify(ledger));
    } catch(e) {}

    // 3. If client selected, update CRM profile with this purchase
    if (clientId) {
      try {
        const clients = JSON.parse(localStorage.getItem(CRM_KEY) || '[]');
        const c = clients.find(x => x.id === clientId);
        if (c) {
          c.stage = 'comprador';
          c.score = Math.min(100, (c.score || 50) + 25);
          c.events = c.events || [];
          c.events.push({
            type: 'pos_purchase',
            label: `Compró ${qty}x ${activePOSItem.name} (${fmt(totalSale)})`,
            ts: new Date().toISOString()
          });
          localStorage.setItem(CRM_KEY, JSON.stringify(clients));
        }
      } catch(e) {}
    }

    document.getElementById('pos-modal').style.display = 'none';
    alert(`Venta Registrada Exitosamente.\n\n• Producto: ${qty}x ${activePOSItem.name}\n• Total cobrado: ${fmt(totalSale)} MXN\n• Forma de pago: ${method}\n• Nuevo stock: ${newStock} pz\n\nEl ingreso ya fue registrado en Contabilidad.`);
    renderCatalog();
  });

