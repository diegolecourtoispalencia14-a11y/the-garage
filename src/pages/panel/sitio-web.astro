  // Save Product
  document.getElementById('bm-save').addEventListener('click', () => {
    const modelo = document.getElementById('bm-modelo').value.trim();
    const marca  = document.getElementById('bm-marca').value.trim();
    const precio = parseFloat(document.getElementById('bm-precio').value) || 0;
    const stock  = parseInt(document.getElementById('bm-stock').value) || 0;
    const cat    = document.getElementById('bm-cat').value;

    if (!modelo) { alert('El nombre o modelo es obligatorio.'); return; }

    const id = editingId || (marca ? marca + '-' : '') + modelo.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '') + '-' + Date.now();
    const finalImage = currentImageDataUrl || document.getElementById('bm-img-url').value.trim() || null;

    const payload = {
      id,
      name: modelo,
      brand: marca,
      cat,
      price: precio,
      cost: Math.round(precio * 0.65),
      stock,
      min: 1,
      talla: document.getElementById('bm-talla').value,
      color: document.getElementById('bm-color').value,
      estado: document.getElementById('bm-estado').value,
      disponibilidad: stock > 0 ? document.getElementById('bm-disp').value : 'Vendida',
      publishedOnWeb: true,
      ...(finalImage ? { fotos: [finalImage] } : {})
    };

    // Save to master inventory
    let inventory = JSON.parse(localStorage.getItem(INV_KEY) || '[]');
    const idx = inventory.findIndex(p => p.id == id || p.sku == id);
    if (idx !== -1) {
      inventory[idx] = { ...inventory[idx], ...payload };
    } else {
      inventory.unshift(payload);
    }
    localStorage.setItem(INV_KEY, JSON.stringify(inventory));

    // Save to web override layer
    saveItemOverride(id, payload);

    document.getElementById('bike-modal').style.display = 'none';
    alert(`Producto "${modelo}" guardado exitosamente en Inventario y Catálogo Web.`);
    renderCatalog();
  });

