    document.getElementById('bm-cat').value    = item.cat || 'Bicicletas';
    document.getElementById('bm-precio').value = item.price || 0;
    document.getElementById('bm-stock').value  = item.stock !== undefined ? item.stock : 1;
    document.getElementById('bm-talla').value  = item.talla || '';
    document.getElementById('bm-disp').value   = item.disponibilidad || 'Disponible';
    document.getElementById('bm-estado').value = item.estado || 'Nueva';
