<style is:global>
  /* Zoho Section Tabs */
  .section-tabs {
    display: flex; gap: 0.25rem; margin-bottom: 1.25rem;
    background: var(--bg-surface); padding: 0.3rem;
    border-radius: var(--radius-md); width: fit-content;
    border: 1px solid var(--border-subtle);
  }
  .stab {
    padding: 0.5rem 1.25rem; border-radius: 8px; border: none;
    font-weight: 600; font-size: 0.88rem; cursor: pointer;
    background: transparent; color: var(--text-secondary); transition: all 0.2s;
  }
  .stab.active { background: var(--bg-base); color: var(--text-primary); box-shadow: var(--shadow-soft); }

  /* Zoho KPI Row */
  .zoho-kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .zoho-kpi-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex; flex-direction: column; gap: 0.25rem;
  }
  .zk-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); font-weight: 600; }
  .zk-value { font-size: 1.4rem; font-weight: 700; color: var(--text-primary); }
  .zk-value.blue  { color: var(--accent-blue); }
  .zk-value.green { color: var(--accent-green); }

  /* Zoho Filters Bar */
  .zoho-filter-bar {
    display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }
  .zoho-search-wrap {
    flex: 1; min-width: 220px; position: relative; display: flex; align-items: center;
    background: var(--bg-base); border: 1px solid var(--border-subtle);
    border-radius: 8px; padding: 0.45rem 0.75rem; gap: 0.5rem;
  }
  .zoho-search-wrap input {
    border: none; background: transparent; outline: none; color: var(--text-primary);
    font-size: 0.88rem; width: 100%;
  }
  .zoho-select {
    padding: 0.5rem 0.85rem; border-radius: 8px;
    border: 1px solid var(--border-subtle); background: var(--bg-base);
    color: var(--text-primary); font-size: 0.85rem; outline: none; font-weight: 500;
  }

  /* ══════════════════ SHOPIFY-STYLE CATALOG & POS REDESIGN ══════════════════ */
  .catalog-family-tabs {
    display: flex; gap: 0.5rem; margin-bottom: 1.25rem; overflow-x: auto; padding-bottom: 0.35rem;
    scrollbar-width: thin;
  }
  .cft-tab {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.95rem;
    background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 100px;
    font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); cursor: pointer;
    white-space: nowrap; transition: all 0.2s ease;
  }
  .cft-tab:hover {
    border-color: var(--accent-blue); color: var(--text-primary);
  }
  .cft-tab.active {
    background: var(--accent-blue); color: #ffffff; border-color: var(--accent-blue);
    box-shadow: 0 4px 12px rgba(0, 113, 227, 0.25);
  }
  .cft-count {
    background: rgba(0,0,0,0.08); padding: 0.1rem 0.45rem; border-radius: 100px;
    font-size: 0.72rem; font-weight: 700;
  }
  .cft-tab.active .cft-count {
    background: rgba(255,255,255,0.25); color: #ffffff;
  }

  /* Toolbar */
  .catalog-toolbar {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    flex-wrap: wrap; margin-bottom: 1.25rem;
  }
  .toolbar-left {
    display: flex; align-items: center; gap: 0.75rem; flex: 1; flex-wrap: wrap;
  }
  .toolbar-right {
    display: flex; align-items: center; gap: 0.75rem;
  }
  .view-mode-toggle {
    display: inline-flex; background: var(--bg-base); padding: 3px; border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }
  .vmt-btn {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem;
    border-radius: 8px; border: none; background: transparent; font-size: 0.8rem;
    font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.15s ease;
  }
  .vmt-btn.active {
    background: var(--bg-surface); color: var(--text-primary);
    box-shadow: 0 2px 6px rgba(0,0,0,0.08); font-weight: 700;
  }

  /* Shopify Table View */
  .catalog-table-wrap {
    background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    overflow-x: auto; box-shadow: var(--shadow-soft);
  }
  .shopify-table {
    width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;
  }
  .shopify-table thead {
    background: var(--bg-base); border-bottom: 1px solid var(--border-subtle);
  }
  .shopify-table th {
    padding: 0.85rem 1rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--text-secondary); white-space: nowrap;
  }
  .shopify-table tbody tr {
    border-bottom: 1px solid var(--border-subtle); transition: background-color 0.15s ease;
    cursor: pointer;
  }
  .shopify-table tbody tr:hover {
