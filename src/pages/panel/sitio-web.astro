    document.getElementById('drw-btn-pos').onclick = () => {
      window.closeProductDrawer();
      window.openPOS(item.sku || item.id);
    };

    document.getElementById('drw-btn-edit').onclick = () => {
      window.closeProductDrawer();
      window.editProduct(item.sku || item.id);
    };

    const overlay = document.getElementById('product-drawer-overlay');
    if (overlay) overlay.style.display = 'flex';
  };

  window.closeProductDrawer = function() {
    const overlay = document.getElementById('product-drawer-overlay');
    if (overlay) overlay.style.display = 'none';
    activeDrawerItem = null;
  };

  window.quickAdjustStock = function(id, delta) {
    const catalog = loadUnifiedCatalog();
    const item = catalog.find(p => p.sku === id || p.id == id);
    if (!item) return;
    const newStock = Math.max(0, (item.stock || 0) + delta);
    updateInventoryItem(item.id || item.sku, { stock: newStock });
    saveItemOverride(item.sku || item.id, {
      stock: newStock,
      disponibilidad: newStock === 0 ? 'Vendida' : 'Disponible'
    });
    renderCatalog();
    window.openProductDrawer(id);
  };

  /* ── Bulk Actions Logic ── */
  window.toggleSelectProduct = function(id, e) {
    e.stopPropagation();
    if (selectedProductIds.has(id)) {
      selectedProductIds.delete(id);
    } else {
      selectedProductIds.add(id);
    }
    updateBulkBar();
  };

  window.toggleSelectAllVisible = function(e) {
    const isChecked = e.target.checked;
    const checkboxes = document.querySelectorAll('.st-item-checkbox');
    checkboxes.forEach(cb => {
      cb.checked = isChecked;
      const id = cb.getAttribute('data-id');
      if (isChecked) selectedProductIds.add(id);
      else selectedProductIds.delete(id);
