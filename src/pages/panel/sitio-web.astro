    if (pubKeyEl) pubKeyEl.value = cfg.mpPublicKey || '';
    if (tokenEl)  tokenEl.value  = cfg.mpAccessToken || '';
    if (linkEl)   linkEl.value   = cfg.mpPaymentLink || '';
    if (clabeEl)  clabeEl.value  = cfg.speiClabe || '646690146012345678';
    if (bankEl)   bankEl.value   = cfg.speiBank || 'STP / BBVA México';
    if (benEl)    benEl.value    = cfg.speiBeneficiary || 'The Garage Bike Experts';
    if (feeEl)    feeEl.value    = cfg.onlineFeePercent !== undefined ? cfg.onlineFeePercent : 3.5;
    if (shipEl)   shipEl.value   = cfg.freeShippingThreshold !== undefined ? cfg.freeShippingThreshold : 500;

    const badgeEl = document.getElementById('gateway-status-badge');
    const dotEl = document.getElementById('gateway-status-dot');
    const labelEl = document.getElementById('gateway-mode-label');
    const toggleBtnText = document.getElementById('btn-toggle-gateway-text');
    const alertBox = document.getElementById('gateway-mode-alert');
    const alertTitle = document.getElementById('gateway-alert-title');
    const alertDesc = document.getElementById('gateway-alert-desc');

    if (isLive) {
      if (badgeEl) {
        badgeEl.style.background = 'rgba(52,199,89,0.12)';
        badgeEl.style.color = '#34c759';
        badgeEl.style.borderColor = 'rgba(52,199,89,0.25)';
      }
      if (dotEl) {
        dotEl.style.background = '#34c759';
        dotEl.style.boxShadow = '0 0 8px #34c759';
      }
      if (labelEl) labelEl.textContent = 'Modo Producción (Cobros Reales)';
      if (toggleBtnText) toggleBtnText.textContent = 'Cambiar a Modo Sandbox';
      if (alertBox) {
        alertBox.style.background = 'rgba(52,199,89,0.08)';
        alertBox.style.borderColor = 'rgba(52,199,89,0.25)';
        alertBox.style.color = '#34c759';
      }
      if (alertTitle) {
        alertTitle.textContent = 'Modo Producción Activo · Cobros Reales Habilitados';
        alertTitle.style.color = '#34c759';
      }
      if (alertDesc) {
        alertDesc.innerHTML = 'El checkout está cobrando de forma real con tarjeta, SPEI y Mercado Pago. Los recibos de éxito se generan con el sello oficial <strong>"Transacción Oficial en Vivo (Producción)"</strong>.';
      }
    } else {
      if (badgeEl) {
        badgeEl.style.background = 'rgba(255,149,0,0.12)';
        badgeEl.style.color = '#ff9500';
        badgeEl.style.borderColor = 'rgba(255,149,0,0.25)';
      }
      if (dotEl) {
        dotEl.style.background = '#ff9500';
        dotEl.style.boxShadow = '0 0 8px #ff9500';
      }
      if (labelEl) labelEl.textContent = 'Modo Sandbox (Pruebas)';
      if (toggleBtnText) toggleBtnText.textContent = 'Cambiar a Modo Producción';
      if (alertBox) {
        alertBox.style.background = 'rgba(255,149,0,0.08)';
        alertBox.style.borderColor = 'rgba(255,149,0,0.25)';
        alertBox.style.color = '#ff9500';
      }
      if (alertTitle) {
        alertTitle.textContent = 'Actualmente en Modo Sandbox (Pruebas)';
        alertTitle.style.color = '#f5f5f7';
      }
      if (alertDesc) {
        alertDesc.innerHTML = 'El checkout simula compras aprobadas sin tocar dinero real. Los comprobantes dicen <em>"Modo de Prueba (Sandbox) — No se realizó un cobro real"</em>. Haz clic en "Cambiar a Modo Producción" para habilitar cobros reales.';
      }
    }
  }

  // Toggle mode button listener
  document.getElementById('btn-toggle-gateway-mode')?.addEventListener('click', () => {
    const cfg = getPaymentConfig();
    cfg.mode = cfg.mode === 'production' ? 'sandbox' : 'production';
    savePaymentConfig(cfg);
    renderPaymentGatewayUI();
    const modeName = cfg.mode === 'production' ? 'PRODUCCIÓN (Cobros Reales)' : 'SANDBOX (Pruebas)';
    alert(`Modo de Pasarela actualizado a: ${modeName}.\n\nEl checkout del sitio web ahora opera en ${modeName}.`);
  });

  // Save gateway settings listener
  document.getElementById('btn-save-gateway')?.addEventListener('click', () => {
    const cfg = getPaymentConfig();
    const pubKeyEl = document.getElementById('cfg-mp-public-key');
    const tokenEl  = document.getElementById('cfg-mp-access-token');
    const linkEl   = document.getElementById('cfg-mp-payment-link');
    const clabeEl  = document.getElementById('cfg-spei-clabe');
    const bankEl   = document.getElementById('cfg-spei-bank');
    const benEl    = document.getElementById('cfg-spei-beneficiary');
    const feeEl    = document.getElementById('cfg-fee-percent');
    const shipEl   = document.getElementById('cfg-free-shipping');

    cfg.mpPublicKey = pubKeyEl && 'value' in pubKeyEl ? pubKeyEl.value.trim() : '';
    cfg.mpAccessToken = tokenEl && 'value' in tokenEl ? tokenEl.value.trim() : '';
    cfg.mpPaymentLink = linkEl && 'value' in linkEl ? linkEl.value.trim() : '';
    cfg.speiClabe = clabeEl && 'value' in clabeEl ? clabeEl.value.trim() : '646690146012345678';
    cfg.speiBank = bankEl && 'value' in bankEl ? bankEl.value.trim() : 'STP / BBVA México';
    cfg.speiBeneficiary = benEl && 'value' in benEl ? benEl.value.trim() : 'The Garage Bike Experts';
    cfg.onlineFeePercent = feeEl && 'value' in feeEl ? (parseFloat(feeEl.value) || 3.5) : 3.5;
    cfg.freeShippingThreshold = shipEl && 'value' in shipEl ? (parseFloat(shipEl.value) || 500) : 500;

    savePaymentConfig(cfg);
    renderPaymentGatewayUI();

    const msg = document.getElementById('gateway-save-msg');
    if (msg) {
      msg.style.display = 'inline';
      setTimeout(() => { msg.style.display = 'none'; }, 3000);
    }
    alert('Configuración de pasarela de pagos guardada con éxito.');
  });

  // ─── Firebase Cloud Sync UI Logic ───
  function getFirebaseConfigLocal() {
    try {
      const raw = localStorage.getItem('bicisaas_firebase_config');
      if (raw) return JSON.parse(raw);
    } catch(e) {}
    return {
      apiKey: '',
      authDomain: '',
      projectId: '',
      storageBucket: '',
      messagingSenderId: '',
      appId: ''
    };
  }

  function renderFirebaseUI() {
    const cfg = getFirebaseConfigLocal();
    const pidEl = document.getElementById('cfg-fb-project-id');
    const keyEl = document.getElementById('cfg-fb-api-key');
    const domEl = document.getElementById('cfg-fb-auth-domain');
    const bktEl = document.getElementById('cfg-fb-storage-bucket');
    const sndEl = document.getElementById('cfg-fb-sender-id');
    const appEl = document.getElementById('cfg-fb-app-id');

    if (pidEl) pidEl.value = cfg.projectId || '';
    if (keyEl) keyEl.value = cfg.apiKey || '';
    if (domEl) domEl.value = cfg.authDomain || '';
    if (bktEl) bktEl.value = cfg.storageBucket || '';
    if (sndEl) sndEl.value = cfg.messagingSenderId || '';
    if (appEl) appEl.value = cfg.appId || '';

    const badge = document.getElementById('fb-status-badge');
    const hasConfig = Boolean(cfg.apiKey && cfg.projectId);
    if (badge) {
      if (hasConfig) {
        badge.style.background = 'rgba(52,199,89,0.12)';
        badge.style.color = '#34c759';
        badge.style.borderColor = 'rgba(52,199,89,0.25)';
        badge.textContent = 'Google Cloud Activo · ' + (cfg.projectId || 'Vinculado');
      } else {
        badge.style.background = 'rgba(255,149,0,0.12)';
        badge.style.color = '#ff9500';
        badge.style.borderColor = 'rgba(255,149,0,0.25)';
        badge.textContent = 'Modo Local-First (Caché Local Activa)';
      }
    }

    try {
      const metaRaw = localStorage.getItem('bicisaas_cloud_sync_meta');
      if (metaRaw) {
        const meta = JSON.parse(metaRaw);
        const countEl = document.getElementById('fb-seed-count');
        const barEl = document.getElementById('fb-seed-bar');
        const msgEl = document.getElementById('fb-seed-msg');
        if (countEl && meta.count) countEl.textContent = `${meta.count} Productos Sincronizados`;
        if (barEl && meta.count) barEl.style.width = '100%';
        if (msgEl && meta.lastSyncTime) {
          const d = new Date(meta.lastSyncTime);
          msgEl.textContent = `Última sincronización: ${d.toLocaleDateString()} a las ${d.toLocaleTimeString().slice(0,5)}`;
        }
      }
    } catch(e) {}
  }

  document.getElementById('btn-save-firebase')?.addEventListener('click', () => {
    const pidEl = document.getElementById('cfg-fb-project-id');
    const keyEl = document.getElementById('cfg-fb-api-key');
    const domEl = document.getElementById('cfg-fb-auth-domain');
    const bktEl = document.getElementById('cfg-fb-storage-bucket');
    const sndEl = document.getElementById('cfg-fb-sender-id');
    const appEl = document.getElementById('cfg-fb-app-id');

    const cfg = {
      projectId: pidEl && 'value' in pidEl ? pidEl.value.trim() : '',
      apiKey: keyEl && 'value' in keyEl ? keyEl.value.trim() : '',
      authDomain: domEl && 'value' in domEl ? domEl.value.trim() : '',
      storageBucket: bktEl && 'value' in bktEl ? bktEl.value.trim() : '',
      messagingSenderId: sndEl && 'value' in sndEl ? sndEl.value.trim() : '',
      appId: appEl && 'value' in appEl ? appEl.value.trim() : ''
    };

    localStorage.setItem('bicisaas_firebase_config', JSON.stringify(cfg));
    renderFirebaseUI();

    const feedback = document.getElementById('fb-save-feedback');
    if (feedback) {
      feedback.style.display = 'inline';
      setTimeout(() => { feedback.style.display = 'none'; }, 3500);
    }
    alert('Credenciales de Firebase guardadas con éxito.\n\nProyecto: ' + (cfg.projectId || 'Modo Local'));
  });

  async function handleTestFirebase() {
    const cfg = getFirebaseConfigLocal();
    if (!cfg.apiKey || !cfg.projectId) {
      alert('Ingresa al menos el Project ID y el API Key de tu consola de Firebase para probar la conexión con Google Cloud.');
      return;
    }

    try {
      const { testFirebaseConnection } = await import('../../lib/firebase');
      const res = await testFirebaseConnection();
      if (res.success) {
        alert(res.message);
        renderFirebaseUI();
      } else {
        alert(res.message);
      }
    } catch(err) {
      const msg = err && err.message ? err.message : err;
      alert('Error probando conexión: ' + msg);
    }
  }

  document.getElementById('btn-test-firebase')?.addEventListener('click', handleTestFirebase);
  document.getElementById('btn-test-firebase-top')?.addEventListener('click', handleTestFirebase);

  document.getElementById('btn-seed-firebase')?.addEventListener('click', async () => {
    const cfg = getFirebaseConfigLocal();
    if (!cfg.apiKey || !cfg.projectId) {
      alert('Antes de sincronizar el catálogo con la nube, debes ingresar las credenciales de tu proyecto de Firebase en el formulario.');
      return;
    }

    const btn = document.getElementById('btn-seed-firebase');
    const bar = document.getElementById('fb-seed-bar');
    const countEl = document.getElementById('fb-seed-count');
    const msgEl = document.getElementById('fb-seed-msg');

    if (btn) btn.disabled = true;
    if (msgEl) msgEl.textContent = '⏳ Sincronizando catálogo maestro con Google Cloud Firestore...';

    try {
      const { seedMasterCatalogToCloud } = await import('../../services/cloudSyncService');
      const res = await seedMasterCatalogToCloud((curr, tot) => {
        const pct = Math.round((curr / tot) * 100);
        if (bar) bar.style.width = pct + '%';
        if (countEl) countEl.textContent = `${curr} / ${tot} Productos`;
      });

      if (res.success) {
        if (bar) bar.style.width = '100%';
        if (msgEl) msgEl.textContent = `${res.total} productos del inventario físico respaldados en Firestore.`;
        alert(res.message);
        renderFirebaseUI();
      } else {
        alert(res.message);
        if (msgEl) msgEl.textContent = res.message;
      }
    } catch (err) {
      const msg = err && err.message ? err.message : err;
      alert('Error en la migración: ' + msg);
      if (msgEl) msgEl.textContent = 'Error: ' + msg;
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  // ─── Initial Execution ───
  renderCatalog();
  renderPaymentGatewayUI();
  renderFirebaseUI();
  updateGooglePreview();
  updateQRCode();
})();
</script>
