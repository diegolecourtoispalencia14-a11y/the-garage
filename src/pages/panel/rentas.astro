---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { Icon } from 'astro-icon/components';
import { INITIAL_RENTAL_FLEET, INITIAL_RENTAL_CONTRACTS } from '../../data/rentalFleet';

const initialFleetJson = JSON.stringify(INITIAL_RENTAL_FLEET);
const initialContractsJson = JSON.stringify(INITIAL_RENTAL_CONTRACTS);
---

<PanelLayout title="Flota & Rentas de Bicicletas | BiciSaaS">
  <!-- Top Breadcrumb & Header -->
  <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem;">
    <div>
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem;">
        <span style="background:rgba(0,113,227,0.12); color:var(--accent-blue); font-size:0.75rem; font-weight:700; padding:0.2rem 0.65rem; border-radius:100px; display:inline-flex; align-items:center; gap:0.35rem;">
          <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-blue);"></span> Flota en Alquiler & Horómetros
        </span>
        <span style="font-size:0.8rem; color:var(--text-secondary);">The Garage · Playa del Carmen & Riviera Maya</span>
      </div>
      <h1 style="font-size:1.75rem; font-weight:700; color:var(--text-primary); letter-spacing:-0.02em; margin:0 0 0.25rem;">
        Gestión de Flota & Rentas.
      </h1>
      <p style="color:var(--text-secondary); font-size:0.9rem; margin:0;">
        Control de unidades de alquiler, contratos digitales, custodia de depósitos y mantenimiento predictivo por horas de rodado.
      </p>
    </div>

    <!-- Header Actions -->
    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
      <a href="/renta" target="_blank" class="btn-secondary" style="font-size:0.85rem; text-decoration:none;">
        <Icon name="mdi:open-in-new" width="16" height="16" /> Ver Catálogo Público ↗
      </a>
      <button class="btn-primary" id="btn-open-new-rental" style="font-size:0.88rem; padding:0.55rem 1.1rem; border-radius:10px;">
        <Icon name="mdi:plus" width="18" height="18" /> Nueva Salida / Renta
      </button>
    </div>
  </div>

  <!-- KPI Metrics Row -->
  <div class="kpi-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
    <div class="kpi-card bento-card" style="padding:1rem 1.25rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--text-secondary);">Total Flota</span>
        <Icon name="mdi:bicycle" width="18" height="18" style="color:var(--text-secondary);" />
      </div>
      <div id="kpi-total-fleet" style="font-size:1.6rem; font-weight:700; color:var(--text-primary);">8</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Unidades registradas</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-blue);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-blue);">En Renta Activa</span>
        <Icon name="mdi:bike-fast" width="18" height="18" style="color:var(--accent-blue);" />
      </div>
      <div id="kpi-active-rentals" style="font-size:1.6rem; font-weight:700; color:var(--accent-blue);">0</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">En calle / turista</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-green);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-green);">Disponibles</span>
        <Icon name="mdi:check-circle-outline" width="18" height="18" style="color:var(--accent-green);" />
      </div>
      <div id="kpi-available-fleet" style="font-size:1.6rem; font-weight:700; color:var(--accent-green);">8</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Listas para entrega</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-red);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-red);">En Taller / Alerta</span>
        <Icon name="mdi:wrench-clock" width="18" height="18" style="color:var(--accent-red);" />
      </div>
      <div id="kpi-maintenance-fleet" style="font-size:1.6rem; font-weight:700; color:var(--accent-red);">0</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Límite de horas alcanzado</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem; border-left:3px solid var(--accent-orange);">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--accent-orange);">Depósitos en Custodia</span>
        <Icon name="mdi:shield-lock-outline" width="18" height="18" style="color:var(--accent-orange);" />
      </div>
      <div id="kpi-held-deposits" style="font-size:1.6rem; font-weight:700; color:var(--accent-orange);">$0</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Garantías activas retenidas</div>
    </div>

    <div class="kpi-card bento-card" style="padding:1rem 1.25rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem;">
        <span style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:var(--text-secondary);">Horas Rodadas Flota</span>
        <Icon name="mdi:timer-outline" width="18" height="18" style="color:var(--text-secondary);" />
      </div>
      <div id="kpi-total-hours" style="font-size:1.6rem; font-weight:700; color:var(--text-primary);">0 hrs</div>
      <div style="font-size:0.75rem; color:var(--text-secondary);">Historial acumulado</div>
    </div>
  </div>

  <!-- Navigation View Tabs -->
  <div style="display:flex; gap:0.5rem; border-bottom:1px solid var(--border-subtle); margin-bottom:1.5rem; overflow-x:auto;">
    <button class="view-tab active" data-tab="tab-fleet" style="padding:0.65rem 1.2rem; background:none; border:none; border-bottom:2px solid var(--accent-blue); color:var(--accent-blue); font-weight:600; font-size:0.9rem; cursor:pointer; display:flex; align-items:center; gap:0.4rem; white-space:nowrap;">
      <Icon name="mdi:bicycle" width="18" height="18" />
      <span>Flota & Horómetros</span>
      <span id="tab-fleet-badge" style="background:var(--bg-surface-hover); padding:0.15rem 0.45rem; border-radius:100px; font-size:0.75rem; color:var(--text-primary);">8</span>
    </button>
    <button class="view-tab" data-tab="tab-public-web" style="padding:0.65rem 1.2rem; background:none; border:none; border-bottom:2px solid transparent; color:var(--text-secondary); font-weight:600; font-size:0.9rem; cursor:pointer; display:flex; align-items:center; gap:0.4rem; white-space:nowrap;">
      <Icon name="mdi:web" width="18" height="18" />
      <span>Catálogo Web Público (/renta)</span>
      <span id="tab-web-badge" style="background:rgba(0,113,227,0.12); color:var(--accent-blue); padding:0.15rem 0.45rem; border-radius:100px; font-size:0.75rem; font-weight:700;">8 en Línea</span>
    </button>
    <button class="view-tab" data-tab="tab-contracts" style="padding:0.65rem 1.2rem; background:none; border:none; border-bottom:2px solid transparent; color:var(--text-secondary); font-weight:600; font-size:0.9rem; cursor:pointer; display:flex; align-items:center; gap:0.4rem; white-space:nowrap;">
      <Icon name="mdi:file-document-outline" width="18" height="18" />
      <span>Contratos & Salidas</span>
      <span id="tab-contracts-badge" style="background:var(--bg-surface-hover); padding:0.15rem 0.45rem; border-radius:100px; font-size:0.75rem; color:var(--text-secondary);">2</span>
    </button>
    <button class="view-tab" data-tab="tab-maintenance" style="padding:0.65rem 1.2rem; background:none; border:none; border-bottom:2px solid transparent; color:var(--text-secondary); font-weight:600; font-size:0.9rem; cursor:pointer; display:flex; align-items:center; gap:0.4rem; white-space:nowrap;">
      <Icon name="mdi:wrench-outline" width="18" height="18" />
      <span>Telemetría & Mantenimiento Preventivo</span>
      <span id="tab-maint-badge" style="background:rgba(255,59,48,0.15); color:var(--accent-red); padding:0.15rem 0.45rem; border-radius:100px; font-size:0.75rem; font-weight:700;">1</span>
    </button>
  </div>

  <!-- TAB 1: FLOTA & HORÓMETROS -->
  <section id="tab-fleet" class="tab-pane active">
    <!-- Filter bar -->
    <div class="bento-card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding:0.85rem 1.25rem; margin-bottom:1.25rem;">
      <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
        <span style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">Filtrar por:</span>
        <button class="filter-pill active" data-category="all" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--accent-blue); background:var(--accent-blue); color:#fff; font-size:0.8rem; font-weight:600; cursor:pointer;">Todas</button>
        <button class="filter-pill" data-category="MTB" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">MTB</button>
        <button class="filter-pill" data-category="Gravel" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">Gravel</button>
        <button class="filter-pill" data-category="Ruta" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">Ruta</button>
        <button class="filter-pill" data-category="Urbana" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">Cruisers</button>
        <button class="filter-pill" data-category="E-Bike" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">E-Bikes</button>
      </div>

      <div style="display:flex; gap:0.5rem; align-items:center;">
        <select id="status-filter" style="padding:0.4rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-panel); color:var(--text-primary); font-size:0.82rem;">
          <option value="all">Todos los Estados</option>
          <option value="disponible">Solo Disponibles</option>
          <option value="en_renta">Solo en Renta</option>
          <option value="en_taller">En Taller / Mantenimiento</option>
        </select>
      </div>
    </div>

    <!-- Bikes Grid Container -->
    <div id="fleet-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1.25rem;">
      <!-- Populated via JavaScript -->
    </div>
  </section>

  <!-- TAB WEB: CATÁLOGO WEB PÚBLICO (/renta) -->
  <section id="tab-public-web" class="tab-pane" style="display:none;">
    <!-- Public Web Hero Header -->
    <div class="bento-card" style="padding:1.25rem 1.5rem; margin-bottom:1.25rem; background:linear-gradient(135deg, rgba(0,113,227,0.06) 0%, rgba(52,199,89,0.04) 100%); border:1px solid rgba(0,113,227,0.2);">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
        <div>
          <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem;">
            <span style="background:rgba(0,113,227,0.15); color:var(--accent-blue); font-size:0.75rem; font-weight:700; padding:0.2rem 0.6rem; border-radius:100px; display:inline-flex; align-items:center; gap:0.35rem;">
              <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-blue);"></span> Escaparate Oficial /renta
            </span>
            <span style="font-size:0.8rem; color:var(--text-secondary);">Sincronización en Tiempo Real</span>
          </div>
          <h2 style="font-size:1.35rem; font-weight:700; color:var(--text-primary); margin:0 0 0.25rem;">
            Catálogo Web Público de Renta (/renta)
          </h2>
          <p style="font-size:0.85rem; color:var(--text-secondary); margin:0; max-width:750px;">
            Gestiona qué bicicletas ve el cliente en la página web pública, modifica las tarifas por temporalidad (1 día, 3 días fin de semana, semana completa), ajusta los depósitos en garantía y edita las fichas comerciales.
          </p>
        </div>

        <div style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
          <a href="/renta" target="_blank" class="btn-primary" style="font-size:0.85rem; text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem; padding:0.55rem 1rem;">
            <Icon name="mdi:open-in-new" width="16" height="16" /> Ver Página en Vivo ↗
          </a>
          <button type="button" class="btn-secondary" id="btn-batch-publish-all" style="font-size:0.82rem; padding:0.55rem 0.85rem;">
            <Icon name="mdi:eye-check-outline" width="16" height="16" /> Publicar Todas
          </button>
        </div>
      </div>

      <!-- Quick Web KPIs Strip -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0.85rem; margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border-subtle);">
        <div style="background:var(--bg-base); padding:0.75rem 1rem; border-radius:10px; border:1px solid var(--border-subtle);">
          <div style="font-size:0.72rem; color:var(--text-secondary); text-transform:uppercase; font-weight:600;">En Línea en /renta</div>
          <div id="web-kpi-published" style="font-size:1.35rem; font-weight:700; color:var(--accent-blue);">8</div>
          <div style="font-size:0.72rem; color:var(--accent-green);">Visibles para turistas</div>
        </div>
        <div style="background:var(--bg-base); padding:0.75rem 1rem; border-radius:10px; border:1px solid var(--border-subtle);">
          <div style="font-size:0.72rem; color:var(--text-secondary); text-transform:uppercase; font-weight:600;">Ocultas del Sitio</div>
          <div id="web-kpi-hidden" style="font-size:1.35rem; font-weight:700; color:var(--text-secondary);">0</div>
          <div style="font-size:0.72rem; color:var(--text-secondary);">Solo mostrador físico</div>
        </div>
        <div style="background:var(--bg-base); padding:0.75rem 1rem; border-radius:10px; border:1px solid var(--border-subtle);">
          <div style="font-size:0.72rem; color:var(--text-secondary); text-transform:uppercase; font-weight:600;">Tarifa Promedio Día</div>
          <div id="web-kpi-avg-rate" style="font-size:1.35rem; font-weight:700; color:var(--text-primary);">$513 MXN</div>
          <div style="font-size:0.72rem; color:var(--text-secondary);">Por cada 24 horas</div>
        </div>
        <div style="background:var(--bg-base); padding:0.75rem 1rem; border-radius:10px; border:1px solid var(--border-subtle);">
          <div style="font-size:0.72rem; color:var(--text-secondary); text-transform:uppercase; font-weight:600;">Depósito Promedio</div>
          <div id="web-kpi-avg-deposit" style="font-size:1.35rem; font-weight:700; color:var(--accent-orange);">$1,313 MXN</div>
          <div style="font-size:0.72rem; color:var(--text-secondary);">Garantía reembolsable</div>
        </div>
      </div>
    </div>

    <!-- Web Filter Toolbar -->
    <div class="bento-card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding:0.85rem 1.25rem; margin-bottom:1.25rem;">
      <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; flex:1; min-width:280px;">
        <input type="text" id="web-search-input" placeholder="Buscar unidad por modelo, marca o ID..." style="padding:0.45rem 0.85rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem; flex:1; max-width:320px;" />
        <div style="display:flex; gap:0.35rem; align-items:center; flex-wrap:wrap;">
          <button class="web-filter-pill active" data-web-cat="all" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--accent-blue); background:var(--accent-blue); color:#fff; font-size:0.8rem; font-weight:600; cursor:pointer;">Todas</button>
          <button class="web-filter-pill" data-web-cat="MTB" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">MTB</button>
          <button class="web-filter-pill" data-web-cat="Gravel" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">Gravel</button>
          <button class="web-filter-pill" data-web-cat="Ruta" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">Ruta</button>
          <button class="web-filter-pill" data-web-cat="Urbana" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">Cruisers</button>
          <button class="web-filter-pill" data-web-cat="E-Bike" style="padding:0.35rem 0.75rem; border-radius:100px; border:1px solid var(--border-subtle); background:transparent; color:var(--text-secondary); font-size:0.8rem; font-weight:600; cursor:pointer;">E-Bikes</button>
        </div>
      </div>

      <div style="display:flex; gap:0.5rem; align-items:center;">
        <select id="web-status-filter" style="padding:0.4rem 0.75rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-panel); color:var(--text-primary); font-size:0.82rem;">
          <option value="all">Todas las Unidades</option>
          <option value="published">Solo Publicadas en Web</option>
          <option value="hidden">Solo Ocultas en Web</option>
        </select>
      </div>
    </div>

    <!-- Public Web Grid -->
    <div id="public-web-fleet-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(350px, 1fr)); gap:1.25rem;">
      <!-- Populated via JavaScript -->
    </div>
  </section>

  <!-- TAB 2: CONTRATOS & SALIDAS -->
  <section id="tab-contracts" class="tab-pane" style="display:none;">
    <div class="bento-card" style="padding:1.25rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:1rem;">
        <div>
          <h2 style="font-size:1.15rem; font-weight:700; color:var(--text-primary); margin:0 0 0.25rem;">Contratos Digitales de Renta</h2>
          <p style="font-size:0.82rem; color:var(--text-secondary); margin:0;">Registro de salidas, folios, cobros y estatus de depósitos en garantía.</p>
        </div>
        <div style="display:flex; gap:0.5rem;">
          <input type="text" id="search-contracts" placeholder="Buscar folio, cliente o teléfono..." style="padding:0.45rem 0.85rem; border-radius:8px; border:1px solid var(--border-color); background:var(--bg-base); color:var(--text-primary); font-size:0.85rem; min-width:260px;" />
        </div>
      </div>

      <!-- Contracts Table -->
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:0.88rem; text-align:left;">
          <thead>
            <tr style="border-bottom:1px solid var(--border-color); color:var(--text-secondary); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em;">
              <th style="padding:0.75rem 0.5rem;">Folio</th>
              <th style="padding:0.75rem 0.5rem;">Cliente</th>
              <th style="padding:0.75rem 0.5rem;">Bicicleta Asignada</th>
              <th style="padding:0.75rem 0.5rem;">Modalidad</th>
              <th style="padding:0.75rem 0.5rem;">Vigencia</th>
              <th style="padding:0.75rem 0.5rem;">Total Renta</th>
              <th style="padding:0.75rem 0.5rem;">Depósito</th>
              <th style="padding:0.75rem 0.5rem;">Estado</th>
              <th style="padding:0.75rem 0.5rem; text-align:right;">Acciones</th>
            </tr>
          </thead>
          <tbody id="contracts-table-body">
            <!-- Populated via JavaScript -->
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- TAB 3: TELEMETRÍA & MANTENIMIENTO PREVENTIVO -->
  <section id="tab-maintenance" class="tab-pane" style="display:none;">
    <!-- Alert banner about coastal environment -->
    <div style="background:rgba(255,149,0,0.1); border:1px solid rgba(255,149,0,0.3); border-radius:12px; padding:1rem 1.25rem; margin-bottom:1.5rem; display:flex; gap:0.75rem; align-items:flex-start;">
      <Icon name="mdi:weather-partly-cloudy" width="24" height="24" style="color:var(--accent-orange); flex-shrink:0; margin-top:2px;" />
      <div>
        <div style="font-weight:700; color:var(--text-primary); font-size:0.92rem; margin-bottom:0.25rem;">
          Protocolo de Salinidad & Desgaste Costero (Riviera Maya)
        </div>
        <p style="font-size:0.83rem; color:var(--text-secondary); margin:0; line-height:1.45;">
