---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { INITIAL_RENTAL_FLEET } from '../data/rentalFleet';

const rentalFleetJson = JSON.stringify(INITIAL_RENTAL_FLEET);
---

<Base 
  title="Renta de Bicicletas en Playa del Carmen | The Garage Bike Experts" 
  description="Renta de bicicletas de montaña (MTB), gravel, ruta, cruisers y e-bikes en Playa del Carmen. Entrega en tu hotel o Airbnb, casco y candado incluidos."
>
  <!-- Hero Section -->
  <section class="rental-hero">
    <div class="hero-backdrop"></div>
    <div class="container hero-content">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>Flota Oficial · Playa del Carmen & Riviera Maya</span>
      </div>
      
      <h1 class="hero-title">
        Renta Bicicletas <span class="gradient-text">Calibradas por Mecánicos</span> para el Caribe
      </h1>
      
      <p class="hero-subtitle">
        Desde paseos relajados por la 5ta Avenida y Playacar, hasta rodadas de fondo hacia Tulum o senderos de cenotes. 
        Bicicletas impecables, lubricadas contra salitre y con entrega en tu hotel o Airbnb.
      </p>

      <!-- Included Perks Pill Bar -->
      <div class="perks-row">
        <div class="perk-item">
          <Icon name="mdi:shield-check-outline" width="20" height="20" class="perk-icon" />
          <span>Casco Higienizado Incluido</span>
        </div>
        <div class="perk-item">
          <Icon name="mdi:lock-outline" width="20" height="20" class="perk-icon" />
          <span>Candado U-Lock Antirrobo</span>
        </div>
        <div class="perk-item">
          <Icon name="mdi:truck-delivery-outline" width="20" height="20" class="perk-icon" />
          <span>Entrega en Hotel / Airbnb</span>
        </div>
        <div class="perk-item">
          <Icon name="mdi:tools" width="20" height="20" class="perk-icon" />
          <span>Asistencia Mecánica en Ruta</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Catalog Section -->
  <section class="rental-catalog-section">
    <div class="container">
      
      <!-- Filter Bar -->
      <div class="filter-wrapper">
        <div class="category-pills" id="category-filters">
          <button class="cat-pill active" data-cat="all">Todas las Bicicletas</button>
          <button class="cat-pill" data-cat="Urbana">Urbanas de Playa &amp; Cruisers</button>
          <button class="cat-pill" data-cat="MTB">Montaña &amp; Cenotes (MTB)</button>
          <button class="cat-pill" data-cat="Gravel">Gravel Aventura</button>
          <button class="cat-pill" data-cat="Ruta">Ruta &amp; Fondo Tulum</button>
          <button class="cat-pill" data-cat="E-Bike">E-Bikes Eléctricas</button>
        </div>

        <div class="duration-hint">
          <span><strong>Tip viajero:</strong> A partir de 3 días de renta, la entrega y recogida en tu hotel es <strong>completamente gratuita</strong>.</span>
        </div>
      </div>

      <!-- Fleet Grid -->
      <div class="fleet-grid" id="fleet-grid">
        <!-- Rendered by client JS -->
      </div>

    </div>
  </section>

  <!-- How It Works Section -->
  <section class="how-it-works-section">
    <div class="container">
      <div class="section-heading">
        <span class="subheading-tag">Cero Fila · Cero Complicaciones</span>
        <h2>¿Cómo Funciona la Renta en The Garage?</h2>
        <p>Proceso 100% transparente pensado tanto para turistas internacionales como residentes de Playa del Carmen.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">01</div>
          <div class="step-icon-wrap">
            <Icon name="mdi:calendar-clock" width="28" height="28" />
          </div>
          <h3>Elige tu Bici y Fechas</h3>
          <p>Selecciona tu modelo ideal y fechas de rodada. Si no estás seguro de tu talla, te asesoramos según tu estatura.</p>
        </div>

        <div class="step-card">
          <div class="step-num">02</div>
          <div class="step-icon-wrap">
            <Icon name="mdi:map-marker-radius" width="28" height="28" />
          </div>
          <h3>Recibe en Hotel o Tienda</h3>
          <p>Te la llevamos directo a la puerta de tu hotel o condominio en Playa del Carmen, o recógela en nuestra tienda en Av. Ich Xeel.</p>
        </div>

        <div class="step-card">
          <div class="step-num">03</div>
          <div class="step-icon-wrap">
            <Icon name="mdi:bicycle" width="28" height="28" />
          </div>
          <h3>Disfruta del Caribe</h3>
          <p>Rueda con total tranquilidad. Todas nuestras unidades cuentan con transmisión desengrasada y cera cerámica anti-salitre.</p>
        </div>

        <div class="step-card">
          <div class="step-num">04</div>
          <div class="step-icon-wrap">
            <Icon name="mdi:cash-refund" width="28" height="28" />
          </div>
          <h3>Devolución y Reembolso</h3>
          <p>Pasamos a recoger la bicicleta en la fecha pactada y liberamos tu depósito en garantía de inmediato sin letras chiquitas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table vs Generic Rentals -->
  <section class="comparison-section">
    <div class="container">
      <div class="comparison-card">
        <div class="comp-header">
          <h3>¿Por qué rentar con The Garage Bike Experts?</h3>
          <p>Diferencias claras contra las bicicletas de autoservicio o puestos callejeros en Playa del Carmen.</p>
        </div>

        <div class="comp-table-wrap">
          <table class="comp-table">
            <thead>
              <tr>
                <th>Característica</th>
                <th class="garage-col">The Garage Bike Experts</th>
                <th class="generic-col">Bicis Públicas / Puestos Calle</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Mantenimiento de Taller</strong></td>
                <td class="garage-col"><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span> Ajustadas por mecánicos cada 40h de uso</td>
                <td class="generic-col"><span class="cross"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span> Cadenas oxidadas por salitre y cambios duros</td>
              </tr>
              <tr>
                <td><strong>Entrega en Hotel / Airbnb</strong></td>
                <td class="garage-col"><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span> Directo a tu recepción o villa privada</td>
                <td class="generic-col"><span class="cross"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span> Tienes que caminar a buscar estaciones</td>
              </tr>
              <tr>
                <td><strong>Gama y Marcas Líderes</strong></td>
                <td class="garage-col"><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span> Trek, Specialized, Basso (Gravel, MTB, E-Bike)</td>
                <td class="generic-col"><span class="cross"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span> Bicis pesadas de fierro de una velocidad</td>
              </tr>
              <tr>
                <td><strong>Pedales Personalizados</strong></td>
                <td class="garage-col"><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span> Plataforma, Shimano SPD o Look Keo gratis</td>
                <td class="generic-col"><span class="cross"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span> Solo pedal plástico desgastado</td>
              </tr>
              <tr>
                <td><strong>Kit de Seguridad Incluido</strong></td>
                <td class="garage-col"><span class="check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span> Casco higienizado + Candado U-Lock blindado</td>
                <td class="generic-col"><span class="cross"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span> Sin casco ni candado seguro</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ BOOKING MODAL / DRAWER ═══════════════════════ -->
  <div id="rental-modal" class="rental-modal-overlay" style="display:none;">
    <div class="rental-modal-box">
      
      <div class="modal-header">
        <div style="display:flex; align-items:center; gap:0.65rem;">
          <span style="display:flex; align-items:center; color:var(--accent-orange);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="m12 17.5 2.5-7.5H6l3.5 7.5"/><path d="M12 17.5 9.5 10H6"/><path d="m15 5-3 5"/></svg>
          </span>
          <div>
            <h2 id="rm-bike-name" style="font-size:1.15rem; margin:0; font-weight:700;">Reservar Bicicleta</h2>
            <span id="rm-bike-meta" style="font-size:0.75rem; color:var(--text-muted);">Talla & Categoría</span>
          </div>
        </div>
        <button class="btn-close-modal" id="btn-close-rental-modal">
          <Icon name="mdi:close" width="20" height="20" />
        </button>
      </div>

      <div class="modal-body">
        
        <!-- Bike Snapshot Banner -->
        <div class="bike-snapshot">
          <img id="rm-bike-img" src="" alt="" />
          <div class="snapshot-details">
            <div class="rate-badge">
              <span id="rm-daily-rate" class="rate-amount">$0</span>
              <span class="rate-period">MXN / 24 hrs</span>
            </div>
            <p id="rm-bike-summary" class="snapshot-text"></p>
          </div>
        </div>

        <form id="rental-booking-form">
          
          <!-- Dates -->
          <div class="form-row-2">
            <div class="form-group">
              <label for="rent-start-date">Fecha de Inicio / Entrega</label>
              <input type="date" id="rent-start-date" required class="form-input" />
            </div>
            <div class="form-group">
              <label for="rent-end-date">Fecha de Devolución</label>
              <input type="date" id="rent-end-date" required class="form-input" />
            </div>
          </div>

          <!-- Rider Info -->
          <div class="form-row-2">
            <div class="form-group">
              <label for="rent-rider-name">Nombre del Ciclista</label>
              <input type="text" id="rent-rider-name" placeholder="Ej. Carlos Mendoza" required class="form-input" />
            </div>
            <div class="form-group">
              <label for="rent-rider-phone">WhatsApp de Contacto (10 dígitos)</label>
              <input type="tel" id="rent-rider-phone" placeholder="Ej. 9841234567" required class="form-input" />
            </div>
          </div>

          <!-- Estatura & Pedales -->
          <div class="form-row-2">
            <div class="form-group">
              <label for="rent-rider-height">Estatura del Ciclista</label>
              <select id="rent-rider-height" class="form-select">
                <option value="155-165">1.55 m – 1.65 m (Talla S recomendada)</option>
                <option value="166-176" selected>1.66 m – 1.76 m (Talla M recomendada)</option>
                <option value="177-187">1.77 m – 1.87 m (Talla L recomendada)</option>
                <option value="188+">Más de 1.88 m (Talla XL recomendada)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="rent-pedal-pref">Tipo de Pedales Preferidos</label>
              <select id="rent-pedal-pref" class="form-select">
                <option value="Plataforma normal">Plataforma convencional (Tenis de calle)</option>
                <option value="Shimano SPD MTB">Shimano SPD (Montaña / Gravel)</option>
                <option value="Look Keo / SPD-SL Ruta">Look Keo / SPD-SL (Carretera)</option>
                <option value="Trae pedales propios">Traigo mis pedales (Instalación gratis)</option>
              </select>
            </div>
          </div>

          <!-- Entrega Location -->
          <div class="form-group">
            <label>Punto de Entrega / Recogida</label>
            <div class="delivery-toggle-grid">
              <label class="del-option active" id="del-opt-tienda">
                <input type="radio" name="delivery_type" value="tienda" checked style="display:none;" />
                <span class="del-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </span>
                <div>
                  <strong>Recoger en Tienda Física</strong>
                  <small>Av. Ich Xeel, Cataluña · Gratis</small>
                </div>
              </label>

              <label class="del-option" id="del-opt-hotel">
                <input type="radio" name="delivery_type" value="hotel" style="display:none;" />
                <span class="del-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </span>
                <div>
                  <strong>Entrega en Hotel / Airbnb</strong>
                  <small id="del-fee-hint">Playa del Carmen · $150 MXN (Gratis en 3+ días)</small>
                </div>
              </label>
            </div>
          </div>

          <div class="form-group" id="hotel-address-group" style="display:none;">
            <label for="rent-hotel-address">Nombre del Hotel, Airbnb o Dirección en Playa del Carmen</label>
            <input type="text" id="rent-hotel-address" placeholder="Ej. Hotel The Fives Downtown o Condominio Playacar Fase 2" class="form-input" />
          </div>

          <!-- Pricing Calculation Card -->
          <div class="pricing-breakdown-card">
            <div class="pb-row">
              <span id="pb-days-label">Renta por 1 Día</span>
              <strong id="pb-rental-total">$0 MXN</strong>
            </div>
            <div class="pb-row">
              <span>Entrega & Recogida a Domicilio</span>
              <span id="pb-delivery-fee" style="color:var(--accent-green);">Gratis en Tienda</span>
            </div>
            <div class="pb-row" style="border-top:1px dashed rgba(255,255,255,0.1); padding-top:0.4rem; margin-top:0.4rem;">
              <span style="font-size:0.78rem; color:#86868b;">Depósito de Garantía (100% Reembolsable)</span>
              <span id="pb-deposit-fee" style="font-size:0.85rem; color:#d4d4d8;">$0 MXN</span>
            </div>
            <div class="pb-total-row">
              <span>Total a Liquidar:</span>
              <strong id="pb-grand-total" class="grand-total">$0 MXN</strong>
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="modal-actions">
            <button type="button" class="btn-wa-confirm" id="btn-confirm-wa">
              <Icon name="mdi:whatsapp" width="20" height="20" />
              <span>Solicitar Reserva por WhatsApp</span>
            </button>
          </div>

          <p class="terms-microtext">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Tu información está protegida. Al reservar, aceptas el contrato de comodato y deslinde civil de The Garage Bike Experts. El depósito de garantía se reintegra íntegro en la misma forma de pago al regresar la bicicleta.
          </p>
        </form>

      </div>
    </div>
  </div>

</Base>

<style>
  :root {
    --accent-orange: #ff9500;
    --accent-blue: #0071e3;
    --accent-green: #34c759;
    --bg-card: #18181b;
    --border-card: rgba(255, 255, 255, 0.08);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ─── Hero Section ─── */
  .rental-hero {
    position: relative;
    padding: 5rem 0 3.5rem;
    background: radial-gradient(circle at 50% 20%, rgba(0, 113, 227, 0.15), transparent 70%),
                radial-gradient(circle at 80% 50%, rgba(255, 149, 0, 0.08), transparent 60%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #f5f5f7;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 10px var(--accent-green);
  }

  .hero-title {
    font-size: clamp(2.1rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .gradient-text {
    background: linear-gradient(135deg, #2997ff, #30d158);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: #a1a1aa;
    max-width: 760px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .perks-row {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.6rem 1.1rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #e4e4e7;
  }

  .perk-icon {
    color: var(--accent-blue);
  }

  /* ─── Catalog & Filters ─── */
  .rental-catalog-section {
    padding: 3.5rem 0;
  }

  .filter-wrapper {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .category-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cat-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    padding: 0.55rem 1.1rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .cat-pill.active {
    background: var(--accent-blue);
    border-color: var(--accent-blue);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 113, 227, 0.35);
  }

  .duration-hint {
    font-size: 0.82rem;
    color: var(--accent-green);
    background: rgba(52, 199, 89, 0.1);
    border: 1px solid rgba(52, 199, 89, 0.25);
    padding: 0.35rem 1rem;
    border-radius: 100px;
  }

  /* ─── Fleet Grid & Cards ─── */
  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .bike-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .bike-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .card-media-wrap {
    height: 220px;
    position: relative;
    overflow: hidden;
    background: #09090b;
  }

  .card-media-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .bike-card:hover .card-media-wrap img {
    transform: scale(1.04);
  }

  .badge-category {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    color: #f5f5f7;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .badge-size {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    background: rgba(0, 113, 227, 0.85);
    color: #ffffff;
    font-size: 0.72rem;
