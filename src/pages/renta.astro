<script is:inline define:vars={{ rentalFleetJson }}>
  (function() {
    function getPublicFleet() {
      try {
        const stored = localStorage.getItem('thegarage_rental_fleet');
        if (stored) {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {}
      return JSON.parse(rentalFleetJson);
    }

    const FLEET = getPublicFleet();

    // Format currency
    function formatMXN(num) {
      return '$' + Math.round(num).toLocaleString('es-MX');
    }

    let activeCategory = 'all';
    let selectedBike = null;

    // Render Fleet Grid
    function renderFleet() {
      const grid = document.getElementById('fleet-grid');
      if (!grid) return;

      const visibleBikes = FLEET.filter(b => b.publishedOnWeb !== false);
      const filtered = activeCategory === 'all' 
        ? visibleBikes 
        : visibleBikes.filter(b => b.category === activeCategory);

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: #8e8e93;">
            <div style="margin-bottom: 0.75rem; color: #555;"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="m12 17.5 2.5-7.5H6l3.5 7.5"/><path d="M12 17.5 9.5 10H6"/><path d="m15 5-3 5"/></svg></div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">No hay unidades disponibles en esta categoría</h3>
            <p style="font-size: 0.9rem; max-width: 450px; margin: 0 auto;">Todas nuestras bicicletas para esta modalidad están en rodada o puedes consultar disponibilidad directa por WhatsApp.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(bike => {
        const isAvailable = bike.status === 'disponible';
        const isRented = bike.status === 'en_renta';
        const isService = bike.status === 'en_taller';

        let actionBtn = '';
        if (isAvailable) {
          actionBtn = '<button class="btn-rent-action btn-rent-available" onclick="openRentalModal(\'' + bike.id + '\')"><span>Reservar Unidad</span></button>';
        } else if (isRented) {
          actionBtn = '<button class="btn-rent-action btn-rent-available" style="background:#ff9500; color:#000;" onclick="openRentalModal(\'' + bike.id + '\')"><span>Reservar Próxima Fecha</span></button>';
        } else {
          actionBtn = '<button class="btn-rent-action btn-rent-service" disabled><span>En Servicio de Taller</span></button>';
        }

        return `
          <div class="bike-card">
            <div class="card-media-wrap">
              <img src="${bike.image}" alt="${bike.model}" loading="lazy" />
              <span class="badge-category">${bike.category}</span>
              <span class="badge-size">Talla ${bike.size}</span>
            </div>
            
            <div class="card-content">
              <h3 class="card-title">${bike.model}</h3>
              <div class="card-height-fit">
                <span>Ajuste recomendado: ${bike.riderHeightRange}</span>
              </div>

              <ul class="card-features">
                ${bike.features.slice(0, 3).map(f => `<li>${f}</li>`).join('')}
              </ul>

              <div class="pricing-matrix">
                <div class="pm-item">
                  <span class="pm-label">1 Día</span>
                  <span class="pm-price">${formatMXN(bike.dailyRate)}</span>
                </div>
                <div class="pm-item">
                  <span class="pm-label">Fin de Sem</span>
                  <span class="pm-price">${formatMXN(bike.weekendRate)}</span>
                </div>
                <div class="pm-item">
                  <span class="pm-label">Semana</span>
                  <span class="pm-price">${formatMXN(bike.weeklyRate)}</span>
                </div>
              </div>

              ${actionBtn}
            </div>
          </div>
        `;
      }).join('');
    }

    // Category Filter Listeners
    document.querySelectorAll('.cat-pill').forEach(pill => {
      pill.addEventListener('click', function() {
        document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        activeCategory = this.dataset.cat;
        renderFleet();
      });
    });

    // ─── Modal Booking Engine ───
    const modal = document.getElementById('rental-modal');
    const closeBtn = document.getElementById('btn-close-rental-modal');
    const startDateInput = document.getElementById('rent-start-date');
    const endDateInput = document.getElementById('rent-end-date');

    // Set default dates (Today and Tomorrow)
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);

    const todayStr = today.toISOString().slice(0, 10);
    const tomorrowStr = tomorrow.toISOString().slice(0, 10);

    if (startDateInput) {
      startDateInput.min = todayStr;
      startDateInput.value = todayStr;
    }
    if (endDateInput) {
      endDateInput.min = tomorrowStr;
      endDateInput.value = tomorrowStr;
    }

    window.openRentalModal = function(bikeId) {
      selectedBike = FLEET.find(b => b.id === bikeId);
      if (!selectedBike) return;

      document.getElementById('rm-bike-name').textContent = selectedBike.model;
      document.getElementById('rm-bike-meta').textContent = `Categoría ${selectedBike.category} · Talla ${selectedBike.size} (${selectedBike.riderHeightRange})`;
      document.getElementById('rm-bike-img').src = selectedBike.image;
      document.getElementById('rm-daily-rate').textContent = formatMXN(selectedBike.dailyRate);
      document.getElementById('rm-bike-summary').textContent = selectedBike.componentsSummary;
      document.getElementById('pb-deposit-fee').textContent = formatMXN(selectedBike.depositAmount) + ' MXN';

      recalculatePrice();
      modal.style.display = 'flex';
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
        selectedBike = null;
      });
    }

    // Delivery Radio Toggles
    const optTienda = document.getElementById('del-opt-tienda');
    const optHotel = document.getElementById('del-opt-hotel');
    const hotelGroup = document.getElementById('hotel-address-group');

    if (optTienda && optHotel) {
      optTienda.addEventListener('click', () => {
        optTienda.classList.add('active');
        optHotel.classList.remove('active');
        optTienda.querySelector('input').checked = true;
        if (hotelGroup) hotelGroup.style.display = 'none';
        recalculatePrice();
      });

      optHotel.addEventListener('click', () => {
        optHotel.classList.add('active');
        optTienda.classList.remove('active');
        optHotel.querySelector('input').checked = true;
        if (hotelGroup) hotelGroup.style.display = 'block';
        recalculatePrice();
      });
    }

    function calculateDays() {
      const s = new Date(startDateInput.value);
      const e = new Date(endDateInput.value);
      const diffMs = e - s;
      if (isNaN(diffMs) || diffMs <= 0) return 1;
      return Math.max(1, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
    }

    function recalculatePrice() {
      if (!selectedBike) return;

      const days = calculateDays();
      let rentTotal = 0;

      // Tiered discount calculation:
      if (days >= 7) {
        const weeks = Math.floor(days / 7);
        const remDays = days % 7;
        rentTotal = (weeks * selectedBike.weeklyRate) + (remDays * (selectedBike.weeklyRate / 7));
      } else if (days >= 3) {
        rentTotal = selectedBike.weekendRate + ((days - 3) * (selectedBike.dailyRate * 0.8));
      } else {
        rentTotal = days * selectedBike.dailyRate;
      }
      rentTotal = Math.round(rentTotal);

      // Delivery Fee
      const isHotel = optHotel && optHotel.classList.contains('active');
      let deliveryFee = 0;
      if (isHotel) {
        deliveryFee = days >= 3 ? 0 : 150;
      }

      const deposit = selectedBike.depositAmount || 1000;
      const grandTotal = rentTotal + deliveryFee;

      // Update UI
      document.getElementById('pb-days-label').textContent = `Renta por ${days} ${days === 1 ? 'Día (24 hrs)' : 'Días'}`;
      document.getElementById('pb-rental-total').textContent = formatMXN(rentTotal) + ' MXN';
      
      const delEl = document.getElementById('pb-delivery-fee');
      if (delEl) {
        if (!isHotel) {
          delEl.textContent = 'Gratis en Tienda';
          delEl.style.color = '#34c759';
        } else if (deliveryFee === 0) {
          delEl.textContent = '¡Gratis! (Promoción 3+ días)';
          delEl.style.color = '#34c759';
        } else {
          delEl.textContent = '+$150 MXN';
          delEl.style.color = '#d4d4d8';
        }
      }

      document.getElementById('pb-grand-total').textContent = formatMXN(grandTotal) + ' MXN';
    }

    if (startDateInput) startDateInput.addEventListener('change', recalculatePrice);
    if (endDateInput) endDateInput.addEventListener('change', recalculatePrice);

    // ─── WhatsApp Booking Dispatcher ───
    const waBtn = document.getElementById('btn-confirm-wa');
    if (waBtn) {
      waBtn.addEventListener('click', () => {
        if (!selectedBike) return;

        const name = document.getElementById('rent-rider-name').value.trim();
        const phone = document.getElementById('rent-rider-phone').value.trim();
        const start = startDateInput.value;
        const end = endDateInput.value;
        const days = calculateDays();
        const height = document.getElementById('rent-rider-height').value;
        const pedal = document.getElementById('rent-pedal-pref').value;
        const isHotel = optHotel && optHotel.classList.contains('active');
        const hotelAddr = document.getElementById('rent-hotel-address').value.trim();

        if (!name || !phone) {
          alert('Por favor ingresa tu nombre y número de WhatsApp para confirmar tu reserva.');
          return;
        }

        if (isHotel && !hotelAddr) {
          alert('Por favor especifica el nombre de tu hotel, Airbnb o dirección de entrega en Playa del Carmen.');
          return;
        }

        const total = document.getElementById('pb-grand-total').textContent;
        const deliveryText = isHotel ? `Entrega a domicilio: ${hotelAddr}` : 'Recojo en tienda (Av. Ich Xeel)';

        const msg = encodeURIComponent(
          `*SOLICITUD DE RENTA DE BICICLETA — THE GARAGE*\n` +
          `--------------------------------------
` +
          `• *Bicicleta:* ${selectedBike.model} (Talla ${selectedBike.size})
` +
          `• *Ciclista:* ${name}
` +
          `• *WhatsApp:* ${phone}
` +
          `• *Fechas:* del ${start} al ${end} (${days} días)
` +
          `• *Estatura:* ${height} cm
` +
          `• *Pedales solicitados:* ${pedal}
` +
          `• *Modalidad:* ${deliveryText}
` +
          `• *Importe estimado:* ${total}
` +
          `• *Depósito en garantía:* ${formatMXN(selectedBike.depositAmount)} MXN (Reembolsable)
` +
          `--------------------------------------
` +
          `Hola The Garage! Me gustaría confirmar la disponibilidad de esta bicicleta para esas fechas. ¿Me pueden apoyar con la confirmación?`
        );

        window.open(`https://api.whatsapp.com/send?phone=529841381493&text=${msg}`, '_blank');
      });
    }

    // Initial render
    renderFleet();
  })();
</script>
