---
import { Icon } from 'astro-icon/components';
const { title = "Panel Maestro | The Garage" } = Astro.props;
---
<html lang="es" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Synchronous Client-Side Auth & Route Guard -->
  <script src="../utils/securityLogger.ts"></script>
  <script is:inline>
    (function() {
      function logSecurityEvent(type, level, details, userContext) {
        if (typeof window !== 'undefined' && typeof window.recordSecurityLog === 'function') {
          window.recordSecurityLog(type, level, details, userContext);
          return;
        }
        try {
          var raw = localStorage.getItem('bicisaas_audit_log');
          var logs = raw ? JSON.parse(raw) : [];
          logs.unshift({
            timestamp: new Date().toISOString(),
            type: type,
            level: level,
            user: (userContext && userContext.user) || 'anon',
            role: (userContext && userContext.role) || 'guest',
            path: window.location.pathname,
            details: details || {}
          });
          if (logs.length > 50) logs.length = 50;
          localStorage.setItem('bicisaas_audit_log', JSON.stringify(logs));
        } catch(_) {}
      }

      try {
        var rawSession = localStorage.getItem('bicisaas_session');
        var currentPath = window.location.pathname.replace(/\/$/, '') || '/panel';

        // 1. If not logged in, redirect immediately to login
        if (!rawSession) {
          document.cookie = 'bicisaas_auth=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          window.location.replace('/panel/login?redirect=' + encodeURIComponent(window.location.pathname));
          return;
        }

        var session = JSON.parse(rawSession);
        if (!session || !session.userId || !session.role) {
          localStorage.removeItem('bicisaas_session');
          document.cookie = 'bicisaas_auth=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          window.location.replace('/panel/login?redirect=' + encodeURIComponent(window.location.pathname));
          return;
        }

        // 1.1 Inactivity session expiration check (8 hours timeout)
        var now = Date.now();
        if (session.expiresAt && now > session.expiresAt) {
          logSecurityEvent('SESSION_EXPIRED', 'WARN', {
            expiredAt: new Date(session.expiresAt).toISOString(),
            elapsedMinutes: Math.round((now - session.expiresAt) / 60000)
          }, { user: session.name, role: session.roleLabel || session.role });
          localStorage.removeItem('bicisaas_session');
          document.cookie = 'bicisaas_auth=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          window.location.replace('/panel/login?reason=expired&redirect=' + encodeURIComponent(window.location.pathname));
          return;
        }

        // Sliding renewal of active session activity & edge cookie sync
        session.lastActivity = now;
        session.expiresAt = now + (8 * 60 * 60 * 1000);
        try { localStorage.setItem('bicisaas_session', JSON.stringify(session)); } catch(_) {}

        if (session.sessionId) {
          document.cookie = 'bicisaas_auth=' + encodeURIComponent(session.sessionId) + '; path=/; SameSite=Lax; max-age=' + (8 * 3600);
        }

        // 2. Check RBAC permissions for current path (OWASP A01: Deny by default)
        var moduleMap = {
          '/panel': 'dashboard',
          '/panel/crm': 'crm',
          '/panel/inventario': 'inventario',
          '/panel/rentas': 'rentas',
          '/panel/taller': 'taller',
          '/panel/contabilidad': 'contabilidad',
          '/panel/analytics': 'analytics',
          '/panel/sitio-web': 'sitio-web',
          '/panel/empleados': 'empleados',
          '/panel/mi-perfil': 'mi-perfil'
        };

        if (session.role === 'admin') {
          sessionStorage.removeItem('bicisaas_auth_denied');
          sessionStorage.removeItem('bicisaas_denied_role');
        } else {
          var isAllowed = false; // Deny by default
          var defaultRoleMods = {
            'mecanico': ['dashboard', 'crm', 'inventario', 'taller', 'mi-perfil'],
            'ventas': ['dashboard', 'crm', 'inventario', 'rentas', 'mi-perfil'],
            'personalizado': ['dashboard', 'mi-perfil']
          };
          var rawAllowed = (session.allowedModules && session.allowedModules.length > 0)
            ? session.allowedModules
            : (defaultRoleMods[session.role] || ['dashboard', 'mi-perfil']);

          var allowed = rawAllowed.map(function(m) {
            return String(m).toLowerCase().trim().replace(/\s+/g, '-');
          });

          // Match current path to module key
          var matchedKey = Object.keys(moduleMap).find(function(k) {
            return currentPath === k || (k !== '/panel' && currentPath.indexOf(k + '/') === 0);
          });

          var currentMod = matchedKey ? moduleMap[matchedKey] : null;

          // Personal profile is always allowed for all authenticated personnel
          if (currentMod === 'mi-perfil') {
            isAllowed = true;
          } else if (currentMod && allowed.indexOf(currentMod) !== -1) {
            isAllowed = true;
          } else if (currentPath === '/panel') {
            isAllowed = (allowed.indexOf('dashboard') !== -1);
          }

          if (!isAllowed) {
            logSecurityEvent('RBAC_DENIED', 'SECURITY_ALERT', {
              attemptedPath: currentPath,
              requiredModule: currentMod,
              allowedModules: allowed
            }, { user: session.name, role: session.roleLabel || session.role });
            sessionStorage.setItem('bicisaas_auth_denied', 'true');
            sessionStorage.setItem('bicisaas_denied_role', session.roleLabel || session.role);
            var modToPath = {
              'dashboard': '/panel',
              'crm': '/panel/crm',
              'empleados': '/panel/empleados',
              'mi-perfil': '/panel/mi-perfil',
              'inventario': '/panel/inventario',
              'rentas': '/panel/rentas',
              'taller': '/panel/taller',
              'contabilidad': '/panel/contabilidad',
              'analytics': '/panel/analytics',
              'sitio-web': '/panel/sitio-web'
            };
            var safeFallback = '/panel/mi-perfil';
            for (var i = 0; i < allowed.length; i++) {
              if (modToPath[allowed[i]]) {
                safeFallback = modToPath[allowed[i]];
                break;
              }
            }
            if (currentPath === safeFallback) {
              // Circuit breaker: already on safe fallback and still blocked, purge session to prevent reload loop
              localStorage.removeItem('bicisaas_session');
              localStorage.removeItem('bicisaas_user_role');
              document.cookie = 'bicisaas_auth=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
              window.location.replace('/panel/login?reason=unauthorized');
            } else {
              window.location.replace(safeFallback);
            }
            return;
          }
        }
      } catch(e) {
        window.location.replace('/panel/login');
      }
    })();
  </script>

  <style is:global>
    :root {
      /* Apple & Zoho Light Theme (Default) */
      --bg-app: #f5f5f7;
      --bg-base: #f0f0f3;
      --bg-surface: #ffffff;
      --bg-panel: #ffffff;
      --bg-surface-hover: #e8e8ed;
      --text-main: #1d1d1f;
      --text-primary: #1d1d1f;
      --text-muted: #86868b;
      --text-secondary: #6e6e73;
      --border-color: #d2d2d7;
      --border-subtle: #e1e1e6;
      --accent-color: #0071e3;
      --accent-hover: #0077ed;
      --accent-blue: #0071e3;
      --accent-green: #34c759;
      --accent-orange: #ff9500;
      --accent-red: #ff3b30;
      --sidebar-width: 260px;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 20px;
      --shadow-soft: 0 2px 8px rgba(0, 0, 0, 0.04);
      --shadow-float: 0 12px 32px rgba(0, 0, 0, 0.08);
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
      --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
    }
    
    html.dark {
      /* Dark Theme */
      --bg-app: #121214;
      --bg-base: #18181b;
      --bg-surface: #202024;
      --bg-panel: #202024;
      --bg-surface-hover: #27272a;
      --text-main: #f5f5f7;
      --text-primary: #f5f5f7;
      --text-muted: #86868b;
      --text-secondary: #a1a1aa;
      --border-color: #3f3f46;
      --border-subtle: #2e2e33;
      --accent-color: #2997ff;
      --accent-hover: #3b9fff;
      --accent-blue: #2997ff;
      --accent-green: #30d158;
      --accent-orange: #ff9f0a;
      --accent-red: #ff453a;
      --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.35);
      --shadow-float: 0 16px 40px rgba(0, 0, 0, 0.5);
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-app);
      color: var(--text-main);
      display: flex;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Sidebar */
    .sidebar {
      width: var(--sidebar-width);
      min-width: var(--sidebar-width);
      flex-shrink: 0;
      background-color: var(--bg-panel);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1rem;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .sidebar-header {
      font-weight: 600;
      font-size: 1.25rem;
      margin-bottom: 2rem;
      padding-left: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-sm);
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      margin-bottom: 0.25rem;
      transition: all 0.15s ease-in-out;
    }

    .nav-item:hover {
      background-color: var(--bg-surface-hover);
      color: var(--text-main);
    }

    .nav-item.active {
      background-color: var(--accent-color);
      color: #ffffff;
    }

    /* Topbar */
    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .topbar {
      height: 60px;
      min-height: 60px;
      background-color: var(--bg-panel);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 2rem;
      gap: 1rem;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .content-area {
      flex: 1;
      overflow-y: auto;
      padding: 2rem;
    }

    /* Base Components */
    .btn-icon {
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
      border-radius: var(--radius-sm);
      transition: background 0.15s, color 0.15s;
    }

    .btn-icon:hover {
      background-color: var(--bg-surface-hover);
      color: var(--text-main);
    }

    .btn-primary {
      background-color: var(--accent-color);
      color: #ffffff;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: background-color 0.15s;
    }

    .btn-primary:hover {
      background-color: var(--accent-hover);
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-color);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: background-color 0.15s, border-color 0.15s;
    }

    .btn-secondary:hover {
      background-color: var(--bg-surface-hover);
    }

    .btn-demo-seed {
      background: linear-gradient(135deg, #af52de, #5856d6);
      color: #ffffff;
      border: none;
      padding: 0.45rem 0.9rem;
      border-radius: 100px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      box-shadow: 0 2px 8px rgba(175, 82, 222, 0.3);
      transition: all 0.2s ease;
      letter-spacing: 0.02em;
    }
    .btn-demo-seed:hover {
      background: linear-gradient(135deg, #bf5af2, #5e5ce6);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(175, 82, 222, 0.45);
    }

    /* Bento Box Styles */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .bento-card {
      background-color: var(--bg-panel);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .bento-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    /* Auth Toast Alert (Fixed overlay, out of document flow) */
    #auth-guard-toast {
      display: none !important;
      position: fixed !important;
      top: 1.25rem !important;
      right: 1.25rem !important;
      z-index: 999999 !important;
      background: rgba(255, 69, 58, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      color: #fff;
      padding: 0.85rem 1.25rem;
      border-radius: 12px;
      box-shadow: 0 12px 36px rgba(255, 69, 58, 0.35);
      font-size: 0.85rem;
      font-weight: 600;
      align-items: center;
      gap: 0.65rem;
      pointer-events: none;
      animation: slideInDown 0.3s ease;
    }
    #auth-guard-toast.show-toast {
      display: flex !important;
    }
    @keyframes slideInDown {
      from { transform: translateY(-20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-header">
      <Icon name="mdi:bicycle" width="28" height="28" />
      <span>BiciSaaS</span>
    </div>
    
    <nav id="panel-nav" style="flex:1; overflow-y:auto;">
      <a href="/panel" class="nav-item" data-path="/panel"><Icon name="mdi:view-dashboard-outline" width="20" height="20" /> Dashboard</a>
      <a href="/panel/crm" class="nav-item" data-path="/panel/crm"><Icon name="mdi:account-group-outline" width="20" height="20" /> CRM Clientes</a>
      <a href="/panel/empleados" class="nav-item admin-nav" data-path="/panel/empleados"><Icon name="mdi:badge-account-horizontal-outline" width="20" height="20" /> Gestión de Empleados</a>
      <a href="/panel/mi-perfil" class="nav-item employee-nav" data-path="/panel/mi-perfil"><Icon name="mdi:account-circle-outline" width="20" height="20" /> Mi Perfil & Tareas</a>
      <a href="/panel/inventario" class="nav-item" data-path="/panel/inventario"><Icon name="mdi:package-variant-closed" width="20" height="20" /> Inventario Maestro & POS</a>
      <a href="/panel/rentas" class="nav-item" data-path="/panel/rentas"><Icon name="mdi:bike-fast" width="20" height="20" /> Flota & Rentas</a>
      <a href="/panel/taller" class="nav-item" data-path="/panel/taller"><Icon name="mdi:wrench-outline" width="20" height="20" /> Taller & Servicios</a>
      <a href="/panel/contabilidad" class="nav-item admin-nav" data-path="/panel/contabilidad"><Icon name="mdi:finance" width="20" height="20" /> Contabilidad & Caja</a>
      <a href="/panel/analytics" class="nav-item admin-nav" data-path="/panel/analytics"><Icon name="mdi:chart-areaspline" width="20" height="20" /> Analytics & Proyecciones</a>
      <div class="admin-nav" style="margin: 0.75rem 0 0.25rem; padding: 0 0.5rem; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-secondary); font-weight:700;">Sitio Web & Ventas</div>
      <a href="/panel/sitio-web" class="nav-item admin-nav" data-path="/panel/sitio-web"><Icon name="mdi:web" width="20" height="20" /> Gestionar Sitio Web & POS</a>
      <a href="/" target="_blank" class="nav-item" style="opacity:0.65; font-size:0.88rem;"><Icon name="mdi:open-in-new" width="18" height="18" /> Ver Sitio Público ↗</a>
    </nav>
    
    <!-- Authenticated User Profile Pill (Replaces vulnerable role selector) -->
    <div class="sidebar-footer" id="sidebar-user-card" style="padding:0.85rem; border-top:1px solid var(--border-subtle); display:flex; flex-direction:column; gap:0.65rem; background:var(--bg-panel);">
      <div style="display:flex; align-items:center; gap:0.65rem; min-width:0;">
        <div id="auth-user-avatar" style="width:36px; height:36px; border-radius:10px; background:rgba(0,113,227,0.15); border:1px solid rgba(0,113,227,0.3); display:flex; align-items:center; justify-content:center; font-size:0.88rem; font-weight:800; color:var(--accent-blue); flex-shrink:0;">
          DL
        </div>
        <div style="min-width:0; flex:1;">
          <div id="auth-user-name" style="font-size:0.85rem; font-weight:700; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
            Diego Lecourtois
          </div>
          <div id="auth-user-role-badge" style="font-size:0.72rem; font-weight:600; color:var(--accent-blue); display:inline-flex; align-items:center; gap:0.3rem;">
            <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-green); box-shadow:0 0 4px var(--accent-green);"></span>
            <span id="auth-user-role-text">Administrador</span>
          </div>
        </div>
      </div>

      <!-- Logout Button -->
      <button id="btn-user-logout" style="width:100%; display:flex; align-items:center; justify-content:center; gap:0.45rem; padding:0.45rem 0.75rem; border-radius:8px; border:1px solid var(--border-subtle); background:var(--bg-base); color:var(--text-secondary); font-size:0.78rem; font-weight:600; cursor:pointer; transition:all 0.2s;" onmouseover="this.style.color='#ff3b30'; this.style.borderColor='rgba(255,59,48,0.35)'; this.style.background='rgba(255,59,48,0.1)';" onmouseout="this.style.color='var(--text-secondary)'; this.style.borderColor='var(--border-subtle)'; this.style.background='var(--bg-base)';">
        <Icon name="mdi:logout" width="16" height="16" />
        <span>Cerrar Sesión</span>
      </button>
    </div>
  </aside>

  <main class="main-wrapper">
    <header class="topbar">
      <!-- Demo Data Seeder Button for Video/Pitch -->
      <button class="btn-demo-seed" id="btn-seed-demo-data" title="Cargar datos de prueba hiper-realistas para demo comercial o video">
        <Icon name="mdi:movie-open-play-outline" style="display:inline; vertical-align:middle; margin-right:4px;" />
        <span>Datos Demo</span>
      </button>

      <!-- Checador de Empleados / Asistencia -->
      <button class="btn-primary" id="btn-global-clock" style="font-size:0.85rem; padding:0.45rem 1rem; border-radius:100px;">
        <Icon name="mdi:clock-check-outline" style="display:inline; vertical-align:middle; margin-right:4px;" />
        <span id="global-clock-label">Entrada / Checar</span>
      </button>
      
      <!-- Theme Toggle -->
      <button class="btn-icon" id="theme-toggle" aria-label="Toggle Theme">
        <Icon name="mdi:theme-light-dark" width="24" height="24" />
      </button>
      
      <!-- Notification -->
      <button class="btn-icon" style="position:relative;" onclick="alert('Sin notificaciones pendientes')">
        <Icon name="mdi:bell-outline" width="24" height="24" />
        <span style="position:absolute; top:4px; right:4px; width:8px; height:8px; background:var(--accent-green); border-radius:50%;"></span>
      </button>
    </header>

    <div class="content-area">
      <slot />
    </div>
  </main>

  <!-- Toast Notification for Denied Route Attempts (Fixed Overlay - Never affects flex flow) -->
  <div id="auth-guard-toast" style="display:none !important; position:fixed !important; top:1.25rem !important; right:1.25rem !important; z-index:999999 !important; pointer-events:none;">
    <Icon name="mdi:shield-alert-outline" width="20" height="20" />
    <span id="auth-guard-toast-msg"></span>
  </div>

  <script is:inline>
    // Theme logic
    const toggleBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;
    if(localStorage.getItem('theme') === 'dark') {
      html.classList.add('dark');
    }
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
      });
    }

    // Check for Flash Denied Message from Auth Guard
    try {
      var raw = localStorage.getItem('bicisaas_session');
      var currSession = raw ? JSON.parse(raw) : null;
      if (currSession && currSession.role === 'admin') {
        sessionStorage.removeItem('bicisaas_auth_denied');
        sessionStorage.removeItem('bicisaas_denied_role');
      } else if (sessionStorage.getItem('bicisaas_auth_denied') === 'true') {
        const toast = document.getElementById('auth-guard-toast');
        const role = sessionStorage.getItem('bicisaas_denied_role') || 'tu usuario';
        if (toast) {
          const msg = document.getElementById('auth-guard-toast-msg');
          if (msg) msg.textContent = 'Acceso restringido: Módulo reservado (' + role + ').';
          toast.classList.add('show-toast');
          setTimeout(() => {
            toast.classList.remove('show-toast');
          }, 4500);
        }
        sessionStorage.removeItem('bicisaas_auth_denied');
        sessionStorage.removeItem('bicisaas_denied_role');
      }
    } catch(e) {}

    // Apply Active Session & RBAC UI
    function renderAuthenticatedSession() {
      try {
        const sessionRaw = localStorage.getItem('bicisaas_session');
        if (!sessionRaw) return;
        const session = JSON.parse(sessionRaw);

        // Update User Pill
        const avatarEl = document.getElementById('auth-user-avatar');
        const nameEl = document.getElementById('auth-user-name');
        const roleTextEl = document.getElementById('auth-user-role-text');

        if (avatarEl) {
          const monogram = session.monogram || (session.name ? session.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase() : 'US');
          avatarEl.textContent = monogram;
          if (session.color) {
            avatarEl.style.background = session.color + '22';
            avatarEl.style.borderColor = session.color + '66';
            avatarEl.style.color = session.color;
          }
        }
        if (nameEl) nameEl.textContent = session.name || 'Usuario';
        if (roleTextEl) roleTextEl.textContent = session.roleLabel || session.role;

        const isAdmin = session.role === 'admin';
        const allowedModules = session.allowedModules || (isAdmin ? ['dashboard', 'crm', 'inventario', 'rentas', 'taller', 'contabilidad', 'analytics', 'sitio-web', 'empleados', 'mi-perfil'] : []);

        const pathToModule = {
          '/panel': 'dashboard',
          '/panel/crm': 'crm',
          '/panel/empleados': 'empleados',
          '/panel/mi-perfil': 'mi-perfil',
          '/panel/inventario': 'inventario',
          '/panel/rentas': 'rentas',
          '/panel/taller': 'taller',
          '/panel/contabilidad': 'contabilidad',
          '/panel/analytics': 'analytics',
          '/panel/sitio-web': 'sitio-web'
        };

        // Filter Sidebar Navigation based on allowedModules
        document.querySelectorAll('#panel-nav .nav-item[data-path]').forEach(el => {
          const p = el.getAttribute('data-path');
          const mod = pathToModule[p];
          if (isAdmin) {
            el.style.display = '';
          } else if (mod) {
            el.style.display = allowedModules.includes(mod) ? '' : 'none';
          }
        });

        document.querySelectorAll('.admin-nav').forEach(el => {
          if (!el.getAttribute('data-path')) {
            el.style.display = isAdmin ? '' : 'none';
          }
        });

        // Update Topbar Clock state
        updateGlobalClockButton(session.userId);
      } catch(e) {}
    }

