        if (emp && emp.clockIn && !emp.clockOut) {
          label.textContent = `${emp.name.split(' ')[0]} • Salida (desde ${emp.clockIn})`;
          btn.style.background = 'rgba(255,59,48,0.15)';
          btn.style.color = '#ff3b30';
          btn.style.borderColor = 'rgba(255,59,48,0.3)';
