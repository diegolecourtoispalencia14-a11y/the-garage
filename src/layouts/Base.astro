---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import BehaviorTracker from '../components/BehaviorTracker.astro';
import GoogleOneTap from '../components/GoogleOneTap.astro';
import GarageBot from '../components/GarageBot.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  tipo?: string;
}

const {
  title = "The Garage • Bike Experts | Boutique Ciclista & Taller en Playa del Carmen",
  description = "Distribuidor oficial Basso Bikes Italia en Playa del Carmen. Taller certificado SRAM/Shimano, nutrición Wayfar, rodadas The Garage Ride y catálogo de bicicletas.",
  image = "/img/the-garage-logo-white.png",
  canonicalURL = Astro.url.href,
  tipo = "website",
} = Astro.props;

const siteUrl = "https://the-garage-dw4.pages.dev";
const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

const schemaLocalBusiness = {
  "@context": "https://schema.org",
  "@type": "BikeStore",
  "name": "The Garage Bike Experts",
  "image": fullImageUrl,
  "telephone": "+52-984-138-1493",
  "url": siteUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Ich Xeel CASA 19, Cataluña",
    "addressLocality": "Playa del Carmen",
    "addressRegion": "Quintana Roo",
    "postalCode": "77725",
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 20.6618,
    "longitude": -87.0874
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "14:00"
    }
  ],
  "priceRange": "$$",
  "areaServed": ["Playa del Carmen", "Tulum", "Puerto Aventuras", "Cancún", "Riviera Maya"]
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="The Garage Bike Experts" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <CookieBanner />
    <BehaviorTracker />
    <GoogleOneTap />
    <GarageBot />
  </body>
</html>
