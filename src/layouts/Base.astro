---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import BehaviorTracker from '../components/BehaviorTracker.astro';
import GoogleOneTap from '../components/GoogleOneTap.astro';
import CartDrawer from '../components/CartDrawer.astro';
import GarageBot from '../components/GarageBot.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  tipo?: string;
}

const {
  title = "The Garage • Bike Experts | Boutique Ciclista & Taller en Playa del Carmen",
  description = "Distribuidor oficial Basso Bikes Italia en Playa del Carmen. Taller certificado SRAM/Shimano, nutrición Wayfar, rodadas The Garage Ride y catálogo de bicicletas.",
  image = "/img/the-garage-logo-white.png",
  canonicalURL = Astro.url.href,
  tipo = "website",
} = Astro.props;

const siteUrl = "https://the-garage-dw4.pages.dev";
const fullImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

const schemaLocalBusiness = {
  "@context": "https://schema.org",
  "@type": ["BikeStore", "AutoRepair"],
  "name": "The Garage Bike Experts",
  "alternateName": "The Garage Playa del Carmen",
  "description": "Boutique ciclista de alta gama y taller especializado a puerta cerrada en Playa del Carmen. Distribuidor oficial Basso Bikes Italia, servicio técnico SRAM/Shimano y entregas locales.",
  "image": fullImageUrl,
  "telephone": "+52-984-138-1493",
  "url": siteUrl,
  "sameAs": [
    "https://www.instagram.com/thegarage.pdc/",
    "https://www.google.com/maps/search/?api=1&query=The+Garage+Bike+Experts+Av+Ich+Xeel+Catalu%C3%B1a+Playa+del+Carmen",
    "https://www.google.com/search?q=The+Garage+Bike+Experts+Playa+del+Carmen"
  ],
  "hasMap": "https://www.google.com/maps/search/?api=1&query=The+Garage+Bike+Experts+Av+Ich+Xeel+Catalu%C3%B1a+Playa+del+Carmen",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Ich Xeel, Cataluña (Taller a Puerta Cerrada · Atención con Cita Previa)",
    "addressLocality": "Playa del Carmen",
    "addressRegion": "Quintana Roo",
    "postalCode": "77725",
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 20.6618,
    "longitude": -87.0874
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "14:00"
    }
  ],
  "priceRange": "$$",
  "areaServed": [
    { "@type": "City", "name": "Playa del Carmen" },
    { "@type": "City", "name": "Playacar" },
    { "@type": "City", "name": "Puerto Aventuras" },
    { "@type": "City", "name": "Tulum" },
    { "@type": "City", "name": "Cancún" },
    { "@type": "AdministrativeArea", "name": "Riviera Maya" }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.95",
    "reviewCount": "38",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Roberto Mendoza" },
      "datePublished": "2024-08-14",
      "reviewBody": "Excelente servicio en mi bicicleta Basso de ruta. Calibración milimétrica y atención personalizada insuperable.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Mariana Solís" },
      "datePublished": "2024-08-28",
      "reviewBody": "La comodidad de coordinar cita previa y que te atiendan a puerta cerrada sin prisas es única en Playa del Carmen.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
    }
  ]
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="The Garage Bike Experts" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Geo / Local SEO (Playa del Carmen, Quintana Roo) -->
    <meta name="geo.region" content="MX-ROO" />
    <meta name="geo.placename" content="Playa del Carmen, Quintana Roo" />
    <meta name="geo.position" content="20.6618;-87.0874" />
    <meta name="ICBM" content="20.6618, -87.0874" />
    <meta name="google-site-verification" content="google-site-verification-thegarage-pdc-sab-2026" />

    <!-- Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <CookieBanner />
    <BehaviorTracker />
    <GoogleOneTap />
    <CartDrawer />
    <GarageBot />
  </body>
</html>
