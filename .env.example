# ══════════════════════════════════════════════════════════════
# THE GARAGE & BICISAAS — VARIABLES DE ENTORNO (PLANTILLA)
# ══════════════════════════════════════════════════════════════
# IMPORTANTE: Nunca agregues valores reales en este archivo ni
# lo subas con contraseñas a Git. Configura estos valores en el
# Dashboard de Cloudflare Pages (Settings -> Environment variables)
# o localmente en un archivo .dev.vars (ignorado por Git).
# ══════════════════════════════════════════════════════════════

# URL oficial del despliegue (para validaciones de CORS y callbacks)
PUBLIC_SITE_URL="https://the-garage-dw4.pages.dev"

# MercadoPago — Access Token de producción o prueba (Sandbox)
# Obtén tu token en: https://www.mercadopago.com.mx/developers/panel/app
# Formato típico: APP_USR-xxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx-xxxxxxxx
MP_ACCESS_TOKEN=""

# Google Gemini / AI Studio — Clave de API para el asistente virtual y consultas
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=""

# Clave secreta para firma y cifrado de sesiones administrativas (32+ caracteres aleatorios)
SESSION_SECRET=""
